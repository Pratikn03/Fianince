+    let col_w2 : ℝ := u_0 * 1 + u_1 * eta_2 + u_2 * eta_2 ^ 2 + u_3 * eta_2 ^ 3
+    let col_eta1 : ℝ := w_1 * (u_1 * 1 + u_2 * (2 * eta_1) + u_3 * (3 * eta_1 ^ 2))
+    let col_eta2 : ℝ := w_2 * (u_1 * 1 + u_2 * (2 * eta_2) + u_3 * (3 * eta_2 ^ 2))
