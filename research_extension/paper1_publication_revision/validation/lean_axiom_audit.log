{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ar_moment_succ","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin (n + 1) → ℝ),\n  CurrentMM.arMoment decay v = v 0 + decay * CurrentMM.arMoment decay fun i => v i.succ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ar_quadratic_succ","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin (n + 1) → ℝ),\n  CurrentMM.arQuadratic decay v =\n    (v 0 ^ 2 + 2 * decay * v 0 * CurrentMM.arMoment decay fun i => v i.succ) +\n      CurrentMM.arQuadratic decay fun i => v i.succ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ar_reverse_factorization","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin n → ℝ),\n  CurrentMM.arQuadratic decay v =\n    (1 - decay ^ 2) * CurrentMM.reverseMomentEnergy n decay v + decay ^ 2 * CurrentMM.arMoment decay v ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.reverse_moment_energy_nonnegative","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin n → ℝ), 0 ≤ CurrentMM.reverseMomentEnergy n decay v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ar_reverse_energy_bound","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin n → ℝ),\n  0 ≤ decay →\n    CurrentMM.probeEnergy v ≤\n      (1 + decay) ^ 2 * CurrentMM.reverseMomentEnergy n decay v - decay * (1 + decay) * CurrentMM.arMoment decay v ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ar_quadratic_coercive","type":"∀ {n : ℕ} (decay : ℝ) (v : Fin n → ℝ),\n  0 ≤ decay → decay ≤ 1 → (1 - decay) / (1 + decay) * CurrentMM.probeEnergy v ≤ CurrentMM.arQuadratic decay v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.decay_coercivity_monotone","type":"∀ (decay radius : ℝ), 0 ≤ decay → decay ≤ radius → (1 - radius) / (1 + radius) ≤ (1 - decay) / (1 + decay)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_execution_cost_identity","type":"∀ {ι : Type u_1} [inst : Fintype ι] {n : ℕ} (weights rates : ι → ℝ) (v : Fin n → ℝ),\n  CurrentMM.quadraticExecutionCost (CurrentMM.positiveMixtureKernel weights rates) v =\n    (∑ l, weights l * CurrentMM.arQuadratic (rates l) v) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.probe_energy_nonnegative","type":"∀ {n : ℕ} (v : Fin n → ℝ), 0 ≤ CurrentMM.probeEnergy v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_execution_cost_coercive","type":"∀ {ι : Type u_1} [inst : Fintype ι] {n : ℕ} (weights rates : ι → ℝ) (v : Fin n → ℝ) (impact radius : ℝ),\n  (∀ (l : ι), 0 ≤ weights l) →\n    (∀ (l : ι), 0 ≤ rates l ∧ rates l ≤ radius) →\n      radius < 1 →\n        ∑ l, weights l = impact →\n          impact * ((1 - radius) / (1 + radius)) / 2 * CurrentMM.probeEnergy v ≤\n            CurrentMM.quadraticExecutionCost (CurrentMM.positiveMixtureKernel weights rates) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.probe_energy_positive","type":"∀ {n : ℕ} (v : Fin n → ℝ), (v ≠ fun x => 0) → 0 < CurrentMM.probeEnergy v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_execution_cost_positive","type":"∀ {ι : Type u_1} [inst : Fintype ι] {n : ℕ} (weights rates : ι → ℝ) (v : Fin n → ℝ) (impact radius : ℝ),\n  (∀ (l : ι), 0 ≤ weights l) →\n    (∀ (l : ι), 0 ≤ rates l ∧ rates l ≤ radius) →\n      0 ≤ radius →\n        radius < 1 →\n          ∑ l, weights l = impact →\n            0 < impact →\n              (v ≠ fun x => 0) → 0 < CurrentMM.quadraticExecutionCost (CurrentMM.positiveMixtureKernel weights rates) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_trader_solvency_energy","type":"∀ {ι : Type u_1} [inst : Fintype ι] {n : ℕ} (weights rates : ι → ℝ) (v : Fin n → ℝ) (B P impact fee radius : ℝ),\n  (∀ (l : ι), 0 ≤ weights l) →\n    (∀ (l : ι), 0 ≤ rates l ∧ rates l ≤ radius) →\n      0 ≤ radius →\n        radius < 1 →\n          ∑ l, weights l = impact →\n            0 < impact →\n              0 ≤ fee →\n                0 ≤\n                    CurrentMM.equity\n                      (CurrentMM.traderCashAfter B P impact fee (CurrentMM.positiveMixtureKernel weights rates) v)\n                      (∑ i, v i) P →\n                  CurrentMM.probeEnergy v ≤ 2 * B / (impact * ((1 - radius) / (1 + radius)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.dealer_marked_equity_identity","type":"∀ (cash inventory quantity price nextPrice spread fees funding : ℝ),\n  CurrentMM.equity (CurrentMM.dealerCash cash quantity price spread fees funding)\n        (CurrentMM.dealerInventory inventory quantity) nextPrice -\n      CurrentMM.equity cash inventory price =\n    spread * |quantity| + (inventory - quantity) * (nextPrice - price) - fees - funding"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.counterparty_first_pulse_equity","type":"∀ (B P impact quantity cost : ℝ),\n  CurrentMM.equity (B + quantity * CurrentMM.averageFill P impact quantity - cost * quantity) (-quantity)\n      (CurrentMM.postMark P impact quantity) =\n    B - impact * quantity ^ 2 / 2 - cost * quantity"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.counterparty_first_pulse_margin_iff","type":"∀ (B P impact quantity cost margin : ℝ),\n  0 ≤ quantity →\n    (margin * |quantity| * CurrentMM.postMark P impact quantity ≤\n        CurrentMM.equity (B + quantity * CurrentMM.averageFill P impact quantity - cost * quantity) (-quantity)\n          (CurrentMM.postMark P impact quantity) ↔\n      (margin + 1 / 2) * impact * quantity ^ 2 + (cost + margin * P) * quantity ≤ B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.trader_first_pulse_equity","type":"∀ (B P impact quantity cost : ℝ),\n  CurrentMM.equity (B - quantity * CurrentMM.averageFill P impact quantity - cost * quantity) quantity\n      (CurrentMM.postMark P impact quantity) =\n    B + impact * quantity ^ 2 / 2 - cost * quantity"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.trader_fundamental_mark_equity","type":"∀ (B P impact quantity cost : ℝ),\n  CurrentMM.equity (B - quantity * CurrentMM.averageFill P impact quantity - cost * quantity) quantity P =\n    B - impact * quantity ^ 2 / 2 - cost * quantity"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.two_account_equity_conservation","type":"∀ (Btrader Bdealer inventory quantity fill mark traderCost dealerCost : ℝ),\n  CurrentMM.equity (Btrader - quantity * fill - traderCost) (inventory + quantity) mark +\n      CurrentMM.equity (Bdealer + quantity * fill - dealerCost) (-inventory - quantity) mark =\n    Btrader + Bdealer - traderCost - dealerCost"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.funded_trader_pulse_equity","type":"∀ (impact cost margin P quantity h : ℝ),\n  CurrentMM.equity\n      (CurrentMM.pulseTraderCapital impact cost margin P quantity - quantity * CurrentMM.averageFill P impact quantity -\n        cost * quantity)\n      quantity (P + quantity * h) =\n    margin * quantity * P + quantity ^ 2 * h"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.funded_trader_pulse_margin","type":"∀ (impact cost margin P quantity h : ℝ),\n  0 ≤ quantity →\n    0 ≤ h →\n      margin ≤ 1 →\n        margin * |quantity| * (P + quantity * h) ≤\n          CurrentMM.equity\n            (CurrentMM.pulseTraderCapital impact cost margin P quantity -\n                quantity * CurrentMM.averageFill P impact quantity -\n              cost * quantity)\n            quantity (P + quantity * h)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_quantity_cap_pos","type":"∀ (alpha beta B : ℝ), 0 < alpha → 0 < beta → 0 < B → 0 < CurrentMM.robustQuantityCap alpha beta B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_quantity_cap_quadratic","type":"∀ (alpha beta B : ℝ),\n  0 < alpha →\n    0 < beta →\n      0 < B → alpha * CurrentMM.robustQuantityCap alpha beta B ^ 2 + beta * CurrentMM.robustQuantityCap alpha beta B = B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_quantity_cap_iff","type":"∀ (alpha beta B V : ℝ),\n  0 < alpha → 0 < beta → 0 < B → 0 ≤ V → (alpha * V ^ 2 + beta * V ≤ B ↔ V ≤ CurrentMM.robustQuantityCap alpha beta B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_equity_disclosure_separation","type":"∀ (B impact quantity cost h0 h1 q delta : ℝ),\n  h1 - h0 = -impact ^ 2 * q * delta ^ 2 →\n    B + impact * quantity ^ 2 / 2 - cost * quantity - quantity ^ 2 * h1 -\n        (B + impact * quantity ^ 2 / 2 - cost * quantity - quantity ^ 2 * h0) =\n      quantity ^ 2 * impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.prediction_loss_derivative","type":"∀ (curvature observation theta : ℝ),\n  HasDerivAt (CurrentMM.quadraticPredictionLoss curvature observation) (curvature * (theta - observation)) theta"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_quadratic_ogd_update","type":"∀ (theta observation gamma alpha curvature : ℝ),\n  gamma + alpha * curvature ≠ 0 →\n    (1 - gamma) * theta - alpha * deriv (CurrentMM.quadraticPredictionLoss curvature observation) theta =\n      (1 - (gamma + alpha * curvature)) * theta +\n        (gamma + alpha * curvature) * (alpha * curvature / (gamma + alpha * curvature)) * observation"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.normalized_ogd_gain_unit_interval","type":"∀ (gamma alpha curvature : ℝ),\n  0 < gamma →\n    0 < alpha →\n      0 < curvature →\n        0 < alpha * curvature / (gamma + alpha * curvature) ∧ alpha * curvature / (gamma + alpha * curvature) < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.willingness_to_pay_integral","type":"∀ (V0 b cost L U : ℝ),\n  ∫ (V : ℝ) in L..U, (V0 - V) / b - cost =\n    CurrentMM.allocationSurplusPrimitive V0 b cost U - CurrentMM.allocationSurplusPrimitive V0 b cost L"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.allocation_loss_from_actual_integral","type":"∀ (V0 b cost s0 delta : ℝ),\n  b ≠ 0 →\n    ∫ (V : ℝ) in V0 - b * (s0 + delta)..V0 - b * s0, (V0 - V) / b - cost = b * (s0 - cost) * delta + b * delta ^ 2 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.capacity_interval_infeasible","type":"∀ (lower upper budget capitalPerQuantity depth : ℝ),\n  0 < capitalPerQuantity →\n    min upper (budget / capitalPerQuantity) < lower →\n      lower ≤ depth → depth ≤ upper → capitalPerQuantity * depth ≤ budget → False"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.clamped_capacity_feasible","type":"∀ (lower upper edge holding : ℝ),\n  lower ≤ upper →\n    lower ≤ CurrentMM.clampedCapacity lower upper edge holding ∧\n      CurrentMM.clampedCapacity lower upper edge holding ≤ upper"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.capacity_quadratic_difference","type":"∀ (edge holding optimum depth : ℝ),\n  CurrentMM.capacityProfit edge holding optimum - CurrentMM.capacityProfit edge holding depth =\n    (optimum - depth) * (edge - holding * (optimum + depth) / 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.clamped_capacity_maximizes","type":"∀ (lower upper edge holding depth : ℝ),\n  0 < holding →\n    lower ≤ upper →\n      lower ≤ depth ∧ depth ≤ upper →\n        CurrentMM.capacityProfit edge holding depth ≤\n          CurrentMM.capacityProfit edge holding (CurrentMM.clampedCapacity lower upper edge holding)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.capacity_weakly_increases_with_budget","type":"∀ (lower upper edge holding b0 b1 m : ℝ),\n  0 < m →\n    b0 ≤ b1 →\n      CurrentMM.clampedCapacity lower (min upper (b0 / m)) edge holding ≤\n        CurrentMM.clampedCapacity lower (min upper (b1 / m)) edge holding"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.one_cohort_jury_stability_iff","type":"∀ (kappa phi q eta : ℝ),\n  0 < kappa →\n    0 < phi →\n      0 < eta →\n        eta < 1 →\n          have a := 1 - kappa * phi;\n          have tr := a + (1 - eta) + eta * kappa * q;\n          have det := a * (1 - eta);\n          (1 - tr + det = kappa * eta * (phi - q) ∧\n              1 + tr + det = 4 - 2 * eta - kappa * ((2 - eta) * phi - eta * q) ∧\n                1 - det = eta + (1 - eta) * kappa * phi) ∧\n            (0 < 1 - tr + det ∧ 0 < 1 + tr + det ∧ 0 < 1 - det ↔\n              q < phi ∧ kappa * ((2 - eta) * phi - eta * q) < 4 - 2 * eta)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.capacity_impact_transient_counterexample","type":"(9 / 10) ^ 2 + (81 / 100) ^ 2 = 14661 / 10000 ∧\n  1 < (9 / 10) ^ 2 + (81 / 100) ^ 2 ∧ (1 / 10) ^ 2 + (19 / 100) ^ 2 = 461 / 10000 ∧ (1 / 10) ^ 2 + (19 / 100) ^ 2 < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.causal_column_energy_bound","type":"∀ {T : ℕ} (impulse : ℕ → ℝ) (s : Fin T),\n  ‖CurrentMM.causalImpulseColumn impulse s‖ ^ 2 ≤ ‖CurrentMM.finiteImpulseVector T impulse‖ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.causal_column_norm_bound","type":"∀ {T : ℕ} (impulse : ℕ → ℝ) (s : Fin T),\n  ‖CurrentMM.causalImpulseColumn impulse s‖ ≤ ‖CurrentMM.finiteImpulseVector T impulse‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.causal_first_column","type":"∀ {T : ℕ} (impulse : ℕ → ℝ) (hT : 0 < T),\n  CurrentMM.causalImpulseColumn impulse ⟨0, hT⟩ = CurrentMM.finiteImpulseVector T impulse"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_convolution_quantity_bound","type":"∀ {T : ℕ} (impulse : ℕ → ℝ) (v : Fin T → ℝ) (V : ℝ),\n  ∑ t, |v t| ≤ V → ‖CurrentMM.causalImpulseConvolution impulse v‖ ≤ V * ‖CurrentMM.finiteImpulseVector T impulse‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.first_pulse_convolution_attains","type":"∀ {T : ℕ} (impulse : ℕ → ℝ),\n  0 < T →\n    ∀ (V : ℝ),\n      0 ≤ V →\n        have v := fun t => if ↑t = 0 then V else 0;\n        ∑ t, |v t| = V ∧ ‖CurrentMM.causalImpulseConvolution impulse v‖ = V * ‖CurrentMM.finiteImpulseVector T impulse‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_lifetime_quantity_signal_optimum","type":"∀ {T : ℕ} (impulse : ℕ → ℝ),\n  0 < T →\n    ∀ (V : ℝ),\n      0 ≤ V →\n        IsGreatest ((fun v => ‖CurrentMM.causalImpulseConvolution impulse v‖) '' {v | ∑ t, |v t| ≤ V})\n          (V * ‖CurrentMM.finiteImpulseVector T impulse‖)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_kalman_memory","type":"∀ (Q R vHat r : ℝ),\n  0 < Q →\n    0 < R →\n      have eta := (-Q + √(Q ^ 2 + 4 * Q * R)) / (2 * R);\n      (0 < eta ∧ eta < 1) ∧ R * eta ^ 2 + Q * eta - Q = 0 ∧ vHat + eta * (r - vHat) = (1 - eta) * vHat + eta * r"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_ogd_memory","type":"∀ (gamma alpha H theta x : ℝ),\n  0 < gamma + alpha * H →\n    gamma + alpha * H < 1 →\n      have eta := gamma + alpha * H;\n      have q := alpha * H / eta;\n      (0 < eta ∧ eta < 1) ∧ (1 - gamma) * theta + alpha * H * (x - theta) = (1 - eta) * theta + eta * (q * x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lem_cm_positive_response","type":"∀ (w1 w2 lam1 lam2 kappa : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      w1 + w2 = kappa →\n        0 ≤ lam1 →\n          lam1 < 1 →\n            0 ≤ lam2 →\n              lam2 < 1 →\n                ∀ (j : ℕ),\n                  have h := fun m => w1 * lam1 ^ m + w2 * lam2 ^ m;\n                  0 ≤ h j ∧ h (j + 1) ≤ h j ∧ h j ≤ kappa ∧ 0 ≤ h j - 2 * h (j + 1) + h (j + 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_equivalence_and_resolvent","type":"∀ (kappa z a G0 G1 sigma_nu alpha K P delta T : ℝ),\n  z - a - kappa * G0 ≠ 0 →\n    z - a - kappa * G1 ≠ 0 →\n      0 < K →\n        0 < P →\n          0 < delta →\n            0 < sigma_nu →\n              (1 - 2 * alpha) ^ 2 ≤ K ^ 2 * P * delta ^ 4 * T / (4 * sigma_nu ^ 2) →\n                have H0 := kappa / (z - a - kappa * G0);\n                have H1 := kappa / (z - a - kappa * G1);\n                H1 - H0 = H1 * H0 * (G1 - G0) ∧ 4 * sigma_nu ^ 2 * (1 - 2 * alpha) ^ 2 / (K ^ 2 * P * delta ^ 4) ≤ T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_sharp_orders","type":"∀ (a kappa q eta delta V B L lam c : ℝ),\n  0 < kappa →\n    0 < |lam| →\n      0 ≤ c →\n        have d0 := kappa - kappa;\n        have d1 :=\n          kappa * (a + kappa * (q / 2 * (eta - delta) + q / 2 * (eta + delta))) - kappa * (a + kappa * (q * eta));\n        have d2 :=\n          kappa *\n              ((a + kappa * q * eta) ^ 2 +\n                kappa * (q / 2 * (eta - delta) * (1 - (eta - delta)) + q / 2 * (eta + delta) * (1 - (eta + delta)))) -\n            kappa * ((a + kappa * q * eta) ^ 2 + kappa * q * eta * (1 - eta));\n        (d0 = 0 ∧ d1 = 0 ∧ d2 = -kappa ^ 2 * q * delta ^ 2) ∧\n          (|lam| * kappa * V + c * V + L ≤ B ↔ V ≤ (B - L) / (|lam| * kappa + c))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lem_toeplitz_fair_execution","type":"∀ (h0 h1 c v0 v1 : ℝ),\n  |h1| < h0 →\n    0 ≤ c →\n      v0 ≠ 0 ∨ v1 ≠ 0 →\n        have C_quad := (h0 * v0 ^ 2 + 2 * h1 * v0 * v1 + h0 * v1 ^ 2) / 2;\n        0 < C_quad + c * (|v0| + |v1|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_cap_counterparty_margin","type":"∀ (B mu kappa c Pstar : ℝ),\n  0 < B →\n    0 ≤ mu →\n      0 < kappa →\n        0 ≤ c →\n          0 < Pstar →\n            have beta := c + mu * Pstar;\n            have a_coef := (mu + 1 / 2) * kappa;\n            have V_B := (-beta + √(beta ^ 2 + 4 * a_coef * B)) / (2 * a_coef);\n            0 < V_B ∧ a_coef * V_B ^ 2 + beta * V_B = B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_disclosure_third_mark","type":"∀ (B kappa A c h2_0 q delta : ℝ),\n  0 < A →\n    0 < kappa →\n      0 < q →\n        0 < delta →\n          have h2_delta := h2_0 - kappa ^ 2 * q * delta ^ 2;\n          have E3_0 := B + kappa * A ^ 2 / 2 - c * A - A ^ 2 * h2_0;\n          have E3_delta := B + kappa * A ^ 2 / 2 - c * A - A ^ 2 * h2_delta;\n          E3_delta - E3_0 = A ^ 2 * kappa ^ 2 * q * delta ^ 2 ∧ 0 < E3_delta - E3_0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_funded_probes","type":"∀ (kappa r A Pstar mu h_step : ℝ),\n  0 < kappa →\n    0 ≤ r →\n      r < 1 →\n        0 < A →\n          mu ≤ 1 →\n            0 ≤ h_step →\n              have m := kappa * (1 - r) / (1 + r);\n              have E_t := mu * A * Pstar + A ^ 2 * h_step;\n              have MM_t := mu * A * (Pstar + A * h_step);\n              0 < m ∧ MM_t ≤ E_t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_passive0_three_step_blocks","type":"∀ (a kappa q eta delta b : ℝ),\n  0 < b →\n    have b1 := a + kappa * q * eta;\n    have b2_0 := b1 ^ 2 + kappa * q * eta * (1 - eta);\n    have b2_delta :=\n      b1 ^ 2 + kappa * (q / 2 * (eta - delta) * (1 - (eta - delta)) + q / 2 * (eta + delta) * (1 - (eta + delta)));\n    have s_w_sq := b ^ 2 / 3;\n    have fourth_cumulant := b ^ 4 / 5 - 3 * s_w_sq ^ 2;\n    b2_0 - b2_delta = kappa * q * delta ^ 2 ∧ fourth_cumulant = -2 * b ^ 4 / 15 ∧ fourth_cumulant < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_ambiguity_quote_and_surplus","type":"∀ (V0 b cost s0 s1 s2 : ℝ),\n  0 < b →\n    cost ≤ s0 →\n      s1 ≤ s2 →\n        have Delta := s2 - s1;\n        have W_loss := b * (s0 - cost) * Delta + b * Delta ^ 2 / 2;\n        have surplus := fun s => (V0 - b * s) * (s - cost) + (V0 - b * s) ^ 2 / (2 * b);\n        0 ≤ Delta ∧ 0 ≤ W_loss ∧ surplus s0 - surplus (s0 + Delta) = W_loss"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tri_region_partition","type":"∀ (sigma z_alpha V_eff d_norm : ℝ),\n  0 < sigma →\n    0 < z_alpha →\n      0 < V_eff →\n        0 < d_norm →\n          have kl_per_pulse := V_eff ^ 2 * d_norm ^ 2 / (2 * sigma ^ 2);\n          have N_cont := 4 * sigma ^ 2 * z_alpha ^ 2 / (V_eff ^ 2 * d_norm ^ 2);\n          0 < kl_per_pulse ∧ N_cont * kl_per_pulse = 2 * z_alpha ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_spectral_dissipation_bound","type":"∀ (w1 lam1 cos_omega L_v ratio_sup sigma z_alpha : ℝ),\n  0 < w1 →\n    0 ≤ lam1 →\n      lam1 < 1 →\n        -1 ≤ cos_omega ∧ cos_omega ≤ 1 →\n          0 < ratio_sup →\n            4 * sigma ^ 2 * z_alpha ^ 2 ≤ ratio_sup * L_v →\n              have denom := 1 - 2 * lam1 * cos_omega + lam1 ^ 2;\n              0 < denom ∧ 0 < w1 * (1 - lam1 ^ 2) / (2 * denom) ∧ 4 * sigma ^ 2 * z_alpha ^ 2 / ratio_sup ≤ L_v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_adaptive_sequential_bound","type":"∀ (E_L0 sigma kl_ab ratio_sup z_alpha : ℝ),\n  0 < sigma →\n    0 < ratio_sup →\n      0 < z_alpha →\n        kl_ab ≤ ratio_sup * E_L0 / (2 * sigma ^ 2) →\n          have C_det_quad := 4 * sigma ^ 2 * z_alpha ^ 2 / ratio_sup;\n          have C_adap := 2 * sigma ^ 2 * kl_ab / ratio_sup;\n          C_adap ≤ E_L0 ∧ C_adap / C_det_quad = kl_ab / (2 * z_alpha ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_rh_duality","type":"∀ (c_req lam_L Delta2 F_dom W_perp gamma : ℝ),\n  0 ≤ Delta2 →\n    0 ≤ W_perp →\n      0 < 1 - gamma * F_dom →\n        (1 - gamma * F_dom) * Delta2 + F_dom - √W_perp * √Delta2 ≥ F_dom - W_perp / (4 * (1 - gamma * F_dom)) ∧\n          c_req / lam_L + Delta2 + max 0 (F_dom - √W_perp * √Delta2 - gamma * F_dom * Delta2) ≥\n            c_req / lam_L + max 0 (F_dom - W_perp / (4 * (1 - gamma * F_dom)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cor_garch_heteroskedastic_invariance","type":"∀ (kappa xi0 v_t L_base : ℝ),\n  0 < kappa →\n    0 ≤ xi0 →\n      have kappa_eff := kappa * (1 + xi0 * |v_t|);\n      have extra_slippage := kappa * xi0 * |v_t| * v_t ^ 2 / 2;\n      kappa ≤ kappa_eff ∧ 0 ≤ extra_slippage ∧ L_base ≤ L_base + extra_slippage"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_crb_benchmark","type":"∀ (sigma_p V_probe tol F_inv_kk Delta_eta c_crb : ℝ),\n  0 < sigma_p →\n    0 < V_probe →\n      0 < tol →\n        0 < Delta_eta →\n          0 < c_crb →\n            c_crb / Delta_eta ^ 6 ≤ F_inv_kk →\n              have N_star := (196 / 100 / tol) ^ 2 * (sigma_p / V_probe) ^ 2 * F_inv_kk;\n              0 < N_star ∧ (196 / 100 / tol) ^ 2 * (sigma_p / V_probe) ^ 2 * c_crb / Delta_eta ^ 6 ≤ N_star"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_twocohort_hankel_and_moment_gap","type":"∀ (q eta_bar tau Delta_eta w1 w2 eta1 eta2 : ℝ),\n  q ≠ 0 →\n    0 < w1 →\n      0 < w2 →\n        0 < eta1 →\n          eta1 < 1 →\n            0 < eta2 →\n              eta2 < 1 →\n                eta1 ≠ eta2 →\n                  have p_minus := 1 / 2 - tau / q;\n                  have p_plus := 1 / 2 + tau / q;\n                  have w0_1 := q * p_minus;\n                  have w0_2 := q * p_plus;\n                  have e0_1 := eta_bar - p_plus * Delta_eta;\n                  have e0_2 := eta_bar + p_minus * Delta_eta;\n                  have w1_1 := q * p_plus;\n                  have w1_2 := q * p_minus;\n                  have e1_1 := eta_bar - p_minus * Delta_eta;\n                  have e1_2 := eta_bar + p_plus * Delta_eta;\n                  have r1 := 1 - eta1;\n                  have r2 := 1 - eta2;\n                  have g1 := w1 * eta1 * r1 + w2 * eta2 * r2;\n                  have g2 := w1 * eta1 * r1 ^ 2 + w2 * eta2 * r2 ^ 2;\n                  have g3 := w1 * eta1 * r1 ^ 3 + w2 * eta2 * r2 ^ 3;\n                  (w1_1 + w1_2 = w0_1 + w0_2 ∧\n                      w1_1 * e1_1 + w1_2 * e1_2 = w0_1 * e0_1 + w0_2 * e0_2 ∧\n                        w1_1 * e1_1 ^ 2 + w1_2 * e1_2 ^ 2 = w0_1 * e0_1 ^ 2 + w0_2 * e0_2 ^ 2 ∧\n                          w1_1 * e1_1 ^ 3 + w1_2 * e1_2 ^ 3 - (w0_1 * e0_1 ^ 3 + w0_2 * e0_2 ^ 3) =\n                            4 * tau * p_minus * p_plus * Delta_eta ^ 3) ∧\n                    g1 * g3 - g2 ^ 2 = w1 * w2 * eta1 * eta2 * r1 * r2 * (eta2 - eta1) ^ 2 ∧ 0 < g1 * g3 - g2 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound","type":"∀ (Delta_eta W g_K : ℝ),\n  0 < W →\n    g_K ≠ 0 →\n      0 < Delta_eta →\n        have m0_R := 1 / 4 + 3 / 4;\n        have m1_R := 1 / 4 * -1 + 3 / 4 * (1 / 3);\n        have m2_R := 1 / 4 * (-1) ^ 2 + 3 / 4 * (1 / 3) ^ 2;\n        have m3_R := 1 / 4 * (-1) ^ 3 + 3 / 4 * (1 / 3) ^ 3;\n        (m0_R = 1 ∧ m1_R = 0 ∧ m2_R = 1 / 3 ∧ m3_R = -2 / 9) ∧\n          W * (0 - m3_R) * Delta_eta ^ 3 = 2 / 9 * W * Delta_eta ^ 3 ∧ W * g_K * Delta_eta ^ 3 ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_esprit_matching_upper_bound","type":"∀ (w1 w2 s1 s2 omega_min gamma r_c Delta_eta : ℝ),\n  omega_min ≤ w1 →\n    omega_min ≤ w2 →\n      0 < omega_min →\n        0 < gamma →\n          gamma ^ 2 ≤ (s1 - s2) ^ 2 →\n            have r1 := r_c + Delta_eta * s1;\n            have r2 := r_c + Delta_eta * s2;\n            have k0 := w1 + w2;\n            have k1 := w1 * r1 + w2 * r2;\n            have k2 := w1 * r1 ^ 2 + w2 * r2 ^ 2;\n            have k3 := w1 * r1 ^ 3 + w2 * r2 ^ 3;\n            have mu0 := k0;\n            have mu1 := k1 - r_c * k0;\n            have mu2 := k2 - 2 * r_c * k1 + r_c ^ 2 * k0;\n            have mu3 := k3 - 3 * r_c * k2 + 3 * r_c ^ 2 * k1 - r_c ^ 3 * k0;\n            have det_confluent := w1 * w2 * (s1 - s2) ^ 4;\n            (mu0 = w1 + w2 ∧\n                mu1 = Delta_eta * (w1 * s1 + w2 * s2) ∧\n                  mu2 = Delta_eta ^ 2 * (w1 * s1 ^ 2 + w2 * s2 ^ 2) ∧\n                    mu3 = Delta_eta ^ 3 * (w1 * s1 ^ 3 + w2 * s2 ^ 3)) ∧\n              omega_min ^ 2 * gamma ^ 4 ≤ det_confluent ∧ 0 < det_confluent"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lem_altpair_moment_matched_wasserstein","type":"∀ (rho E : ℝ),\n  0 < rho →\n    1 / 8 ≤ E →\n      have m0_A := 1 / 2 + 1 / 2;\n      have m1_A := 1 / 2 * (-1 / 2) + 1 / 2 * (1 / 2);\n      have m2_A := 1 / 2 * (-1 / 2) ^ 2 + 1 / 2 * (1 / 2) ^ 2;\n      have m0_B := 1 / 8 + 3 / 4 + 1 / 8;\n      have m1_B := 1 / 8 * -1 + 3 / 4 * 0 + 1 / 8 * 1;\n      have m2_B := 1 / 8 * (-1) ^ 2 + 3 / 4 * 0 ^ 2 + 1 / 8 * 1 ^ 2;\n      have abs_A := 1 / 2 * (1 / 2) + 1 / 2 * (1 / 2);\n      have abs_B := 1 / 8 * 1 + 3 / 4 * 0 + 1 / 8 * 1;\n      (m0_A = 1 ∧ m0_B = 1 ∧ m1_A = m1_B ∧ m2_A = m2_B) ∧\n        rho / 2 * (abs_A - abs_B) = rho / 8 ∧ rho / 2 * (E + E) = rho * E ∧ rho / 8 ≤ rho * E"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_general_memory_minimax","type":"∀ (rho W L delta B_rho s kappa norm_E : ℝ),\n  0 < rho →\n    0 < W →\n      0 ≤ L →\n        0 ≤ delta →\n          1 ≤ B_rho →\n            0 ≤ s →\n              s < 1 →\n                0 < kappa →\n                  0 ≤ norm_E →\n                    (1 + s) / kappa * norm_E ≤ 1 / 2 →\n                      have err_approx := Real.pi * rho * (W + delta) / (2 * (L + 1));\n                      have err_moment := 2 * delta * rho * B_rho;\n                      have norm_H_inv := (1 + s) / kappa;\n                      0 < err_approx + err_moment ∧\n                        0 < kappa / (1 - s) ∧\n                          norm_H_inv ^ 2 * norm_E / (1 - norm_H_inv * norm_E) ≤ 2 * norm_H_inv ^ 2 * norm_E"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_passive_identification","type":"∀ (kappa a w1 w2 r1 r2 : ℝ),\n  kappa ≠ 0 →\n    w1 ≠ 0 →\n      r1 ≠ 0 →\n        r1 ≠ r2 →\n          have D := fun z => (z - r1) * (z - r2);\n          have N := fun z => w1 * z * (z - r2) + w2 * z * (z - r1);\n          have Denom := fun z => (z - a) * D z - kappa * N z;\n          D r1 = 0 ∧ Denom r1 = -kappa * w1 * r1 * (r1 - r2) ∧ Denom r1 ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost","type":"∀ (u c_spec delta tau p_minus p_plus Delta_eta : ℝ),\n  0 < c_spec →\n    delta ≠ 0 →\n      tau ≠ 0 →\n        p_minus ≠ 0 →\n          p_plus ≠ 0 →\n            Delta_eta ≠ 0 →\n              have q_quad := u ^ 2 / 4;\n              have D_sym := c_spec * (delta ^ 2) ^ 2;\n              have D_mix := c_spec * (4 * tau * p_minus * p_plus * Delta_eta ^ 3) ^ 2;\n              0 ≤ q_quad ∧\n                (D_sym = c_spec * delta ^ 4 ∧ 0 < D_sym) ∧\n                  D_mix = 16 * c_spec * tau ^ 2 * p_minus ^ 2 * p_plus ^ 2 * Delta_eta ^ 6 ∧ 0 < D_mix"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tagged_flow_removes_barrier","type":"∀ (r_i w_i x_t u_prev sigma_f Var_x : ℝ),\n  0 < sigma_f →\n    0 < Var_x →\n      have u_next := r_i * u_prev + w_i * x_t;\n      have fisher_w_i := Var_x / sigma_f ^ 2;\n      u_next - r_i * u_prev = w_i * x_t ∧ 0 < fisher_w_i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_discvalue_ratio","type":"∀ (sigma sigma_f Delta_eta D_pow : ℝ),\n  0 < sigma →\n    0 < sigma_f →\n      0 < Delta_eta →\n        0 < D_pow →\n          have N_p := sigma ^ 2 * Delta_eta ^ 2;\n          have N_t_weight := sigma_f ^ 2 * (Delta_eta ^ 2 * D_pow * Delta_eta ^ 2);\n          have N_t_rate := sigma_f ^ 2 * (Delta_eta ^ 2 * D_pow);\n          N_p / N_t_weight = (sigma / sigma_f) ^ 2 / (D_pow * Delta_eta ^ 2) ∧\n            N_p / N_t_rate = (sigma / sigma_f) ^ 2 / D_pow"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_blind_spectral_blindness","type":"∀ (lam1 lam2 s1 V theta : ℝ),\n  0 < lam2 →\n    lam2 < lam1 →\n      lam1 < 1 →\n        0 < s1 →\n          theta ≠ 0 →\n            s1 / (1 - lam1 ^ 2) ≤ V →\n              have denom := (1 - lam1 ^ 2) * (1 - lam2 ^ 2) * (1 - lam1 * lam2);\n              have s2_theta := (V - s1 / (1 - lam1 ^ 2)) * denom / (theta ^ 2 * (1 + lam1 * lam2));\n              have P22 := s2_theta / (1 - lam2 ^ 2);\n              have P12 := lam2 * theta * P22 / (1 - lam1 * lam2);\n              have P11 := (s1 + 2 * lam1 * theta * P12 + theta ^ 2 * P22) / (1 - lam1 ^ 2);\n              0 ≤ s2_theta ∧ P11 = V ∧ theta ^ 2 ≤ lam1 ^ 2 + theta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_mech_persistence","type":"∀ (p_b m_prev dp_next : ℝ),\n  have alpha := 2 / (300 / 10 + 1);\n  have a0 := 1 - alpha;\n  have m_b := (1 - alpha) * m_prev + alpha * p_b;\n  have x_b := p_b - m_b;\n  have p_next := p_b + dp_next;\n  have m_next := (1 - alpha) * m_b + alpha * p_next;\n  have x_next := p_next - m_next;\n  a0 = 29 / 31 ∧ x_next = a0 * x_b + a0 * dp_next"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_abstain_finite_window","type":"∀ (alpha tv : ℝ), 0 ≤ alpha → tv < 1 - 2 * alpha → 0 < 1 - 2 * alpha - tv ∧ 0 ≤ (1 - tv) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_endogenous_kappa","type":"∀ (cov_y var_y gamma sigma_z : ℝ),\n  0 < var_y →\n    0 ≤ sigma_z →\n      have kappa := cov_y / var_y + gamma * sigma_z ^ 2 / 2;\n      ∀ (cov_y' var_y' : ℝ), cov_y' = cov_y → var_y' = var_y → cov_y' / var_y' + gamma * sigma_z ^ 2 / 2 = kappa"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_primitives","type":"∀ (beta lambda_tc s c_minus c_plus : ℝ),\n  lambda_tc ≠ 0 →\n    0 < c_minus →\n      c_minus ≤ c_plus →\n        0 < s →\n          have eta := (√(s ^ 2 + 4 * s) - s) / 2;\n          have q := beta / lambda_tc;\n          q * lambda_tc = beta ∧ c_minus * s ≤ c_plus * s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tied","type":"∀ (m w_eta : ℝ),\n  0 < w_eta →\n    have n := m / w_eta;\n    n * w_eta = m ∧ ∀ (c sigma_sq delta : ℝ), 0 < c → 0 < sigma_sq → 0 < delta → 0 < c * sigma_sq * delta ^ (-4)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_uniformw1","type":"∀ (K : ℕ),\n  1 ≤ K →\n    ∀ (sigma m_min beta N : ℝ),\n      0 < sigma →\n        0 < m_min →\n          0 < beta →\n            beta < 1 →\n              0 < N →\n                have exponent := 1 / (2 * ↑K - 1);\n                have sample_exponent := 4 * ↑K - 2;\n                0 < exponent ∧ 0 < sample_exponent ∧ exponent * sample_exponent = 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_strategic","type":"∀ (alpha_share det_Sigma kappa sigma_zeta sq_drag pi_max gamma_chill : ℝ),\n  0 < alpha_share →\n    0 < det_Sigma →\n      0 < kappa →\n        0 < sigma_zeta →\n          sq_drag = kappa * sigma_zeta ^ 2 / 2 →\n            pi_max < sq_drag →\n              0 < gamma_chill →\n                have det_sub := alpha_share * det_Sigma;\n                have det_chill := gamma_chill * det_Sigma;\n                0 < det_sub ∧ 0 < det_chill ∧ sq_drag - pi_max > 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_choice","type":"∀ (F M c ell G_star : ℝ),\n  0 < M →\n    0 < ell →\n      0 < G_star →\n        have _M_star := F / (ell * G_star - c);\n        (F / M + c < ell * G_star ↔ F / M < ell * G_star - c) ∧ (c < ell * G_star → 0 < ell * G_star - c)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_target","type":"∀ (K b theta_star : ℝ),\n  2 ≤ K →\n    0 < b →\n      have DWL_market := (1 - theta_star) * K * b;\n      have DWL_target := b;\n      DWL_target < DWL_market ↔ theta_star < 1 - 1 / K"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_capacity","type":"∀ (a kappa Q_bar H : ℝ),\n  0 ≤ H →\n    0 ≤ a →\n      0 ≤ kappa →\n        0 ≤ Q_bar →\n          have G_lower := kappa * H * a;\n          have G_upper := kappa * H * (a + kappa * Q_bar);\n          G_lower ≤ G_upper"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_nodata_chance","type":"∀ (gamma g_nd g_f : ℝ),\n  0 ≤ gamma →\n    gamma ≤ 1 →\n      g_nd ≤ g_f →\n        have V_nd := (1 - gamma) * g_nd + gamma * g_f;\n        g_nd ≤ V_nd ∧ V_nd ≤ g_f"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_decision","type":"∀ (A D c_H N : ℝ), 0 ≤ A → 0 ≤ D → 0 ≤ c_H → 0 < N → 0 ≤ A * N ^ (-(1 / 2)) + D * c_H * N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_pair","type":"∀ (kappa Q delta : ℝ),\n  0 < kappa →\n    0 < Q →\n      0 < delta →\n        have diff_k2 := -3 / 2 * Q * delta ^ 3;\n        have diff_h3 := -3 / 2 * kappa ^ 2 * Q * delta ^ 3;\n        diff_h3 = kappa ^ 2 * diff_k2 ∧ diff_h3 ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_priced","type":"∀ (c_H N D_H B : ℝ), 0 < c_H → 0 < D_H → 0 < B → B < c_H * (N / D_H) ^ 2 → c_H * (N / D_H) ^ 2 - B > 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cor_unknown_primitives","type":"∀ (M_prony M_est : ℝ), 0 ≤ M_est → M_prony ≤ M_prony + M_est"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_jury_one_cohort","type":"∀ (κ η q φ_f : ℝ),\n  0 < κ →\n    0 < η →\n      q < φ_f →\n        have a := 1 - κ * φ_f;\n        have trJ := a + (1 - η + η * κ * q);\n        have detJ := a * (1 - η + η * κ * q) - η * a * (κ * q);\n        detJ = (1 - κ * φ_f) * (1 - η) ∧\n          1 - trJ + detJ = η * κ * (φ_f - q) ∧\n            1 + trJ + detJ = 4 - 2 * η - κ * ((2 - η) * φ_f - η * q) ∧ 0 < 1 - trJ + detJ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_input_output_invariance","type":"∀ (c mk b s : ℝ), s ≠ 0 → c * s⁻¹ * (s * mk * s⁻¹) * (s * b) = c * mk * b"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_ambig_quote_cost","type":"∀ (s L0 L1 : ℝ),\n  L0 ≠ L1 →\n    2 * ((s - L0) ^ 2 + (s - L1) ^ 2) = (2 * s - L0 - L1) ^ 2 + (L1 - L0) ^ 2 ∧\n      (L1 - L0) ^ 2 / 2 ≤ (s - L0) ^ 2 + (s - L1) ^ 2 ∧ 0 < (L1 - L0) ^ 2 / 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_radius_kreiss","type":"∀ (ρ ν B G0 G1 : ℝ),\n  ρ < 1 →\n    1 - ρ < ν → 0 < B → 0 < G0 → G0 < G1 → (1 - ρ) * (ν / (1 - ρ) ^ 2) = ν / (1 - ρ) ∧ 1 < ν / (1 - ρ) ∧ B / G1 < B / G0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_spectral_blindness_companion","type":"∀ (a b σ_sq : ℝ),\n  b ≠ 0 →\n    (a + b) ^ 2 - (a - b) ^ 2 = 4 * a * b ∧ (a ^ 2 + b ^ 2) * σ_sq = (a ^ 2 + (-b) ^ 2) * σ_sq ∧ a + b - (a - b) ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_lem_cm_no_amplification_without_depth","type":"∀ (κ η q : ℝ),\n  0 < κ →\n    0 < η →\n      η < 1 →\n        0 ≤ q →\n          have h0 := κ;\n          have h1 := (1 - κ * η) * κ - κ ^ 2 * (1 - η) * q;\n          h1 - h0 = -κ ^ 2 * (η + (1 - η) * q) ∧ h1 < h0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_multi_venue_cross_impact","type":"∀ (κ_tilde Γ m q B : ℝ),\n  0 < κ_tilde →\n    0 < Γ →\n      0 ≤ q →\n        0 < B →\n          0 < m - q * (κ_tilde + Γ) →\n            have S_single := κ_tilde / (m - q * κ_tilde);\n            have S_multi := (κ_tilde + Γ) / (m - q * (κ_tilde + Γ));\n            S_multi - S_single = m * Γ / ((m - q * (κ_tilde + Γ)) * (m - q * κ_tilde)) ∧\n              S_single < S_multi ∧ B / S_multi < B / S_single"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_t6_amplification_condition","type":"∀ (κ a φ_eps : ℝ),\n  have h0 := κ;\n  have h1 := a * κ + φ_eps;\n  have C2 := φ_eps - (1 - a) * κ;\n  h1 - h0 = C2 ∧ (h0 < h1 ↔ 0 < C2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_shape_overshoot","type":"∀ (κ a b r φ_eps : ℝ),\n  a ≠ b →\n    a < 1 →\n      0 < r →\n        b = 1 - r →\n          have A := κ + φ_eps / (a - b);\n          have B := -φ_eps / (a - b);\n          A + B = κ ∧ A * a + B * b = a * κ + φ_eps ∧ A / (1 - a) + B / (1 - b) = κ / (1 - a) + φ_eps / ((1 - a) * r)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_t6m_one_period_margin","type":"∀ (κ a η q φ_eps : ℝ),\n  have h0 := κ;\n  have h1 := a * κ + κ ^ 2 * η * q + φ_eps;\n  have C3 := φ_eps + κ ^ 2 * η * q - (1 - a) * κ;\n  h1 - h0 = C3 ∧ (h0 < h1 ↔ 0 < C3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_nomom_no_overshoot","type":"∀ (κ η q : ℝ),\n  0 < κ →\n    0 < η →\n      q < 1 →\n        have a := 1 - κ * η;\n        have C3 := 0 + κ ^ 2 * η * q - (1 - a) * κ;\n        C3 = -κ ^ 2 * η * (1 - q) ∧ C3 < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_noover_sufficient_condition","type":"∀ (κ a r abs_phi_eps abs_q : ℝ),\n  abs_phi_eps * (1 + κ * abs_q / r) + κ ^ 2 * abs_q - (1 - a) * κ ≤ 0 →\n    have C3_bar := abs_phi_eps * (1 + κ * abs_q / r) + κ ^ 2 * abs_q - (1 - a) * κ;\n    a * κ + abs_phi_eps * (1 + κ * abs_q / r) + κ ^ 2 * abs_q = κ + C3_bar ∧\n      a * κ + abs_phi_eps * (1 + κ * abs_q / r) + κ ^ 2 * abs_q ≤ κ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_sum_closed_form","type":"∀ (κ η r q φ_eps : ℝ),\n  0 < η →\n    0 < r →\n      0 < κ * η - q * (κ + φ_eps / r) →\n        have m := κ * η;\n        have κ_tilde := κ + φ_eps / r;\n        have det_IM3 := η * (r * (m - κ * q) - φ_eps * q);\n        have num_IM3 := η * (r * κ + φ_eps);\n        det_IM3 = η * r * (m - q * κ_tilde) ∧\n          num_IM3 = η * r * κ_tilde ∧ num_IM3 / det_IM3 = κ_tilde / (m - q * κ_tilde)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_guard_maximal","type":"∀ {H : ℕ} (I_abs u_bar V : ℝ) (g : Fin H → ℝ) (k_star : Fin H),\n  0 ≤ I_abs →\n    0 ≤ u_bar →\n      0 ≤ V →\n        (∀ (k : Fin H), |g k| ≤ |g k_star|) →\n          IsGreatest {L | ∃ u, (∀ (k : Fin H), |u k| ≤ u_bar) ∧ L = I_abs * |∑ k, g k * u k|}\n              (I_abs * u_bar * ∑ k, |g k|) ∧\n            IsGreatest {L | ∃ v, ∑ k, |v k| ≤ V ∧ L = |∑ k, g k * v k|} (V * |g k_star|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_lem_tail_contraction","type":"∀ (C ρ_H ρ : ℝ),\n  0 ≤ C →\n    0 ≤ ρ_H →\n      ρ < 1 →\n        have T_H := C * ρ_H / (1 - ρ);\n        (1 - ρ) * T_H = C * ρ_H ∧ 0 ≤ T_H"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_robust_gain","type":"∀ (M S ε : ℝ),\n  0 < M →\n    0 < S →\n      0 ≤ ε →\n        ε * S < 1 →\n          have G_rob := M / (1 - ε * S);\n          G_rob - M = ε * M * S / (1 - ε * S) ∧ M ≤ G_rob ∧ 0 < G_rob"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_bridge_no_identification","type":"∀ (I_abs u_bar g0_a g1_a g2_a g0_b g1_b g2_b : ℝ),\n  g0_a = g0_b →\n    g1_a = g1_b → g2_a = g2_b → I_abs * u_bar * (|g0_a| + |g1_a| + |g2_a|) = I_abs * u_bar * (|g0_b| + |g1_b| + |g2_b|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_forward_solvency","type":"∀ (E L L_max : ℝ), L ≤ L_max → (L_max ≤ E → 0 ≤ E - L) ∧ (E < L_max → E - L_max < 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_dominance_guard_vs_eigenvalue","type":"∀ (I_abs u_bar S κ_eig : ℝ),\n  0 < I_abs →\n    0 < u_bar →\n      κ_eig < S →\n        have M_eig := I_abs * u_bar * κ_eig;\n        have M_guard := I_abs * u_bar * S;\n        M_eig - M_guard = -I_abs * u_bar * (S - κ_eig) ∧ M_eig < M_guard ∧ M_eig - M_guard < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_lucas_reinforces_guard","type":"∀ (κ_tilde m q0 q1 : ℝ),\n  0 < κ_tilde →\n    q1 < q0 →\n      0 < m - q0 * κ_tilde →\n        have S0 := κ_tilde / (m - q0 * κ_tilde);\n        have S1 := κ_tilde / (m - q1 * κ_tilde);\n        S0 - S1 = (q0 - q1) * κ_tilde ^ 2 / ((m - q0 * κ_tilde) * (m - q1 * κ_tilde)) ∧ S1 < S0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_equil_transient_risk","type":"∀ (κ_tilde m q θ N1 N2 Λ : ℝ),\n  0 < κ_tilde →\n    0 < m - q * κ_tilde →\n      0 < θ →\n        θ < N1 →\n          N1 < N2 →\n            0 < Λ →\n              have S := κ_tilde / (m - q * κ_tilde);\n              have g_m := κ_tilde / (m - q * κ_tilde) ^ 2;\n              have tau_star := (1 - θ / N1) * Λ * (S ^ 2 / κ_tilde);\n              g_m = S ^ 2 / κ_tilde ∧\n                θ / N1 * Λ * g_m + tau_star = Λ * g_m ∧ θ / N1 * Λ * g_m < Λ * g_m ∧ θ / N2 < θ / N1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.foundational_result_A_impossibility","type":"∀ (v0 v1 beta d_tv P0_E P1_E ExpLoss1 : ℝ),\n  v0 < v1 →\n    1 - beta ≤ P0_E →\n      P0_E - P1_E ≤ d_tv →\n        0 ≤ ExpLoss1 →\n          (v1 - v0) * P1_E ≤ ExpLoss1 →\n            have a := 2 / 5;\n            have etaA := 1 / 2;\n            have qA := 2 / 25;\n            have etaB1 := 1;\n            have qB1 := 1 / 50;\n            have etaB2 := 1 / 20;\n            have qB2 := 2 / 5;\n            have hA0 := 1;\n            have yA0 := 0;\n            have hA1 := a * hA0 + yA0;\n            have yA1 := (1 - etaA) * yA0 + etaA * qA * hA0;\n            have hA2 := a * hA1 + yA1;\n            have yA2 := (1 - etaA) * yA1 + etaA * qA * hA1;\n            have hA3 := a * hA2 + yA2;\n            have hB0 := 1;\n            have yB1_0 := 0;\n            have yB2_0 := 0;\n            have hB1 := a * hB0 + yB1_0 + yB2_0;\n            have yB1_1 := (1 - etaB1) * yB1_0 + etaB1 * qB1 * hB0;\n            have yB2_1 := (1 - etaB2) * yB2_0 + etaB2 * qB2 * hB0;\n            have hB2 := a * hB1 + yB1_1 + yB2_1;\n            have yB1_2 := (1 - etaB1) * yB1_1 + etaB1 * qB1 * hB1;\n            have yB2_2 := (1 - etaB2) * yB2_1 + etaB2 * qB2 * hB1;\n            have hB3 := a * hB2 + yB1_2 + yB2_2;\n            have SA := 1 / (1 - a - qA);\n            have SB := 1 / (1 - a - (qB1 + qB2));\n            have vA_max := 1 / SA;\n            have vB_max := 1 / SB;\n            hA0 = hB0 ∧\n              hA1 = hB1 ∧\n                hA2 = hB2 ∧\n                  hA2 = 1 / 5 ∧\n                    hA3 = 29 / 250 ∧\n                      hB3 = 23 / 200 ∧\n                        SA = 25 / 13 ∧\n                          SB = 50 / 9 ∧\n                            vA_max = 13 / 25 ∧\n                              vB_max = 9 / 50 ∧\n                                (vA_max - vB_max) * (1 - 1 / 20 - 0) = 323 / 1000 ∧\n                                  (v1 - v0) * max 0 (1 - beta - d_tv) ≤ ExpLoss1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmA_algebraic_core","type":"∀ (v0 v1 beta d_tv P0_E P1_E ExpLoss1 : ℝ),\n  v0 < v1 →\n    1 - beta ≤ P0_E →\n      P0_E - P1_E ≤ d_tv →\n        0 ≤ ExpLoss1 →\n          (v1 - v0) * P1_E ≤ ExpLoss1 →\n            (v1 - v0) * max 0 (1 - beta - d_tv) ≤ ExpLoss1 ∧ (13 / 25 - 9 / 50) * (1 - 1 / 20 - 0) = 323 / 1000"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmB_algebraic_core","type":"∀ (w1 w2 r1 r2 r_bar : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      0 ≤ r1 →\n        r1 ≤ r_bar →\n          0 ≤ r2 →\n            r2 ≤ r_bar →\n              r_bar < 1 →\n                have m0 := w1 + w2;\n                have Q := w1 / (1 - r1) + w2 / (1 - r2);\n                m0 ≤ Q ∧\n                  Q ≤ m0 / (1 - r_bar) ∧\n                    (1 / 25) ^ 2 / (1 / 25 - 1 / 50) = 2 / 25 ∧ 1 / 25 + 19 / 1000 / (1 - 19 / 20) = 21 / 50"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmC_algebraic_core","type":"∀ (N snr beta eps d_tv : ℝ),\n  0 < snr →\n    0 ≤ 1 - beta - eps →\n      d_tv ^ 2 ≤ N / 4 * snr →\n        1 - beta - eps ≤ d_tv →\n          4 * (1 - beta - eps) ^ 2 / snr ≤ N ∧ 4 * (1 - 1 / 20 - 9 / 20) ^ 2 / ((1 / 1000) ^ 2 / (1 / 100) ^ 2) = 100"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmD_algebraic_core","type":"∀ (I_abs v S_true S_upper B P_noncov gamma : ℝ),\n  0 ≤ I_abs →\n    0 ≤ v → S_true ≤ S_upper → I_abs * v * S_upper ≤ B → P_noncov ≤ gamma → I_abs * v * S_true ≤ B ∧ P_noncov ≤ gamma"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmE_algebraic_core","type":"∀ (m_lo q_hi kappa_hi req_inv alpha : ℝ),\n  0 < q_hi * kappa_hi →\n    req_inv ≤ m_lo →\n      0 ≤ alpha →\n        have alpha_unclamped := (m_lo - req_inv) / (q_hi * kappa_hi);\n        0 ≤ alpha_unclamped ∧ (alpha ≤ alpha_unclamped ↔ req_inv ≤ m_lo - alpha * (q_hi * kappa_hi))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmF_algebraic_core","type":"∀ (B_over_I q eta eta_min omega c_comp c_leak : ℝ),\n  0 < B_over_I →\n    0 < q →\n      0 < eta_min →\n        eta_min < eta →\n          have delta_v := B_over_I * q * (eta / eta_min - 1);\n          have V_net := omega * delta_v - c_comp - c_leak;\n          0 < delta_v ∧ (0 < V_net ↔ c_comp + c_leak < omega * delta_v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thmG_algebraic_core","type":"∀ (q_true delta_q_pub delta_q_disc kappa_tilde wedge_eq wedge_soc : ℝ),\n  0 < kappa_tilde →\n    delta_q_disc < delta_q_pub →\n      wedge_eq < wedge_soc →\n        have m_eq_pub := (q_true + delta_q_pub) * kappa_tilde + wedge_eq;\n        have m_soc_pub := (q_true + delta_q_pub) * kappa_tilde + wedge_soc;\n        have m_eq_disc := (q_true + delta_q_disc) * kappa_tilde + wedge_eq;\n        m_eq_pub < m_soc_pub ∧ m_eq_disc < m_eq_pub"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.foundational_result_B_disclosure_control","type":"∀ (B denom S_tag S_pub : ℝ),\n  0 < B →\n    0 < denom →\n      0 < S_tag →\n        S_tag < S_pub →\n          have alpha_pub := B / (denom * S_pub);\n          have alpha_tag := B / (denom * S_tag);\n          alpha_tag - alpha_pub = B * (S_pub - S_tag) / (denom * S_tag * S_pub) ∧ alpha_pub < alpha_tag"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.foundational_result_C_probing_control_tradeoff","type":"∀ (κ_diss V V_star : ℝ),\n  0 < κ_diss →\n    0 < V →\n      0 < V_star →\n        have lam_c := 2 * κ_diss * V_star ^ 3;\n        have C_tot := fun x => 1 / 2 * κ_diss * x ^ 2 + lam_c / (2 * x);\n        C_tot V - C_tot V_star = κ_diss * (V - V_star) ^ 2 * (V + 2 * V_star) / (2 * V) ∧ C_tot V_star ≤ C_tot V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_ex_witness","type":"have a := 2 / 5;\nhave kappa := 1;\nhave qA := 2 / 25;\nhave etaA := 1 / 2;\nhave qB1 := 2 / 95;\nhave etaB1 := 19 / 20;\nhave qB2 := 2 / 5;\nhave etaB2 := 1 / 20;\nhave hA0 := kappa;\nhave yA0 := etaA * hA0;\nhave hA1 := a * hA0 + kappa * qA * yA0;\nhave yA1 := (1 - etaA) * yA0 + etaA * hA1;\nhave hA2 := a * hA1 + kappa * qA * yA1;\nhave yA2 := (1 - etaA) * yA1 + etaA * hA2;\nhave hA3 := a * hA2 + kappa * qA * yA2;\nhave hB0 := kappa;\nhave yB1_0 := etaB1 * hB0;\nhave yB2_0 := etaB2 * hB0;\nhave hB1 := a * hB0 + kappa * (qB1 * yB1_0 + qB2 * yB2_0);\nhave yB1_1 := (1 - etaB1) * yB1_0 + etaB1 * hB1;\nhave yB2_1 := (1 - etaB2) * yB2_0 + etaB2 * hB1;\nhave hB2 := a * hB1 + kappa * (qB1 * yB1_1 + qB2 * yB2_1);\nhave yB1_2 := (1 - etaB1) * yB1_1 + etaB1 * hB2;\nhave yB2_2 := (1 - etaB2) * yB2_1 + etaB2 * hB2;\nhave hB3 := a * hB2 + kappa * (qB1 * yB1_2 + qB2 * yB2_2);\nhave SA := kappa / (1 - a - kappa * qA);\nhave SB := kappa / (1 - a - kappa * (qB1 + qB2));\nhA0 = 1 ∧\n  hB0 = 1 ∧\n    hA1 = 11 / 25 ∧\n      hB1 = 11 / 25 ∧\n        hA2 = 267 / 1250 ∧\n          hB2 = 267 / 1250 ∧\n            hA3 = 7049 / 62500 ∧\n              hB3 = 30221 / 250000 ∧\n                hB3 - hA3 = 81 / 10000 ∧ SA = 25 / 13 ∧ SB = 95 / 17 ∧ 1 / SA = 13 / 25 ∧ 1 / SB = 17 / 95"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.totalVariationDist_event_le","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P0 P1 : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P0]\n  [MeasureTheory.IsProbabilityMeasure P1] (E : Set Ω),\n  MeasurableSet E →\n    |P0.real E - P1.real E| ≤ CurrentMM.totalVariationDist P0 P1 ∧\n      P0.real E - P1.real E ≤ CurrentMM.totalVariationDist P0 P1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_twoworld","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P0 P1 : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P0]\n  [MeasureTheory.IsProbabilityMeasure P1] (A : Ω → ℝ) (v0 v1 beta : ℝ),\n  v0 < v1 →\n    Measurable A →\n      (∀ (ω : Ω), 0 ≤ A ω ∧ A ω ≤ v1) →\n        1 - beta ≤ P0.real {ω | A ω ≤ v0} →\n          (v1 - v0) * max 0 (1 - beta - CurrentMM.totalVariationDist P0 P1) ≤ ∫ (ω : Ω), v1 - A ω ∂P1 ∧\n            (13 / 25 - 17 / 95) * (1 - 1 / 20 - 0) = 81 / 250"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_window","type":"∀ {K n : ℕ} (r w : Fin K → ℝ) (r_bar : ℝ),\n  (∀ (i : Fin K), 0 ≤ w i) →\n    (∀ (i : Fin K), 0 ≤ r i ∧ r i ≤ r_bar) →\n      r_bar < 1 →\n        ∀ (c : Fin n → ℝ) (eps : ℝ),\n          0 < eps →\n            ∀ (r_res w_res : ℝ → Fin K → ℝ),\n              (∀ r0 ∈ Set.Ico 0 1, ∀ (i : Fin K), 0 ≤ w_res r0 i ∧ 0 ≤ r_res r0 i ∧ r_res r0 i < 1) →\n                (∀ r0 ∈ Set.Ico 0 1,\n                    ∀ (m : Fin n), CurrentMM.discreteMoment (r_res r0) (w_res r0) ↑m = c m - eps * r0 ^ ↑m) →\n                  ∀ (M_target : ℝ),\n                    CurrentMM.discreteMoment r w 0 ≤ CurrentMM.discretePhi r w ∧\n                      CurrentMM.discretePhi r w ≤ CurrentMM.discreteMoment r w 0 / (1 - r_bar) ∧\n                        ∃ r_aug w_aug,\n                          (∀ (j : Option (Fin K)), 0 ≤ w_aug j ∧ 0 ≤ r_aug j ∧ r_aug j < 1) ∧\n                            (∀ (m : Fin n), ∑ j, w_aug j * r_aug j ^ ↑m = c m) ∧ M_target < ∑ j, w_aug j / (1 - r_aug j)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_step_contraction_box","type":"∀ {n : ℕ} (a kappa s_bar r_bar M : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ kappa →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          0 ≤ r_bar →\n            r_bar ≤ 1 →\n              s_bar ≤ 1 →\n                (∀ (i : Fin n), 1 - r_bar ≤ rate i ∧ rate i ≤ 1) →\n                  a + kappa * ∑ i, q i ≤ s_bar →\n                    CurrentMM.stateInBox state M →\n                      have lambda_bar := 1 - (1 - r_bar) * (1 - s_bar);\n                      CurrentMM.stateInBox (CurrentMM.cohortStep a kappa q rate 0 state) (lambda_bar * M)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_trajectory_contraction","type":"∀ {n : ℕ} (a kappa s_bar r_bar : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ kappa →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        0 ≤ r_bar →\n          r_bar ≤ 1 →\n            0 ≤ s_bar →\n              s_bar ≤ 1 →\n                (∀ (i : Fin n), 1 - r_bar ≤ rate i ∧ rate i ≤ 1) →\n                  a + kappa * ∑ i, q i ≤ s_bar →\n                    ∀ (t : ℕ),\n                      have lambda_bar := 1 - (1 - r_bar) * (1 - s_bar);\n                      CurrentMM.stateInBox\n                        (CurrentMM.autonomousState a kappa q rate (CurrentMM.pulse1 a kappa q rate 1) t)\n                        (kappa * lambda_bar ^ t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.geom_tail_sum_identity","type":"∀ (lam : ℝ) (T M : ℕ), (1 - lam) * ∑ k ∈ Finset.range M, lam ^ (T + k) = lam ^ T - lam ^ (T + M)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_certcost","type":"∀ {n : ℕ} (a kappa s_bar r_bar : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ kappa →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        0 ≤ r_bar →\n          r_bar < 1 →\n            0 ≤ s_bar →\n              s_bar < 1 →\n                (∀ (i : Fin n), 1 - r_bar ≤ rate i ∧ rate i ≤ 1) →\n                  a + kappa * ∑ i, q i ≤ s_bar →\n                    ∀ (T M : ℕ),\n                      have lambda_bar := 1 - (1 - r_bar) * (1 - s_bar);\n                      (0 ≤ lambda_bar ∧ lambda_bar < 1) ∧\n                        (∀ (t : ℕ),\n                            0 ≤ CurrentMM.actualCohortImpulse a kappa q rate t ∧\n                              CurrentMM.actualCohortImpulse a kappa q rate t ≤ kappa * lambda_bar ^ t) ∧\n                          ∑ k ∈ Finset.range M, CurrentMM.actualCohortImpulse a kappa q rate (T + k) ≤\n                            kappa * lambda_bar ^ T / (1 - lambda_bar)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_lem_sound","type":"∀ (I_abs u_bar S_true S_sup B : ℝ),\n  0 ≤ I_abs → 0 ≤ u_bar → S_true ≤ S_sup → I_abs * u_bar * S_sup ≤ B → I_abs * u_bar * S_true ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mem_robustSafeAdmissionSet_iff","type":"∀ (a kappa I_abs u_bar B Phi_plus alpha : ℝ),\n  0 < kappa →\n    0 < I_abs →\n      0 < u_bar →\n        0 < B →\n          0 < Phi_plus →\n            (alpha ∈ CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_plus ↔\n              0 ≤ alpha ∧ alpha ≤ 1 ∧ alpha * (kappa * Phi_plus) ≤ 1 - a - kappa * I_abs * u_bar / B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_robustguard","type":"∀ (a kappa I_abs u_bar B Phi_plus : ℝ),\n  0 < kappa →\n    0 < I_abs →\n      0 < u_bar →\n        0 < B →\n          0 < Phi_plus →\n            have c_I := 1 - a - kappa * I_abs * u_bar / B;\n            have alpha_star := min 1 (c_I / (kappa * Phi_plus));\n            (0 ≤ c_I →\n                CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_plus = Set.Icc 0 alpha_star ∧\n                  IsGreatest (CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_plus) alpha_star) ∧\n              (CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_plus = ∅ ↔ c_I < 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_thm_disclosure","type":"∀ (a kappa I_abs u_bar B w c_cost : ℝ) (Theta_O_prime Theta_O : Set ℝ),\n  0 < kappa →\n    Theta_O_prime ⊆ Theta_O →\n      BddAbove Theta_O →\n        ∀ Phi0 ∈ Theta_O_prime,\n          0 < Phi0 →\n            have Phi_O_prime := sSup Theta_O_prime;\n            have Phi_O := sSup Theta_O;\n            have c_I := 1 - a - kappa * I_abs * u_bar / B;\n            have alpha_O_prime := min 1 (c_I / (kappa * Phi_O_prime));\n            have alpha_O := min 1 (c_I / (kappa * Phi_O));\n            0 < Phi_O_prime ∧\n              Phi_O_prime ≤ Phi_O ∧\n                CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_O ⊆\n                    CurrentMM.robustSafeAdmissionSet a kappa I_abs u_bar B Phi_O_prime ∧\n                  (0 ≤ c_I → alpha_O ≤ alpha_O_prime) ∧\n                    (0 < c_I → Phi_O_prime < Phi_O → c_I / (kappa * Phi_O) < 1 → alpha_O < alpha_O_prime) ∧\n                      (0 < w * (alpha_O_prime - alpha_O) - c_cost ↔ c_cost < w * (alpha_O_prime - alpha_O))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_fhc_capacity","type":"∀ (a kappa Q_bar H : ℝ),\n  0 ≤ H →\n    0 ≤ a →\n      0 ≤ kappa →\n        0 ≤ Q_bar →\n          have G_lower := kappa * H * a;\n          have G_upper := kappa * H * (a + kappa * Q_bar);\n          G_lower ≤ G_upper"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_fhc_nodata_chance","type":"∀ (gamma g_nd g_f : ℝ),\n  0 ≤ gamma →\n    gamma ≤ 1 →\n      g_nd ≤ g_f →\n        have V_nd := (1 - gamma) * g_nd + gamma * g_f;\n        g_nd ≤ V_nd ∧ V_nd ≤ g_f"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_fhc_decision","type":"∀ (A D c_H N : ℝ), 0 ≤ A → 0 ≤ D → 0 ≤ c_H → 0 < N → 0 ≤ A * N ^ (-(1 / 2)) + D * c_H * N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_fhc_pair","type":"∀ (kappa Q delta : ℝ),\n  0 < kappa →\n    0 < Q →\n      0 < delta →\n        have diff_k2 := -3 / 2 * Q * delta ^ 3;\n        have diff_h3 := -3 / 2 * kappa ^ 2 * Q * delta ^ 3;\n        diff_h3 = kappa ^ 2 * diff_k2 ∧ diff_h3 ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_fhc_priced","type":"∀ (c_H N D_H B : ℝ), 0 < c_H → 0 < D_H → 0 < B → B < c_H * (N / D_H) ^ 2 → c_H * (N / D_H) ^ 2 - B > 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.symmetric_first_tap_identical","type":"∀ (a impact q rate delta : ℝ),\n  CurrentMM.splitPriceTap1 a impact q rate delta = CurrentMM.singlePriceTap1 a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.symmetric_third_tap_difference","type":"∀ (a impact q rate delta : ℝ),\n  CurrentMM.splitPriceTap2 a impact q rate delta - CurrentMM.singlePriceTap2 a impact q rate =\n    -impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.symmetric_third_tap_separates","type":"∀ (a impact q rate delta : ℝ),\n  0 < impact →\n    0 < q → delta ≠ 0 → CurrentMM.splitPriceTap2 a impact q rate delta ≠ CurrentMM.singlePriceTap2 a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.split_transfer_difference","type":"∀ (q rate delta z : ℝ),\n  z - 1 + rate ≠ 0 →\n    z - 1 + rate - delta ≠ 0 →\n      z - 1 + rate + delta ≠ 0 →\n        CurrentMM.splitTransfer q rate delta z - CurrentMM.singleTransfer q rate z =\n          -q * z * (z - 1) * delta ^ 2 / ((z - 1 + rate) * ((z - 1 + rate) ^ 2 - delta ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.closed_price_transfer_difference","type":"∀ (a impact G0 G1 z : ℝ),\n  z - a - impact * G0 ≠ 0 →\n    z - a - impact * G1 ≠ 0 →\n      CurrentMM.closedPriceTransfer a impact G1 z - CurrentMM.closedPriceTransfer a impact G0 z =\n        CurrentMM.closedPriceTransfer a impact G1 z * CurrentMM.closedPriceTransfer a impact G0 z * (G1 - G0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ogd_rate_normalization","type":"∀ (theta x gamma alpha curvature : ℝ),\n  theta - alpha * curvature * (theta - x) - gamma * theta =\n    (1 - (gamma + alpha * curvature)) * theta + alpha * curvature * x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ogd_normalized_recursion","type":"∀ (theta x gamma alpha curvature : ℝ),\n  gamma + alpha * curvature ≠ 0 →\n    theta - alpha * curvature * (theta - x) - gamma * theta =\n      (1 - (gamma + alpha * curvature)) * theta +\n        (gamma + alpha * curvature) * (alpha * curvature / (gamma + alpha * curvature)) * x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_step_linear_coordinates","type":"∀ {n : ℕ} (a impact quantity : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  CurrentMM.cohortCoordinates (CurrentMM.cohortStep a impact q rate quantity state) =\n    (CurrentMM.cohortLinearTransition a impact q rate) (CurrentMM.cohortCoordinates state) +\n      quantity • CurrentMM.cohortInputVector impact rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.reset_linear_run_convolution","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (A : Module.End ℝ E) (b : E) (v : ℕ → ℝ) (t : ℕ),\n  CurrentMM.controlledLinearRun A b v t = ∑ s ∈ Finset.range t, v s • (A ^ (t - 1 - s)) b"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_reset_run_linear_coordinates","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : ℕ → ℝ) (t : ℕ),\n  CurrentMM.cohortCoordinates (CurrentMM.controlledCohortRun a impact q rate v t) =\n    CurrentMM.controlledLinearRun (CurrentMM.cohortLinearTransition a impact q rate)\n      (CurrentMM.cohortInputVector impact rate) v t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_reset_price_convolution","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : ℕ → ℝ) (t : ℕ),\n  (CurrentMM.controlledCohortRun a impact q rate v (t + 1)).price =\n    ∑ s ∈ Finset.range (t + 1), v s * CurrentMM.actualCohortImpulse a impact q rate (t - s)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_cohort_record_is_causal_convolution","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  CurrentMM.actualCohortPriceRecord a impact q rate v =\n    CurrentMM.causalImpulseConvolution (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_cohort_record_quantity_bound","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ) (V : ℝ),\n  ∑ s, |v s| ≤ V →\n    ‖CurrentMM.actualCohortPriceRecord a impact q rate v‖ ≤\n      V * ‖CurrentMM.finiteImpulseVector T (CurrentMM.actualCohortImpulse a impact q rate)‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_pair_price_record_difference","type":"∀ {n m T : ℕ} (a impact : ℝ) (q0 rate0 : Fin n → ℝ) (q1 rate1 : Fin m → ℝ) (v : Fin T → ℝ),\n  CurrentMM.actualCohortPriceRecord a impact q1 rate1 v - CurrentMM.actualCohortPriceRecord a impact q0 rate0 v =\n    CurrentMM.causalImpulseConvolution\n      (fun j => CurrentMM.actualCohortImpulse a impact q1 rate1 j - CurrentMM.actualCohortImpulse a impact q0 rate0 j) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_pair_observation_kl","type":"∀ {n m T : ℕ} (a impact : ℝ) (q0 rate0 : Fin n → ℝ) (q1 rate1 : Fin m → ℝ) (v : Fin T → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv\n        (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q0 rate0 v).ofLp t)\n          variance)\n        (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q1 rate1 v).ofLp t)\n          variance) =\n      ENNReal.ofReal\n        (‖CurrentMM.causalImpulseConvolution\n                (fun j =>\n                  CurrentMM.actualCohortImpulse a impact q1 rate1 j - CurrentMM.actualCohortImpulse a impact q0 rate0 j)\n                v‖ ^\n            2 /\n          (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_pair_quantity_kl_bound","type":"∀ {n m T : ℕ} (a impact : ℝ) (q0 rate0 : Fin n → ℝ) (q1 rate1 : Fin m → ℝ) (v : Fin T → ℝ) (V : ℝ),\n  0 ≤ V →\n    ∑ i, |v i| ≤ V →\n      ∀ (variance : NNReal),\n        variance ≠ 0 →\n          InformationTheory.klDiv\n              (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q0 rate0 v).ofLp t)\n                variance)\n              (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q1 rate1 v).ofLp t)\n                variance) ≤\n            ENNReal.ofReal\n              (V ^ 2 *\n                  ‖CurrentMM.finiteImpulseVector T fun j =>\n                        CurrentMM.actualCohortImpulse a impact q1 rate1 j -\n                          CurrentMM.actualCohortImpulse a impact q0 rate0 j‖ ^\n                    2 /\n                (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_pair_first_pulse_attains_kl","type":"∀ {n m T : ℕ} (a impact : ℝ) (q0 rate0 : Fin n → ℝ) (q1 rate1 : Fin m → ℝ),\n  0 < T →\n    ∀ (V : ℝ),\n      0 ≤ V →\n        ∀ (variance : NNReal),\n          variance ≠ 0 →\n            have v := fun t => if ↑t = 0 then V else 0;\n            InformationTheory.klDiv\n                (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q0 rate0 v).ofLp t)\n                  variance)\n                (CurrentMM.gaussianRecordLaw T (fun t => (CurrentMM.actualCohortPriceRecord a impact q1 rate1 v).ofLp t)\n                  variance) =\n              ENNReal.ofReal\n                (V ^ 2 *\n                    ‖CurrentMM.finiteImpulseVector T fun j =>\n                          CurrentMM.actualCohortImpulse a impact q1 rate1 j -\n                            CurrentMM.actualCohortImpulse a impact q0 rate0 j‖ ^\n                      2 /\n                  (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.autonomous_coordinates_power","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (initial : CurrentMM.CohortState n) (t : ℕ),\n  CurrentMM.cohortCoordinates (CurrentMM.autonomousState a impact q rate initial t) =\n    (CurrentMM.cohortLinearTransition a impact q rate ^ t) (CurrentMM.cohortCoordinates initial)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_impulse_matches_physical_pulse","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (t : ℕ),\n  CurrentMM.actualCohortImpulse a impact q rate t =\n    (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate 1) t).price"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_impulse_peak","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i ≤ 1 →\n            ∀ (t : ℕ),\n              0 ≤ CurrentMM.actualCohortImpulse a impact q rate t ∧\n                CurrentMM.actualCohortImpulse a impact q rate t ≤ impact"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.complex_split_transfer_difference","type":"∀ (q rate delta z : ℂ),\n  z - 1 + rate ≠ 0 →\n    z - 1 + rate - delta ≠ 0 →\n      z - 1 + rate + delta ≠ 0 →\n        CurrentMM.complexSplitTransfer q rate delta z - CurrentMM.complexSingleTransfer q rate z =\n          -q * z * (z - 1) * delta ^ 2 / ((z - 1 + rate) * ((z - 1 + rate) ^ 2 - delta ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.complex_price_transfer_difference","type":"∀ (a impact G0 G1 z : ℂ),\n  z - a - impact * G0 ≠ 0 →\n    z - a - impact * G1 ≠ 0 →\n      CurrentMM.complexPriceTransfer a impact G1 z - CurrentMM.complexPriceTransfer a impact G0 z =\n        CurrentMM.complexPriceTransfer a impact G1 z * CurrentMM.complexPriceTransfer a impact G0 z * (G1 - G0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.unit_circle_rate_denominator_lower","type":"∀ (z : ℂ) (rate : ℝ), ‖z‖ = 1 → rate ≤ 1 → rate ≤ ‖z - 1 + ↑rate‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.unit_circle_single_transfer_bound","type":"∀ (z : ℂ) (q rate : ℝ), ‖z‖ = 1 → 0 ≤ q → 0 < rate → rate ≤ 1 → ‖CurrentMM.complexSingleTransfer (↑q) (↑rate) z‖ ≤ q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.split_transfer_as_sum","type":"∀ (q rate delta : ℝ) (z : ℂ),\n  CurrentMM.complexSplitTransfer (↑q) (↑rate) (↑delta) z =\n    CurrentMM.complexSingleTransfer (↑(q / 2)) (↑(rate - delta)) z +\n      CurrentMM.complexSingleTransfer (↑(q / 2)) (↑(rate + delta)) z"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.unit_circle_split_transfer_bound","type":"∀ (z : ℂ) (q rate delta : ℝ),\n  ‖z‖ = 1 →\n    0 ≤ q →\n      0 < rate - delta ∧ rate - delta ≤ 1 →\n        0 < rate + delta ∧ rate + delta ≤ 1 → ‖CurrentMM.complexSplitTransfer (↑q) (↑rate) (↑delta) z‖ ≤ q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_price_denominator_lower","type":"∀ (z G : ℂ) (a impact q : ℝ), ‖z‖ = 1 → 0 ≤ a → 0 ≤ impact → ‖G‖ ≤ q → 1 - a - impact * q ≤ ‖z - ↑a - ↑impact * G‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_price_transfer_uniform_bound","type":"∀ (z G : ℂ) (a impact q : ℝ),\n  ‖z‖ = 1 →\n    0 ≤ a →\n      0 ≤ impact →\n        ‖G‖ ≤ q →\n          a + impact * q < 1 → ‖CurrentMM.complexPriceTransfer (↑a) (↑impact) G z‖ ≤ impact / (1 - a - impact * q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.unit_circle_symmetric_transfer_difference_bound","type":"∀ (z : ℂ) (q rate delta eps : ℝ),\n  ‖z‖ = 1 →\n    0 ≤ q →\n      0 < eps →\n        eps ≤ rate ∧ rate ≤ 1 →\n          eps ≤ rate - delta ∧ rate - delta ≤ 1 →\n            eps ≤ rate + delta ∧ rate + delta ≤ 1 →\n              ‖CurrentMM.complexSplitTransfer (↑q) (↑rate) (↑delta) z -\n                    CurrentMM.complexSingleTransfer (↑q) (↑rate) z‖ ≤\n                2 * q * delta ^ 2 / eps ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.symmetric_price_transfer_difference_uniform_bound","type":"∀ (z : ℂ) (a impact q rate delta eps : ℝ),\n  ‖z‖ = 1 →\n    0 ≤ a →\n      0 ≤ impact →\n        0 ≤ q →\n          a + impact * q < 1 →\n            0 < eps →\n              eps ≤ rate ∧ rate ≤ 1 →\n                eps ≤ rate - delta ∧ rate - delta ≤ 1 →\n                  eps ≤ rate + delta ∧ rate + delta ≤ 1 →\n                    ‖CurrentMM.complexPriceTransfer (↑a) (↑impact)\n                            (CurrentMM.complexSplitTransfer (↑q) (↑rate) (↑delta) z) z -\n                          CurrentMM.complexPriceTransfer (↑a) (↑impact) (CurrentMM.complexSingleTransfer (↑q) (↑rate) z)\n                            z‖ ≤\n                      2 * impact ^ 2 * q / (eps ^ 3 * (1 - a - impact * q) ^ 2) * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.parseval_transfer_energy_bound","type":"∀ {N : ℕ} (w dH_sq U_sq : Fin N → ℝ) (M_sq E_u : ℝ),\n  (∀ (k : Fin N), 0 ≤ w k) →\n    (∀ (k : Fin N), 0 ≤ U_sq k) →\n      0 ≤ M_sq → (∀ (k : Fin N), dH_sq k ≤ M_sq) → ∑ k, w k * U_sq k ≤ E_u → ∑ k, w k * dH_sq k * U_sq k ≤ M_sq * E_u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.two_cohort_active_identification_sample_bound","type":"∀ (N_samples sigma_sq kl_req V M_delta d_eta : ℝ),\n  0 < sigma_sq →\n    0 < V →\n      0 < M_delta →\n        0 < d_eta →\n          kl_req ≤ N_samples * V ^ 2 * (M_delta * d_eta ^ 2) ^ 2 / (2 * sigma_sq) →\n            2 * sigma_sq * kl_req / (V ^ 2 * M_delta ^ 2 * d_eta ^ 4) ≤ N_samples"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.counterparty_pulse_margin_all_times","type":"∀ {n : ℕ} (a impact A cost margin P B : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ A →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              0 ≤ margin →\n                (margin + 1 / 2) * impact * A ^ 2 + (cost + margin * P) * A ≤ B →\n                  ∀ (t : ℕ),\n                    have mark :=\n                      P + (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate A) t).price;\n                    margin * |(-A)| * mark ≤\n                      CurrentMM.equity (B + A * CurrentMM.averageFill P impact A - cost * A) (-A) mark"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.counterparty_pulse_cap_guarantees_margin","type":"∀ {n : ℕ} (a impact A cost margin P B : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 ≤ A →\n        0 ≤ cost →\n          0 < margin →\n            0 < P →\n              0 < B →\n                (∀ (i : Fin n), 0 ≤ q i) →\n                  (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n                    a + impact * ∑ i, q i ≤ 1 →\n                      A ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (cost + margin * P) B →\n                        ∀ (t : ℕ),\n                          have mark :=\n                            P +\n                              (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate A) t).price;\n                          margin * |(-A)| * mark ≤\n                            CurrentMM.equity (B + A * CurrentMM.averageFill P impact A - cost * A) (-A) mark"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.arbitrarily_small_solvent_exact_disclosure","type":"∀ (B P a impact cost q rate delta margin radius : ℝ),\n  0 < B →\n    0 < P →\n      0 ≤ a →\n        0 < impact →\n          0 ≤ cost →\n            0 < q →\n              0 < margin →\n                0 < radius →\n                  delta ≠ 0 →\n                    a + impact * q ≤ 1 →\n                      0 ≤ rate ∧ rate ≤ 1 →\n                        (∀ (i : Fin 2), 0 ≤ CurrentMM.pairRates rate delta i ∧ CurrentMM.pairRates rate delta i ≤ 1) →\n                          ∃ A,\n                            0 < A ∧\n                              A ≤ radius ∧\n                                (∀ (t : ℕ),\n                                    have mark :=\n                                      P +\n                                        (CurrentMM.autonomousState a impact (fun x => q) (fun x => rate)\n                                            (CurrentMM.pulse1 a impact (fun x => q) (fun x => rate) A) t).price;\n                                    margin * |(-A)| * mark ≤\n                                      CurrentMM.equity (B + A * CurrentMM.averageFill P impact A - cost * A) (-A)\n                                        mark) ∧\n                                  (∀ (t : ℕ),\n                                      have mark :=\n                                        P +\n                                          (CurrentMM.autonomousState a impact (fun x => q / 2)\n                                              (CurrentMM.pairRates rate delta)\n                                              (CurrentMM.pulse1 a impact (fun x => q / 2)\n                                                (CurrentMM.pairRates rate delta) A)\n                                              t).price;\n                                      margin * |(-A)| * mark ≤\n                                        CurrentMM.equity (B + A * CurrentMM.averageFill P impact A - cost * A) (-A)\n                                          mark) ∧\n                                    have e0 :=\n                                      CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q) fun x => rate;\n                                    have e1 :=\n                                      CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q / 2)\n                                        (CurrentMM.pairRates rate delta);\n                                    CurrentMM.exactEquityDecision e0 e0 = false ∧\n                                      CurrentMM.exactEquityDecision e0 e1 = true"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kernel_cost_entry_split","type":"∀ {n : ℕ} (kernel : ℕ → ℝ) (trades : Fin n → ℝ) (i j : Fin n),\n  trades i * trades j * kernel ((↑i).dist ↑j) =\n    ((if j < i then trades i * (kernel (↑i - ↑j) * trades j) else 0) +\n        if i < j then trades j * (kernel (↑j - ↑i) * trades i) else 0) +\n      if i = j then kernel 0 * trades i ^ 2 else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.quadratic_execution_cost_triangular","type":"∀ {n : ℕ} (kernel : ℕ → ℝ) (trades : Fin n → ℝ),\n  CurrentMM.quadraticExecutionCost kernel trades =\n    ∑ i, trades i * CurrentMM.baselineDisplacement kernel trades i + kernel 0 / 2 * ∑ i, trades i ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_trader_fundamental_equity","type":"∀ {n : ℕ} (B P impact fee : ℝ) (kernel : ℕ → ℝ) (trades : Fin n → ℝ),\n  kernel 0 = impact →\n    CurrentMM.equity (CurrentMM.traderCashAfter B P impact fee kernel trades) (∑ i, trades i) P =\n      B - CurrentMM.quadraticExecutionCost kernel trades - fee * ∑ i, |trades i|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.solvent_trader_energy_bound","type":"∀ (B cost fees energy spectralFloor : ℝ),\n  0 ≤ B - cost - fees →\n    0 ≤ fees → spectralFloor / 2 * energy ≤ cost → 0 < spectralFloor → energy ≤ 2 * B / spectralFloor"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.no_free_identification_kl_to_execution_loss_bridge","type":"∀ (loss_exec energy c_coer sigma_sq kl_req kl_obs dH_sup_sq : ℝ),\n  0 < c_coer →\n    0 < sigma_sq →\n      0 < dH_sup_sq →\n        c_coer / 2 * energy ≤ loss_exec →\n          kl_req ≤ kl_obs →\n            kl_obs ≤ dH_sup_sq * energy / (2 * sigma_sq) → c_coer * sigma_sq * kl_req / dH_sup_sq ≤ loss_exec"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_log_density_ratio_affine","type":"∀ (mean0 mean1 x : ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    Real.log (ProbabilityTheory.gaussianPDFReal mean0 variance x / ProbabilityTheory.gaussianPDFReal mean1 variance x) =\n      (mean0 - mean1) / ↑variance * x + (mean1 ^ 2 - mean0 ^ 2) / (2 * ↑variance)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_actual_llr_affine","type":"∀ (mean0 mean1 : ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    MeasureTheory.llr (ProbabilityTheory.gaussianReal mean0 variance)\n        (ProbabilityTheory.gaussianReal mean1 variance) =ᵐ[ProbabilityTheory.gaussianReal mean0 variance]\n      fun x => (mean0 - mean1) / ↑variance * x + (mean1 ^ 2 - mean0 ^ 2) / (2 * ↑variance)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_actual_llr_integrable","type":"∀ (mean0 mean1 : ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    MeasureTheory.Integrable\n      (MeasureTheory.llr (ProbabilityTheory.gaussianReal mean0 variance)\n        (ProbabilityTheory.gaussianReal mean1 variance))\n      (ProbabilityTheory.gaussianReal mean0 variance)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_equal_variance_kl","type":"∀ (mean0 mean1 : ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (ProbabilityTheory.gaussianReal mean0 variance)\n        (ProbabilityTheory.gaussianReal mean1 variance) =\n      ENNReal.ofReal ((mean0 - mean1) ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.active_probing_kl_necessity_lower_bound","type":"∀ (V sigma_sq kl_req kl_obs signal_norm_sq : ℝ),\n  0 < sigma_sq →\n    0 < signal_norm_sq →\n      kl_req ≤ kl_obs →\n        kl_obs ≤ V ^ 2 * signal_norm_sq / (2 * sigma_sq) →\n          2 * sigma_sq * kl_req / signal_norm_sq ≤ V ^ 2 ∧ (0 < kl_req → V ≠ 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_cara_exponential_integral","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (law : MeasureTheory.Measure Ω) (loss : Ω → ℝ) (mean : ℝ)\n  (variance : NNReal) (gamma spread : ℝ),\n  ProbabilityTheory.HasLaw loss (ProbabilityTheory.gaussianReal mean variance) law →\n    ∫ (ω : Ω), Real.exp (-gamma * (spread - loss ω)) ∂law =\n      Real.exp (-gamma * spread + mean * gamma + ↑variance * gamma ^ 2 / 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_cara_certainty_equivalent","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (law : MeasureTheory.Measure Ω) (loss : Ω → ℝ) (mean : ℝ)\n  (variance : NNReal) (gamma spread : ℝ),\n  gamma ≠ 0 →\n    ProbabilityTheory.HasLaw loss (ProbabilityTheory.gaussianReal mean variance) law →\n      CurrentMM.caraCertaintyEquivalent law loss gamma spread = spread - mean - gamma * ↑variance / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_cara_quote_iff","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (law : MeasureTheory.Measure Ω) (loss : Ω → ℝ) (mean : ℝ)\n  (variance : NNReal) (gamma spread : ℝ),\n  0 < gamma →\n    ProbabilityTheory.HasLaw loss (ProbabilityTheory.gaussianReal mean variance) law →\n      (0 ≤ CurrentMM.caraCertaintyEquivalent law loss gamma spread ↔ mean + gamma * ↑variance / 2 ≤ spread)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_quote_iff","type":"∀ {Θ : Type u_1} (models : Set Θ) (cost : Θ → ℝ),\n  models.Nonempty →\n    BddAbove (cost '' models) → ∀ (spread : ℝ), (∀ θ ∈ models, cost θ ≤ spread) ↔ sSup (cost '' models) ≤ spread"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_quote_dominates_baseline","type":"∀ {Θ : Type u_1} (models : Set Θ) (cost : Θ → ℝ),\n  BddAbove (cost '' models) → ∀ baseline ∈ models, cost baseline ≤ sSup (cost '' models)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_premium_nonneg_and_pos_iff","type":"∀ {Θ : Type u_1} (models : Set Θ) (cost : Θ → ℝ),\n  BddAbove (cost '' models) →\n    ∀ baseline ∈ models,\n      0 ≤ sSup (cost '' models) - cost baseline ∧\n        (0 < sSup (cost '' models) - cost baseline ↔ cost baseline < sSup (cost '' models))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ema_filtered_martingale_expectation","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure μ]\n  (alpha price oldAnchor : ℝ) (increment : Ω → ℝ),\n  MeasureTheory.Integrable increment μ →\n    ∫ (ω : Ω), increment ω ∂μ = 0 →\n      ∫ (ω : Ω), price + increment ω - ((1 - alpha) * oldAnchor + alpha * (price + increment ω)) ∂μ =\n        (1 - alpha) * (price - oldAnchor)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_absolute_continuity","type":"∀ {T : ℕ} (mean0 mean1 : Fin T → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    (CurrentMM.gaussianRecordLaw T mean0 variance).AbsolutelyContinuous (CurrentMM.gaussianRecordLaw T mean1 variance)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_llr_integrable","type":"∀ {T : ℕ} (mean0 mean1 : Fin T → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    MeasureTheory.Integrable\n      (MeasureTheory.llr (CurrentMM.gaussianRecordLaw T mean0 variance) (CurrentMM.gaussianRecordLaw T mean1 variance))\n      (CurrentMM.gaussianRecordLaw T mean0 variance)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_equal_variance_kl","type":"∀ {T : ℕ} (mean0 mean1 : Fin T → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T mean0 variance)\n        (CurrentMM.gaussianRecordLaw T mean1 variance) =\n      ENNReal.ofReal ((∑ i, (mean0 i - mean1 i) ^ 2) / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_kl_euclidean_mean","type":"∀ {T : ℕ} (mean0 mean1 : Fin T → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T mean0 variance)\n        (CurrentMM.gaussianRecordLaw T mean1 variance) =\n      ENNReal.ofReal (‖WithLp.toLp 2 fun i => mean0 i - mean1 i‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_kl_zero_mean","type":"∀ {T : ℕ} (mean : EuclideanSpace ℝ (Fin T)) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T (fun x => 0) variance)\n        (CurrentMM.gaussianRecordLaw T (fun i => mean.ofLp i) variance) =\n      ENNReal.ofReal (‖mean‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_actual_quantity_kl_bound","type":"∀ {T : ℕ} (impulse : ℕ → ℝ) (v : Fin T → ℝ) (V : ℝ),\n  0 ≤ V →\n    ∑ i, |v i| ≤ V →\n      ∀ (variance : NNReal),\n        variance ≠ 0 →\n          InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T (fun x => 0) variance)\n              (CurrentMM.gaussianRecordLaw T (fun i => (CurrentMM.causalImpulseConvolution impulse v).ofLp i)\n                variance) ≤\n            ENNReal.ofReal (V ^ 2 * ‖CurrentMM.finiteImpulseVector T impulse‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_first_pulse_attains_quantity_kl","type":"∀ {T : ℕ} (impulse : ℕ → ℝ),\n  0 < T →\n    ∀ (V : ℝ),\n      0 ≤ V →\n        ∀ (variance : NNReal),\n          variance ≠ 0 →\n            have v := fun t => if ↑t = 0 then V else 0;\n            InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T (fun x => 0) variance)\n                (CurrentMM.gaussianRecordLaw T (fun i => (CurrentMM.causalImpulseConvolution impulse v).ofLp i)\n                  variance) =\n              ENNReal.ofReal (V ^ 2 * ‖CurrentMM.finiteImpulseVector T impulse‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_record_kl_common_mean_shift","type":"∀ {T : ℕ} (baseline : Fin T → ℝ) (signal : EuclideanSpace ℝ (Fin T)) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T baseline variance)\n        (CurrentMM.gaussianRecordLaw T (fun i => baseline i + signal.ofLp i) variance) =\n      ENNReal.ofReal (‖signal‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_actual_quantity_kl_with_baseline","type":"∀ {T : ℕ} (baseline : Fin T → ℝ) (impulse : ℕ → ℝ) (v : Fin T → ℝ) (V : ℝ),\n  0 ≤ V →\n    ∑ i, |v i| ≤ V →\n      ∀ (variance : NNReal),\n        variance ≠ 0 →\n          InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T baseline variance)\n              (CurrentMM.gaussianRecordLaw T\n                (fun i => baseline i + (CurrentMM.causalImpulseConvolution impulse v).ofLp i) variance) ≤\n            ENNReal.ofReal (V ^ 2 * ‖CurrentMM.finiteImpulseVector T impulse‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.gaussian_first_pulse_kl_with_baseline","type":"∀ {T : ℕ} (baseline : Fin T → ℝ) (impulse : ℕ → ℝ),\n  0 < T →\n    ∀ (V : ℝ),\n      0 ≤ V →\n        ∀ (variance : NNReal),\n          variance ≠ 0 →\n            have v := fun t => if ↑t = 0 then V else 0;\n            InformationTheory.klDiv (CurrentMM.gaussianRecordLaw T baseline variance)\n                (CurrentMM.gaussianRecordLaw T\n                  (fun i => baseline i + (CurrentMM.causalImpulseConvolution impulse v).ofLp i) variance) =\n              ENNReal.ofReal (V ^ 2 * ‖CurrentMM.finiteImpulseVector T impulse‖ ^ 2 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.scalar_ar1_state_variance_bound","type":"∀ (t : ℕ) (sigma_sq s_sq E_bound : ℝ),\n  0 ≤ sigma_sq →\n    0 ≤ s_sq →\n      1 ≤ E_bound →\n        (∀ j ∈ Finset.range t, s_sq ^ j ≤ E_bound) → sigma_sq * ∑ j ∈ Finset.range t, s_sq ^ j ≤ sigma_sq * ↑t * E_bound"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.scalar_ar1_path_kl_bound","type":"∀ (T : ℕ),\n  0 < T →\n    ∀ (c0 sigma_sq exp_2c0 sum_t : ℝ),\n      0 < sigma_sq →\n        0 ≤ exp_2c0 →\n          sum_t ≤ ↑T * (↑T - 1) / 2 →\n            (c0 / ↑T) ^ 2 / (2 * sigma_sq) * (sigma_sq * sum_t * exp_2c0) ≤ c0 ^ 2 * exp_2c0 / 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.finite_window_abstention_lower_bound","type":"∀ (p_unstable_0 p_stable_0 p_abstain_0 p_stable_1 alpha tv tv_bound : ℝ),\n  p_unstable_0 + p_stable_0 + p_abstain_0 = 1 →\n    p_unstable_0 ≤ alpha →\n      p_stable_1 ≤ alpha →\n        |p_stable_0 - p_stable_1| ≤ tv →\n          tv ≤ tv_bound → tv_bound < 1 - 2 * alpha → 1 - 2 * alpha - tv_bound ≤ p_abstain_0 ∧ 0 < p_abstain_0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.binary_rule_minimax_error_lower_bound","type":"∀ (p_unstable_minus p_stable_minus p_stable_plus tv : ℝ),\n  p_unstable_minus + p_stable_minus = 1 →\n    |p_stable_minus - p_stable_plus| ≤ tv → (1 - tv) / 2 ≤ max p_unstable_minus p_stable_plus"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.adaptive_feedback_chain_rule_kl_bound","type":"∀ {T : ℕ} (kl_step state_var : Fin T → ℝ) (delta_s_sq sigma_sq E_bound : ℝ),\n  0 < sigma_sq →\n    0 ≤ delta_s_sq →\n      (∀ (t : Fin T), kl_step t ≤ delta_s_sq / (2 * sigma_sq) * state_var t) →\n        (∀ (t : Fin T), state_var t ≤ sigma_sq * ↑↑t * E_bound) → ∑ t, kl_step t ≤ delta_s_sq * E_bound / 2 * ∑ t, ↑↑t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_two_world_capacity_loss","type":"∀ {Ω : Type u_1} [inst : Fintype Ω] [DecidableEq Ω] (p0 p1 : Ω → ℝ),\n  ∑ ω, p0 ω = 1 →\n    (∀ (ω : Ω), 0 ≤ p1 ω) →\n      ∀ (A : Ω → ℝ) (v0 v1 β : ℝ),\n        v0 ≤ v1 →\n          (∀ (ω : Ω), A ω ≤ v1) →\n            CurrentMM.is_prob p0 {ω | v0 < A ω} ≤ β →\n              (v1 - v0) * max 0 (1 - β - CurrentMM.is_tv p0 p1) ≤ CurrentMM.is_expect p1 fun ω => v1 - A ω"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_two_world_attained","type":"∀ (v0 v1 β : ℝ),\n  0 ≤ β →\n    β ≤ 1 →\n      v0 < v1 →\n        have p := fun b => if b = true then β else 1 - β;\n        have A := fun b => if b = true then v1 else v0;\n        CurrentMM.is_tv p p = 0 ∧\n          CurrentMM.is_prob p {ω | v0 < A ω} = β ∧\n            (CurrentMM.is_expect p fun ω => v1 - A ω) = (v1 - v0) * max 0 (1 - β - CurrentMM.is_tv p p)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_per_period_upper","type":"∀ {n : ℕ} (g v : Fin n → ℝ) (d V : ℝ), (∀ (k : Fin n), |v k| ≤ V) → |d + ∑ k, g k * v k| ≤ |d| + V * ∑ k, |g k|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_per_period_attained","type":"∀ {n : ℕ} (g : Fin n → ℝ) (d V : ℝ),\n  0 ≤ V →\n    (∀ (k : Fin n), |CurrentMM.is_alignedPath g d V k| ≤ V) ∧\n      |d + ∑ k, g k * CurrentMM.is_alignedPath g d V k| = |d| + V * ∑ k, |g k|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_budget_upper","type":"∀ {n : ℕ} (g v : Fin n → ℝ) (W M : ℝ), (∀ (k : Fin n), |g k| ≤ M) → ∑ k, |v k| ≤ W → 0 ≤ M → |∑ k, g k * v k| ≤ W * M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_budget_attained","type":"∀ {n : ℕ} (g : Fin n → ℝ) (W : ℝ),\n  0 ≤ W →\n    ∀ (j : Fin n),\n      have v := fun k => if k = j then W else 0;\n      ∑ k, |v k| = W ∧ |∑ k, g k * v k| = W * |g j|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_peak_understates","type":"∀ {n : ℕ} (g : Fin n → ℝ) (V : ℝ), 0 < V → ∀ (i j : Fin n), i ≠ j → g i ≠ 0 → V * |g j| < V * ∑ k, |g k|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_robust_safe_set_eq","type":"∀ (a κ L B Φp : ℝ),\n  0 < κ →\n    0 < L →\n      0 < B →\n        0 < Φp →\n          0 ≤ CurrentMM.is_cI a κ L B →\n            {α | α ∈ Set.Icc 0 1 ∧ CurrentMM.is_RobustSafe a κ L B Φp α} = Set.Icc 0 (CurrentMM.is_alphaStar a κ L B Φp)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_alphaStar_isGreatest","type":"∀ (a κ L B Φp : ℝ),\n  0 < κ →\n    0 < L →\n      0 < B →\n        0 < Φp →\n          0 ≤ CurrentMM.is_cI a κ L B →\n            IsGreatest {α | α ∈ Set.Icc 0 1 ∧ CurrentMM.is_RobustSafe a κ L B Φp α} (CurrentMM.is_alphaStar a κ L B Φp)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_infeasible_of_cI_neg","type":"∀ (a κ L B α Φ : ℝ),\n  0 < κ → 0 < L → 0 < B → 0 ≤ α → 0 ≤ Φ → CurrentMM.is_cI a κ L B < 0 → ¬CurrentMM.is_Safe a κ L B α Φ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_sound","type":"∀ (a κ L B Φp Φtrue α : ℝ),\n  Φtrue ∈ Set.Icc 0 Φp → CurrentMM.is_RobustSafe a κ L B Φp α → CurrentMM.is_Safe a κ L B α Φtrue"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_disclosure_monotone","type":"∀ (a κ L B Φtag Φpub α : ℝ),\n  Φtag ≤ Φpub → CurrentMM.is_RobustSafe a κ L B Φpub α → CurrentMM.is_RobustSafe a κ L B Φtag α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_disclosure_strict","type":"∀ (a κ L B Φtag Φpub : ℝ),\n  0 < κ →\n    0 < CurrentMM.is_cI a κ L B →\n      0 < Φtag →\n        Φtag < Φpub →\n          CurrentMM.is_cI a κ L B / (κ * Φpub) < 1 →\n            CurrentMM.is_alphaStar a κ L B Φpub < CurrentMM.is_alphaStar a κ L B Φtag"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_robust_safe_antitone","type":"∀ {Θ : Type u_1} {U : Type u_2} (R : Θ → U → ℝ) (B : ℝ) (Θsmall Θbig : Set Θ),\n  Θsmall ⊆ Θbig → ∀ (u : U), (∀ θ ∈ Θbig, R θ u ≤ B) → ∀ θ ∈ Θsmall, R θ u ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_Dv_convex","type":"∀ (κ0 a0 Φ δ ρ x y t : ℝ),\n  0 ≤ δ * ρ →\n    0 ≤ t →\n      t ≤ 1 →\n        CurrentMM.is_Dv κ0 a0 Φ δ ρ (t * x + (1 - t) * y) ≤\n          t * CurrentMM.is_Dv κ0 a0 Φ δ ρ x + (1 - t) * CurrentMM.is_Dv κ0 a0 Φ δ ρ y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_unsafe_between","type":"∀ (κ0 a0 Φ δ ρ ℓ x y z : ℝ),\n  0 ≤ δ * ρ →\n    x ≤ y →\n      y ≤ z →\n        CurrentMM.is_margin κ0 a0 Φ δ ρ ℓ x < 0 →\n          CurrentMM.is_margin κ0 a0 Φ δ ρ ℓ z < 0 → CurrentMM.is_margin κ0 a0 Φ δ ρ ℓ y < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_worst_corner","type":"∀ (κ0 a0 Φ δ ρ κp ap Φp δm ρm ℓ α : ℝ),\n  0 ≤ α →\n    0 ≤ ℓ →\n      κ0 ≤ κp →\n        a0 ≤ ap →\n          Φ ≤ Φp →\n            δm ≤ δ →\n              ρm ≤ ρ →\n                0 ≤ Φ →\n                  0 ≤ κ0 →\n                    0 ≤ δm →\n                      0 ≤ ρm → ap < 1 → CurrentMM.is_margin κp ap Φp δm ρm ℓ α ≤ CurrentMM.is_margin κ0 a0 Φ δ ρ ℓ α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_venue_example","type":"0 ≤ CurrentMM.is_margin 1.02 0.60 2.4 2.9 0.58 0.37 0 ∧\n  CurrentMM.is_margin 1.02 0.60 2.4 2.9 0.58 0.37 0.2 < 0 ∧ 0 ≤ CurrentMM.is_margin 1.02 0.60 2.4 2.9 0.58 0.37 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_venue_example_box","type":"∀ (κ0 a0 Φ δ ρ : ℝ),\n  0.98 ≤ κ0 ∧ κ0 ≤ 1.02 →\n    0.58 ≤ a0 ∧ a0 ≤ 0.60 →\n      2.3 ≤ Φ ∧ Φ ≤ 2.4 →\n        2.9 ≤ δ ∧ δ ≤ 3.1 →\n          0.58 ≤ ρ ∧ ρ ≤ 0.62 → 0 ≤ CurrentMM.is_margin κ0 a0 Φ δ ρ 0.37 0 ∧ 0 ≤ CurrentMM.is_margin κ0 a0 Φ δ ρ 0.37 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_classify_safe_sound","type":"∀ {Θ : Type u_1} {ι : Type u_2} (S : ℝ → Θ → ℝ) (A : Set ℝ) (Θs : Set Θ) (part : ι → Set Θ) (U : ι → ℝ) (B : ℝ),\n  Θs ⊆ ⋃ i, part i →\n    (∀ (i : ι), ∀ α ∈ A, ∀ θ ∈ part i, S α θ ≤ U i) → (∀ (i : ι), U i ≤ B) → ∀ α ∈ A, ∀ θ ∈ Θs, S α θ ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_classify_unsafe_sound","type":"∀ {Θ : Type u_1} (S : ℝ → Θ → ℝ) (A : Set ℝ) (Θs : Set Θ),\n  ∀ θj ∈ Θs, ∀ (L B : ℝ), (∀ α ∈ A, L ≤ S α θj) → B < L → ∀ α ∈ A, ∃ θ ∈ Θs, B < S α θ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_robustSafeSet_closed","type":"∀ {Θ : Type u_1} (S : ℝ → Θ → ℝ) (Θs : Set Θ) (B : ℝ),\n  (∀ (θ : Θ), Continuous fun α => S α θ) → IsClosed (CurrentMM.is_robustSafeSet S Θs B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_largest_safe_exists","type":"∀ {Θ : Type u_1} (S : ℝ → Θ → ℝ) (Θs : Set Θ) (B : ℝ),\n  (∀ (θ : Θ), Continuous fun α => S α θ) →\n    (Set.Icc 0 1 ∩ CurrentMM.is_robustSafeSet S Θs B).Nonempty →\n      ∃ αmax,\n        IsGreatest (Set.Icc 0 1 ∩ CurrentMM.is_robustSafeSet S Θs B) αmax ∧\n          ∀ α ∈ Set.Icc 0 1 ∩ CurrentMM.is_robustSafeSet S Θs B, α ≤ αmax"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_coeff_moment_eq","type":"∀ {m n : ℕ} (w x : Fin m → ℝ) (c : Fin n → ℝ),\n  ∑ j, c j * CurrentMM.is_moment w x ↑j = ∑ i, w i * CurrentMM.is_poly c (x i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_upper_bound","type":"∀ {m n : ℕ} (w x : Fin m → ℝ) (c : Fin n → ℝ) (f : ℝ → ℝ) (rbar : ℝ),\n  (∀ (i : Fin m), 0 ≤ w i) →\n    (∀ (i : Fin m), x i ∈ Set.Icc 0 rbar) →\n      (∀ r ∈ Set.Icc 0 rbar, f r ≤ CurrentMM.is_poly c r) → ∑ i, w i * f (x i) ≤ ∑ j, c j * CurrentMM.is_moment w x ↑j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_lower_bound","type":"∀ {m n : ℕ} (w x : Fin m → ℝ) (c : Fin n → ℝ) (f : ℝ → ℝ) (rbar : ℝ),\n  (∀ (i : Fin m), 0 ≤ w i) →\n    (∀ (i : Fin m), x i ∈ Set.Icc 0 rbar) →\n      (∀ r ∈ Set.Icc 0 rbar, CurrentMM.is_poly c r ≤ f r) → ∑ j, c j * CurrentMM.is_moment w x ↑j ≤ ∑ i, w i * f (x i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_slack_shift","type":"∀ {m n : ℕ} (w x : Fin m → ℝ) (c : Fin n → ℝ) (f : ℝ → ℝ) (rbar s : ℝ),\n  (∀ (i : Fin m), 0 ≤ w i) →\n    (∀ (i : Fin m), x i ∈ Set.Icc 0 rbar) →\n      (∀ r ∈ Set.Icc 0 rbar, f r ≤ CurrentMM.is_poly c r + s) →\n        ∑ i, w i * f (x i) ≤ ∑ j, c j * CurrentMM.is_moment w x ↑j + s * CurrentMM.is_moment w x 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_cohort_row_bound","type":"∀ (η a κΦ rbar sbar : ℝ),\n  1 - rbar ≤ η → a + κΦ ≤ sbar → sbar ≤ 1 → rbar ≤ 1 → 1 - η * (1 - a - κΦ) ≤ 1 - (1 - rbar) * (1 - sbar)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_price_row_bound","type":"∀ (a κΦ rbar sbar : ℝ), a + κΦ ≤ sbar → sbar ≤ 1 → 0 ≤ rbar → a + κΦ ≤ 1 - (1 - rbar) * (1 - sbar)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_step_bound","type":"∀ {n : ℕ} (J : Fin n → Fin n → ℝ) (v : Fin n → ℝ) (lam M : ℝ),\n  (∀ (i j : Fin n), 0 ≤ J i j) →\n    (∀ (i : Fin n), ∑ j, J i j ≤ lam) →\n      (∀ (j : Fin n), 0 ≤ v j) →\n        (∀ (j : Fin n), v j ≤ M) → 0 ≤ M → ∀ (i : Fin n), 0 ≤ ∑ j, J i j * v j ∧ ∑ j, J i j * v j ≤ lam * M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_iter_bound","type":"∀ {n : ℕ} (J : Fin n → Fin n → ℝ) (b : Fin n → ℝ) (lam κ : ℝ),\n  (∀ (i j : Fin n), 0 ≤ J i j) →\n    (∀ (i : Fin n), ∑ j, J i j ≤ lam) →\n      0 ≤ lam →\n        (∀ (j : Fin n), 0 ≤ b j) →\n          (∀ (j : Fin n), b j ≤ κ) →\n            0 ≤ κ → ∀ (t : ℕ) (i : Fin n), 0 ≤ CurrentMM.is_iter J b t i ∧ CurrentMM.is_iter J b t i ≤ κ * lam ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_tail_bound","type":"∀ (κ lam : ℝ) (T m : ℕ), 0 ≤ κ → 0 ≤ lam → lam < 1 → ∑ s ∈ Finset.range m, κ * lam ^ (T + s) ≤ κ * lam ^ T / (1 - lam)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_buffer_after_step","type":"∀ (K I p dp μ c0 U Ch Cf R : ℝ),\n  0 ≤ μ →\n    |dp| ≤ U →\n      |I| * (1 + μ) * U + Ch + Cf + R ≤ CurrentMM.is_buffer K I p μ c0 →\n        R ≤ CurrentMM.is_buffer (K - Ch - Cf) I (p + dp) μ c0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_scenario","type":"CurrentMM.is_buffer (10000 + 2000 * 100) (-2000) 100 5e-3 50 = 9050 ∧\n  CurrentMM.is_admissibleShock 9050 950 (-2000) 5e-3 = 8100 / 2010 ∧\n    950 ≤ CurrentMM.is_buffer (10000 + 2000 * 100) (-2000) (100 + 4.02) 5e-3 50 ∧\n      CurrentMM.is_buffer (10000 + 2000 * 100) (-2000) (100 + 4.05) 5e-3 50 < 950"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_corrSum_ge","type":"∀ (φ : ℝ), 0 ≤ φ → ∀ (T : ℕ), ↑T ≤ CurrentMM.is_corrSum φ T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_o1_margin_too_small","type":"∀ (φ z σ N s1 s2 : ℝ) (T : ℕ),\n  0 ≤ φ →\n    0 ≤ z →\n      0 ≤ σ →\n        0 < N → 0 ≤ s1 → 0 ≤ s2 → s1 ^ 2 = ↑T / N → s2 ^ 2 = CurrentMM.is_corrSum φ T / N → z * σ * s1 ≤ z * σ * s2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_sequential_rule_correct","type":"∀ (xbar r : ℕ → ℝ) (ST S tail sB : ℝ),\n  (∀ (n : ℕ), |xbar n - ST| < r n) →\n    ST ≤ S ∧ S ≤ ST + tail → ∀ (n : ℕ), (xbar n + r n + tail ≤ sB → S ≤ sB) ∧ (sB < xbar n - r n → sB < S)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_rh_radius_bound","type":"∀ (r L0 s γ D : ℝ), 0 ≤ r → 0 ≤ s → s ^ 2 = L0 → 0 ≤ γ * D → L0 * (1 - γ * D) ≤ r ^ 2 → s * max 0 (1 - γ * D) ≤ r"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_rh_chain","type":"∀ (L0 x r fee cE s sW γ : ℝ),\n  0 ≤ cE →\n    0 ≤ fee →\n      cE * r - x * sW ≤ fee →\n        s * max 0 (1 - γ * x ^ 2) ≤ r → L0 + x ^ 2 + max 0 (cE * s * max 0 (1 - γ * x ^ 2) - sW * x) ≤ L0 + x ^ 2 + fee"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_iv_det_pos","type":"∀ {n : ℕ} (c lam : Fin n → ℝ) (w r : ℝ),\n  0 < w →\n    0 ≤ r →\n      r < 1 →\n        (∀ (l : Fin n), 0 ≤ c l) →\n          (∀ (l : Fin n), 0 ≤ lam l) →\n            (∀ (l : Fin n), lam l < 1) →\n              (∃ l, 0 < c l) → 0 < w * ∑ l, ∑ m, c l * c m * (1 - lam l * lam m) / (1 - r * lam m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_confluent_stationary","type":"∀ (a κ φε L : ℝ), 0 < L → 0 < φε → (a * κ + φε * (1 / L - a * κ / φε)) * -L + φε = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_momentum_residues","type":"∀ (l1 l2 m11 : ℝ),\n  l2 < l1 →\n    l2 ≤ m11 → m11 ≤ l1 → 0 ≤ (m11 - l2) / (l1 - l2) ∧ (m11 - l2) / (l1 - l2) ≤ 1 ∧ 0 ≤ 1 - (m11 - l2) / (l1 - l2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_summed_response_closed_form","type":"∀ (a κ φ ε r η q X D F : ℝ),\n  r ≠ 0 →\n    η ≠ 0 →\n      1 - a - q * (κ + φ * ε / r) ≠ 0 →\n        X = κ + a * X + φ * D + κ * F →\n          D = ε + (1 - r) * D + ε * F →\n            F = (1 - η) * F + η * q * X → X = (κ + φ * ε / r) / (1 - a - q * (κ + φ * ε / r))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_intersection_admits_more","type":"∀ (a κ L B P1 P2 : ℝ),\n  0 < κ →\n    0 < P1 →\n      0 < P2 →\n        0 ≤ CurrentMM.is_cI a κ L B →\n          CurrentMM.is_alphaStar a κ L B P1 ≤ CurrentMM.is_alphaStar a κ L B (min P1 P2) ∧\n            CurrentMM.is_alphaStar a κ L B P2 ≤ CurrentMM.is_alphaStar a κ L B (min P1 P2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_depth_solution_increasing","type":"∀ (A b1 b2 D1 D2 : ℝ), 0 ≤ A → 0 < D1 → 0 < D2 → D1 - A / D1 ^ 2 = b1 → D2 - A / D2 ^ 2 = b2 → b1 < b2 → D1 < D2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_depth_eq_lt_sp","type":"∀ (θ N X b Deq Dsp : ℝ),\n  0 < X → 0 ≤ θ → θ < N → 0 < Deq → 0 < Dsp → Deq - θ * X / Deq ^ 2 = b → Dsp - N * X / Dsp ^ 2 = b → Deq < Dsp"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.is_depth_rebate_identified","type":"∀ (Γ D : ℝ), D ≠ 0 → Γ / D ^ 2 = Γ / D * (1 / D)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_inventory_S","type":"∀ (a κ Φ δ ψ : ℝ),\n  0 < κ →\n    0 ≤ Φ →\n      0 < δ →\n        0 ≤ ψ →\n          a + κ * Φ < 1 →\n            have Φ_eff := δ / (δ + ψ) * Φ;\n            have S_inv := κ / (1 - a - κ * Φ_eff);\n            have S_0 := κ / (1 - a - κ * Φ);\n            Φ_eff ≤ Φ ∧ S_inv ≤ S_0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p2_prop_driftguard","type":"∀ (c_I kPhi B I_abs y0_bar : ℝ),\n  kPhi ≠ 0 →\n    B ≠ 0 →\n      B + I_abs * y0_bar ≠ 0 →\n        have alpha_star := c_I / (kPhi * B);\n        have alpha_drift := c_I / (kPhi * (B + I_abs * y0_bar));\n        alpha_star - alpha_drift = alpha_star * (I_abs * y0_bar) / (B + I_abs * y0_bar)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defectiveJ_charpoly_det","type":"∀ (ρ θ s : ℝ), (s • 1 - CurrentMM.defectiveJ ρ θ).det = (s - ρ) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defectiveJ_commutator","type":"∀ (ρ θ : ℝ),\n  CurrentMM.defectiveJ ρ θ * (CurrentMM.defectiveJ ρ θ).transpose -\n      (CurrentMM.defectiveJ ρ θ).transpose * CurrentMM.defectiveJ ρ θ =\n    !![θ ^ 2, 0; 0, -θ ^ 2]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defectiveJ_not_normal","type":"∀ (ρ θ : ℝ),\n  θ ≠ 0 →\n    CurrentMM.defectiveJ ρ θ * (CurrentMM.defectiveJ ρ θ).transpose ≠\n      (CurrentMM.defectiveJ ρ θ).transpose * CurrentMM.defectiveJ ρ θ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defectiveJ_pow_succ","type":"∀ (ρ θ : ℝ) (t : ℕ), CurrentMM.defectiveJ ρ θ ^ (t + 1) = !![ρ ^ (t + 1), (↑t + 1) * θ * ρ ^ t; 0, ρ ^ (t + 1)]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defectiveJ_pow","type":"∀ (ρ θ : ℝ) (t : ℕ), 1 ≤ t → CurrentMM.defectiveJ ρ θ ^ t = !![ρ ^ t, ↑t * θ * ρ ^ (t - 1); 0, ρ ^ t]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.firstCoordOutput_mul_pow_succ","type":"∀ (ρ θ : ℝ) (t : ℕ),\n  CurrentMM.firstCoordOutput * CurrentMM.defectiveJ ρ θ ^ (t + 1) = !![ρ ^ (t + 1), (↑t + 1) * θ * ρ ^ t]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.row_l2_opNorm","type":"∀ (a b : ℝ), ‖!![a, b]‖ = √(a ^ 2 + b ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.firstCoordOutput_norm","type":"‖CurrentMM.firstCoordOutput‖ = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defective_outputGain_bddAbove","type":"∀ (ρ θ : ℝ),\n  0 < ρ → ρ < 1 → 0 ≤ θ → BddAbove (Set.range fun t => ‖CurrentMM.firstCoordOutput * CurrentMM.defectiveJ ρ θ ^ t‖)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.firstCoordOutput_mul_defectiveJ_norm","type":"∀ (ρ θ : ℝ), ‖CurrentMM.firstCoordOutput * CurrentMM.defectiveJ ρ θ‖ = √(ρ ^ 2 + θ ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defective_outputGain_ge","type":"∀ (ρ θ : ℝ),\n  0 < ρ →\n    ρ < 1 →\n      0 ≤ θ →\n        √(ρ ^ 2 + θ ^ 2) ≤ CurrentMM.outputGain CurrentMM.firstCoordOutput (CurrentMM.defectiveJ ρ θ) ∧\n          θ ≤ CurrentMM.outputGain CurrentMM.firstCoordOutput (CurrentMM.defectiveJ ρ θ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defective_exact_radius_le","type":"∀ (ρ θ B : ℝ),\n  0 < ρ → ρ < 1 → 0 < θ → 0 < B → B / CurrentMM.outputGain CurrentMM.firstCoordOutput (CurrentMM.defectiveJ ρ θ) ≤ B / θ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.defective_exact_radius_tendsto_zero","type":"∀ (ρ B : ℝ),\n  0 < ρ →\n    ρ < 1 →\n      0 < B →\n        Filter.Tendsto (fun θ => B / CurrentMM.outputGain CurrentMM.firstCoordOutput (CurrentMM.defectiveJ ρ θ))\n          Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.outputGain_ge","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (C : Matrix (Fin m) (Fin n) 𝕜) (J : Matrix (Fin n) (Fin n) 𝕜),\n  BddAbove (Set.range fun t => ‖C * J ^ t‖) → ∀ (t : ℕ), ‖C * J ^ t‖ ≤ CurrentMM.outputGain C J"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.outputGain_pos","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (C : Matrix (Fin m) (Fin n) 𝕜) (J : Matrix (Fin n) (Fin n) 𝕜),\n  BddAbove (Set.range fun t => ‖C * J ^ t‖) → C ≠ 0 → 0 < CurrentMM.outputGain C J"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_safe_radius_sufficient","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (C : Matrix (Fin m) (Fin n) 𝕜) (J : Matrix (Fin n) (Fin n) 𝕜) (B : ℝ),\n  BddAbove (Set.range fun t => ‖C * J ^ t‖) →\n    C ≠ 0 →\n      ∀ (z : EuclideanSpace 𝕜 (Fin n)),\n        ‖z‖ ≤ B / CurrentMM.outputGain C J → ∀ (t : ℕ), ‖CurrentMM.l2Apply (C * J ^ t) z‖ ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_safe_radius_necessary","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (C : Matrix (Fin m) (Fin n) 𝕜) (J : Matrix (Fin n) (Fin n) 𝕜) (B : ℝ),\n  BddAbove (Set.range fun t => ‖C * J ^ t‖) →\n    C ≠ 0 →\n      0 < B → ∀ (r : ℝ), B / CurrentMM.outputGain C J < r → ∃ z, ‖z‖ = r ∧ ∃ t, B < ‖CurrentMM.l2Apply (C * J ^ t) z‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_safe_radius_isGreatest","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (C : Matrix (Fin m) (Fin n) 𝕜) (J : Matrix (Fin n) (Fin n) 𝕜) (B : ℝ),\n  BddAbove (Set.range fun t => ‖C * J ^ t‖) →\n    C ≠ 0 →\n      0 < B →\n        IsGreatest\n          {r | 0 ≤ r ∧ ∀ (z : EuclideanSpace 𝕜 (Fin n)), ‖z‖ ≤ r → ∀ (t : ℕ), ‖CurrentMM.l2Apply (C * J ^ t) z‖ ≤ B}\n          (B / CurrentMM.outputGain C J)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.zero_output_no_radius_bound","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {m n : ℕ} (J : Matrix (Fin n) (Fin n) 𝕜) (B : ℝ),\n  0 ≤ B → ∀ (z : EuclideanSpace 𝕜 (Fin n)) (t : ℕ), ‖CurrentMM.l2Apply (0 * J ^ t) z‖ ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_neumann_hasSum","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ) (M : ℝ),\n  (∀ (t : ℕ), ‖J ^ t‖ ≤ M) → ∀ (z : ℂ), 1 < ‖z‖ → HasSum (fun t => (z⁻¹ • J) ^ t) (∑' (t : ℕ), (z⁻¹ • J) ^ t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_neumann_inverse","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ) (M : ℝ),\n  (∀ (t : ℕ), ‖J ^ t‖ ≤ M) →\n    ∀ (z : ℂ), 1 < ‖z‖ → (1 - z⁻¹ • J) * ∑' (t : ℕ), (z⁻¹ • J) ^ t = 1 ∧ (∑' (t : ℕ), (z⁻¹ • J) ^ t) * (1 - z⁻¹ • J) = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_resolvent_eq","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ) (M : ℝ),\n  (∀ (t : ℕ), ‖J ^ t‖ ≤ M) →\n    ∀ (z : ℂ),\n      1 < ‖z‖ →\n        (z • 1 - J) * z⁻¹ • ∑' (t : ℕ), (z⁻¹ • J) ^ t = 1 ∧\n          (z⁻¹ • ∑' (t : ℕ), (z⁻¹ • J) ^ t) * (z • 1 - J) = 1 ∧ (z • 1 - J)⁻¹ = z⁻¹ • ∑' (t : ℕ), (z⁻¹ • J) ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_resolvent_isUnit","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ) (M : ℝ), (∀ (t : ℕ), ‖J ^ t‖ ≤ M) → ∀ (z : ℂ), 1 < ‖z‖ → IsUnit (z • 1 - J)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_resolvent_lower_bound","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ) (M : ℝ),\n  (∀ (t : ℕ), ‖J ^ t‖ ≤ M) → ∀ (z : ℂ), 1 < ‖z‖ → (‖z‖ - 1) * ‖(z • 1 - J)⁻¹‖ ≤ M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreissConstant_le_powerBound","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ),\n  BddAbove (Set.range fun t => ‖J ^ t‖) → CurrentMM.kreissConstant J ≤ CurrentMM.powerBound J"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_values_bddAbove","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ),\n  BddAbove (Set.range fun t => ‖J ^ t‖) → BddAbove (Set.range fun z => (‖↑z‖ - 1) * ‖(↑z • 1 - J)⁻¹‖)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.powerBound_pos","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ), 0 < n → BddAbove (Set.range fun t => ‖J ^ t‖) → 0 < CurrentMM.powerBound J"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.outputGain_one_eq_powerBound","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ), CurrentMM.outputGain 1 J = CurrentMM.powerBound J"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_bilateral_radius","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin n) ℂ),\n  0 < n →\n    ∀ (B : ℝ),\n      0 < B →\n        BddAbove (Set.range fun t => ‖J ^ t‖) →\n          CurrentMM.powerBound J ≤ Real.exp 1 * ↑n * CurrentMM.kreissConstant J →\n            0 < CurrentMM.kreissConstant J ∧\n              B / (Real.exp 1 * ↑n * CurrentMM.kreissConstant J) ≤ B / CurrentMM.powerBound J ∧\n                B / CurrentMM.powerBound J ≤ B / CurrentMM.kreissConstant J ∧\n                  IsGreatest\n                    {r |\n                      0 ≤ r ∧\n                        ∀ (z : EuclideanSpace ℂ (Fin n)), ‖z‖ ≤ r → ∀ (t : ℕ), ‖CurrentMM.l2Apply (1 * J ^ t) z‖ ≤ B}\n                    (B / CurrentMM.powerBound J)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_prior_variance_pos","type":"∀ (Q R : ℝ), 0 < Q → 0 < R → 0 < CurrentMM.trackingPriorVariance Q R"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_prior_variance_quadratic","type":"∀ (Q R : ℝ),\n  0 < Q → 0 < R → CurrentMM.trackingPriorVariance Q R ^ 2 - Q * CurrentMM.trackingPriorVariance Q R - Q * R = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_prior_variance_unique_positive","type":"∀ (Q R P : ℝ), 0 < Q → 0 < R → 0 < P → P ^ 2 - Q * P - Q * R = 0 → P = CurrentMM.trackingPriorVariance Q R"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_gain_unit_interval","type":"∀ (Q R : ℝ), 0 < Q → 0 < R → 0 < CurrentMM.trackingGain Q R ∧ CurrentMM.trackingGain Q R < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_prior_riccati_equation","type":"∀ (Q R : ℝ),\n  0 < Q →\n    0 < R →\n      CurrentMM.trackingPriorVariance Q R =\n        CurrentMM.trackingPriorVariance Q R -\n            CurrentMM.trackingPriorVariance Q R ^ 2 / (CurrentMM.trackingPriorVariance Q R + R) +\n          Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.tracking_gain_explicit_root","type":"∀ (Q R : ℝ), 0 < Q → 0 < R → CurrentMM.trackingGain Q R = (-Q + √(Q ^ 2 + 4 * Q * R)) / (2 * R)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ema_deviation_identity","type":"∀ (alpha oldAnchor price : ℝ), price - CurrentMM.emaUpdate alpha oldAnchor price = (1 - alpha) * (price - oldAnchor)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ema_next_deviation_identity","type":"∀ (alpha price oldAnchor increment : ℝ),\n  price + increment - CurrentMM.emaUpdate alpha oldAnchor (price + increment) =\n    (1 - alpha) * (price - oldAnchor + increment)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.allocation_loss_formula","type":"∀ (V0 b cost s0 delta : ℝ),\n  b ≠ 0 →\n    CurrentMM.allocationSurplusPrimitive V0 b cost (V0 - b * s0) -\n        CurrentMM.allocationSurplusPrimitive V0 b cost (V0 - b * (s0 + delta)) =\n      b * (s0 - cost) * delta + b * delta ^ 2 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.allocation_triangle_requires_efficient_baseline","type":"∀ (V0 b cost delta : ℝ),\n  b ≠ 0 →\n    CurrentMM.allocationSurplusPrimitive V0 b cost (V0 - b * cost) -\n        CurrentMM.allocationSurplusPrimitive V0 b cost (V0 - b * (cost + delta)) =\n      b * delta ^ 2 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ces_price_impact_inverse_demand","type":"∀ (vHat lam p q : ℝ),\n  0 < lam →\n    have qStar := (vHat - p) / lam;\n    vHat - lam * qStar = p ∧ vHat * q - lam * q ^ 2 / 2 - p * q ≤ vHat * qStar - lam * qStar ^ 2 / 2 - p * qStar"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.cara_market_clearing_linear_impact","type":"∀ (m_t p_t kappa q_S q_t u_t : ℝ),\n  0 < kappa →\n    have q_S_star := (p_t - m_t) / kappa;\n    q_S * (p_t - m_t) - kappa * q_S ^ 2 / 2 ≤ q_S_star * (p_t - m_t) - kappa * q_S_star ^ 2 / 2 ∧\n      (q_S_star = q_t + u_t ↔ p_t = m_t + kappa * (q_t + u_t))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.entry_mul_mono","type":"∀ {ι : Type u_1} {κ : Type u_2} {μ : Type u_3} [inst : Fintype κ] {P P' : Matrix ι κ ℝ} {Q Q' : Matrix κ μ ℝ},\n  CurrentMM.EntryNonneg P →\n    CurrentMM.EntryLE P P' →\n      CurrentMM.EntryNonneg Q →\n        CurrentMM.EntryLE Q Q' → CurrentMM.EntryNonneg (P * Q) ∧ CurrentMM.EntryLE (P * Q) (P' * Q')"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.entry_one_nonneg","type":"∀ {ι : Type u_1} [inst : DecidableEq ι], CurrentMM.EntryNonneg 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.entry_pow_mono","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {A A' : Matrix ι ι ℝ},\n  CurrentMM.EntryNonneg A →\n    CurrentMM.EntryLE A A' → ∀ (t : ℕ), CurrentMM.EntryNonneg (A ^ t) ∧ CurrentMM.EntryLE (A ^ t) (A' ^ t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.l2_opNorm_le_of_entry_bound","type":"∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [DecidableEq ι] [inst_3 : DecidableEq κ]\n  {𝕜 : Type u_4} [inst_4 : RCLike 𝕜] (P : Matrix ι κ 𝕜) (q : Matrix ι κ ℝ),\n  (∀ (i : ι) (j : κ), 0 ≤ q i j) → (∀ (i : ι) (j : κ), ‖P i j‖ ≤ q i j) → ‖P‖ ≤ ‖q.map ⇑(algebraMap ℝ 𝕜)‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.l2_opNorm_mono_of_entry","type":"∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [DecidableEq ι] [inst_3 : DecidableEq κ]\n  {P Q : Matrix ι κ ℝ}, CurrentMM.EntryNonneg P → CurrentMM.EntryLE P Q → ‖P‖ ≤ ‖Q‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.output_norm_mono","type":"∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [DecidableEq ι] [inst_3 : DecidableEq κ]\n  {C : Matrix ι κ ℝ} {J J' : Matrix κ κ ℝ},\n  CurrentMM.EntryNonneg C → CurrentMM.EntryNonneg J → CurrentMM.EntryLE J J' → ∀ (t : ℕ), ‖C * J ^ t‖ ≤ ‖C * J' ^ t‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.output_vector_mono","type":"∀ {ι : Type u_1} {κ : Type u_2} [Fintype ι] [inst : Fintype κ] [DecidableEq ι] [inst_2 : DecidableEq κ]\n  {C : Matrix ι κ ℝ} {J J' : Matrix κ κ ℝ},\n  CurrentMM.EntryNonneg C →\n    CurrentMM.EntryNonneg J →\n      CurrentMM.EntryLE J J' →\n        ∀ (z : κ → ℝ),\n          (∀ (j : κ), 0 ≤ z j) →\n            ∀ (t : ℕ) (i : ι), 0 ≤ (C * J ^ t).mulVec z i ∧ (C * J ^ t).mulVec z i ≤ (C * J' ^ t).mulVec z i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.peak_gain_mono","type":"∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [DecidableEq ι] [inst_3 : DecidableEq κ]\n  {C : Matrix ι κ ℝ} {J J' : Matrix κ κ ℝ},\n  CurrentMM.EntryNonneg C →\n    CurrentMM.EntryNonneg J →\n      CurrentMM.EntryLE J J' →\n        BddAbove (Set.range fun t => ‖C * J' ^ t‖) →\n          BddAbove (Set.range fun t => ‖C * J ^ t‖) ∧ ⨆ t, ‖C * J ^ t‖ ≤ ⨆ t, ‖C * J' ^ t‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_radius_contraction","type":"∀ {ι : Type u_1} {κ : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κ] [DecidableEq ι] [inst_3 : DecidableEq κ]\n  {C : Matrix ι κ ℝ} {J J' : Matrix κ κ ℝ},\n  CurrentMM.EntryNonneg C →\n    C ≠ 0 →\n      CurrentMM.EntryNonneg J →\n        CurrentMM.EntryLE J J' →\n          ∀ (B : ℝ), 0 < B → BddAbove (Set.range fun t => ‖C * J' ^ t‖) → B / ⨆ t, ‖C * J' ^ t‖ ≤ B / ⨆ t, ‖C * J ^ t‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.outputGain_mono","type":"∀ {m n : ℕ} {C : Matrix (Fin m) (Fin n) ℝ} {J J' : Matrix (Fin n) (Fin n) ℝ},\n  CurrentMM.EntryNonneg C →\n    CurrentMM.EntryNonneg J →\n      CurrentMM.EntryLE J J' →\n        BddAbove (Set.range fun t => ‖C * J' ^ t‖) → CurrentMM.outputGain C J ≤ CurrentMM.outputGain C J'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.multiJacobian_entry_mono","type":"∀ {d : ℕ} (a η q : Fin d → ℝ) (K K' : Matrix (Fin d) (Fin d) ℝ),\n  (∀ (i : Fin d), 0 ≤ a i) →\n    (∀ (i : Fin d), 0 ≤ η i) →\n      (∀ (i : Fin d), η i ≤ 1) →\n        (∀ (i : Fin d), 0 ≤ q i) →\n          CurrentMM.EntryNonneg K →\n            CurrentMM.EntryLE K K' →\n              CurrentMM.EntryNonneg (CurrentMM.multiJacobian a η q K) ∧\n                CurrentMM.EntryLE (CurrentMM.multiJacobian a η q K) (CurrentMM.multiJacobian a η q K')"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.cross_impact_exact_radius_contraction","type":"∀ {d : ℕ} {ο : Type u_4} [inst : Fintype ο] [DecidableEq ο] (a η q : Fin d → ℝ)\n  (Kdiag Kmulti : Matrix (Fin d) (Fin d) ℝ),\n  (∀ (i : Fin d), 0 ≤ a i) →\n    (∀ (i : Fin d), 0 ≤ η i) →\n      (∀ (i : Fin d), η i ≤ 1) →\n        (∀ (i : Fin d), 0 ≤ q i) →\n          CurrentMM.EntryNonneg Kdiag →\n            CurrentMM.EntryLE Kdiag Kmulti →\n              ∀ (C : Matrix ο (Fin d ⊕ Fin d) ℝ),\n                CurrentMM.EntryNonneg C →\n                  C ≠ 0 →\n                    ∀ (B : ℝ),\n                      0 < B →\n                        BddAbove (Set.range fun t => ‖C * CurrentMM.multiJacobian a η q Kmulti ^ t‖) →\n                          (∀ (t : ℕ),\n                              ‖C * CurrentMM.multiJacobian a η q Kdiag ^ t‖ ≤\n                                ‖C * CurrentMM.multiJacobian a η q Kmulti ^ t‖) ∧\n                            ⨆ t, ‖C * CurrentMM.multiJacobian a η q Kdiag ^ t‖ ≤\n                                ⨆ t, ‖C * CurrentMM.multiJacobian a η q Kmulti ^ t‖ ∧\n                              B / ⨆ t, ‖C * CurrentMM.multiJacobian a η q Kmulti ^ t‖ ≤\n                                B / ⨆ t, ‖C * CurrentMM.multiJacobian a η q Kdiag ^ t‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.neumann_partial_entry_mono","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {A A' : Matrix ι ι ℝ},\n  CurrentMM.EntryNonneg A →\n    CurrentMM.EntryLE A A' →\n      ∀ (N : ℕ) (r : ℝ),\n        0 < r →\n          CurrentMM.EntryNonneg (CurrentMM.neumannPartialResolvent N r A) ∧\n            CurrentMM.EntryLE (CurrentMM.neumannPartialResolvent N r A) (CurrentMM.neumannPartialResolvent N r A')"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.neumann_partial_opNorm_mono","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] {A A' : Matrix ι ι ℝ},\n  CurrentMM.EntryNonneg A →\n    CurrentMM.EntryLE A A' →\n      ∀ (N : ℕ) (r : ℝ),\n        1 < r →\n          ‖CurrentMM.neumannPartialResolvent N r A‖ ≤ ‖CurrentMM.neumannPartialResolvent N r A'‖ ∧\n            (r - 1) * ‖CurrentMM.neumannPartialResolvent N r A‖ ≤ (r - 1) * ‖CurrentMM.neumannPartialResolvent N r A'‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.cross_impact_conservative_radius_contraction","type":"∀ (B c_dim K_diag K_multi : ℝ),\n  0 < B → 0 < c_dim → 0 < K_diag → K_diag ≤ K_multi → B / (c_dim * K_multi) ≤ B / (c_dim * K_diag)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_arA_mul_arL","type":"∀ (n : ℕ) (s1 s0 : ℝ) (i j : Fin n),\n  (CurrentMM.arA n s1 * CurrentMM.arL n s0) i j =\n    CurrentMM.arL n s0 i j - if 0 < ↑i then s1 * CurrentMM.arL n s0 ⟨↑i - 1, ⋯⟩ j else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_arB_sub_one_aux","type":"∀ (n : ℕ) (s1 s0 : ℝ) (i j : Fin n),\n  (CurrentMM.arA n s1 * CurrentMM.arL n s0 - 1) i j = if j < i then (s0 - s1) * s0 ^ (↑i - 1 - ↑j) else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_arA_mul_arL_self","type":"∀ (n : ℕ) (s : ℝ), CurrentMM.arA n s * CurrentMM.arL n s = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_arB_lower","type":"∀ (n : ℕ) (s1 s0 : ℝ), (CurrentMM.arA n s1 * CurrentMM.arL n s0).IsLowerTriangular"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_arB_diag","type":"∀ (n : ℕ) (s1 s0 : ℝ) (i : Fin n), (CurrentMM.arA n s1 * CurrentMM.arL n s0) i i = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_range_cast_id","type":"∀ (n : ℕ), (∑ i ∈ Finset.range n, ↑i) * 2 = ↑n * (↑n - 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_ar_path_kl_le","type":"∀ (n : ℕ) (s0 s1 M : ℝ) (v : NNReal),\n  v ≠ 0 →\n    0 ≤ M →\n      (∀ k < n, s0 ^ (2 * k) ≤ M) →\n        InformationTheory.klDiv (CurrentMM.arPathLaw n s0 v) (CurrentMM.arPathLaw n s1 v) ≤\n          ENNReal.ofReal ((s1 - s0) ^ 2 * M * (↑n * (↑n - 1)) / 4)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pow_le_exp","type":"∀ (T k : ℕ), 0 < T → k ≤ T → ∀ (c : ℝ), 0 ≤ c → ∀ (s : ℝ), 0 ≤ s → s ≤ 1 + c / ↑T → s ^ (2 * k) ≤ Real.exp (2 * c)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_ar_window_kl","type":"∀ (T : ℕ),\n  0 < T →\n    ∀ (c0 : ℝ),\n      0 ≤ c0 →\n        ∀ (s0 s1 : ℝ),\n          0 ≤ s0 →\n            s0 ≤ 1 + c0 / ↑T →\n              |s1 - s0| ≤ c0 / ↑T →\n                ∀ (v : NNReal),\n                  v ≠ 0 →\n                    InformationTheory.klDiv (CurrentMM.arPathLaw T s0 v) (CurrentMM.arPathLaw T s1 v) ≤\n                      ENNReal.ofReal (c0 ^ 2 * Real.exp (2 * c0) / 4)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_event_gap_le","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A → ∀ (c : ℝ), 0 ≤ c → InformationTheory.klDiv P Q ≤ ENNReal.ofReal c → |P.real A - Q.real A| ≤ √(c / 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sqrt_window","type":"∀ (c0 : ℝ), 0 ≤ c0 → √(c0 ^ 2 * Real.exp (2 * c0) / 4 / 2) = c0 * Real.exp c0 / (2 * √2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_abstain","type":"∀ (T : ℕ),\n  0 < T →\n    ∀ (v : NNReal),\n      v ≠ 0 →\n        ∀ (α c0 : ℝ),\n          0 < c0 →\n            c0 < 1 →\n              ∀ (Stab Unst : Set (Fin T → ℝ)),\n                MeasurableSet Stab →\n                  MeasurableSet Unst →\n                    Disjoint Stab Unst →\n                      (∀ (s : ℝ), 0 < s → s < 1 → (CurrentMM.arPathLaw T s v).real Unst ≤ α) →\n                        (∀ (s : ℝ), 1 ≤ s → s < 2 → (CurrentMM.arPathLaw T s v).real Stab ≤ α) →\n                          ∀ (s : ℝ),\n                            1 - c0 / ↑T < s →\n                              s < 1 + c0 / ↑T →\n                                1 - 2 * α - c0 * Real.exp c0 / (2 * √2) ≤\n                                  (CurrentMM.arPathLaw T s v).real (Stab ∪ Unst)ᶜ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_abstain_binary","type":"∀ (T : ℕ),\n  0 < T →\n    ∀ (v : NNReal),\n      v ≠ 0 →\n        ∀ (Unst : Set (Fin T → ℝ)),\n          MeasurableSet Unst →\n            ∀ (ε : ℝ),\n              0 < ε →\n                ∃ s0 s1,\n                  0 < s0 ∧\n                    s0 < 1 ∧\n                      1 ≤ s1 ∧\n                        s1 < 2 ∧\n                          1 / 2 - ε ≤\n                            max ((CurrentMM.arPathLaw T s0 v).real Unst) ((CurrentMM.arPathLaw T s1 v).real Unstᶜ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_lyapunov_of_scalar","type":"∀ (l1 l2 θ s1 s2 V c vy : ℝ),\n  V = l1 ^ 2 * V + 2 * l1 * θ * c + θ ^ 2 * vy + s1 →\n    c = l1 * l2 * c + θ * l2 * vy →\n      vy = l2 ^ 2 * vy + s2 →\n        !![V, c; c, vy] =\n          CurrentMM.blindJ l1 l2 θ * !![V, c; c, vy] * (CurrentMM.blindJ l1 l2 θ).transpose + !![s1, 0; 0, s2]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_eigenvalues","type":"∀ (l1 l2 θ z : ℝ), (CurrentMM.blindJ l1 l2 θ - z • 1).det = (l1 - z) * (l2 - z)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_one_step_variance","type":"∀ (l1 l2 s1 V θ : ℝ), CurrentMM.blindS l1 l2 s1 V θ 0 0 = s1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_s2_nonneg","type":"∀ (l1 l2 s1 V θ : ℝ), 0 < l2 → l2 < l1 → l1 < 1 → s1 / (1 - l1 ^ 2) ≤ V → 0 ≤ CurrentMM.blindS2 l1 l2 s1 V θ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_lyapunov","type":"∀ (l1 l2 s1 V θ : ℝ),\n  0 < l2 →\n    l2 < l1 →\n      l1 < 1 →\n        θ ≠ 0 →\n          CurrentMM.blindSigma l1 l2 s1 V θ =\n              CurrentMM.blindJ l1 l2 θ * CurrentMM.blindSigma l1 l2 s1 V θ * (CurrentMM.blindJ l1 l2 θ).transpose +\n                CurrentMM.blindS l1 l2 s1 V θ ∧\n            CurrentMM.blindSigma l1 l2 s1 V θ 0 0 = V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blind_lyapunov_unique","type":"∀ (l1 l2 θ : ℝ) (S M1 M2 : Matrix (Fin 2) (Fin 2) ℝ),\n  0 < l2 →\n    l2 < l1 →\n      l1 < 1 →\n        M1 = CurrentMM.blindJ l1 l2 θ * M1 * (CurrentMM.blindJ l1 l2 θ).transpose + S →\n          M2 = CurrentMM.blindJ l1 l2 θ * M2 * (CurrentMM.blindJ l1 l2 θ).transpose + S → M1 = M2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_blind","type":"∀ (l1 l2 s1 V : ℝ),\n  0 < l2 →\n    l2 < l1 →\n      l1 < 1 →\n        s1 / (1 - l1 ^ 2) ≤ V →\n          ∀ (M : ℝ),\n            ∃ θ,\n              θ ≠ 0 ∧\n                (∀ (z : ℝ), (CurrentMM.blindJ l1 l2 θ - z • 1).det = (l1 - z) * (l2 - z)) ∧\n                  CurrentMM.blindS l1 l2 s1 V θ 0 0 = s1 ∧\n                    0 ≤ CurrentMM.blindS2 l1 l2 s1 V θ ∧\n                      (∀ (M' : Matrix (Fin 2) (Fin 2) ℝ),\n                          M' =\n                              CurrentMM.blindJ l1 l2 θ * M' * (CurrentMM.blindJ l1 l2 θ).transpose +\n                                CurrentMM.blindS l1 l2 s1 V θ →\n                            M' 0 0 = V) ∧\n                        M < |(CurrentMM.blindJ l1 l2 θ ^ 1) 0 1|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cohortKernel_differentiable","type":"∀ {n : ℕ} (m : ℕ), Differentiable ℝ fun θ => CurrentMM.cohortKernel (CurrentMM.qOf θ) (CurrentMM.rateOf θ) m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_differentiable","type":"∀ {n : ℕ} (a κ : ℝ) (j : ℕ),\n  Differentiable ℝ fun θ => CurrentMM.actualCohortImpulse a κ (CurrentMM.qOf θ) (CurrentMM.rateOf θ) j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_probeMean_line_deriv","type":"∀ {n : ℕ} (a κ V : ℝ) (T : ℕ) (θ0 d : Fin (n + n) → ℝ) (t : Fin T),\n  HasDerivAt (fun s => CurrentMM.p1ProbeMean a κ V T (θ0 + s • d) t) ((CurrentMM.p1ProbeJac a κ V T θ0).mulVec d t) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_cramer_rao_actual","type":"∀ {n : ℕ} (a κ V : ℝ) (T : ℕ) (θ0 : Fin (n + n) → ℝ),\n  IsUnit ((CurrentMM.p1ProbeJac a κ V T θ0).transpose * CurrentMM.p1ProbeJac a κ V T θ0).det →\n    ∀ (v : NNReal),\n      v ≠ 0 →\n        ∀ (S : CurrentMM.ObservationRecord T → ℝ),\n          MeasureTheory.MemLp S 2 (CurrentMM.gaussianRecordLaw T (CurrentMM.p1ProbeMean a κ V T θ0) v) →\n            ∀ (k : Fin (n + n)),\n              (∀ᶠ (θ : Fin (n + n) → ℝ) in nhds θ0,\n                  ∫ (x : CurrentMM.ObservationRecord T),\n                      S x ∂CurrentMM.gaussianRecordLaw T (CurrentMM.p1ProbeMean a κ V T θ) v =\n                    θ k) →\n                ↑v * ((CurrentMM.p1ProbeJac a κ V T θ0).transpose * CurrentMM.p1ProbeJac a κ V T θ0)⁻¹ k k ≤\n                  ProbabilityTheory.variance S (CurrentMM.gaussianRecordLaw T (CurrentMM.p1ProbeMean a κ V T θ0) v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rawJac_gram","type":"∀ {p T : ℕ} (N : ℕ) (V : ℝ) (J : Matrix (Fin T) (Fin p) ℝ),\n  (CurrentMM.rawJac N V J).transpose * CurrentMM.rawJac N V J = (↑N * V ^ 2) • (J.transpose * J)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rawMean_line_deriv","type":"∀ {p T : ℕ} (N : ℕ) (V : ℝ) (μh : (Fin p → ℝ) → Fin T → ℝ) (θ0 : Fin p → ℝ) (J : Matrix (Fin T) (Fin p) ℝ),\n  (∀ (a : Fin p → ℝ) (i : Fin T), HasDerivAt (fun s => μh (θ0 + s • a) i) (J.mulVec a i) 0) →\n    ∀ (a : Fin p → ℝ) (idx : Fin (N * T)),\n      HasDerivAt (fun s => CurrentMM.rawMean N V μh (θ0 + s • a) idx) ((CurrentMM.rawJac N V J).mulVec a idx) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_cramer_rao_raw","type":"∀ {p T : ℕ} (N : ℕ),\n  0 < N →\n    ∀ (V : ℝ),\n      V ≠ 0 →\n        ∀ (μh : (Fin p → ℝ) → Fin T → ℝ) (θ0 : Fin p → ℝ) (J : Matrix (Fin T) (Fin p) ℝ),\n          IsUnit (J.transpose * J).det →\n            ∀ (v : NNReal),\n              v ≠ 0 →\n                ∀ (S : CurrentMM.ObservationRecord (N * T) → ℝ),\n                  MeasureTheory.MemLp S 2 (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.rawMean N V μh θ0) v) →\n                    ∀ (k : Fin p),\n                      (∀ᶠ (θ : Fin p → ℝ) in nhds θ0,\n                          ∫ (x : CurrentMM.ObservationRecord (N * T)),\n                              S x ∂CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.rawMean N V μh θ) v =\n                            θ k) →\n                        (∀ (a : Fin p → ℝ) (i : Fin T), HasDerivAt (fun s => μh (θ0 + s • a) i) (J.mulVec a i) 0) →\n                          ↑v / (↑N * V ^ 2) * (J.transpose * J)⁻¹ k k ≤\n                            ProbabilityTheory.variance S\n                              (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.rawMean N V μh θ0) v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_cramer_rao_raw_actual","type":"∀ {n : ℕ} (a κ : ℝ) (T N : ℕ),\n  0 < N →\n    ∀ (V : ℝ),\n      V ≠ 0 →\n        ∀ (θ0 : Fin (n + n) → ℝ),\n          IsUnit ((CurrentMM.p1ProbeJac a κ 1 T θ0).transpose * CurrentMM.p1ProbeJac a κ 1 T θ0).det →\n            ∀ (v : NNReal),\n              v ≠ 0 →\n                ∀ (S : CurrentMM.ObservationRecord (N * T) → ℝ),\n                  MeasureTheory.MemLp S 2\n                      (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.rawMean N V (CurrentMM.p1ProbeMean a κ 1 T) θ0)\n                        v) →\n                    ∀ (k : Fin (n + n)),\n                      (∀ᶠ (θ : Fin (n + n) → ℝ) in nhds θ0,\n                          ∫ (x : CurrentMM.ObservationRecord (N * T)),\n                              S\n                                x ∂CurrentMM.gaussianRecordLaw (N * T)\n                                (CurrentMM.rawMean N V (CurrentMM.p1ProbeMean a κ 1 T) θ) v =\n                            θ k) →\n                        ↑v / (↑N * V ^ 2) *\n                            ((CurrentMM.p1ProbeJac a κ 1 T θ0).transpose * CurrentMM.p1ProbeJac a κ 1 T θ0)⁻¹ k k ≤\n                          ProbabilityTheory.variance S\n                            (CurrentMM.gaussianRecordLaw (N * T)\n                              (CurrentMM.rawMean N V (CurrentMM.p1ProbeMean a κ 1 T) θ0) v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_abs_sub_le","type":"∀ (x y : ℝ), |x - y| ≤ |x| + |y|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S_taylor","type":"∀ (r1 r2 : ℝ) (m : ℕ),\n  r2 ^ (m + 1) - r1 ^ (m + 1) - (↑m + 1) * r1 ^ m * (r2 - r1) = (r2 - r1) ^ 2 * CurrentMM.p1S r1 r2 (m + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_Q_cubic","type":"∀ (r1 r2 : ℝ) (m : ℕ),\n  r1 ^ (m + 1) - r2 ^ (m + 1) + (r2 - r1) / 2 * (↑m + 1) * (r1 ^ m + r2 ^ m) =\n    (r2 - r1) ^ 3 * CurrentMM.p1Q r1 r2 (m + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S_abs_le","type":"∀ (r1 r2 : ℝ), |r1| ≤ 1 → |r2| ≤ 1 → ∀ (m : ℕ), |CurrentMM.p1S r1 r2 m| ≤ ↑m ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_Q_abs_le","type":"∀ (r1 r2 : ℝ), |r1| ≤ 1 → |r2| ≤ 1 → ∀ (m : ℕ), |CurrentMM.p1Q r1 r2 m| ≤ ↑m ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2D_weak","type":"∀ (w1 w2 r1 r2 : ℝ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      ∀ (m : ℕ),\n        CurrentMM.p1K2D ![w1, w2, r1, r2] ![1, -1, (r2 - r1) / (2 * w1), (r2 - r1) / (2 * w2)] m =\n          (r2 - r1) ^ 3 * CurrentMM.p1Q r1 r2 m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_abs_le","type":"∀ (w1 w2 r1 r2 wm : ℝ),\n  0 ≤ w1 →\n    w1 ≤ wm →\n      0 ≤ w2 → w2 ≤ wm → 0 ≤ r1 → r1 ≤ 1 → 0 ≤ r2 → r2 ≤ 1 → ∀ (m : ℕ), |CurrentMM.p1K2 ![w1, w2, r1, r2] m| ≤ 2 * wm"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_weak_norm","type":"∀ (a κ κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  |κ| ≤ κm →\n    0 < w1 →\n      w1 ≤ wm →\n        0 < w2 →\n          w2 ≤ wm →\n            0 ≤ r1 →\n              r1 ≤ r2 →\n                r2 ≤ 1 →\n                  (CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).mulVec\n                        ![1, -1, (r2 - r1) / (2 * w1), (r2 - r1) / (2 * w2)] ⬝ᵥ\n                      (CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).mulVec\n                        ![1, -1, (r2 - r1) / (2 * w1), (r2 - r1) / (2 * w2)] ≤\n                    (↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2 * (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_U_ge","type":"∀ (r1 r2 : ℝ) (j : ℕ), 4 ≤ j → CurrentMM.p1U r1 r2 j = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_C_ge","type":"∀ (a κ : ℝ) (k u : ℕ → ℝ) (t : ℕ), 5 ≤ t → CurrentMM.p1C a κ k u t = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_C_zero","type":"∀ (a κ : ℝ) (k u : ℕ → ℝ), CurrentMM.p1C a κ k u 0 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_C_identity","type":"∀ (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (k k' u : ℕ → ℝ),\n      (∀ (j : ℕ), 4 ≤ j → u j = 0) →\n        ∑ t ∈ Finset.range 5, CurrentMM.p1C a κ k u t * CurrentMM.p1TapD a κ k k' t = ∑ m ∈ Finset.range 4, u m * k' m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_U_moment","type":"∀ (w1 w2 r1 r2 : ℝ) (i : Fin 4),\n  ∑ m ∈ Finset.range 4, CurrentMM.p1U r1 r2 m * CurrentMM.p1K2D ![w1, w2, r1, r2] (Pi.single i 1) m =\n    Pi.single 0 ((r2 - r1) ^ 3) i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_fin_range5","type":"∀ (T : ℕ), 4 ≤ T → ∀ (f : ℕ → ℝ), (∀ (n : ℕ), 5 ≤ n → f n = 0) → ∑ t, f ↑t = ∑ n ∈ Finset.range 5, f n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapJac_entry","type":"∀ (a κ : ℝ) (T : ℕ) (θ0 : Fin 4 → ℝ) (t : Fin (T + 1)) (i : Fin 4),\n  CurrentMM.p1TapJac a κ T θ0 t i = CurrentMM.p1TapD a κ (CurrentMM.p1K2 θ0) (CurrentMM.p1K2D θ0 (Pi.single i 1)) ↑t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_recover","type":"∀ (a κ w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    κ ≠ 0 →\n      r2 - r1 ≠ 0 →\n        ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose.mulVec fun t =>\n            CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r1 r2) ↑t / (r2 - r1) ^ 3) =\n          Pi.single 0 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_injective","type":"∀ (a κ w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    κ ≠ 0 →\n      w1 ≠ 0 →\n        w2 ≠ 0 → r2 - r1 ≠ 0 → ∀ (x : Fin 4 → ℝ), (CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).mulVec x = 0 → x = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_isUnit","type":"∀ (a κ w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    κ ≠ 0 →\n      w1 ≠ 0 →\n        w2 ≠ 0 →\n          r2 - r1 ≠ 0 →\n            IsUnit\n              ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose * CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).det"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_U_abs_le","type":"∀ (r1 r2 : ℝ), 0 ≤ r1 → r1 ≤ 1 → 0 ≤ r2 → r2 ≤ 1 → ∀ (j : ℕ), |CurrentMM.p1U r1 r2 j| ≤ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_E_abs_le","type":"∀ (a κ : ℝ) (k : ℕ → ℝ) (P Q : ℝ),\n  |a + κ * k 0| ≤ P →\n    |κ * k 1| ≤ Q → |κ * k 2| ≤ Q → ∀ (j : ℕ), |CurrentMM.p1E a κ k j| ≤ 1 + 2 * P + P ^ 2 + 2 * Q + 2 * P * Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_C_abs_le","type":"∀ (a κ κmin : ℝ) (k u : ℕ → ℝ) (Z U : ℝ),\n  0 < κmin →\n    κmin ≤ |κ| →\n      (∀ (j : ℕ), |CurrentMM.p1E a κ k j| ≤ Z) →\n        (∀ (j : ℕ), |u j| ≤ U) → ∀ (t : ℕ), |CurrentMM.p1C a κ k u t| ≤ 4 * (Z * U) / κmin ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_b_norm","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 ≤ w1 →\n            w1 ≤ wm →\n              0 ≤ w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ 1 →\n                        ((fun t =>\n                              CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r1 r2) ↑t /\n                                (r2 - r1) ^ 3) ⬝ᵥ\n                            fun t =>\n                            CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r1 r2) ↑t /\n                              (r2 - r1) ^ 3) ≤\n                          5 *\n                              (4 *\n                                    ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                        2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                      6) /\n                                  κmin ^ 2 *\n                                (4 *\n                                    ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                        2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                      6) /\n                                  κmin ^ 2)) /\n                            (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_lower","type":"∀ (a κ κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    κ ≠ 0 →\n      |κ| ≤ κm →\n        0 < w1 →\n          w1 ≤ wm →\n            0 < w2 →\n              w2 ≤ wm →\n                0 ≤ r1 →\n                  r1 < r2 →\n                    r2 ≤ 1 →\n                      1 ≤\n                        ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                  CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                              0 0 *\n                            (r2 - r1) ^ 6 *\n                          ((↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_upper","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ 1 →\n                        ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                  CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                              0 0 *\n                            (r2 - r1) ^ 6 ≤\n                          5 *\n                            (4 *\n                                  ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                      2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                    6) /\n                                κmin ^ 2 *\n                              (4 *\n                                  ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                      2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                    6) /\n                                κmin ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_S7_1_iii","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ 1 →\n                        IsUnit\n                            ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).det ∧\n                          0 < (↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2 ∧\n                            1 / ((↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2) / (r2 - r1) ^ 6 ≤\n                                ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                      CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                  0 0 ∧\n                              ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                      CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                  0 0 ≤\n                                5 *\n                                    (4 *\n                                          ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                2 * (κm * (2 * wm)) +\n                                              2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                            6) /\n                                        κmin ^ 2 *\n                                      (4 *\n                                          ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                2 * (κm * (2 * wm)) +\n                                              2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                            6) /\n                                        κmin ^ 2)) /\n                                  (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_etaToR_line","type":"∀ (θ x : Fin 4 → ℝ) (s : ℝ), CurrentMM.p1EtaToR (θ + s • x) = CurrentMM.p1EtaToR θ + s • CurrentMM.p1D.mulVec x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapEta_line_deriv","type":"∀ (a κ : ℝ) (T : ℕ) (θ0 x : Fin 4 → ℝ) (t : Fin (T + 1)),\n  HasDerivAt (fun s => CurrentMM.p1TapW a κ (CurrentMM.p1EtaToR (θ0 + s • x)) ↑t)\n    ((CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR θ0) * CurrentMM.p1D).mulVec x t) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_D_mul_D","type":"CurrentMM.p1D * CurrentMM.p1D = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_D_transpose","type":"CurrentMM.p1D.transpose = CurrentMM.p1D"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_D_det","type":"CurrentMM.p1D.det = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fisher_eta_entry","type":"∀ {n : ℕ} (J : Matrix (Fin n) (Fin 4) ℝ),\n  IsUnit (J.transpose * J).det →\n    IsUnit ((J * CurrentMM.p1D).transpose * (J * CurrentMM.p1D)).det ∧\n      ((J * CurrentMM.p1D).transpose * (J * CurrentMM.p1D))⁻¹ 0 0 = (J.transpose * J)⁻¹ 0 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_etaToR_eval","type":"∀ (w1 w2 e1 e2 : ℝ), CurrentMM.p1EtaToR ![w1, w2, e1, e2] = ![w1, w2, 1 - e1, 1 - e2]"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_S7_1_iii_eta","type":"∀ (a κ κmin κm wm w1 w2 e1 e2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ e2 →\n                    e2 < e1 →\n                      e1 ≤ 1 →\n                        IsUnit\n                            ((CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) *\n                                    CurrentMM.p1D).transpose *\n                                (CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) * CurrentMM.p1D)).det ∧\n                          1 / ((↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2) / (e1 - e2) ^ 6 ≤\n                              ((CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) *\n                                        CurrentMM.p1D).transpose *\n                                    (CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) * CurrentMM.p1D))⁻¹\n                                0 0 ∧\n                            ((CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) *\n                                        CurrentMM.p1D).transpose *\n                                    (CurrentMM.p1TapJac a κ T (CurrentMM.p1EtaToR ![w1, w2, e1, e2]) * CurrentMM.p1D))⁻¹\n                                0 0 ≤\n                              5 *\n                                  (4 *\n                                        ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                              2 * (κm * (2 * wm)) +\n                                            2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                          6) /\n                                      κmin ^ 2 *\n                                    (4 *\n                                        ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                              2 * (κm * (2 * wm)) +\n                                            2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                          6) /\n                                      κmin ^ 2)) /\n                                (e1 - e2) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_U_moment_swap","type":"∀ (w1 w2 r1 r2 : ℝ) (i : Fin 4),\n  ∑ m ∈ Finset.range 4, CurrentMM.p1U r2 r1 m * CurrentMM.p1K2D ![w1, w2, r1, r2] (Pi.single i 1) m =\n    Pi.single 1 ((r1 - r2) ^ 3) i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_recover_two","type":"∀ (a κ w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    κ ≠ 0 →\n      r1 - r2 ≠ 0 →\n        ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose.mulVec fun t =>\n            CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r2 r1) ↑t / (r1 - r2) ^ 3) =\n          Pi.single 1 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_b_norm_two","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 ≤ w1 →\n            w1 ≤ wm →\n              0 ≤ w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ 1 →\n                        ((fun t =>\n                              CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r2 r1) ↑t /\n                                (r1 - r2) ^ 3) ⬝ᵥ\n                            fun t =>\n                            CurrentMM.p1C a κ (CurrentMM.p1K2 ![w1, w2, r1, r2]) (CurrentMM.p1U r2 r1) ↑t /\n                              (r1 - r2) ^ 3) ≤\n                          5 *\n                              (4 *\n                                    ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                        2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                      6) /\n                                  κmin ^ 2 *\n                                (4 *\n                                    ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 + 2 * (κm * (2 * wm)) +\n                                        2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                      6) /\n                                  κmin ^ 2)) /\n                            (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_S7_1_iii_two","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ 1 →\n                        1 / ((↑T + 1) * (↑T ^ 3 * CurrentMM.p1TapG |a| κm (2 * wm) T) ^ 2) / (r2 - r1) ^ 6 ≤\n                            ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                  CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                              1 1 ∧\n                          ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                  CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                              1 1 ≤\n                            5 *\n                                (4 *\n                                      ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                            2 * (κm * (2 * wm)) +\n                                          2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                        6) /\n                                    κmin ^ 2 *\n                                  (4 *\n                                      ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                            2 * (κm * (2 * wm)) +\n                                          2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                        6) /\n                                    κmin ^ 2)) /\n                              (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_alg","type":"∀ (w1 w2 r1 r2 x : ℂ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      1 - r1 * x ≠ 0 →\n        1 - r2 * x ≠ 0 →\n          (1 * (1 - r1 * x) - w1 * -(1 * ((r2 - r1) / (2 * w1)) * x)) / (1 - r1 * x) ^ 2 +\n              (-1 * (1 - r2 * x) - w2 * -(1 * ((r2 - r1) / (2 * w2)) * x)) / (1 - r2 * x) ^ 2 =\n            (r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - r1 * x) ^ 2 * (1 - r2 * x) ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_dirDeriv","type":"∀ (w1 w2 r1 r2 x : ℂ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      1 - r1 * x ≠ 0 →\n        1 - r2 * x ≠ 0 →\n          HasDerivAt\n            (fun s =>\n              (w1 + s) / (1 - (r1 + s * ((r2 - r1) / (2 * w1))) * x) +\n                (w2 - s) / (1 - (r2 + s * ((r2 - r1) / (2 * w2))) * x))\n            ((r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - r1 * x) ^ 2 * (1 - r2 * x) ^ 2)) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_dirDeriv_real","type":"∀ (w1 w2 r1 r2 : ℝ) (x : ℂ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      1 - ↑r1 * x ≠ 0 →\n        1 - ↑r2 * x ≠ 0 →\n          HasDerivAt\n            (fun s =>\n              ↑(w1 + s) / (1 - ↑(r1 + s * ((r2 - r1) / (2 * w1))) * x) +\n                ↑(w2 - s) / (1 - ↑(r2 + s * ((r2 - r1) / (2 * w2))) * x))\n            (↑(r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - ↑r1 * x) ^ 2 * (1 - ↑r2 * x) ^ 2)) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_moment_dirDeriv","type":"∀ (w1 w2 r1 r2 : ℝ) (m : ℕ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      HasDerivAt\n        (fun s => (w1 + s) * (r1 + s * ((r2 - r1) / (2 * w1))) ^ m + (w2 - s) * (r2 + s * ((r2 - r1) / (2 * w2))) ^ m)\n        (r1 ^ m - r2 ^ m + (r2 - r1) / 2 * ↑m * (r1 ^ (m - 1) + r2 ^ (m - 1))) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_moment_cancel","type":"∀ (r1 r2 : ℝ),\n  r1 ^ 0 - r2 ^ 0 + (r2 - r1) / 2 * ↑0 * (r1 ^ (0 - 1) + r2 ^ (0 - 1)) = 0 ∧\n    r1 ^ 1 - r2 ^ 1 + (r2 - r1) / 2 * ↑1 * (r1 ^ (1 - 1) + r2 ^ (1 - 1)) = 0 ∧\n      r1 ^ 2 - r2 ^ 2 + (r2 - r1) / 2 * ↑2 * (r1 ^ (2 - 1) + r2 ^ (2 - 1)) = 0 ∧\n        r1 ^ 3 - r2 ^ 3 + (r2 - r1) / 2 * ↑3 * (r1 ^ (3 - 1) + r2 ^ (3 - 1)) = (r2 - r1) ^ 3 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_one_sub_mul_norm_ge","type":"∀ (r x : ℂ) (ρ : ℝ), ‖r‖ ≤ ρ → ‖x‖ ≤ 1 → 1 - ρ ≤ ‖1 - r * x‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_dirDeriv_bound","type":"∀ (r1 r2 x : ℂ),\n  ∀ ρ < 1,\n    ‖r1‖ ≤ ρ →\n      ‖r2‖ ≤ ρ →\n        ‖x‖ ≤ 1 →\n          ‖(r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - r1 * x) ^ 2 * (1 - r2 * x) ^ 2)‖ ≤ ‖r2 - r1‖ ^ 3 / (2 * (1 - ρ) ^ 4)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_H2_deriv_alg","type":"∀ (κ x X E : ℂ), X ≠ 0 → (0 - κ * -(κ * x * E)) / X ^ 2 = x * (κ / X) ^ 2 * E"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_H2_dirDeriv","type":"∀ (a κ w1 w2 r1 r2 x : ℂ),\n  w1 ≠ 0 →\n    w2 ≠ 0 →\n      1 - r1 * x ≠ 0 →\n        1 - r2 * x ≠ 0 →\n          1 - a * x - κ * x * (w1 / (1 - r1 * x) + w2 / (1 - r2 * x)) ≠ 0 →\n            HasDerivAt\n              (fun s =>\n                κ /\n                  (1 - a * x -\n                    κ * x *\n                      ((w1 + s) / (1 - (r1 + s * ((r2 - r1) / (2 * w1))) * x) +\n                        (w2 - s) / (1 - (r2 + s * ((r2 - r1) / (2 * w2))) * x))))\n              (x * (κ / (1 - a * x - κ * x * (w1 / (1 - r1 * x) + w2 / (1 - r2 * x)))) ^ 2 *\n                ((r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - r1 * x) ^ 2 * (1 - r2 * x) ^ 2)))\n              0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_norm_le","type":"∀ (w1 w2 : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      ∀ (r1 r2 x : ℂ),\n        ∀ ρ < 1, ‖r1‖ ≤ ρ → ‖r2‖ ≤ ρ → ‖x‖ ≤ 1 → ‖↑w1 / (1 - r1 * x) + ↑w2 / (1 - r2 * x)‖ ≤ (w1 + w2) / (1 - ρ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_H2_den_norm_ge","type":"∀ (a κ w1 w2 : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      ∀ (r1 r2 x : ℂ) (ρ s : ℝ),\n        ρ < 1 →\n          ‖r1‖ ≤ ρ →\n            ‖r2‖ ≤ ρ →\n              ‖x‖ ≤ 1 →\n                |a| + |κ| * ((w1 + w2) / (1 - ρ)) ≤ s →\n                  1 - s ≤ ‖1 - ↑a * x - ↑κ * x * (↑w1 / (1 - r1 * x) + ↑w2 / (1 - r2 * x))‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_H2_norm_le","type":"∀ (a κ w1 w2 : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      ∀ (r1 r2 x : ℂ) (ρ s : ℝ),\n        ρ < 1 →\n          s < 1 →\n            ‖r1‖ ≤ ρ →\n              ‖r2‖ ≤ ρ →\n                ‖x‖ ≤ 1 →\n                  |a| + |κ| * ((w1 + w2) / (1 - ρ)) ≤ s →\n                    ‖↑κ / (1 - ↑a * x - ↑κ * x * (↑w1 / (1 - r1 * x) + ↑w2 / (1 - r2 * x)))‖ ≤ |κ| / (1 - s)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_H2_dirDeriv_bound","type":"∀ (a κ w1 w2 : ℝ),\n  0 ≤ w1 →\n    0 ≤ w2 →\n      ∀ (r1 r2 x : ℂ) (ρ s : ℝ),\n        ρ < 1 →\n          s < 1 →\n            ‖r1‖ ≤ ρ →\n              ‖r2‖ ≤ ρ →\n                ‖x‖ ≤ 1 →\n                  |a| + |κ| * ((w1 + w2) / (1 - ρ)) ≤ s →\n                    ‖x * (↑κ / (1 - ↑a * x - ↑κ * x * (↑w1 / (1 - r1 * x) + ↑w2 / (1 - r2 * x)))) ^ 2 *\n                          ((r2 - r1) ^ 3 * x ^ 3 / (2 * (1 - r1 * x) ^ 2 * (1 - r2 * x) ^ 2))‖ ≤\n                      (|κ| / (1 - s)) ^ 2 * (‖r2 - r1‖ ^ 3 / (2 * (1 - ρ) ^ 4))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tap_zero","type":"∀ (a κ : ℝ) (k : ℕ → ℝ), CurrentMM.p1Tap a κ k 0 = κ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tap_succ","type":"∀ (a κ : ℝ) (k : ℕ → ℝ) (j : ℕ),\n  CurrentMM.p1Tap a κ k (j + 1) =\n    a * CurrentMM.p1Tap a κ k j + κ * ∑ m ∈ Finset.range (j + 1), k m * CurrentMM.p1Tap a κ k (j - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_actual_eq_tap","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ) (j : ℕ),\n  CurrentMM.actualCohortImpulse a κ q rate j = CurrentMM.p1Tap a κ (CurrentMM.cohortKernel q rate) j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cohortKernel_two","type":"∀ (q rate : Fin 2 → ℝ) (m : ℕ),\n  CurrentMM.cohortKernel q rate m = CurrentMM.p1K2 ![q 0 * rate 0, q 1 * rate 1, 1 - rate 0, 1 - rate 1] m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_actual_two_eq_tapW","type":"∀ (a κ : ℝ) (q rate : Fin 2 → ℝ) (j : ℕ),\n  CurrentMM.actualCohortImpulse a κ q rate j =\n    CurrentMM.p1TapW a κ ![q 0 * rate 0, q 1 * rate 1, 1 - rate 0, 1 - rate 1] j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_differentiable","type":"∀ (m : ℕ), Differentiable ℝ fun θ => CurrentMM.p1K2 θ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapW_differentiable","type":"∀ (a κ : ℝ) (j : ℕ), Differentiable ℝ fun θ => CurrentMM.p1TapW a κ θ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapJac_line_deriv","type":"∀ (a κ : ℝ) (T : ℕ) (θ0 x : Fin 4 → ℝ) (t : Fin (T + 1)),\n  HasDerivAt (fun s => CurrentMM.p1TapW a κ (θ0 + s • x) ↑t) ((CurrentMM.p1TapJac a κ T θ0).mulVec x t) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_line_deriv","type":"∀ (θ0 x : Fin 4 → ℝ) (m : ℕ), HasDerivAt (fun s => CurrentMM.p1K2 (θ0 + s • x) m) (CurrentMM.p1K2D θ0 x m) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapD_zero","type":"∀ (a κ : ℝ) (k k' : ℕ → ℝ), CurrentMM.p1TapD a κ k k' 0 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapD_succ","type":"∀ (a κ : ℝ) (k k' : ℕ → ℝ) (j : ℕ),\n  CurrentMM.p1TapD a κ k k' (j + 1) =\n    a * CurrentMM.p1TapD a κ k k' j +\n      κ * ∑ m ∈ Finset.range (j + 1), (k' m * CurrentMM.p1Tap a κ k (j - m) + k m * CurrentMM.p1TapD a κ k k' (j - m))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tap_hasDerivAt","type":"∀ (a κ : ℝ) (k : ℝ → ℕ → ℝ) (k' : ℕ → ℝ),\n  (∀ (m : ℕ), HasDerivAt (fun s => k s m) (k' m) 0) →\n    ∀ (j : ℕ), HasDerivAt (fun s => CurrentMM.p1Tap a κ (k s) j) (CurrentMM.p1TapD a κ (k 0) k' j) 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapJac_mulVec","type":"∀ (a κ : ℝ) (T : ℕ) (θ0 x : Fin 4 → ℝ) (t : Fin (T + 1)),\n  (CurrentMM.p1TapJac a κ T θ0).mulVec x t = CurrentMM.p1TapD a κ (CurrentMM.p1K2 θ0) (CurrentMM.p1K2D θ0 x) ↑t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapM_nonneg","type":"∀ (A κm K0 : ℝ), 0 ≤ A → 0 ≤ κm → 0 ≤ K0 → ∀ (j : ℕ), 0 ≤ CurrentMM.p1TapM A κm K0 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapG_nonneg","type":"∀ (A κm K0 : ℝ), 0 ≤ A → 0 ≤ κm → 0 ≤ K0 → ∀ (j : ℕ), 0 ≤ CurrentMM.p1TapG A κm K0 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tap_abs_le","type":"∀ (a κ : ℝ) (k : ℕ → ℝ) (κm K0 : ℝ),\n  |κ| ≤ κm →\n    0 ≤ K0 → (∀ (m : ℕ), |k m| ≤ K0) → ∀ (j s : ℕ), s ≤ j → |CurrentMM.p1Tap a κ k s| ≤ CurrentMM.p1TapM |a| κm K0 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapD_abs_le","type":"∀ (a κ : ℝ) (k k' : ℕ → ℝ) (κm K0 E : ℝ) (N : ℕ),\n  |κ| ≤ κm →\n    0 ≤ K0 →\n      0 ≤ E →\n        (∀ (m : ℕ), |k m| ≤ K0) →\n          (∀ m < N, |k' m| ≤ E) → ∀ j ≤ N, ∀ s ≤ j, |CurrentMM.p1TapD a κ k k' s| ≤ E * CurrentMM.p1TapG |a| κm K0 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_geom_sum_le_inv","type":"∀ (q : ℝ), 0 ≤ q → q < 1 → ∀ (n : ℕ), ∑ m ∈ Finset.range n, q ^ m ≤ 1 / (1 - q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_conv_geom_le","type":"∀ (ρ θ : ℝ), 0 ≤ ρ → ρ < θ → ∀ (j : ℕ), ∑ m ∈ Finset.range (j + 1), ρ ^ m * θ ^ (j - m) ≤ θ ^ (j + 1) / (θ - ρ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lin_rec_geom","type":"∀ (y c f : ℕ → ℝ) (ρ θ X F : ℝ),\n  0 ≤ ρ →\n    0 ≤ θ →\n      (∀ (j : ℕ), y (j + 1) = c j * y j + f j) →\n        (∀ (j : ℕ), |c j| ≤ ρ) →\n          (∀ (j : ℕ), |f j| ≤ F * θ ^ (j + 1)) → |y 0| ≤ X → ρ * X + F * θ ≤ X * θ → ∀ (j : ℕ), |y j| ≤ X * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lin_geom","type":"∀ (θ θ' : ℝ), 0 ≤ θ → θ < θ' → ∀ (j : ℕ), ↑j * θ ^ j ≤ θ' / (θ' - θ) * θ' ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_P_geom","type":"∀ (r1 ρ θ : ℝ), |r1| ≤ ρ → 0 ≤ ρ → ρ < θ → ∀ (j : ℕ), |(↑j + 1) * r1 ^ j| ≤ θ / (θ - ρ) * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S_geom","type":"∀ (r1 r2 ρ θ : ℝ),\n  |r1| ≤ ρ → |r2| ≤ ρ → 0 ≤ ρ → ρ < θ → ∀ (j : ℕ), |CurrentMM.p1S r1 r2 (j + 1)| ≤ θ / (θ - ρ) ^ 2 * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_Q_geom2","type":"∀ (r1 r2 ρ θ : ℝ),\n  |r1| ≤ ρ → |r2| ≤ ρ → 0 ≤ ρ → ρ < θ → ∀ (j : ℕ), |CurrentMM.p1Q r1 r2 (j + 2)| ≤ θ ^ 2 / (2 * (θ - ρ) ^ 3) * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_Q_geom","type":"∀ (r1 r2 ρ θ : ℝ), |r1| ≤ ρ → |r2| ≤ ρ → 0 ≤ ρ → ρ < θ → ∀ (m : ℕ), |CurrentMM.p1Q r1 r2 m| ≤ θ ^ m / (2 * (θ - ρ) ^ 3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_K2_abs_geom","type":"∀ (w1 w2 r1 r2 wm ρ : ℝ),\n  0 ≤ w1 →\n    w1 ≤ wm →\n      0 ≤ w2 →\n        w2 ≤ wm → 0 ≤ r1 → r1 ≤ ρ → 0 ≤ r2 → r2 ≤ ρ → ∀ (m : ℕ), |CurrentMM.p1K2 ![w1, w2, r1, r2] m| ≤ 2 * wm * ρ ^ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tap_abs_geom","type":"∀ (a κ : ℝ) (k : ℕ → ℝ) (κm K ρ θ : ℝ),\n  |κ| ≤ κm →\n    0 ≤ K →\n      0 ≤ ρ →\n        ρ < θ →\n          (∀ (m : ℕ), |k m| ≤ K * ρ ^ m) →\n            |a| + κm * K * θ / (θ - ρ) ≤ θ → ∀ (j : ℕ), |CurrentMM.p1Tap a κ k j| ≤ κm * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tapD_abs_geom","type":"∀ (a κ : ℝ) (k k' : ℕ → ℝ) (κm K ρ θ E θ1 : ℝ),\n  |κ| ≤ κm →\n    0 ≤ K →\n      0 ≤ ρ →\n        ρ < θ →\n          0 ≤ θ1 →\n            θ1 < θ →\n              0 ≤ E →\n                (∀ (m : ℕ), |k m| ≤ K * ρ ^ m) →\n                  (∀ (m : ℕ), |k' m| ≤ E * θ1 ^ m) →\n                    |a| + κm * K * θ / (θ - ρ) ≤ θ →\n                      ∀ (j : ℕ), |CurrentMM.p1TapD a κ k k' j| ≤ κm ^ 2 * E / (θ - θ1) * ↑j * θ ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_S71iii_weak_norm_uniform","type":"∀ (a κ κm wm w1 w2 r1 r2 ρ θ1 θ θ' : ℝ) (T : ℕ),\n  |κ| ≤ κm →\n    0 < w1 →\n      w1 ≤ wm →\n        0 < w2 →\n          w2 ≤ wm →\n            0 ≤ r1 →\n              r1 ≤ r2 →\n                r2 ≤ ρ →\n                  ρ < θ1 →\n                    θ1 < θ →\n                      θ < θ' →\n                        θ' < 1 →\n                          |a| + κm * (2 * wm) * θ / (θ - ρ) ≤ θ →\n                            (CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).mulVec\n                                  ![1, -1, (r2 - r1) / (2 * w1), (r2 - r1) / (2 * w2)] ⬝ᵥ\n                                (CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).mulVec\n                                  ![1, -1, (r2 - r1) / (2 * w1), (r2 - r1) / (2 * w2)] ≤\n                              (κm ^ 2 * (1 / (2 * (θ1 - ρ) ^ 3)) / (θ - θ1) * (θ' / (θ' - θ))) ^ 2 / (1 - θ' ^ 2) *\n                                (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_unifB_eq","type":"∀ (κm ρ θ : ℝ),\n  ρ < θ →\n    θ < 1 →\n      0 ≤ θ →\n        (κm ^ 2 * (1 / (2 * ((ρ + θ) / 2 - ρ) ^ 3)) / (θ - (ρ + θ) / 2) * ((1 + θ) / 2 / ((1 + θ) / 2 - θ))) ^ 2 /\n            (1 - ((1 + θ) / 2) ^ 2) =\n          CurrentMM.p1UnifB κm ρ θ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_S7_1_iii_uniform","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 ρ θ : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ ρ →\n                        ρ < θ →\n                          θ < 1 →\n                            |a| + κm * (2 * wm) * θ / (θ - ρ) ≤ θ →\n                              0 < CurrentMM.p1UnifB κm ρ θ ∧\n                                1 / CurrentMM.p1UnifB κm ρ θ / (r2 - r1) ^ 6 ≤\n                                    ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                          CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                      0 0 ∧\n                                  ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                          CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                      0 0 ≤\n                                    5 *\n                                        (4 *\n                                              ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                    2 * (κm * (2 * wm)) +\n                                                  2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                                6) /\n                                            κmin ^ 2 *\n                                          (4 *\n                                              ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                    2 * (κm * (2 * wm)) +\n                                                  2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                                6) /\n                                            κmin ^ 2)) /\n                                      (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_S7_1_iii_two_uniform","type":"∀ (a κ κmin κm wm w1 w2 r1 r2 ρ θ : ℝ) (T : ℕ),\n  4 ≤ T →\n    0 < κmin →\n      κmin ≤ |κ| →\n        |κ| ≤ κm →\n          0 < w1 →\n            w1 ≤ wm →\n              0 < w2 →\n                w2 ≤ wm →\n                  0 ≤ r1 →\n                    r1 < r2 →\n                      r2 ≤ ρ →\n                        ρ < θ →\n                          θ < 1 →\n                            |a| + κm * (2 * wm) * θ / (θ - ρ) ≤ θ →\n                              1 / CurrentMM.p1UnifB κm ρ θ / (r2 - r1) ^ 6 ≤\n                                  ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                        CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                    1 1 ∧\n                                ((CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2]).transpose *\n                                        CurrentMM.p1TapJac a κ T ![w1, w2, r1, r2])⁻¹\n                                    1 1 ≤\n                                  5 *\n                                      (4 *\n                                            ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                  2 * (κm * (2 * wm)) +\n                                                2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                              6) /\n                                          κmin ^ 2 *\n                                        (4 *\n                                            ((1 + 2 * (|a| + κm * (2 * wm)) + (|a| + κm * (2 * wm)) ^ 2 +\n                                                  2 * (κm * (2 * wm)) +\n                                                2 * (|a| + κm * (2 * wm)) * (κm * (2 * wm))) *\n                                              6) /\n                                          κmin ^ 2)) /\n                                    (r2 - r1) ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pair_tap2_gap","type":"∀ (a κ q η δ : ℝ),\n  CurrentMM.actualCohortImpulse a κ ![q / 2, q / 2] ![η - δ, η + δ] 2 - CurrentMM.actualCohortImpulse a κ ![q] ![η] 2 =\n    -(κ ^ 2 * q * δ ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pulse_record_coord","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ) (A : ℝ) (t : ℕ),\n  (CurrentMM.controlledCohortRun a κ q rate (CurrentMM.pulseProbe A) (t + 1)).price =\n    A * CurrentMM.actualCohortImpulse a κ q rate t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_record_coord_two","type":"∀ (T : ℕ) (mean : Fin (T + 3) → ℝ) (v : NNReal) (S : Set ℝ),\n  (CurrentMM.gaussianRecordLaw (T + 3) mean v) {x | x.2.2.1 ∈ S} = (ProbabilityTheory.gaussianReal (mean 2) v) S"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussian_Iio_shift","type":"∀ (μ m : ℝ) (v : NNReal),\n  (ProbabilityTheory.gaussianReal μ v) (Set.Iio m) = (ProbabilityTheory.gaussianReal 0 v) (Set.Iio (m - μ))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussian_Ici_shift","type":"∀ (μ m : ℝ) (v : NNReal),\n  (ProbabilityTheory.gaussianReal μ v) (Set.Ici m) = (ProbabilityTheory.gaussianReal 0 v) (Set.Ici (m - μ))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussian_Ici_symm","type":"∀ (c : ℝ) (v : NNReal),\n  (ProbabilityTheory.gaussianReal 0 v) (Set.Ici c) = (ProbabilityTheory.gaussianReal 0 v) (Set.Iic (-c))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_converse_errors","type":"∀ (a κ q η δ A μ0 D : ℝ) (T : ℕ) (v : NNReal),\n  μ0 = A * CurrentMM.actualCohortImpulse a κ ![q] ![η] 2 →\n    D = A * (κ ^ 2 * q * δ ^ 2) →\n      (CurrentMM.gaussianRecordLaw (T + 3)\n              (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![η] (CurrentMM.pulseProbe A) (↑t + 1)).price) v)\n            {x | x.2.2.1 ∈ Set.Iio (μ0 - D / 2)} =\n          (ProbabilityTheory.gaussianReal 0 v) (Set.Iio (-(D / 2))) ∧\n        (CurrentMM.gaussianRecordLaw (T + 3)\n              (fun t =>\n                (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![η - δ, η + δ] (CurrentMM.pulseProbe A)\n                    (↑t + 1)).price)\n              v)\n            {x | x.2.2.1 ∈ Set.Iio (μ0 - D / 2)}ᶜ =\n          (ProbabilityTheory.gaussianReal 0 v) (Set.Iic (-(D / 2)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_converse_margin","type":"∀ {n : ℕ} (a κ c μ P A : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ κ →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + κ * ∑ i, q i < 1 →\n            0 ≤ A →\n              μ ≤ 1 →\n                ∀ (t : ℕ),\n                  μ * |A| * (P + A * CurrentMM.actualCohortImpulse a κ q rate t) ≤\n                    CurrentMM.equity (CurrentMM.pulseTraderCapital κ c μ P A - A * CurrentMM.averageFill P κ A - c * A)\n                      A (P + A * CurrentMM.actualCohortImpulse a κ q rate t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_endogenous_contraction_sensitivity","type":"∀ (x y Lk Lg epsilon : ℝ),\n  0 ≤ Lk →\n    0 ≤ Lg →\n      0 ≤ epsilon → Lk * Lg < 1 → |x - y| ≤ Lk * (Lg * |x - y| + epsilon) → |x - y| ≤ Lk * epsilon / (1 - Lk * Lg)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sybil_share_count_bound","type":"∀ {M : ℕ} (shares : Fin M → ℝ) (alpha : ℝ), (∀ (i : Fin M), alpha ≤ shares i) → ∑ i, shares i = 1 → ↑M * alpha ≤ 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_camouflage_unprofitable","type":"∀ (cost profit lower upper : ℝ), lower ≤ cost → profit ≤ upper → upper < lower → profit - cost < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_crb_theta_order","type":"∀ (sigma_h d_eta : ℝ),\n  0 < sigma_h →\n    0 < d_eta →\n      ∀ (row_norm_sq : ℝ),\n        4 ≤ row_norm_sq →\n          row_norm_sq ≤ 200 →\n            have V_CRB := sigma_h ^ 2 * row_norm_sq / d_eta ^ 6;\n            4 * sigma_h ^ 2 / d_eta ^ 6 ≤ V_CRB ∧ V_CRB ≤ 200 * sigma_h ^ 2 / d_eta ^ 6"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_lem_altpair_binomial_satisfies_conditions","type":"∀ (L : ℕ) (W rho : ℝ),\n  0 < W →\n    0 < rho →\n      have _h := rho / (2 * ↑L + 1);\n      have total_mass_A := W;\n      have total_mass_B := W;\n      have wass_lb := rho * W / (8 * (↑L + 1));\n      total_mass_A = total_mass_B ∧ 0 < wass_lb"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.passive_variance_formula_R","type":"∀ (kappa q sigma s_w_sq : ℝ),\n  0 < kappa →\n    0 < q →\n      0 < sigma →\n        0 < s_w_sq →\n          have R := kappa ^ 2 * q ^ 2 * s_w_sq ^ 2 / sigma ^ 2;\n          0 < R ∧ sigma ^ 2 * R = (kappa * q * s_w_sq) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_discvalue_ratio_formal","type":"∀ (c_p c_t K v kappa eps sigma d_eta : ℝ),\n  0 < c_p →\n    0 < c_t →\n      0 < K →\n        0 < v →\n          0 < kappa →\n            0 < eps →\n              0 < sigma →\n                0 < d_eta →\n                  ∀ (N_price N_tagged : ℝ),\n                    c_p * sigma ^ 2 / d_eta ^ 6 ≤ N_price →\n                      0 < N_price →\n                        N_tagged ≤ c_t * K * v / (kappa ^ 2 * eps ^ 2) →\n                          0 < N_tagged →\n                            c_p * kappa ^ 2 * eps ^ 2 * sigma ^ 2 / (c_t * K * v) / d_eta ^ 6 ≤ N_price / N_tagged"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_capacity_quadratic_bounds","type":"∀ (a kappa Q_bar H delta_inv : ℝ),\n  0 ≤ a →\n    0 ≤ kappa →\n      0 ≤ Q_bar →\n        0 ≤ H →\n          0 ≤ delta_inv →\n            delta_inv < 1 →\n              4 * (1 - delta_inv) * kappa * H * a ≤ (a + kappa * Q_bar) ^ 2 →\n                have b := a + kappa * Q_bar;\n                have c := kappa * H * a;\n                have one_m_d := 1 - delta_inv;\n                have disc := b ^ 2 - 4 * one_m_d * c;\n                have G_lower := (b - √disc) / (2 * one_m_d);\n                have G_upper := (b + √disc) / (2 * one_m_d);\n                0 ≤ disc ∧ G_lower ≤ G_upper"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_decision_amgm_optimal","type":"∀ (A D c_H : ℝ),\n  0 < A →\n    0 < D →\n      0 < c_H →\n        have N_star := (A / (2 * D * c_H)) ^ (2 / 3);\n        0 < N_star ∧ A / (2 * D * c_H) = N_star ^ (3 / 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_pair_hellinger_theta_order","type":"∀ (c1 c2 delta D_H : ℝ),\n  0 < c1 →\n    0 < c2 →\n      c1 ≤ c2 →\n        0 < delta →\n          c1 * delta ^ 3 ≤ D_H →\n            D_H ≤ c2 * delta ^ 3 →\n              have N_lo := 1 / (c2 ^ 2 * delta ^ 6);\n              have N_hi := 1 / (c1 ^ 2 * delta ^ 6);\n              0 < D_H ∧ N_lo ≤ 1 / D_H ^ 2 ∧ 1 / D_H ^ 2 ≤ N_hi"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fhc_priced_net_positive","type":"∀ (A D c_H N : ℝ),\n  0 < A →\n    0 < D →\n      0 < c_H →\n        0 < N →\n          D * c_H * N ≤ A * N ^ (-(1 / 2)) →\n            have V_info := A * N ^ (-(1 / 2));\n            have C_tag := D * c_H * N;\n            have V_net := V_info - C_tag;\n            0 ≤ V_net"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_anylinear_flow_kernel","type":"∀ {J : ℕ} (κ : Fin J → ℕ → ℝ) (s : ℕ → ℝ) (t : ℕ),\n  CurrentMM.linPopFlow κ s t = ∑ m ∈ Finset.range t, CurrentMM.linPopKernel κ m * s (t - 1 - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_linPop_impulse","type":"∀ {J : ℕ} (κ : Fin J → ℕ → ℝ) (m : ℕ),\n  CurrentMM.linPopFlow κ (fun j => if j = 0 then 1 else 0) (m + 1) = CurrentMM.linPopKernel κ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_anylinear_iff","type":"∀ {J J' : ℕ} (κ : Fin J → ℕ → ℝ) (κ' : Fin J' → ℕ → ℝ) (T : ℕ),\n  (∀ (s : ℕ → ℝ), ∀ t ≤ T, CurrentMM.linPopFlow κ s t = CurrentMM.linPopFlow κ' s t) ↔\n    ∀ m < T, CurrentMM.linPopKernel κ m = CurrentMM.linPopKernel κ' m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_anylinear_invariance","type":"∀ {J J' : ℕ} (κ : Fin J → ℕ → ℝ) (κ' : Fin J' → ℕ → ℝ) (T : ℕ),\n  (∀ m < T, CurrentMM.linPopKernel κ m = CurrentMM.linPopKernel κ' m) →\n    ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.FlowMarketPath (CurrentMM.linPopFlow κ) v z X Pr S ps ys →\n            CurrentMM.FlowMarketPath (CurrentMM.linPopFlow κ') v z X Pr S ps' ys' → ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_delever_stress_invariance","type":"∀ {K K' : ℕ} (P : Fin K → CurrentMM.BandLinearTrader) (P' : Fin K' → CurrentMM.BandLinearTrader) (T : ℕ),\n  (∀ m < T,\n      CurrentMM.eqKernel (fun i => (P i).w) (fun i => (P i).r) m =\n        CurrentMM.eqKernel (fun i => (P' i).w) (fun i => (P' i).r) m) →\n    ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.FlowMarketPath (CurrentMM.bandPopFlow P) v z X Pr S ps ys →\n            CurrentMM.FlowMarketPath (CurrentMM.bandPopFlow P') v z X Pr S ps' ys' →\n              (∀ t ≤ T,\n                  (∀ (i : Fin K), |(P i).l * CurrentMM.eqMem (P i).r (fun j => S j ps) t| ≤ 1) ∧\n                    ∀ (i : Fin K'), |(P' i).l * CurrentMM.eqMem (P' i).r (fun j => S j ps) t| ≤ 1) →\n                ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_stability_K","type":"∀ {K : ℕ} (κ D : ℝ) (r g : Fin K → ℝ),\n  0 < κ →\n    D < 1 → (∀ (i : Fin K), r i < D) → (∀ (i : Fin K), 0 < g i) → κ * ∑ i, g i = 1 - D → κ * ∑ i, g i / (1 - r i) < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_effective_stability_iff","type":"∀ {K : ℕ} (κ D ab : ℝ) (r g : Fin K → ℝ),\n  0 < D →\n    ab < D →\n      (∀ (i : Fin K), 1 - r i ≠ 0) →\n        (ab / D + κ / D * ∑ i, (D - ab) * g i / (1 - r i) < 1 ↔ κ * ∑ i, g i / (1 - r i) < 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_necessity","type":"∀ {K : ℕ} (A V ab κ D : ℝ) (r β : Fin K → ℝ),\n  D ≠ 0 →\n    (∀ (H : ℝ) (v : Fin K → ℝ),\n        (-κ * ab * H + ∑ i, (κ + β i * r i) * v i) / D - (-κ * H + ∑ i, β i * v i) = A * V * H) →\n      κ * (D - ab) = A * V * D ∧ ∀ (i : Fin K), β i * (D - r i) = κ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rents_symmetrize","type":"∀ {T : ℕ} (A : Fin T → Fin T → ℝ) (b : Fin T → ℝ),\n  CurrentMM.p1Quad A b = CurrentMM.p1Quad (fun i j => (A i j + A j i) / 2) b"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rents_optimum","type":"∀ {T : ℕ} (Q : Fin T → Fin T → ℝ),\n  (∀ (i j : Fin T), Q i j = Q j i) →\n    (∀ (v : Fin T → ℝ), 0 ≤ CurrentMM.p1Quad Q v) →\n      ∀ (bs : Fin T → ℝ),\n        (∀ (i : Fin T), ∑ j, Q i j * bs j = 1 / 2) →\n          ∀ (b : Fin T → ℝ), ∑ i, b i - CurrentMM.p1Quad Q b ≤ ∑ i, bs i - CurrentMM.p1Quad Q bs"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rents_value","type":"∀ {T : ℕ} (Q : Fin T → Fin T → ℝ) (bs : Fin T → ℝ),\n  (∀ (i : Fin T), ∑ j, Q i j * bs j = 1 / 2) → ∑ i, bs i - CurrentMM.p1Quad Q bs = (∑ i, bs i) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_halt_kernel_gap","type":"∀ (W c d σ : ℝ), W / 2 * (c - d * σ) ^ 0 - W / 4 * (c - d) ^ 0 = W / 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_insider_reduced_form","type":"∀ {K : ℕ} (ab κ D lam H Hprev ν νprev x xprev s sprev : ℝ) (r w β u : Fin K → ℝ),\n  (∀ (i : Fin K), β i * (D - r i) = κ) →\n    D = 1 - ∑ i, β i * w i →\n      s = x + lam * ν →\n        sprev = xprev + lam * νprev →\n          H = ab * Hprev - ∑ i, u i - ν →\n            x = -κ * H + ∑ i, β i * (r i * u i + w i * s) →\n              xprev = -κ * Hprev + ∑ i, β i * u i →\n                D * s - ab * sprev = ∑ i, β i * (D - ab) * u i + (κ + lam) * ν - ab * lam * νprev"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_insider_best_response","type":"∀ (θ c d : ℝ), 0 < c → (θ - c * d) * d ≤ θ ^ 2 / (4 * c) ∧ (θ - c * (θ / (2 * c))) * (θ / (2 * c)) = θ ^ 2 / (4 * c)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_insider_kyle_limit","type":"∀ (lam b sT2 sX2 : ℝ), lam ≠ 0 → b = 1 / (2 * lam) → lam * (sX2 + b ^ 2 * sT2) = b * sT2 → 4 * lam ^ 2 * sX2 = sT2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_insider_posterior_variance","type":"∀ (b sT2 sX2 sN2 lam : ℝ),\n  sN2 = sX2 + b ^ 2 * sT2 → sN2 ≠ 0 → lam = b * sT2 / sN2 → sT2 - lam ^ 2 * sN2 = sT2 * sX2 / sN2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqMem_eq","type":"∀ (r : ℝ) (s : ℕ → ℝ) (t : ℕ), CurrentMM.eqMem r s t = ∑ m ∈ Finset.range t, r ^ m * s (t - 1 - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqAggFlow_kernel","type":"∀ {K : ℕ} (w r : Fin K → ℝ) (s : ℕ → ℝ) (t : ℕ),\n  CurrentMM.eqAggFlow w r s t = ∑ m ∈ Finset.range t, CurrentMM.eqKernel w r m * s (t - 1 - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqAggFlow_congr","type":"∀ {K : ℕ} (w r : Fin K → ℝ) (s s' : ℕ → ℝ) (t : ℕ),\n  (∀ j < t, s j = s' j) → CurrentMM.eqAggFlow w r s t = CurrentMM.eqAggFlow w r s' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqAggFlow_of_kernel","type":"∀ {K K' : ℕ} (w r : Fin K → ℝ) (w' r' : Fin K' → ℝ) (T : ℕ),\n  (∀ m < T, CurrentMM.eqKernel w r m = CurrentMM.eqKernel w' r' m) →\n    ∀ (s : ℕ → ℝ), ∀ t ≤ T, CurrentMM.eqAggFlow w r s t = CurrentMM.eqAggFlow w' r' s t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqAggFlow_impulse","type":"∀ {K : ℕ} (w r : Fin K → ℝ) (m : ℕ),\n  CurrentMM.eqAggFlow w r (fun j => if j = 0 then 1 else 0) (m + 1) = CurrentMM.eqKernel w r m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kernel_of_eqAggFlow","type":"∀ {K K' : ℕ} (w r : Fin K → ℝ) (w' r' : Fin K' → ℝ) (T : ℕ),\n  (∀ (s : ℕ → ℝ), ∀ t ≤ T, CurrentMM.eqAggFlow w r s t = CurrentMM.eqAggFlow w' r' s t) →\n    ∀ m < T, CurrentMM.eqKernel w r m = CurrentMM.eqKernel w' r' m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_market_invariance","type":"∀ {K K' : ℕ} (w r : Fin K → ℝ) (w' r' : Fin K' → ℝ) (T : ℕ),\n  (∀ m < T, CurrentMM.eqKernel w r m = CurrentMM.eqKernel w' r' m) →\n    ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.EqMarketPath w r v z X Pr S ps ys →\n            CurrentMM.EqMarketPath w' r' v z X Pr S ps' ys' → ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_insider_profit_invariance","type":"∀ {K K' : ℕ} (w r : Fin K → ℝ) (w' r' : Fin K' → ℝ) (T : ℕ),\n  (∀ m < T, CurrentMM.eqKernel w r m = CurrentMM.eqKernel w' r' m) →\n    ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.EqMarketPath w r v z X Pr S ps ys →\n            CurrentMM.EqMarketPath w' r' v z X Pr S ps' ys' →\n              ∑ t ∈ Finset.range T, (v - ps t) * X t v ps ys = ∑ t ∈ Finset.range T, (v - ps' t) * X t v ps' ys' ∧\n                -∑ t ∈ Finset.range T, ys t = -∑ t ∈ Finset.range T, ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_gauss_radau_kernels","type":"∀ (c d σ : ℝ),\n  σ ^ 2 = 1 / 3 →\n    ∀ m < 3,\n      CurrentMM.eqKernel ![1 / 2, 1 / 2] ![c - d * σ, c + d * σ] m =\n        CurrentMM.eqKernel ![1 / 4, 3 / 4] ![c - d, c + d / 3] m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_group_level_differs","type":"∀ (c d σ : ℝ),\n  σ ^ 2 = 1 / 3 →\n    (∀ m < 3,\n        CurrentMM.eqKernel ![1 / 2, 1 / 2] ![c - d * σ, c + d * σ] m =\n          CurrentMM.eqKernel ![1 / 4, 3 / 4] ![c - d, c + d / 3] m) ∧\n      max (1 / 2) (1 / 2) = 1 / 2 ∧ max (1 / 4) (3 / 4) = 3 / 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_reduced_form","type":"∀ {K : ℕ} (ab κ D Hprev ξ xprev x : ℝ) (r β u : Fin K → ℝ),\n  D ≠ 0 →\n    (∀ (i : Fin K), D - r i ≠ 0) →\n      (∀ (i : Fin K), β i * (D - r i) = κ) →\n        xprev = -κ * Hprev + ∑ i, β i * u i →\n          D * x = -κ * (ab * Hprev - ∑ i, u i - ξ) + ∑ i, β i * r i * u i →\n            x = ab / D * xprev + κ / D * (ξ + ∑ i, (D - ab) / (D - r i) * u i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_scaled_cohort","type":"∀ (ab D r w u x : ℝ), (D - ab) / (D - r) * (r * u + w * x) = r * ((D - ab) / (D - r) * u) + (D - ab) * w / (D - r) * x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_realize_D","type":"∀ {K : ℕ} (as ks W D : ℝ) (wt r : Fin K → ℝ),\n  ∑ i, wt i = W →\n    1 - as ≠ 0 →\n      D ≠ 0 →\n        D = 1 - ks * W / (1 - as) →\n          (∀ (i : Fin K), D - r i ≠ 0) → D + ks * D * ∑ i, wt i * (D - r i) / (D - as * D) / (D - r i) = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eq_realize_dealer","type":"∀ (as ks D V : ℝ), V ≠ 0 → ks * D * (D - as * D) = ks * D * (1 - as) / V * V * D"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fragility_feedback_bound","type":"∀ (A sF2 sX2 ab w r κ D : ℝ),\n  0 < w →\n    0 < D →\n      0 ≤ A →\n        0 ≤ sX2 →\n          (D - 1) * (D - r) + κ * w = 0 →\n            κ * (D - ab) * D = A * (sF2 * D ^ 2 + κ ^ 2 * sX2) → A * sF2 * w * D ≤ (1 - D) * (D - r) * (D - ab)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fragility_benchmark_bound","type":"∀ (A sF2 sX2 ab κ D : ℝ),\n  κ * D ≠ 0 →\n    0 ≤ sF2 → 0 ≤ sX2 → κ * (D - ab) * D = A * (sF2 * D ^ 2 + κ ^ 2 * sX2) → 4 * A ^ 2 * sF2 * sX2 ≤ (D - ab) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fragility_K_bound","type":"∀ (A sF2 sX2 ab s κ D G G1 : ℝ),\n  0 < D →\n    0 < κ →\n      0 ≤ A →\n        0 ≤ sF2 →\n          0 ≤ sX2 →\n            0 < G1 →\n              G1 ≤ G →\n                s ^ 2 = ab →\n                  κ * G = 1 - D → κ * (D - ab) * D = A * (sF2 * D ^ 2 + κ ^ 2 * sX2) → A * sF2 * G1 ≤ (1 - s) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_largest_value_not_constant","type":"∀ {ι : Type u_1} (I : Set ι),\n  I.Infinite →\n    ∀ (N : ι → Finset ℝ),\n      (∀ c ∈ I, (N c).Nonempty) →\n        (∀ c ∈ I, ∀ d ∈ I, c ≠ d → Disjoint (N c) (N d)) →\n          ∀ (f : ℝ → ℝ),\n            (∀ (v : ℝ), {s | f s = v}.Finite) →\n              ∃ c ∈ I, ∃ d ∈ I, ∃ (hc : (N c).Nonempty) (hd : (N d).Nonempty), (N c).sup' hc f ≠ (N d).sup' hd f"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_largest_weight_not_constant","type":"∀ {ι : Type u_1} (I : Set ι),\n  I.Infinite →\n    ∀ (N : ι → Finset ℝ),\n      (∀ c ∈ I, (N c).Nonempty) →\n        (∀ c ∈ I, ∀ d ∈ I, c ≠ d → Disjoint (N c) (N d)) →\n          ∀ (lam : ℝ → ℝ),\n            (∀ (v : ℝ), {s | lam s = v}.Finite) →\n              ∀ (w : ι → ℝ → ℝ),\n                (∀ c ∈ I, ∀ s ∈ N c, w c s = lam s) →\n                  ∃ c ∈ I,\n                    ∃ d ∈ I, ∃ (hc : (N c).Nonempty) (hd : (N d).Nonempty), (N c).sup' hc (w c) ≠ (N d).sup' hd (w d)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_finite_exp_sums_independent","type":"∀ (R : Finset ℝ) (c : ℝ → ℝ), (∀ m < R.card, ∑ ρ ∈ R, c ρ * ρ ^ m = 0) → ∀ ρ ∈ R, c ρ = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_measure_from_finitely_many_moments","type":"∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι) (T : Finset κ) (r w : ι → ℝ) (r' w' : κ → ℝ),\n  (∀ m < S.card + T.card, ∑ i ∈ S, w i * r i ^ m = ∑ i ∈ T, w' i * r' i ^ m) →\n    ∀ (ρ : ℝ), CurrentMM.mergedWeight S r w ρ = CurrentMM.mergedWeight T r' w' ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_deconvolution_finite","type":"∀ (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (k k' h h' : ℕ → ℝ) (m : ℕ),\n      h 0 = κ →\n        (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n          (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n            (∀ t ≤ m, h t = h' t) → ∀ j < m, k j = k' j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_model_finite_identification","type":"∀ {n n' : ℕ} (a impact : ℝ),\n  impact ≠ 0 →\n    ∀ (q rate : Fin n → ℝ) (q' rate' : Fin n' → ℝ),\n      (∀ j ≤ n + n',\n          CurrentMM.actualCohortImpulse a impact q rate j = CurrentMM.actualCohortImpulse a impact q' rate' j) →\n        ∀ (ρ : ℝ),\n          CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate i) (fun i => q i * rate i) ρ =\n            CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate' i) (fun i => q' i * rate' i) ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_dot_sq_le","type":"∀ {n : ℕ} (x y : Fin n → ℝ), (x ⬝ᵥ y) ^ 2 ≤ x ⬝ᵥ x * y ⬝ᵥ y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_dot_self_nonneg","type":"∀ {n : ℕ} (x : Fin n → ℝ), 0 ≤ x ⬝ᵥ x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gram_dot","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ) (a x : Fin p → ℝ), J.mulVec a ⬝ᵥ J.mulVec x = (J.transpose * J).mulVec a ⬝ᵥ x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fisher_col","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ),\n  IsUnit (J.transpose * J).det →\n    ∀ (k : Fin p),\n      (J.transpose * J).mulVec ((J.transpose * J)⁻¹.mulVec (Pi.single k 1)) = Pi.single k 1 ∧\n        (J.transpose * J)⁻¹.mulVec (Pi.single k 1) k = (J.transpose * J)⁻¹ k k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fisher_col_norm","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ),\n  IsUnit (J.transpose * J).det →\n    ∀ (k : Fin p),\n      J.mulVec ((J.transpose * J)⁻¹.mulVec (Pi.single k 1)) ⬝ᵥ J.mulVec ((J.transpose * J)⁻¹.mulVec (Pi.single k 1)) =\n        (J.transpose * J)⁻¹ k k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fisher_entry_lower","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ),\n  IsUnit (J.transpose * J).det →\n    ∀ (k : Fin p) (x : Fin p → ℝ), x k ^ 2 ≤ (J.transpose * J)⁻¹ k k * J.mulVec x ⬝ᵥ J.mulVec x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fisher_entry_upper","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ),\n  IsUnit (J.transpose * J).det →\n    ∀ (k : Fin p) (b : Fin n → ℝ), J.transpose.mulVec b = Pi.single k 1 → (J.transpose * J)⁻¹ k k ≤ b ⬝ᵥ b"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gram_isUnit","type":"∀ {n p : ℕ} (J : Matrix (Fin n) (Fin p) ℝ), (∀ (x : Fin p → ℝ), J.mulVec x = 0 → x = 0) → IsUnit (J.transpose * J).det"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_ratio_interval","type":"∀ (f0 f1 h f0lo f0hi f1lo f1hi hlo hhi κ : ℝ),\n  0 < κ →\n    0 < f0lo →\n      0 ≤ f1lo →\n        f0lo ≤ f0 →\n          f0 ≤ f0hi →\n            f1lo ≤ f1 →\n              f1 ≤ f1hi →\n                hlo ≤ h → h ≤ hhi → f1lo / f0hi - hhi / κ ≤ f1 / f0 - h / κ ∧ f1 / f0 - h / κ ≤ f1hi / f0lo - hlo / κ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_intensity_interval","type":"∀ (w r wlo whi rlo rhi : ℝ),\n  0 ≤ wlo →\n    wlo ≤ w → w ≤ whi → rlo ≤ r → r ≤ rhi → rhi < 1 → wlo / (1 - rlo) ≤ w / (1 - r) ∧ w / (1 - r) ≤ whi / (1 - rhi)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_selected_halt_sound","type":"∀ {K : ℕ} (q upper : Fin K → ℝ) (i : Fin K) (a κ drift allowance cap : ℝ),\n  0 ≤ κ →\n    (∀ (j : Fin K), q j ≤ upper j) →\n      drift ≤ allowance →\n        a + κ * ∑ j ∈ Finset.univ.erase i, upper j + allowance ≤ cap →\n          a + κ * ∑ j ∈ Finset.univ.erase i, q j + drift ≤ cap"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_joint_mean_bound","type":"∀ {J : ℕ} (N : ℕ),\n  0 < N →\n    ∀ (mean : Fin J → ℝ) (v : NNReal) (e : ℝ),\n      0 < e →\n        (MeasureTheory.Measure.pi fun j => MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal (mean j) v)\n            (⋃ j, {x | e ≤ |(∑ n, x j n) / ↑N - mean j|}) ≤\n          ↑J * ENNReal.ofReal (↑v / (↑N * e ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_identity_inversion","type":"∀ (w κ r h : ℝ), w ≠ 0 → κ ≠ 0 → w * (κ * r + h) / (κ * w) - h / κ = r"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_clipped_interval","type":"∀ (lo hi r cap : ℝ), lo ≤ r → r ≤ hi → 0 ≤ r → r ≤ cap → max 0 (min cap lo) ≤ r ∧ r ≤ max 0 (min cap hi)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_gaussian_decision_bound","type":"∀ {J : ℕ} (N : ℕ),\n  0 < N →\n    ∀ (mean : Fin J → ℝ) (v : NNReal) (e : ℝ),\n      0 < e →\n        ∀ (halt violates : (Fin J → Fin N → ℝ) → Prop),\n          (∀ (x : Fin J → Fin N → ℝ), (∀ (j : Fin J), |(∑ n, x j n) / ↑N - mean j| < e) → halt x → ¬violates x) →\n            (MeasureTheory.Measure.pi fun j =>\n                  MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal (mean j) v)\n                {x | halt x ∧ violates x} ≤\n              ↑J * ENNReal.ofReal (↑v / (↑N * e ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_general_alpha_testing_bound","type":"∀ (alpha C delta sigma N : ℝ),\n  0 < alpha →\n    alpha < 1 / 2 →\n      0 < C →\n        0 < delta →\n          0 < sigma →\n            2 * (1 - 2 * alpha) ^ 2 ≤ 1 / 2 * C ^ 2 * delta ^ 4 * N / sigma ^ 2 →\n              4 * (1 - 2 * alpha) ^ 2 * sigma ^ 2 / (C ^ 2 * delta ^ 4) ≤ N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_general_alpha","type":"∀ (alpha K_star delta sigma V : ℝ),\n  0 < alpha →\n    alpha < 1 / 2 →\n      0 < K_star →\n        0 < delta →\n          0 < sigma →\n            2 * (1 - 2 * alpha) ^ 2 ≤ 1 / 2 * K_star ^ 2 * V ^ 2 * delta ^ 4 / sigma ^ 2 →\n              4 * (1 - 2 * alpha) ^ 2 * sigma ^ 2 / (K_star ^ 2 * delta ^ 4) ≤ V ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_general_alpha","type":"∀ (alpha K_star delta sigma m B : ℝ),\n  0 < alpha →\n    alpha < 1 / 2 →\n      0 < K_star →\n        0 < delta →\n          0 < sigma →\n            0 < m →\n              2 * (1 - 2 * alpha) ^ 2 ≤ K_star ^ 2 * B * delta ^ 4 / (sigma ^ 2 * m) →\n                2 * (1 - 2 * alpha) ^ 2 * sigma ^ 2 * m / (K_star ^ 2 * delta ^ 4) ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_spectral_dissipative_heteroskedastic_invariance","type":"∀ (T : ℕ) (v : Fin T → ℝ) (kappa xi0 : ℝ),\n  0 < kappa →\n    0 ≤ xi0 →\n      have E_linear := kappa * ∑ i, v i ^ 2;\n      have E_slippage := kappa * xi0 * ∑ i, |v i| ^ 3;\n      have E_total := ∑ i, v i * (kappa * (1 + xi0 * |v i|) * v i);\n      E_linear ≤ E_total ∧ 0 ≤ E_slippage ∧ E_total = E_linear + E_slippage"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_abstain_path_kl_and_decision","type":"∀ (T : ℕ) (rho0 rho1 rho_bar sigma alpha : ℝ),\n  0 < T →\n    0 ≤ rho_bar →\n      rho_bar < 1 →\n        |rho1 - rho0| ≤ 1 - rho_bar →\n          0 < sigma →\n            0 < alpha →\n              alpha < 1 / 2 →\n                have d_rho := |rho1 - rho0|;\n                have kl_path := ↑T * d_rho ^ 2 / (2 * (1 - rho_bar ^ 2));\n                0 ≤ kl_path ∧ kl_path ≤ ↑T * (1 - rho_bar) ^ 2 / (2 * (1 - rho_bar ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_rh_finite_toeplitz_duality","type":"∀ (F_dom W_perp gamma v_perp_sq : ℝ),\n  0 < F_dom →\n    0 ≤ W_perp →\n      0 ≤ gamma →\n        gamma * F_dom < 1 →\n          0 ≤ v_perp_sq →\n            have lower_bound := F_dom - W_perp / (4 * (1 - gamma * F_dom));\n            have energy := F_dom + (1 - gamma * F_dom) * v_perp_sq - √W_perp * √v_perp_sq;\n            lower_bound ≤ energy"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_uniformw1_minimax_lower_bound","type":"∀ (K : ℕ),\n  0 < K →\n    ∀ (W rho sigma d_eta : ℝ),\n      0 < W →\n        0 < rho →\n          0 < sigma →\n            0 < d_eta →\n              ∀ (c_minimax : ℝ),\n                0 < c_minimax →\n                  have wass_gap := 2 * W * rho / (Real.pi * (2 * ↑K - 1));\n                  have _exp_rate := 4 * ↑K - 2;\n                  have N_sample := c_minimax * sigma ^ 2 / d_eta ^ (4 * K - 2);\n                  0 < wass_gap ∧ 0 < N_sample ∧ c_minimax * sigma ^ 2 / d_eta ^ (4 * K - 2) ≤ N_sample"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_adaptive_stopped_martingale_bound","type":"∀ (T_max : ℕ),\n  0 < T_max →\n    ∀ (K_star delta V_bar sigma E_tau : ℝ),\n      0 < K_star →\n        0 < delta →\n          0 < V_bar →\n            0 < sigma →\n              0 < E_tau ∧ E_tau ≤ ↑T_max →\n                have info_bound := 1 / 2 * K_star ^ 2 * delta ^ 4 * V_bar ^ 2 * E_tau / sigma ^ 2;\n                have session_cap := 1 / 2 * K_star ^ 2 * delta ^ 4 * V_bar ^ 2 * ↑T_max / sigma ^ 2;\n                0 < info_bound ∧ info_bound ≤ session_cap"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_passive_cholesky_finite_sample_lower_bound","type":"∀ (T : ℕ),\n  2 ≤ T →\n    ∀ (kappa q delta : ℝ),\n      0 < kappa →\n        0 < q →\n          0 < delta →\n            ∀ (norm_B_minus_I_sq : ℝ),\n              (↑T - 1) * (kappa * q * delta ^ 2) ^ 2 ≤ norm_B_minus_I_sq →\n                have C_passive := kappa ^ 2 * q ^ 2;\n                have kl_lower := 1 / 2 * (↑T - 1) * C_passive * delta ^ 4;\n                0 < kl_lower ∧ kl_lower ≤ 1 / 2 * norm_B_minus_I_sq"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tagged_finite_sample_chebyshev","type":"∀ (T : ℕ) (V_num gamma_min eps beta : ℝ),\n  0 < V_num →\n    0 < gamma_min →\n      0 < eps →\n        0 < beta →\n          V_num / (eps ^ 2 * gamma_min ^ 2 * beta) ≤ ↑T →\n            have prob_bound := V_num / (↑T * eps ^ 2 * gamma_min ^ 2);\n            0 < prob_bound ∧ prob_bound ≤ beta"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_node_bounds","type":"(∀ (i : Fin 2), |CurrentMM.grGNode i| ≤ 1) ∧ ∀ (i : Fin 2), |CurrentMM.grRNode i| ≤ 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_positive_weights","type":"(∀ (i : Fin 2), 0 < CurrentMM.grGWeight i) ∧ ∀ (i : Fin 2), 0 < CurrentMM.grRWeight i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_normalized_weights","type":"∑ i, CurrentMM.grGWeight i = 1 ∧ ∑ i, CurrentMM.grRWeight i = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_three_matched_moments","type":"∀ (W : ℝ),\n  ∀ j < 3,\n    ∑ i, W * CurrentMM.grGWeight i * CurrentMM.grGNode i ^ j = ∑ i, W * CurrentMM.grRWeight i * CurrentMM.grRNode i ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_third_moment_gap","type":"∀ (W : ℝ),\n  ∑ i, W * CurrentMM.grGWeight i * CurrentMM.grGNode i ^ 3 - ∑ i, W * CurrentMM.grRWeight i * CurrentMM.grRNode i ^ 3 =\n    2 * W / 9"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_dominant_intensity_gap","type":"∀ (W u d : ℝ),\n  0 < W →\n    0 < u →\n      0 ≤ d →\n        d ≤ u / 3 →\n          ∀ (i : Fin 2),\n            CurrentMM.grIntensity CurrentMM.grGWeight CurrentMM.grGNode W u d i ≤\n              CurrentMM.grIntensity CurrentMM.grRWeight CurrentMM.grRNode W u d 1 - W / (8 * u)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_aggregate_gap","type":"∀ (W u d : ℝ),\n  0 < W →\n    0 ≤ d →\n      d < u →\n        |∑ i, CurrentMM.grIntensity CurrentMM.grGWeight CurrentMM.grGNode W u d i -\n              ∑ i, CurrentMM.grIntensity CurrentMM.grRWeight CurrentMM.grRNode W u d i| ≤\n          2 * W * d ^ 3 / (u ^ 3 * (u - d))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr_reset_lower_bound","type":"∀ (a κ c d W H : ℝ) (N T : ℕ) (q rate q' rate' : Fin 2 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 < W →\n            0 ≤ H →\n              (∀ (i : Fin 2), 1 - rate i = c + d * CurrentMM.grGNode i) →\n                (∀ (i : Fin 2), 1 - rate' i = c + d * CurrentMM.grRNode i) →\n                  (∀ (i : Fin 2), q i * rate i = W * CurrentMM.grGWeight i) →\n                    (∀ (i : Fin 2), q' i * rate' i = W * CurrentMM.grRWeight i) →\n                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                        ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                          MeasurableSet A →\n                            (CurrentMM.gaussianRecordLaw (N * T)\n                                      (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                      variance).real\n                                  A ≤\n                                1 / 4 →\n                              (CurrentMM.gaussianRecordLaw (N * T)\n                                        (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                        variance).real\n                                    Aᶜ ≤\n                                  1 / 4 →\n                                ↑variance ≤ 2 * ↑N * ↑T * (2 * W * 2 ^ T * d ^ 3 * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_sqrt_facts","type":"√6 ^ 2 = 6 ∧ √(3 / 5) ^ 2 = 3 / 5 ∧ 0 ≤ √6 ∧ √6 ≤ 4 ∧ 0 ≤ √(3 / 5) ∧ √(3 / 5) ≤ 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_node_bounds","type":"(∀ (i : Fin 3), |CurrentMM.gr3GNode i| ≤ 1) ∧ ∀ (i : Fin 3), |CurrentMM.gr3RNode i| ≤ 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_positive_weights","type":"(∀ (i : Fin 3), 0 < CurrentMM.gr3GWeight i) ∧ ∀ (i : Fin 3), 0 < CurrentMM.gr3RWeight i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_weight_sums","type":"∀ (W : ℝ), ∑ i, W * CurrentMM.gr3GWeight i = W ∧ ∑ i, W * CurrentMM.gr3RWeight i = W"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_five_matched_moments","type":"∀ (W : ℝ),\n  ∀ j < 5,\n    ∑ i, W * CurrentMM.gr3GWeight i * CurrentMM.gr3GNode i ^ j =\n      ∑ i, W * CurrentMM.gr3RWeight i * CurrentMM.gr3RNode i ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gr3_fifth_moment_gap","type":"∀ (W : ℝ),\n  ∑ i, W * CurrentMM.gr3GWeight i * CurrentMM.gr3GNode i ^ 5 -\n      ∑ i, W * CurrentMM.gr3RWeight i * CurrentMM.gr3RNode i ^ 5 =\n    4 * W / 75"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost_gauss_radau_three","type":"∀ (a κ c d W s : ℝ),\n  0 < κ →\n    0 ≤ c →\n      0 ≤ d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + κ * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                ∀ (q rate q' rate' : Fin 3 → ℝ),\n                  (∀ (i : Fin 3), 1 - rate i = c + d * CurrentMM.gr3GNode i) →\n                    (∀ (i : Fin 3), 1 - rate' i = c + d * CurrentMM.gr3RNode i) →\n                      (∀ (i : Fin 3), q i * rate i = W * CurrentMM.gr3GWeight i) →\n                        (∀ (i : Fin 3), q' i * rate' i = W * CurrentMM.gr3RWeight i) →\n                          ∀ (M T : ℕ) (v : NNReal),\n                            v ≠ 0 →\n                              ∀ (A : Set (Fin T → ℝ)),\n                                MeasurableSet A →\n                                  (CurrentMM.obsLaw M T v fun j => CurrentMM.actualCohortImpulse a κ q rate j / κ).real\n                                        A ≤\n                                      1 / 4 →\n                                    (CurrentMM.obsLaw M T v fun j =>\n                                              CurrentMM.actualCohortImpulse a κ q' rate' j / κ).real\n                                          Aᶜ ≤\n                                        1 / 4 →\n                                      1 ≤\n                                        2 * (1 + s) ^ 2 *\n                                            (κ * (2 * W * d ^ 5 * (1 / (1 - (c + d)) ^ (5 + 1))) / (1 - s) ^ 2) ^ 2 *\n                                          ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_exp_sub_one_le","type":"∀ (u : ℝ), Real.exp u - 1 ≤ u * Real.exp u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cr_direction","type":"∀ {n p : ℕ} (h : (Fin p → ℝ) → Fin n → ℝ) (θ0 : Fin p → ℝ) (J : Matrix (Fin n) (Fin p) ℝ) (v : NNReal),\n  v ≠ 0 →\n    ∀ (T : CurrentMM.ObservationRecord n → ℝ),\n      MeasureTheory.MemLp T 2 (CurrentMM.gaussianRecordLaw n (h θ0) v) →\n        ∀ (k : Fin p),\n          (∀ᶠ (θ : Fin p → ℝ) in nhds θ0,\n              ∫ (x : CurrentMM.ObservationRecord n), T x ∂CurrentMM.gaussianRecordLaw n (h θ) v = θ k) →\n            ∀ (a : Fin p → ℝ),\n              (∀ (i : Fin n), HasDerivAt (fun t => h (θ0 + t • a) i) (J.mulVec a i) 0) →\n                a k ^ 2 ≤\n                  ProbabilityTheory.variance T (CurrentMM.gaussianRecordLaw n (h θ0) v) * ((∑ i, J.mulVec a i ^ 2) / ↑v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_gaussian_cramer_rao","type":"∀ {n p : ℕ} (h : (Fin p → ℝ) → Fin n → ℝ) (θ0 : Fin p → ℝ) (J : Matrix (Fin n) (Fin p) ℝ),\n  IsUnit (J.transpose * J).det →\n    ∀ (v : NNReal),\n      v ≠ 0 →\n        ∀ (T : CurrentMM.ObservationRecord n → ℝ),\n          MeasureTheory.MemLp T 2 (CurrentMM.gaussianRecordLaw n (h θ0) v) →\n            ∀ (k : Fin p),\n              (∀ᶠ (θ : Fin p → ℝ) in nhds θ0,\n                  ∫ (x : CurrentMM.ObservationRecord n), T x ∂CurrentMM.gaussianRecordLaw n (h θ) v = θ k) →\n                (∀ (a : Fin p → ℝ) (i : Fin n), HasDerivAt (fun t => h (θ0 + t • a) i) (J.mulVec a i) 0) →\n                  ↑v * (J.transpose * J)⁻¹ k k ≤ ProbabilityTheory.variance T (CurrentMM.gaussianRecordLaw n (h θ0) v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cov_sq_le","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {P : MeasureTheory.Measure Ω} [MeasureTheory.IsProbabilityMeasure P]\n  {X Y : Ω → ℝ},\n  MeasureTheory.MemLp X 2 P →\n    MeasureTheory.MemLp Y 2 P →\n      ProbabilityTheory.covariance X Y P ^ 2 ≤ ProbabilityTheory.variance X P * ProbabilityTheory.variance Y P"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_integral_density_eq_one","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) (ρ : Ω → ℝ),\n  Measurable ρ →\n    (∀ (x : Ω), 0 ≤ ρ x) →\n      MeasureTheory.IsProbabilityMeasure (P.withDensity fun x => ENNReal.ofReal (ρ x)) → ∫ (x : Ω), ρ x ∂P = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hcr","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  (ρ T : Ω → ℝ),\n  Measurable ρ →\n    (∀ (x : Ω), 0 ≤ ρ x) →\n      ∫ (x : Ω), ρ x ∂P = 1 →\n        MeasureTheory.MemLp ρ 2 P →\n          MeasureTheory.MemLp T 2 P →\n            ((∫ (x : Ω), T x ∂P.withDensity fun x => ENNReal.ofReal (ρ x)) - ∫ (x : Ω), T x ∂P) ^ 2 ≤\n              ProbabilityTheory.variance T P * (∫ (x : Ω), ρ x ^ 2 ∂P - 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_pos","type":"∀ (m0 m1 : ℝ) (v : NNReal) (x : ℝ), 0 < CurrentMM.gaussLR m0 m1 v x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_measurable","type":"∀ (m0 m1 : ℝ) (v : NNReal), Measurable (CurrentMM.gaussLR m0 m1 v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_pdf","type":"∀ (m0 m1 : ℝ) (v : NNReal),\n  v ≠ 0 →\n    ∀ (x : ℝ),\n      ProbabilityTheory.gaussianPDFReal m0 v x * CurrentMM.gaussLR m0 m1 v x = ProbabilityTheory.gaussianPDFReal m1 v x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gauss_withDensity","type":"∀ (m0 m1 : ℝ) (v : NNReal),\n  v ≠ 0 →\n    ProbabilityTheory.gaussianReal m1 v =\n      (ProbabilityTheory.gaussianReal m0 v).withDensity fun x => ENNReal.ofReal (CurrentMM.gaussLR m0 m1 v x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_sq","type":"∀ (m0 m1 : ℝ) (v : NNReal),\n  v ≠ 0 →\n    ∀ (x : ℝ),\n      CurrentMM.gaussLR m0 m1 v x ^ 2 =\n        Real.exp (-((m1 - m0) ^ 2 / ↑v) - 2 * (m1 - m0) * m0 / ↑v) * Real.exp (2 * (m1 - m0) / ↑v * x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_sq_integrable","type":"∀ (m0 m1 : ℝ) (v : NNReal),\n  v ≠ 0 → MeasureTheory.Integrable (fun x => CurrentMM.gaussLR m0 m1 v x ^ 2) (ProbabilityTheory.gaussianReal m0 v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussLR_integral_sq","type":"∀ (m0 m1 : ℝ) (v : NNReal),\n  v ≠ 0 →\n    ∫ (x : ℝ), CurrentMM.gaussLR m0 m1 v x ^ 2 ∂ProbabilityTheory.gaussianReal m0 v = Real.exp ((m1 - m0) ^ 2 / ↑v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recordLR_measurable","type":"∀ (n : ℕ) (m0 m1 : Fin n → ℝ) (v : NNReal), Measurable (CurrentMM.recordLR n m0 m1 v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recordLR_nonneg","type":"∀ (n : ℕ) (m0 m1 : Fin n → ℝ) (v : NNReal) (x : CurrentMM.ObservationRecord n), 0 ≤ CurrentMM.recordLR n m0 m1 v x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_record_withDensity","type":"∀ (v : NNReal),\n  v ≠ 0 →\n    ∀ (n : ℕ) (m0 m1 : Fin n → ℝ),\n      CurrentMM.gaussianRecordLaw n m1 v =\n        (CurrentMM.gaussianRecordLaw n m0 v).withDensity fun x => ENNReal.ofReal (CurrentMM.recordLR n m0 m1 v x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recordLR_sq_integrable","type":"∀ (v : NNReal),\n  v ≠ 0 →\n    ∀ (n : ℕ) (m0 m1 : Fin n → ℝ),\n      MeasureTheory.Integrable (fun x => CurrentMM.recordLR n m0 m1 v x ^ 2) (CurrentMM.gaussianRecordLaw n m0 v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recordLR_integral_sq","type":"∀ (v : NNReal),\n  v ≠ 0 →\n    ∀ (n : ℕ) (m0 m1 : Fin n → ℝ),\n      ∫ (x : CurrentMM.ObservationRecord n), CurrentMM.recordLR n m0 m1 v x ^ 2 ∂CurrentMM.gaussianRecordLaw n m0 v =\n        Real.exp ((∑ i, (m1 i - m0 i) ^ 2) / ↑v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_gaussian_hcr","type":"∀ (n : ℕ) (m0 m1 : Fin n → ℝ) (v : NNReal),\n  v ≠ 0 →\n    ∀ (T : CurrentMM.ObservationRecord n → ℝ),\n      MeasureTheory.MemLp T 2 (CurrentMM.gaussianRecordLaw n m0 v) →\n        (∫ (x : CurrentMM.ObservationRecord n), T x ∂CurrentMM.gaussianRecordLaw n m1 v -\n              ∫ (x : CurrentMM.ObservationRecord n), T x ∂CurrentMM.gaussianRecordLaw n m0 v) ^\n            2 ≤\n          ProbabilityTheory.variance T (CurrentMM.gaussianRecordLaw n m0 v) *\n            (Real.exp ((∑ i, (m1 i - m0 i) ^ 2) / ↑v) - 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iidDens_pos","type":"∀ {n : ℕ} (v : NNReal), v ≠ 0 → ∀ (x : Fin n → ℝ), 0 < CurrentMM.iidDens v x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_measurable_iidDens","type":"∀ {n : ℕ} (v : NNReal), Measurable (CurrentMM.iidDens v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iidDens_eq","type":"∀ {n : ℕ} (v : NNReal) (x : Fin n → ℝ),\n  CurrentMM.iidDens v x = (√(2 * Real.pi * ↑v))⁻¹ ^ n * Real.exp ((-∑ i, x i ^ 2) / (2 * ↑v))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iidGauss_eq_withDensity","type":"∀ (n : ℕ) (v : NNReal),\n  v ≠ 0 → CurrentMM.iidGauss n v = MeasureTheory.volume.withDensity fun x => ENNReal.ofReal (CurrentMM.iidDens v x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_measurable_mulVec","type":"∀ {n : ℕ} (B : Matrix (Fin n) (Fin n) ℝ), Measurable B.mulVec"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_map_withDensity_det_one","type":"∀ {n : ℕ} (B : Matrix (Fin n) (Fin n) ℝ),\n  B.det = 1 →\n    ∀ (f : (Fin n → ℝ) → ENNReal),\n      Measurable f →\n        MeasureTheory.Measure.map B.mulVec (MeasureTheory.volume.withDensity f) =\n          MeasureTheory.volume.withDensity fun y => f (B⁻¹.mulVec y)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_measurable_triRatio","type":"∀ {n : ℕ} (v : NNReal) (B : Matrix (Fin n) (Fin n) ℝ), Measurable (CurrentMM.triRatio v B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_map_triangular_eq_withDensity","type":"∀ {n : ℕ} (v : NNReal),\n  v ≠ 0 →\n    ∀ (B : Matrix (Fin n) (Fin n) ℝ),\n      B.det = 1 →\n        MeasureTheory.Measure.map B.mulVec (CurrentMM.iidGauss n v) =\n          (CurrentMM.iidGauss n v).withDensity (CurrentMM.triRatio v B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iidGauss_sq_linear","type":"∀ {n : ℕ} (v : NNReal) (c : Fin n → ℝ),\n  ∫ (ξ : Fin n → ℝ), (∑ j, c j * ξ j) ^ 2 ∂CurrentMM.iidGauss n v = ↑v * ∑ j, c j ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_memLp_linear","type":"∀ {n : ℕ} (v : NNReal) (c : Fin n → ℝ), MeasureTheory.MemLp (fun ξ => ∑ j, c j * ξ j) 2 (CurrentMM.iidGauss n v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_log_dens_ratio","type":"∀ {n : ℕ} (v : NNReal) (x y : Fin n → ℝ),\n  Real.log (CurrentMM.iidDens v y / CurrentMM.iidDens v x) = (∑ i, x i ^ 2 - ∑ i, y i ^ 2) / (2 * ↑v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kl_triangular_gaussian","type":"∀ {n : ℕ} (v : NNReal),\n  v ≠ 0 →\n    ∀ (B : Matrix (Fin n) (Fin n) ℝ),\n      B.IsLowerTriangular →\n        (∀ (i : Fin n), B i i = 1) →\n          InformationTheory.klDiv (MeasureTheory.Measure.map B.mulVec (CurrentMM.iidGauss n v))\n              (CurrentMM.iidGauss n v) =\n            ENNReal.ofReal (1 / 2 * ∑ i, ∑ j, (B - 1) i j ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_responses_of_flow_eq","type":"∀ (a κ : ℝ) (F F' : (ℕ → ℝ) → ℕ → ℝ),\n  (∀ (x : ℕ → ℝ) (t : ℕ), F x t = F' x t) → CurrentMM.ProbeResponses a κ F = CurrentMM.ProbeResponses a κ F'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_general_identification","type":"∀ (a κ : ℝ) (F F' : (ℕ → ℝ) → ℕ → ℝ),\n  κ ≠ 0 → CurrentMM.ProbeResponses a κ F ⊆ CurrentMM.ProbeResponses a κ F' → ∀ (x : ℕ → ℝ) (t : ℕ), F x t = F' x t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_general_identification_iff","type":"∀ (a κ : ℝ) (F F' : (ℕ → ℝ) → ℕ → ℝ),\n  κ ≠ 0 → (CurrentMM.ProbeResponses a κ F = CurrentMM.ProbeResponses a κ F' ↔ ∀ (x : ℕ → ℝ) (t : ℕ), F x t = F' x t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_identified_functional","type":"∀ {P : Type u_1} {β : Type u_2} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (flow : P → (ℕ → ℝ) → ℕ → ℝ) (g : P → β),\n      (∀ (p p' : P), CurrentMM.ProbeResponses a κ (flow p) = CurrentMM.ProbeResponses a κ (flow p') → g p = g p') ↔\n        ∀ (p p' : P), (∀ (x : ℕ → ℝ) (t : ℕ), flow p x t = flow p' x t) → g p = g p'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_lower_bound_from_kernel_gap_general","type":"∀ (a κ B H ε : ℝ) (k k' h h' : ℕ → ℝ) (N T : ℕ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ B →\n      0 ≤ H →\n        0 ≤ ε →\n          h 0 = κ →\n            h' 0 = κ →\n              (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n                (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n                  (∀ (j : ℕ), |k j| ≤ B) →\n                    (∀ s < T, |h' s| ≤ H) →\n                      (∀ j < T, |k j - k' j| ≤ ε) →\n                        ∀ (α₀ β₀ : ℝ),\n                          α₀ + β₀ ≤ 1 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                              MeasurableSet A →\n                                (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h) variance).real A ≤\n                                    α₀ →\n                                  (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h') variance).real\n                                        Aᶜ ≤\n                                      β₀ →\n                                    4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                      ↑N * ↑T * (ε * CurrentMM.p1GapConst a |κ| B H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_formal_general","type":"∀ {n0 n1 : ℕ} (a κ c d W H : ℝ) (nmatch N T : ℕ) (q rate s : Fin n0 → ℝ) (q' rate' s' : Fin n1 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            (∀ (i : Fin n0), 1 - rate i = c + d * s i) →\n              (∀ (i : Fin n1), 1 - rate' i = c + d * s' i) →\n                (∀ (i : Fin n0), |s i| ≤ 1) →\n                  (∀ (i : Fin n1), |s' i| ≤ 1) →\n                    (∀ (i : Fin n0), 0 ≤ q i * rate i) →\n                      (∀ (i : Fin n1), 0 ≤ q' i * rate' i) →\n                        ∑ i, q i * rate i ≤ W →\n                          ∑ i, q' i * rate' i ≤ W →\n                            (∀ j < nmatch,\n                                CurrentMM.mgMoment Finset.univ (fun i => q i * rate i) s j =\n                                  CurrentMM.mgMoment Finset.univ (fun i => q' i * rate' i) s' j) →\n                              (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                                ∀ (α₀ β₀ : ℝ),\n                                  α₀ + β₀ ≤ 1 →\n                                    ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                      MeasurableSet A →\n                                        (CurrentMM.gaussianRecordLaw (N * T)\n                                                  (CurrentMM.p1RepeatedMean N T\n                                                    (CurrentMM.actualCohortImpulse a κ q rate))\n                                                  variance).real\n                                              A ≤\n                                            α₀ →\n                                          (CurrentMM.gaussianRecordLaw (N * T)\n                                                    (CurrentMM.p1RepeatedMean N T\n                                                      (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                    variance).real\n                                                Aᶜ ≤\n                                              β₀ →\n                                            4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                              ↑N * ↑T *\n                                                (2 * W * 2 ^ T * d ^ nmatch * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_twocohort_lower_bound_formal_general","type":"∀ (a κ c d W H : ℝ) (N T : ℕ) (q rate q' rate' : Fin 2 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            0 ≤ W →\n              (∀ (i : Fin 2), 1 - rate i = c + d * ![-1, 1 / 3] i) →\n                (∀ (i : Fin 2), 1 - rate' i = c + d * ![-1 / 2, 2 / 3] i) →\n                  (∀ (i : Fin 2), q i * rate i = W * ![1 / 4, 3 / 4] i) →\n                    (∀ (i : Fin 2), q' i * rate' i = W * ![4 / 7, 3 / 7] i) →\n                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                        ∀ (α₀ β₀ : ℝ),\n                          α₀ + β₀ ≤ 1 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                              MeasurableSet A →\n                                (CurrentMM.gaussianRecordLaw (N * T)\n                                          (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                          variance).real\n                                      A ≤\n                                    α₀ →\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                            (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                            variance).real\n                                        Aᶜ ≤\n                                      β₀ →\n                                    4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                      ↑N * ↑T * (2 * W * 2 ^ T * d ^ 3 * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_every_K_general","type":"∀ (L : ℕ) (a κ c d W H : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            0 ≤ W →\n              (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                  (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                    (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                        ∀ (α₀ β₀ : ℝ),\n                          α₀ + β₀ ≤ 1 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                              MeasurableSet A →\n                                (CurrentMM.gaussianRecordLaw (N * T)\n                                          (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                          variance).real\n                                      A ≤\n                                    α₀ →\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                            (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                            variance).real\n                                        Aᶜ ≤\n                                      β₀ →\n                                    4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                      ↑N * ↑T * (2 * W * 2 ^ T * d ^ (2 * L + 1) * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_worst_error","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (V : ℝ),\n                      ∑ t ∈ Finset.range T, |v t| ≤ V →\n                        ∀ (variance : NNReal),\n                          variance ≠ 0 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                              MeasurableSet A →\n                                (1 - 2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2) * V * δ ^ 2 / (2 * √↑variance)) / 2 ≤\n                                  max\n                                    ((CurrentMM.gaussianRecordLaw T\n                                          (fun t =>\n                                            (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] v\n                                                (↑t + 1)).price)\n                                          variance).real\n                                      A)\n                                    ((CurrentMM.gaussianRecordLaw T\n                                          (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price)\n                                          variance).real\n                                      Aᶜ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_test_general","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (V : ℝ),\n                      ∑ t ∈ Finset.range T, |v t| ≤ V →\n                        ∀ (variance : NNReal),\n                          variance ≠ 0 →\n                            ∀ (α₀ β₀ : ℝ),\n                              α₀ + β₀ ≤ 1 →\n                                ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                                  MeasurableSet A →\n                                    (CurrentMM.gaussianRecordLaw T\n                                              (fun t =>\n                                                (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ]\n                                                    v (↑t + 1)).price)\n                                              variance).real\n                                          A ≤\n                                        α₀ →\n                                      (CurrentMM.gaussianRecordLaw T\n                                                (fun t =>\n                                                  (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price)\n                                                variance).real\n                                            Aᶜ ≤\n                                          β₀ →\n                                        4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                          (2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * V ^ 2 * δ ^ 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_test_general","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∃ m > 0,\n                      ∀ (T : ℕ) (v : Fin T → ℝ) (B P fee : ℝ) (variance : NNReal),\n                        variance ≠ 0 →\n                          0 ≤ fee →\n                            0 ≤\n                                CurrentMM.equity\n                                  (CurrentMM.traderCashAfter B P κ fee (CurrentMM.actualCohortImpulse a κ ![q] ![ηbar])\n                                    v)\n                                  (∑ i, v i) P →\n                              ∀ (α₀ β₀ : ℝ),\n                                α₀ + β₀ < 1 →\n                                  ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                                    MeasurableSet A →\n                                      (CurrentMM.gaussianRecordLaw T\n                                                (fun t =>\n                                                  (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2]\n                                                      ![ηbar - δ, ηbar + δ] (CurrentMM.extendFiniteProbe v)\n                                                      (↑t + 1)).price)\n                                                variance).real\n                                            A ≤\n                                          α₀ →\n                                        (CurrentMM.gaussianRecordLaw T\n                                                  (fun t =>\n                                                    (CurrentMM.controlledCohortRun a κ ![q] ![ηbar]\n                                                        (CurrentMM.extendFiniteProbe v) (↑t + 1)).price)\n                                                  variance).real\n                                              Aᶜ ≤\n                                            β₀ →\n                                          2 * ↑variance * m * (1 - α₀ - β₀) ^ 2 ≤\n                                            (2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * B * δ ^ 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_pop_abs_le","type":"∀ {ι : Type u_1} [inst : Fintype ι] (w s : ι → ℝ) (c d W : ℝ),\n  0 ≤ c →\n    0 ≤ d →\n      (∀ (i : ι), 0 ≤ w i) →\n        ∑ i, w i ≤ W → (∀ (i : ι), |s i| ≤ 1) → ∀ (m : ℕ), |∑ i, w i * (c + d * s i) ^ m| ≤ W * (c + d) ^ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_kernel_gap_l1","type":"∀ {ι : Type u_1} {κι : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κι] (w s : ι → ℝ) (w' s' : κι → ℝ) (c d W : ℝ)\n  (J : ℕ),\n  0 ≤ c →\n    0 ≤ d →\n      c + d < 1 →\n        (∀ (i : ι), 0 ≤ w i) →\n          (∀ (i : κι), 0 ≤ w' i) →\n            ∑ i, w i ≤ W →\n              ∑ i, w' i ≤ W →\n                (∀ (i : ι), |s i| ≤ 1) →\n                  (∀ (i : κι), |s' i| ≤ 1) →\n                    (∀ j < J, ∑ i, w i * s i ^ j = ∑ i, w' i * s' i ^ j) →\n                      ∀ (N : ℕ),\n                        ∑ m ∈ Finset.range N, |∑ i, w i * (c + d * s i) ^ m - ∑ i, w' i * (c + d * s' i) ^ m| ≤\n                          2 * W * (c + d) ^ J / (1 - (c + d))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_rate_node","type":"∀ (ρ : ℝ) (L k : ℕ), ρ / 2 + ρ / 2 * CurrentMM.gridNode L k = ρ * ↑k / (2 * ↑L + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gmWitness_zero","type":"∀ (h : ℝ), CurrentMM.gmWitness h 0 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gmWitness_lipschitz","type":"∀ (h : ℝ), 0 < h → LipschitzWith 1 (CurrentMM.gmWitness h)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gmWitness_node","type":"∀ (h : ℝ), h ≠ 0 → ∀ (k : ℕ), CurrentMM.gmWitness h (h * ↑k) = h / Real.pi * (1 - (-1) ^ k)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_pair_mass","type":"∀ (L : ℕ) (W : ℝ),\n  ∑ i, W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L) = W ∧\n    ∑ i, W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L) = W"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_pair_moments","type":"∀ (L : ℕ) (W : ℝ),\n  ∀ j < 2 * L + 1,\n    ∑ i, W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L) * CurrentMM.gridNode L (2 * ↑i + 1) ^ j =\n      ∑ i, W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L) * CurrentMM.gridNode L (2 * ↑i) ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_general_memory_lower_L","type":"∀ (L : ℕ) (a κ ρ W s : ℝ),\n  0 < κ →\n    0 < ρ →\n      ρ < 1 →\n        0 ≤ W →\n          |a| + κ * (W / (1 - ρ)) ≤ s →\n            s < 1 →\n              ∀ (q rate q' rate' : Fin (L + 1) → ℝ),\n                (∀ (i : Fin (L + 1)), 1 - rate i = ρ * (2 * ↑↑i + 1) / (2 * ↑L + 1)) →\n                  (∀ (i : Fin (L + 1)), 1 - rate' i = ρ * (2 * ↑↑i) / (2 * ↑L + 1)) →\n                    (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                      (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                        ∀ (N T : ℕ) (v : NNReal),\n                          v ≠ 0 →\n                            ∀ (est : CurrentMM.ObservationRecord (N * T) → (ℝ → ℝ) → ℝ),\n                              (∀ (f : ℝ → ℝ), Measurable fun x => est x f) →\n                                3 / 4 ≤\n                                    (CurrentMM.gaussianRecordLaw (N * T)\n                                          (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                          v).real\n                                      {x |\n                                        ∀ (f : ℝ → ℝ),\n                                          LipschitzWith 1 f →\n                                            f 0 = 0 →\n                                              |est x f - ∑ i, q i * rate i * f (1 - rate i)| <\n                                                ρ * W / (Real.pi * (2 * ↑L + 1))} →\n                                  3 / 4 ≤\n                                      (CurrentMM.gaussianRecordLaw (N * T)\n                                            (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                            v).real\n                                        {x |\n                                          ∀ (f : ℝ → ℝ),\n                                            LipschitzWith 1 f →\n                                              f 0 = 0 →\n                                                |est x f - ∑ i, q' i * rate' i * f (1 - rate' i)| <\n                                                  ρ * W / (Real.pi * (2 * ↑L + 1))} →\n                                    ↑v ≤ 2 * ↑N * (2 * κ ^ 2 * W / ((1 - ρ) * (1 - s) ^ 2) * ρ ^ (2 * L + 1)) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_general_memory_lower","type":"∀ (a κ ρ W s : ℝ),\n  0 < κ →\n    0 < ρ →\n      ρ < 1 →\n        0 < W →\n          |a| + κ * (W / (1 - ρ)) ≤ s →\n            s < 1 →\n              ∀ (N T : ℕ) (v : NNReal),\n                v ≠ 0 →\n                  0 < Real.log (2 * ↑N * (2 * κ ^ 2 * W / ((1 - ρ) * (1 - s) ^ 2)) ^ 2 / ↑v) →\n                    ∀ (L : ℕ),\n                      L =\n                          ⌈Real.log (2 * ↑N * (2 * κ ^ 2 * W / ((1 - ρ) * (1 - s) ^ 2)) ^ 2 / ↑v) /\n                              (4 * Real.log ρ⁻¹)⌉₊ →\n                        ∀ (q rate q' rate' : Fin (L + 1) → ℝ),\n                          (∀ (i : Fin (L + 1)), 1 - rate i = ρ * (2 * ↑↑i + 1) / (2 * ↑L + 1)) →\n                            (∀ (i : Fin (L + 1)), 1 - rate' i = ρ * (2 * ↑↑i) / (2 * ↑L + 1)) →\n                              (∀ (i : Fin (L + 1)),\n                                  q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                                (∀ (i : Fin (L + 1)),\n                                    q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                                  ∀ (est : CurrentMM.ObservationRecord (N * T) → (ℝ → ℝ) → ℝ),\n                                    (∀ (f : ℝ → ℝ), Measurable fun x => est x f) →\n                                      ¬(3 / 4 ≤\n                                            (CurrentMM.gaussianRecordLaw (N * T)\n                                                  (CurrentMM.p1RepeatedMean N T\n                                                    (CurrentMM.actualCohortImpulse a κ q rate))\n                                                  v).real\n                                              {x |\n                                                ∀ (f : ℝ → ℝ),\n                                                  LipschitzWith 1 f →\n                                                    f 0 = 0 →\n                                                      |est x f - ∑ i, q i * rate i * f (1 - rate i)| <\n                                                        2 * ρ * W * Real.log ρ⁻¹ /\n                                                          (Real.pi *\n                                                            (Real.log\n                                                                (2 * ↑N *\n                                                                    (2 * κ ^ 2 * W / ((1 - ρ) * (1 - s) ^ 2)) ^ 2 /\n                                                                  ↑v) +\n                                                              6 * Real.log ρ⁻¹))} ∧\n                                          3 / 4 ≤\n                                            (CurrentMM.gaussianRecordLaw (N * T)\n                                                  (CurrentMM.p1RepeatedMean N T\n                                                    (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                  v).real\n                                              {x |\n                                                ∀ (f : ℝ → ℝ),\n                                                  LipschitzWith 1 f →\n                                                    f 0 = 0 →\n                                                      |est x f - ∑ i, q' i * rate' i * f (1 - rate' i)| <\n                                                        2 * ρ * W * Real.log ρ⁻¹ /\n                                                          (Real.pi *\n                                                            (Real.log\n                                                                (2 * ↑N *\n                                                                    (2 * κ ^ 2 * W / ((1 - ρ) * (1 - s) ^ 2)) ^ 2 /\n                                                                  ↑v) +\n                                                              6 * Real.log ρ⁻¹))})"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sqrt_log_le","type":"∀ (z : ℝ), 0 < z → √(Real.log z) ≤ 1 + z"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_rate_core","type":"∀ (A b B W ρ β : ℝ),\n  0 < A →\n    0 ≤ b →\n      1 ≤ B →\n        0 < W →\n          0 < ρ →\n            0 < β →\n              1 / 8 ≤ Real.log (B * (1 + b)) →\n                ∃ x0,\n                  ∀ x ≥ x0,\n                    ∀ (L : ℕ),\n                      L = ⌊Real.log x / (8 * Real.log (B * (1 + b)))⌋₊ →\n                        ∀ (η : ℝ),\n                          0 ≤ η →\n                            η ≤ A * (√2 * √(Real.log (4 * ↑(L + 1) / β)) / √x) →\n                              √2 * √(Real.log (4 * ↑(L + 1) / β)) / √x ≤ 1 ∧\n                                ρ * Real.pi / (2 * (↑L + 2)) *\n                                      (2 * W + 2 * (A * (√2 * √(Real.log (4 * ↑(L + 1) / β)) / √x) * (1 + b) ^ L) + η) +\n                                    ρ * (↑L + 1) * B ^ L *\n                                      (2 * (A * (√2 * √(Real.log (4 * ↑(L + 1) / β)) / √x) * (1 + b) ^ L) + η) ≤\n                                  16 * Real.pi * ρ * W * Real.log (B * (1 + b)) / Real.log x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_general_memory_rate","type":"∀ (a κ ρ s : ℝ),\n  κ ≠ 0 →\n    0 < ρ →\n      ρ < 1 →\n        ∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ],\n          μ (Set.Icc 0 ρ)ᶜ = 0 →\n            0 < μ.real Set.univ →\n              |a| + |κ| * (μ.real Set.univ / (1 - ρ)) ≤ s →\n                s < 1 →\n                  ∀ (h : ℕ → ℝ),\n                    h 0 = κ →\n                      (∀ (t : ℕ),\n                          h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), (∫ (r : ℝ), r ^ j ∂μ) * h (t - j)) →\n                        ∀ (β : ℝ),\n                          0 < β →\n                            β < 1 →\n                              ∃ x0,\n                                ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω)\n                                  [MeasureTheory.IsProbabilityMeasure P] {N : ℕ},\n                                  0 < N →\n                                    ∀ (ξ : Fin N → ℕ → Ω → ℝ) (v : NNReal),\n                                      0 < v →\n                                        (∀ (t : ℕ), ProbabilityTheory.iIndepFun (fun n => ξ n t) P) →\n                                          (∀ (n : Fin N) (t : ℕ), ProbabilityTheory.HasSubgaussianMGF (ξ n t) v P) →\n                                            x0 ≤ ↑N / ↑v →\n                                              ∀ (L : ℕ),\n                                                L =\n                                                    ⌊Real.log (↑N / ↑v) /\n                                                        (8 *\n                                                          Real.log\n                                                            ((2 / ρ + 1) * (1 + √2) *\n                                                              (1 + |κ| * (|κ| / (1 - s) + 1) / κ ^ 2)))⌋₊ →\n                                                  ∀ (η : ℝ),\n                                                    0 ≤ η →\n                                                      η ≤\n                                                          (1 + |a| + |κ| * (μ.real Set.univ / (1 - ρ))) / κ ^ 2 *\n                                                            CurrentMM.gmNoise L β v N →\n                                                        P.real\n                                                            {ω |\n                                                              ¬∀ (ν : MeasureTheory.Measure ℝ),\n                                                                  MeasureTheory.IsFiniteMeasure ν →\n                                                                    ν (Set.Icc 0 ρ)ᶜ = 0 →\n                                                                      (∀ i < L + 1,\n                                                                          |∫ (r : ℝ), r ^ i ∂ν -\n                                                                                CurrentMM.deconv a κ\n                                                                                  (CurrentMM.observedTaps κ h fun t =>\n                                                                                    (∑ n, ξ n t ω) / ↑N)\n                                                                                  i| ≤\n                                                                            ((Finset.range (L + 1)).sup' ⋯ fun i =>\n                                                                                |∫ (r : ℝ), r ^ i ∂μ - ⋯|) +\n                                                                              η) →\n                                                                        ∀ (f : ℝ → ℝ),\n                                                                          LipschitzOnWith 1 f (Set.Icc 0 ρ) →\n                                                                            f 0 = 0 →\n                                                                              |∫ (r : ℝ), f r ∂ν - ∫ (r : ℝ), f r ∂μ| ≤\n                                                                                16 * Real.pi * ρ * μ.real Set.univ *\n                                                                                    Real.log (⋯ * ⋯) /\n                                                                                  Real.log (↑N / ↑v)} ≤\n                                                          β"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_ae_mem_Icc","type":"∀ (μ : MeasureTheory.Measure ℝ) (ρ : ℝ), μ (Set.Icc 0 ρ)ᶜ = 0 → ∀ᵐ (r : ℝ) ∂μ, r ∈ Set.Icc 0 ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_integrable_of_supp","type":"∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ] (ρ : ℝ),\n  μ (Set.Icc 0 ρ)ᶜ = 0 → ∀ (F : ℝ → ℝ), ContinuousOn F (Set.Icc 0 ρ) → MeasureTheory.Integrable F μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_integral_poly","type":"∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ] (ρ : ℝ),\n  μ (Set.Icc 0 ρ)ᶜ = 0 →\n    ∀ (q : Polynomial ℝ) (N : ℕ),\n      q.natDegree < N → ∫ (r : ℝ), Polynomial.eval r q ∂μ = ∑ i ∈ Finset.range N, q.coeff i * ∫ (r : ℝ), r ^ i ∂μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gm_moment_comparison","type":"∀ (ρ : ℝ),\n  0 < ρ →\n    ∀ (n : ℕ) (μ ν : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ] [MeasureTheory.IsFiniteMeasure ν],\n      μ (Set.Icc 0 ρ)ᶜ = 0 →\n        ν (Set.Icc 0 ρ)ᶜ = 0 →\n          ∀ (δ : ℝ),\n            (∀ i < n + 1, |∫ (r : ℝ), r ^ i ∂ν - ∫ (r : ℝ), r ^ i ∂μ| ≤ δ) →\n              ∀ (f : ℝ → ℝ),\n                LipschitzOnWith 1 f (Set.Icc 0 ρ) →\n                  f 0 = 0 →\n                    |∫ (r : ℝ), f r ∂ν - ∫ (r : ℝ), f r ∂μ| ≤\n                      ρ * Real.pi / (2 * (↑n + 2)) * (ν.real Set.univ + μ.real Set.univ) +\n                        ρ * (↑n + 1) * ((2 / ρ + 1) * (1 + √2)) ^ n * δ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_deconv_error_explicit","type":"∀ (a κ H K1 : ℝ),\n  κ ≠ 0 →\n    ∀ (k h hh : ℕ → ℝ),\n      h 0 = κ →\n        (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n          (∀ (t : ℕ), |h t| ≤ H) →\n            (∀ (n : ℕ), ∑ m ∈ Finset.range n, |k m| ≤ K1) →\n              ∀ (T : ℕ) (ε : ℝ),\n                0 ≤ ε →\n                  ε ≤ 1 →\n                    (∀ t ≤ T + 1, |hh t - h t| ≤ ε) →\n                      ∀ t ≤ T,\n                        |CurrentMM.deconv a κ hh t - k t| ≤\n                          (1 + |a| + |κ| * K1) / κ ^ 2 * ε * (1 + |κ| * (H + 1) / κ ^ 2) ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_moment_kernel_abs_le","type":"∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ] (ρ : ℝ),\n  0 ≤ ρ → μ (Set.Icc 0 ρ)ᶜ = 0 → ∀ (m : ℕ), |∫ (r : ℝ), r ^ m ∂μ| ≤ ρ ^ m * μ.real Set.univ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_general_memory_upper","type":"∀ (a κ ρ s : ℝ),\n  κ ≠ 0 →\n    0 < ρ →\n      ρ < 1 →\n        ∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ],\n          μ (Set.Icc 0 ρ)ᶜ = 0 →\n            |a| + |κ| * (μ.real Set.univ / (1 - ρ)) ≤ s →\n              s < 1 →\n                ∀ (h : ℕ → ℝ),\n                  h 0 = κ →\n                    (∀ (t : ℕ),\n                        h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), (∫ (r : ℝ), r ^ j ∂μ) * h (t - j)) →\n                      ∀ (L : ℕ) (η : ℝ),\n                        0 ≤ η →\n                          ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω)\n                            [MeasureTheory.IsProbabilityMeasure P] {N : ℕ},\n                            0 < N →\n                              ∀ (ξ : Fin N → ℕ → Ω → ℝ) (v : NNReal),\n                                0 < v →\n                                  (∀ (t : ℕ), ProbabilityTheory.iIndepFun (fun n => ξ n t) P) →\n                                    (∀ (n : Fin N) (t : ℕ), ProbabilityTheory.HasSubgaussianMGF (ξ n t) v P) →\n                                      ∀ (β : ℝ),\n                                        0 < β →\n                                          β < 1 →\n                                            CurrentMM.gmNoise L β v N ≤ 1 →\n                                              P.real\n                                                  {ω |\n                                                    ¬∀ (ν : MeasureTheory.Measure ℝ),\n                                                        MeasureTheory.IsFiniteMeasure ν →\n                                                          ν (Set.Icc 0 ρ)ᶜ = 0 →\n                                                            (∀ i < L + 1,\n                                                                |∫ (r : ℝ), r ^ i ∂ν -\n                                                                      CurrentMM.deconv a κ\n                                                                        (CurrentMM.observedTaps κ h fun t =>\n                                                                          (∑ n, ξ n t ω) / ↑N)\n                                                                        i| ≤\n                                                                  ((Finset.range (L + 1)).sup' ⋯ fun i =>\n                                                                      |∫ (r : ℝ), r ^ i ∂μ -\n                                                                          CurrentMM.deconv a κ\n                                                                            (CurrentMM.observedTaps κ h fun t =>\n                                                                              (∑ n, ξ n t ω) / ↑N)\n                                                                            i|) +\n                                                                    η) →\n                                                              ∀ (f : ℝ → ℝ),\n                                                                LipschitzOnWith 1 f (Set.Icc 0 ρ) →\n                                                                  f 0 = 0 →\n                                                                    |∫ (r : ℝ), f r ∂ν - ∫ (r : ℝ), f r ∂μ| ≤\n                                                                      CurrentMM.gmBound ρ (μ.real Set.univ) L\n                                                                        (CurrentMM.gmDelta a κ ρ s (μ.real Set.univ) L\n                                                                          (CurrentMM.gmNoise L β v N))\n                                                                        η} ≤\n                                                β"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_halt_moment_gap_le","type":"∀ (W c d : ℝ) (M N : ℕ → ℝ) (m : ℕ),\n  3 ≤ m →\n    (∀ k ≤ 2, M k = N k) →\n      (∀ (k : ℕ), |M k| ≤ W) →\n        (∀ (k : ℕ), |N k| ≤ W) →\n          |∑ k ∈ Finset.range (m + 1), ↑(m.choose k) * c ^ (m - k) * d ^ k * (M k - N k)| ≤\n            2 * W * ↑(m.choose 3) * |d| ^ 3 * (|c| + |d|) ^ (m - 3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_halt_kernel_bound","type":"∀ (W c d σ : ℝ),\n  0 ≤ W →\n    σ ^ 2 = 1 / 3 →\n      0 ≤ σ →\n        ∀ (m : ℕ),\n          3 ≤ m →\n            |W / 2 * (c + d * σ) ^ m + W / 2 * (c + d * -σ) ^ m -\n                  (W / 4 * (c + d * -1) ^ m + 3 * W / 4 * (c + d * (1 / 3)) ^ m)| ≤\n              2 * W * ↑(m.choose 3) * |d| ^ 3 * (|c| + |d|) ^ (m - 3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iv_boundary_decomposition","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (Z : ℕ → E) (ε : ℕ → ℝ) (r : ℝ) (T : ℕ),\n  ∑ t ∈ Finset.Ico 1 (T + 1), (ε t - r * ε (t - 1)) • Z t =\n    ∑ t ∈ Finset.Ico 1 (T + 1), ε t • (Z t - r • Z (t + 1)) + (r * ε T) • Z (T + 1) - (r * ε 0) • Z 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_deconvolution","type":"∀ (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (k k' h : ℕ → ℝ),\n      h 0 = κ →\n        (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n          (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h (t - j)) → ∀ (m : ℕ), k m = k' m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_kernel_from_measure","type":"∀ (a κ : ℝ) (k h h' : ℕ → ℝ),\n  h 0 = κ →\n    h' 0 = κ →\n      (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n        (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k j * h' (t - j)) → ∀ (t : ℕ), h t = h' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_merged_exp_sums_independent","type":"∀ (R : Finset ℝ) (c : ℝ → ℝ), (∀ (m : ℕ), ∑ ρ ∈ R, c ρ * ρ ^ m = 0) → ∀ ρ ∈ R, c ρ = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_measure_identified","type":"∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι) (T : Finset κ) (r w : ι → ℝ) (r' w' : κ → ℝ),\n  (∀ (m : ℕ), ∑ i ∈ S, w i * r i ^ m = ∑ i ∈ T, w' i * r' i ^ m) →\n    ∀ (ρ : ℝ), CurrentMM.mergedWeight S r w ρ = CurrentMM.mergedWeight T r' w' ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_price_law","type":"∀ {K : ℕ} (κ D : ℝ) (w r β u : Fin K → ℝ) (H x : ℝ),\n  D = 1 - ∑ i, β i * w i → D * x = -κ * H + ∑ i, β i * r i * u i → x = -κ * H + ∑ i, β i * (r i * u i + w i * x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_sum_aux","type":"∀ {K : ℕ} (κ ab D H : ℝ) (r β v : Fin K → ℝ),\n  (∀ (i : Fin K), κ * v i + β i * r i * v i = D * (β i * v i)) →\n    -κ * (ab * H - ∑ i, v i) + ∑ i, β i * r i * v i = -κ * ab * H + D * ∑ i, β i * v i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_foc","type":"∀ {K : ℕ} (A V ab κ D : ℝ) (w r β u : Fin K → ℝ) (Hprev ξ : ℝ),\n  D ≠ 0 →\n    (∀ (i : Fin K), β i * (D - r i) = κ) →\n      D = 1 - ∑ i, β i * w i →\n        κ * (D - ab) = A * V * D →\n          have H := ab * Hprev - ∑ i, u i - ξ;\n          have x := (-κ * H + ∑ i, β i * r i * u i) / D;\n          have u' := fun i => r i * u i + w i * x;\n          have H' := ab * H - ∑ i, u' i;\n          have x' := (-κ * H' + ∑ i, β i * r i * u' i) / D;\n          x' - x = A * V * H"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_innovation","type":"∀ {K : ℕ} (ab κ D : ℝ) (r β u' : Fin K → ℝ) (H ξ' : ℝ),\n  D ≠ 0 →\n    (-κ * (ab * H - ∑ i, u' i - ξ') + ∑ i, β i * r i * u' i) / D -\n        (-κ * (ab * H - ∑ i, u' i) + ∑ i, β i * r i * u' i) / D =\n      κ / D * ξ'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_benchmark","type":"∀ (A sF2 sX2 ab : ℝ),\n  A * sX2 ≠ 0 → ((∃ κ, κ * (1 - ab) = A * (sF2 + κ ^ 2 * sX2)) ↔ 4 * A ^ 2 * sF2 * sX2 ≤ (1 - ab) ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_IFT_hasStrictFDerivAt","type":"∀ (A sF2 sX2 ab k0 : ℝ) (g : ℝ → ℝ) (g' : ℝ),\n  HasStrictDerivAt g g' 1 →\n    ∀ (hs : 1 - ab - 2 * A * k0 * sX2 ≠ 0),\n      HasStrictFDerivAt (CurrentMM.p1IFTPsi A sF2 sX2 ab g)\n        ↑(CurrentMM.p1IFTLin (k0 * g 1) (1 - ab - 2 * A * k0 * sX2) (k0 * (2 - ab) - 2 * A * sF2)\n              hs).toContinuousLinearEquiv\n        (0, k0, 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inventory_small_feedback","type":"∀ (A sF2 sX2 ab k0 : ℝ) (g : ℝ → ℝ) (g' : ℝ),\n  HasStrictDerivAt g g' 1 →\n    A * (sF2 + k0 ^ 2 * sX2) = k0 * (1 - ab) →\n      1 - ab - 2 * A * k0 * sX2 ≠ 0 →\n        ∃ U ∈ nhds (k0, 1),\n          ∃ sol,\n            sol 0 = (k0, 1) ∧\n              (∀ᶠ (ε : ℝ) in nhds 0,\n                  sol ε ∈ U ∧\n                    (sol ε).2 + ε * (sol ε).1 * g (sol ε).2 - 1 = 0 ∧\n                      (sol ε).1 * ((sol ε).2 - ab) * (sol ε).2 - A * (sF2 * (sol ε).2 ^ 2 + (sol ε).1 ^ 2 * sX2) = 0 ∧\n                        ∀ q ∈ U,\n                          q.2 + ε * q.1 * g q.2 - 1 = 0 →\n                            q.1 * (q.2 - ab) * q.2 - A * (sF2 * q.2 ^ 2 + q.1 ^ 2 * sX2) = 0 → q = sol ε) ∧\n                HasDerivAt (fun ε => (sol ε).2) (-(k0 * g 1)) 0 ∧\n                  HasDerivAt (fun ε => (sol ε).1) (k0 ^ 2 * (ab + 2 * A * k0 * sX2) * g 1 / (1 - ab - 2 * A * k0 * sX2))\n                    0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_cos_arith","type":"∀ (α β : ℝ) (M : ℕ),\n  Complex.exp (↑β * Complex.I) ≠ 1 →\n    Complex.exp (↑β * Complex.I) ^ M = 1 → ∑ j ∈ Finset.range M, Real.cos (α + ↑j * β) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_node_cos_sum","type":"∀ (M : ℕ) (d : ℤ),\n  |d| < ↑M → ∀ (θ : ℝ), ∑ j ∈ Finset.range M, Real.cos (↑d * (θ - 2 * Real.pi * ↑j / ↑M)) = if d = 0 then ↑M else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_node_cos_sum_int","type":"∀ (M k l : ℕ) (c : ℤ),\n  |↑k - ↑l + c| < ↑M →\n    ∀ (θ : ℝ),\n      ∑ j ∈ Finset.range M, Real.cos ((↑k - ↑l + ↑c) * (θ - 2 * Real.pi * ↑j / ↑M)) = if ↑k - ↑l + c = 0 then ↑M else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkA_nonneg","type":"∀ (n k : ℕ), k < n + 1 → 0 ≤ CurrentMM.fkA n k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkS_pos","type":"∀ (n : ℕ), 0 < CurrentMM.fkS n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_numerator_sq","type":"∀ (n : ℕ) (u : ℝ),\n  ∑ k ∈ Finset.range (n + 1),\n      ∑ l ∈ Finset.range (n + 1), CurrentMM.fkA n k * CurrentMM.fkA n l * Real.cos ((↑k - ↑l) * u) =\n    (∑ k ∈ Finset.range (n + 1), CurrentMM.fkA n k * Real.cos (↑k * u)) ^ 2 +\n      (∑ k ∈ Finset.range (n + 1), CurrentMM.fkA n k * Real.sin (↑k * u)) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkKer_nonneg","type":"∀ (n : ℕ) (u : ℝ), 0 ≤ CurrentMM.fkKer n u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkKer_neg","type":"∀ (n : ℕ) (u : ℝ), CurrentMM.fkKer n (-u) = CurrentMM.fkKer n u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_diag","type":"∀ (n : ℕ),\n  (∑ k ∈ Finset.range (n + 1),\n      ∑ l ∈ Finset.range (n + 1), if ↑k - ↑l + 0 = 0 then CurrentMM.fkA n k * CurrentMM.fkA n l else 0) =\n    CurrentMM.fkS n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_offdiag_plus","type":"∀ (n : ℕ),\n  (∑ k ∈ Finset.range (n + 1),\n      ∑ l ∈ Finset.range (n + 1), if ↑k - ↑l + 1 = 0 then CurrentMM.fkA n k * CurrentMM.fkA n l else 0) =\n    CurrentMM.fkP n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_offdiag_minus","type":"∀ (n : ℕ),\n  (∑ k ∈ Finset.range (n + 1),\n      ∑ l ∈ Finset.range (n + 1), if ↑k - ↑l + -1 = 0 then CurrentMM.fkA n k * CurrentMM.fkA n l else 0) =\n    CurrentMM.fkP n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_node_pair","type":"∀ (n M : ℕ) (c : ℤ),\n  |c| ≤ 1 →\n    n + 1 < M →\n      ∀ (θ : ℝ),\n        ∑ k ∈ Finset.range (n + 1),\n            ∑ l ∈ Finset.range (n + 1),\n              CurrentMM.fkA n k * CurrentMM.fkA n l *\n                ∑ j ∈ Finset.range M, Real.cos ((↑k - ↑l + ↑c) * (θ - 2 * Real.pi * ↑j / ↑M)) =\n          ↑M *\n            ∑ k ∈ Finset.range (n + 1),\n              ∑ l ∈ Finset.range (n + 1), if ↑k - ↑l + c = 0 then CurrentMM.fkA n k * CurrentMM.fkA n l else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkKer_node_sum","type":"∀ (n M : ℕ), n + 1 < M → ∀ (θ : ℝ), ∑ j ∈ Finset.range M, CurrentMM.fkKer n (θ - 2 * Real.pi * ↑j / ↑M) = ↑M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkP_eq","type":"∀ (n : ℕ), CurrentMM.fkP n = Real.cos (Real.pi / (↑n + 2)) * CurrentMM.fkS n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cos_prod","type":"∀ (d x : ℝ),\n  Real.cos (d * x) * (1 - Real.cos x) =\n    Real.cos ((d + 0) * x) - Real.cos ((d + 1) * x) / 2 - Real.cos ((d + -1) * x) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkKer_node_moment","type":"∀ (n M : ℕ),\n  n + 1 < M →\n    ∀ (θ : ℝ),\n      ∑ j ∈ Finset.range M, CurrentMM.fkKer n (θ - 2 * Real.pi * ↑j / ↑M) * (1 - Real.cos (θ - 2 * Real.pi * ↑j / ↑M)) =\n        ↑M * (1 - Real.cos (Real.pi / (↑n + 2)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_one_sub_cos_le","type":"∀ (n : ℕ), 1 - Real.cos (Real.pi / (↑n + 2)) ≤ (Real.pi / (↑n + 2)) ^ 2 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_weighted_cs","type":"∀ (M : ℕ) (w s : ℕ → ℝ),\n  (∀ (j : ℕ), 0 ≤ w j) →\n    (∑ j ∈ Finset.range M, w j * |s j|) ^ 2 ≤ (∑ j ∈ Finset.range M, w j * s j ^ 2) * ∑ j ∈ Finset.range M, w j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fk_abs_sin_sum","type":"∀ (n : ℕ) (θ : ℝ),\n  (∑ j ∈ Finset.range (n + 2),\n        CurrentMM.fkKer n (θ - 2 * Real.pi * ↑j / ↑(n + 2)) * |Real.sin ((θ - 2 * Real.pi * ↑j / ↑(n + 2)) / 2)|) ^\n      2 ≤\n    ↑(n + 2) ^ 2 * ((Real.pi / (↑n + 2)) ^ 2 / 4)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jop_error","type":"∀ (n : ℕ) (g : ℝ → ℝ) (L : ℝ),\n  0 ≤ L →\n    (∀ x ∈ Set.Icc (-1) 1, ∀ y ∈ Set.Icc (-1) 1, |g x - g y| ≤ L * |x - y|) →\n      ∀ (θ : ℝ), |CurrentMM.jop n g θ - g (Real.cos θ)| ≤ L * (Real.pi / (↑n + 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkKer_pm","type":"∀ (n : ℕ) (θ t : ℝ),\n  (CurrentMM.fkKer n (θ - t) + CurrentMM.fkKer n (θ + t)) / 2 =\n    (∑ k ∈ Finset.range (n + 1),\n        ∑ l ∈ Finset.range (n + 1),\n          CurrentMM.fkA n k * CurrentMM.fkA n l * (Real.cos ((↑k - ↑l) * θ) * Real.cos ((↑k - ↑l) * t))) /\n      CurrentMM.fkS n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jpoly_eval_cos","type":"∀ (n : ℕ) (g : ℝ → ℝ) (θ : ℝ), Polynomial.eval (Real.cos θ) (CurrentMM.jpoly n g) = CurrentMM.jop n g θ"}
{"axioms":["propext","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_natAbs_sub_le","type":"∀ (n k l : ℕ), k < n + 1 → l < n + 1 → (↑k - ↑l).natAbs ≤ n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jpoly_natDegree","type":"∀ (n : ℕ) (g : ℝ → ℝ), (CurrentMM.jpoly n g).natDegree ≤ n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jackson","type":"∀ (n : ℕ) (g : ℝ → ℝ) (L : ℝ),\n  0 ≤ L →\n    (∀ x ∈ Set.Icc (-1) 1, ∀ y ∈ Set.Icc (-1) 1, |g x - g y| ≤ L * |x - y|) →\n      ∀ x ∈ Set.Icc (-1) 1, |Polynomial.eval x (CurrentMM.jpoly n g) - g x| ≤ L * (Real.pi / (↑n + 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_nonneg","type":"∀ (N : ℕ) (p : Polynomial ℝ), 0 ≤ CurrentMM.cl1 N p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_add","type":"∀ (N : ℕ) (p q : Polynomial ℝ), CurrentMM.cl1 N (p + q) ≤ CurrentMM.cl1 N p + CurrentMM.cl1 N q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_sub","type":"∀ (N : ℕ) (p q : Polynomial ℝ), CurrentMM.cl1 N (p - q) ≤ CurrentMM.cl1 N p + CurrentMM.cl1 N q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_C_mul","type":"∀ (N : ℕ) (c : ℝ) (p : Polynomial ℝ), CurrentMM.cl1 N (Polynomial.C c * p) = |c| * CurrentMM.cl1 N p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_sum","type":"∀ {ι : Type u_1} (s : Finset ι) (N : ℕ) (p : ι → Polynomial ℝ),\n  CurrentMM.cl1 N (∑ i ∈ s, p i) ≤ ∑ i ∈ s, CurrentMM.cl1 N (p i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_extend","type":"∀ (N N' : ℕ) (p : Polynomial ℝ), p.natDegree < N → N ≤ N' → CurrentMM.cl1 N' p = CurrentMM.cl1 N p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_X_mul","type":"∀ (N : ℕ) (p : Polynomial ℝ), p.natDegree < N → CurrentMM.cl1 (N + 1) (Polynomial.X * p) = CurrentMM.cl1 N p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_linear_mul","type":"∀ (N : ℕ) (α β : ℝ) (p : Polynomial ℝ),\n  p.natDegree < N →\n    CurrentMM.cl1 (N + 1) ((Polynomial.C α * Polynomial.X + Polynomial.C β) * p) ≤ (|α| + |β|) * CurrentMM.cl1 N p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cheb_comp_natDegree","type":"∀ (α β : ℝ) (m : ℕ), ((Polynomial.Chebyshev.T ℝ ↑m).comp (Polynomial.C α * Polynomial.X + Polynomial.C β)).natDegree ≤ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cheb_comp_rec","type":"∀ (α β : ℝ) (m : ℕ),\n  (Polynomial.Chebyshev.T ℝ ↑(m + 2)).comp (Polynomial.C α * Polynomial.X + Polynomial.C β) =\n    Polynomial.C 2 *\n        ((Polynomial.C α * Polynomial.X + Polynomial.C β) *\n          (Polynomial.Chebyshev.T ℝ ↑(m + 1)).comp (Polynomial.C α * Polynomial.X + Polynomial.C β)) -\n      (Polynomial.Chebyshev.T ℝ ↑m).comp (Polynomial.C α * Polynomial.X + Polynomial.C β)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cl1_chebyshev_comp","type":"∀ (α β : ℝ),\n  1 ≤ |α| + |β| →\n    ∀ (m : ℕ),\n      CurrentMM.cl1 (m + 1) ((Polynomial.Chebyshev.T ℝ ↑m).comp (Polynomial.C α * Polynomial.X + Polynomial.C β)) ≤\n        ((|α| + |β|) * (1 + √2)) ^ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jcoef_abs_le","type":"∀ (n : ℕ) (g : ℝ → ℝ) (G : ℝ),\n  (∀ x ∈ Set.Icc (-1) 1, |g x| ≤ G) →\n    ∀ (k l : ℕ),\n      k < n + 1 → l < n + 1 → |CurrentMM.jcoef n g k l| ≤ CurrentMM.fkA n k * CurrentMM.fkA n l / CurrentMM.fkS n * G"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_fkA_sum_sq_le","type":"∀ (n : ℕ),\n  ∑ k ∈ Finset.range (n + 1), ∑ l ∈ Finset.range (n + 1), CurrentMM.fkA n k * CurrentMM.fkA n l / CurrentMM.fkS n ≤\n    ↑n + 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_jpoly_comp_cl1","type":"∀ (n : ℕ) (g : ℝ → ℝ) (G : ℝ),\n  0 ≤ G →\n    (∀ x ∈ Set.Icc (-1) 1, |g x| ≤ G) →\n      ∀ (α β : ℝ),\n        1 ≤ |α| + |β| →\n          CurrentMM.cl1 (n + 1) ((CurrentMM.jpoly n g).comp (Polynomial.C α * Polynomial.X + Polynomial.C β)) ≤\n            G * (↑n + 1) * ((|α| + |β|) * (1 + √2)) ^ n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kc_witness_lipschitz","type":"∀ (h b C : ℝ), 0 < h → LipschitzWith 1 fun r => CurrentMM.gmWitness h (r - b) - C"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kc_node_shift","type":"∀ (L : ℕ) (c d : ℝ) (k : ℕ), c + d * CurrentMM.gridNode L k - (c - d) = 2 * d / (2 * ↑L + 1) * ↑k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_weights","type":"∀ (L : ℕ) (a κ c d W s : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (v : NNReal),\n  v ≠ 0 →\n    0 ≤ c →\n      0 < d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + |κ| * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                  (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                    (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                      (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                        ∀ (est : CurrentMM.ObservationRecord (N * T) → Fin (L + 1) → ℝ),\n                          (∀ (i : Fin (L + 1)), Measurable fun x => est x i) →\n                            3 / 4 ≤\n                                (CurrentMM.gaussianRecordLaw (N * T)\n                                      (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate)) v).real\n                                  {x | ∀ (i : Fin (L + 1)), |est x i - q i * rate i| < ↑L * W / 4 ^ L} →\n                              3 / 4 ≤\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                        (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                        v).real\n                                    {x | ∀ (i : Fin (L + 1)), |est x i - q' i * rate' i| < ↑L * W / 4 ^ L} →\n                                ↑v ≤\n                                  ↑N *\n                                    (2 * κ ^ 2 * W / ((1 - (c + d)) ^ (2 * L + 2) * (1 - s) ^ 2) * d ^ (2 * L + 1)) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_W1","type":"∀ (L : ℕ) (a κ c d W s : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (v : NNReal),\n  v ≠ 0 →\n    0 ≤ c →\n      0 < d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + |κ| * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                  (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                    (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                      (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                        ∀ (est : CurrentMM.ObservationRecord (N * T) → (ℝ → ℝ) → ℝ),\n                          (∀ (f : ℝ → ℝ), Measurable fun x => est x f) →\n                            3 / 4 ≤\n                                (CurrentMM.gaussianRecordLaw (N * T)\n                                      (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate)) v).real\n                                  {x |\n                                    ∀ (f : ℝ → ℝ),\n                                      LipschitzWith 1 f →\n                                        f 0 = 0 →\n                                          |est x f - ∑ i, q i * rate i * f (1 - rate i)| <\n                                            2 * d * W / (Real.pi * (2 * ↑L + 1))} →\n                              3 / 4 ≤\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                        (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                        v).real\n                                    {x |\n                                      ∀ (f : ℝ → ℝ),\n                                        LipschitzWith 1 f →\n                                          f 0 = 0 →\n                                            |est x f - ∑ i, q' i * rate' i * f (1 - rate' i)| <\n                                              2 * d * W / (Real.pi * (2 * ↑L + 1))} →\n                                ↑v ≤\n                                  ↑N *\n                                    (2 * κ ^ 2 * W / ((1 - (c + d)) ^ (2 * L + 2) * (1 - s) ^ 2) * d ^ (2 * L + 1)) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_choose_geom_sum_le","type":"∀ (x : ℝ), 0 ≤ x → x < 1 → ∀ (n N : ℕ), ∑ m ∈ Finset.range N, ↑(m.choose n) * x ^ m ≤ x ^ n / (1 - x) ^ (n + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kc_kernel_gap_l1","type":"∀ {ι : Type u_1} {κι : Type u_2} (S : Finset ι) (T' : Finset κι) (w s : ι → ℝ) (w' s' : κι → ℝ) (c d W : ℝ) (n : ℕ),\n  0 ≤ c →\n    0 ≤ d →\n      0 < c + d →\n        c + d < 1 →\n          (∀ i ∈ S, 0 ≤ w i) →\n            (∀ i ∈ T', 0 ≤ w' i) →\n              (∀ i ∈ S, |s i| ≤ 1) →\n                (∀ i ∈ T', |s' i| ≤ 1) →\n                  ∑ i ∈ S, w i ≤ W →\n                    ∑ i ∈ T', w' i ≤ W →\n                      (∀ j < n, CurrentMM.mgMoment S w s j = CurrentMM.mgMoment T' w' s' j) →\n                        ∀ (N : ℕ),\n                          ∑ m ∈ Finset.range N, |CurrentMM.mgKernel S w s c d m - CurrentMM.mgKernel T' w' s' c d m| ≤\n                            2 * W * d ^ n / (1 - (c + d)) ^ (n + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_uniform","type":"∀ (L : ℕ) (a κ c d W s : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        0 < c + d →\n          c + d < 1 →\n            0 ≤ W →\n              |a| + |κ| * (W / (1 - (c + d))) ≤ s →\n                s < 1 →\n                  (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                    (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                      (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                        (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                          ∀ (α₀ β₀ : ℝ),\n                            α₀ + β₀ ≤ 1 →\n                              ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                MeasurableSet A →\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                            (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                            variance).real\n                                        A ≤\n                                      α₀ →\n                                    (CurrentMM.gaussianRecordLaw (N * T)\n                                              (CurrentMM.p1RepeatedMean N T\n                                                (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                              variance).real\n                                          Aᶜ ≤\n                                        β₀ →\n                                      4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                        ↑N *\n                                          (2 * κ ^ 2 * W / ((1 - (c + d)) ^ (2 * L + 2) * (1 - s) ^ 2) *\n                                              d ^ (2 * L + 1)) ^\n                                            2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_lipschitz","type":"∀ (s s' : ℝ), 0 < s → 0 < s' → |CurrentMM.kalmanGain s - CurrentMM.kalmanGain s'| ≤ |s - s'| / s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gridNode_last","type":"∀ (L : ℕ), CurrentMM.gridNode L (2 * L + 1) = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gridNode_zero","type":"∀ (L : ℕ), CurrentMM.gridNode L 0 = -1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_primitives_lower_bound","type":"∀ (L : ℕ) (a κ c d W H slo Δs sc : ℝ) (N T : ℕ) (q rate q' rate' snr snr' : Fin (L + 1) → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            0 ≤ W →\n              0 < slo →\n                slo ≤ sc - Δs →\n                  (∀ (i : Fin (L + 1)), |snr i - sc| ≤ Δs) →\n                    (∀ (i : Fin (L + 1)), |snr' i - sc| ≤ Δs) →\n                      (∀ (i : Fin (L + 1)), rate i = CurrentMM.kalmanGain (snr i)) →\n                        (∀ (i : Fin (L + 1)), rate' i = CurrentMM.kalmanGain (snr' i)) →\n                          (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                            (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                              (∀ (i : Fin (L + 1)),\n                                  q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                                (∀ (i : Fin (L + 1)),\n                                    q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                                  (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                                    ∀ (α₀ β₀ : ℝ),\n                                      α₀ + β₀ ≤ 1 →\n                                        ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                          MeasurableSet A →\n                                            (CurrentMM.gaussianRecordLaw (N * T)\n                                                      (CurrentMM.p1RepeatedMean N T\n                                                        (CurrentMM.actualCohortImpulse a κ q rate))\n                                                      variance).real\n                                                  A ≤\n                                                α₀ →\n                                              (CurrentMM.gaussianRecordLaw (N * T)\n                                                        (CurrentMM.p1RepeatedMean N T\n                                                          (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                        variance).real\n                                                    Aᶜ ≤\n                                                  β₀ →\n                                                4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                                  ↑N * ↑T *\n                                                    (2 * W * 2 ^ T * (Δs / slo) ^ (2 * L + 1) *\n                                                        CurrentMM.p1GapConst a |κ| W H T) ^\n                                                      2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_second_difference_le","type":"∀ (f f' f'' : ℝ → ℝ) (x δ G : ℝ),\n  0 ≤ δ →\n    (∀ (y : ℝ), HasDerivAt f (f' y) y) →\n      (∀ (y : ℝ), HasDerivAt f' (f'' y) y) →\n        (∀ (y : ℝ), |y - x| ≤ δ → |f'' y| ≤ G) → |f (x + δ) + f (x - δ) - 2 * f x| ≤ 2 * G * δ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tied_lower_bound","type":"∀ (a κ n ηbar δ G H : ℝ) (w : ℝ → ℝ) (N T : ℕ) (qA rateA : Fin 1 → ℝ) (qB rateB : Fin 2 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ n →\n      0 ≤ δ →\n        0 ≤ H →\n          0 ≤ G →\n            0 ≤ ηbar →\n              ηbar ≤ 1 →\n                rateA 0 = ηbar →\n                  qA 0 * rateA 0 = 2 * n * w ηbar →\n                    rateB 0 = ηbar - δ →\n                      rateB 1 = ηbar + δ →\n                        qB 0 * rateB 0 = n * w (ηbar - δ) →\n                          qB 1 * rateB 1 = n * w (ηbar + δ) →\n                            ∀ (g g' g'' : ℕ → ℝ → ℝ),\n                              (∀ (m : ℕ) (y : ℝ), g m y = w y * (1 - y) ^ m) →\n                                (∀ (m : ℕ) (y : ℝ), HasDerivAt (g m) (g' m y) y) →\n                                  (∀ (m : ℕ) (y : ℝ), HasDerivAt (g' m) (g'' m y) y) →\n                                    (∀ m < T, ∀ (y : ℝ), |y - ηbar| ≤ δ → |g'' m y| ≤ G) →\n                                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ qB rateB t| ≤ H) →\n                                        ∀ (α₀ β₀ : ℝ),\n                                          α₀ + β₀ ≤ 1 →\n                                            ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                              MeasurableSet A →\n                                                (CurrentMM.gaussianRecordLaw (N * T)\n                                                          (CurrentMM.p1RepeatedMean N T\n                                                            (CurrentMM.actualCohortImpulse a κ qA rateA))\n                                                          variance).real\n                                                      A ≤\n                                                    α₀ →\n                                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                                            (CurrentMM.p1RepeatedMean N T\n                                                              (CurrentMM.actualCohortImpulse a κ qB rateB))\n                                                            variance).real\n                                                        Aᶜ ≤\n                                                      β₀ →\n                                                    4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                                      ↑N * ↑T *\n                                                        (n * (2 * G * δ ^ 2) *\n                                                            CurrentMM.p1GapConst a |κ| (2 * n * |w ηbar|) H T) ^\n                                                          2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1GapConst_nonneg","type":"∀ (a K0 B H : ℝ), 0 ≤ K0 → 0 ≤ B → 0 ≤ H → ∀ (t : ℕ), 0 ≤ CurrentMM.p1GapConst a K0 B H t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1GapConst_mono","type":"∀ (a K0 B H : ℝ),\n  0 ≤ K0 → 0 ≤ B → 0 ≤ H → ∀ (t : ℕ), CurrentMM.p1GapConst a K0 B H t ≤ CurrentMM.p1GapConst a K0 B H (t + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_gap_finite_horizon","type":"∀ (a κ B H ε : ℝ) (k k' h h' : ℕ → ℝ) (T : ℕ),\n  0 ≤ B →\n    0 ≤ H →\n      0 ≤ ε →\n        h 0 = κ →\n          h' 0 = κ →\n            (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n              (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n                (∀ (j : ℕ), |k j| ≤ B) →\n                  (∀ s < T, |h' s| ≤ H) →\n                    (∀ j < T, |k j - k' j| ≤ ε) → ∀ t < T, |h t - h' t| ≤ ε * CurrentMM.p1GapConst a |κ| B H t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_repeated_record_kl","type":"∀ (N T : ℕ) (h h' : ℕ → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    InformationTheory.klDiv (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h) variance)\n        (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h') variance) =\n      ENNReal.ofReal ((↑N * ∑ t ∈ Finset.range T, (h t - h' t) ^ 2) / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_lower_bound_from_kernel_gap","type":"∀ (a κ B H ε : ℝ) (k k' h h' : ℕ → ℝ) (N T : ℕ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ B →\n      0 ≤ H →\n        0 ≤ ε →\n          h 0 = κ →\n            h' 0 = κ →\n              (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n                (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n                  (∀ (j : ℕ), |k j| ≤ B) →\n                    (∀ s < T, |h' s| ≤ H) →\n                      (∀ j < T, |k j - k' j| ≤ ε) →\n                        ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                          MeasurableSet A →\n                            (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h) variance).real A ≤\n                                1 / 4 →\n                              (CurrentMM.gaussianRecordLaw (N * T) (CurrentMM.p1RepeatedMean N T h') variance).real Aᶜ ≤\n                                  1 / 4 →\n                                ↑variance ≤ 2 * ↑N * ↑T * (ε * CurrentMM.p1GapConst a |κ| B H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mg_kernel_abs_le","type":"∀ {ι : Type u_1} (S : Finset ι) (w s : ι → ℝ) (c d W : ℝ) (m : ℕ),\n  0 ≤ c →\n    0 ≤ d →\n      c + d ≤ 1 → (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, |s i| ≤ 1) → ∑ i ∈ S, w i ≤ W → |CurrentMM.mgKernel S w s c d m| ≤ W"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mg_kernel_gap_uniform","type":"∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι) (T' : Finset κ) (w s : ι → ℝ) (w' s' : κ → ℝ) (c d W : ℝ) (n T : ℕ),\n  0 ≤ c →\n    0 ≤ d →\n      c + d ≤ 1 →\n        (∀ i ∈ S, 0 ≤ w i) →\n          (∀ i ∈ T', 0 ≤ w' i) →\n            (∀ i ∈ S, |s i| ≤ 1) →\n              (∀ i ∈ T', |s' i| ≤ 1) →\n                ∑ i ∈ S, w i ≤ W →\n                  ∑ i ∈ T', w' i ≤ W →\n                    (∀ j < n, CurrentMM.mgMoment S w s j = CurrentMM.mgMoment T' w' s' j) →\n                      ∀ m < T,\n                        |CurrentMM.mgKernel S w s c d m - CurrentMM.mgKernel T' w' s' c d m| ≤ 2 * W * 2 ^ T * d ^ n"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cohortKernel_eq_mgKernel","type":"∀ {n : ℕ} (q rate s : Fin n → ℝ) (c d : ℝ),\n  (∀ (i : Fin n), 1 - rate i = c + d * s i) →\n    ∀ (m : ℕ), CurrentMM.cohortKernel q rate m = CurrentMM.mgKernel Finset.univ (fun i => q i * rate i) s c d m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_formal","type":"∀ {n0 n1 : ℕ} (a κ c d W H : ℝ) (nmatch N T : ℕ) (q rate s : Fin n0 → ℝ) (q' rate' s' : Fin n1 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            (∀ (i : Fin n0), 1 - rate i = c + d * s i) →\n              (∀ (i : Fin n1), 1 - rate' i = c + d * s' i) →\n                (∀ (i : Fin n0), |s i| ≤ 1) →\n                  (∀ (i : Fin n1), |s' i| ≤ 1) →\n                    (∀ (i : Fin n0), 0 ≤ q i * rate i) →\n                      (∀ (i : Fin n1), 0 ≤ q' i * rate' i) →\n                        ∑ i, q i * rate i ≤ W →\n                          ∑ i, q' i * rate' i ≤ W →\n                            (∀ j < nmatch,\n                                CurrentMM.mgMoment Finset.univ (fun i => q i * rate i) s j =\n                                  CurrentMM.mgMoment Finset.univ (fun i => q' i * rate' i) s' j) →\n                              (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                                ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                  MeasurableSet A →\n                                    (CurrentMM.gaussianRecordLaw (N * T)\n                                              (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                              variance).real\n                                          A ≤\n                                        1 / 4 →\n                                      (CurrentMM.gaussianRecordLaw (N * T)\n                                                (CurrentMM.p1RepeatedMean N T\n                                                  (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                variance).real\n                                            Aᶜ ≤\n                                          1 / 4 →\n                                        ↑variance ≤\n                                          2 * ↑N * ↑T *\n                                            (2 * W * 2 ^ T * d ^ nmatch * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_twocohort_matched_pair","type":"∀ (W : ℝ),\n  ∀ j < 3,\n    CurrentMM.mgMoment Finset.univ (fun i => W * ![1 / 4, 3 / 4] i) ![-1, 1 / 3] j =\n      CurrentMM.mgMoment Finset.univ (fun i => W * ![4 / 7, 3 / 7] i) ![-1 / 2, 2 / 3] j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_twocohort_third_moments_differ","type":"∀ (W : ℝ),\n  W ≠ 0 →\n    CurrentMM.mgMoment Finset.univ (fun i => W * ![1 / 4, 3 / 4] i) ![-1, 1 / 3] 3 ≠\n      CurrentMM.mgMoment Finset.univ (fun i => W * ![4 / 7, 3 / 7] i) ![-1 / 2, 2 / 3] 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_twocohort_lower_bound_formal","type":"∀ (a κ c d W H : ℝ) (N T : ℕ) (q rate q' rate' : Fin 2 → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            0 ≤ W →\n              (∀ (i : Fin 2), 1 - rate i = c + d * ![-1, 1 / 3] i) →\n                (∀ (i : Fin 2), 1 - rate' i = c + d * ![-1 / 2, 2 / 3] i) →\n                  (∀ (i : Fin 2), q i * rate i = W * ![1 / 4, 3 / 4] i) →\n                    (∀ (i : Fin 2), q' i * rate' i = W * ![4 / 7, 3 / 7] i) →\n                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                        ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                          MeasurableSet A →\n                            (CurrentMM.gaussianRecordLaw (N * T)\n                                      (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                      variance).real\n                                  A ≤\n                                1 / 4 →\n                              (CurrentMM.gaussianRecordLaw (N * T)\n                                        (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                        variance).real\n                                    Aᶜ ≤\n                                  1 / 4 →\n                                ↑variance ≤ 2 * ↑N * ↑T * (2 * W * 2 ^ T * d ^ 3 * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gridNode_abs_le","type":"∀ (L k : ℕ), k ≤ 2 * L + 1 → |CurrentMM.gridNode L k| ≤ 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_grid_alternating_sum_zero","type":"∀ (L j : ℕ),\n  j < 2 * L + 1 →\n    ∑ k ∈ Finset.range (2 * L + 1 + 1), (-1) ^ (2 * L + 1 - k) * ↑((2 * L + 1).choose k) * CurrentMM.gridNode L k ^ j =\n      0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_range_even_odd","type":"∀ (f : ℕ → ℝ) (L : ℕ), ∑ k ∈ Finset.range (2 * L + 1 + 1), f k = ∑ i ∈ Finset.range (L + 1), (f (2 * i) + f (2 * i + 1))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_grid_matched_moments","type":"∀ (L j : ℕ),\n  j < 2 * L + 1 →\n    ∑ i ∈ Finset.range (L + 1), ↑((2 * L + 1).choose (2 * i + 1)) * CurrentMM.gridNode L (2 * i + 1) ^ j =\n      ∑ i ∈ Finset.range (L + 1), ↑((2 * L + 1).choose (2 * i)) * CurrentMM.gridNode L (2 * i) ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_grid_half_weight","type":"∀ (L : ℕ),\n  ∑ i ∈ Finset.range (L + 1), ↑((2 * L + 1).choose (2 * i + 1)) = 2 ^ (2 * L) ∧\n    ∑ i ∈ Finset.range (L + 1), ↑((2 * L + 1).choose (2 * i)) = 2 ^ (2 * L)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_lower_bound_every_K","type":"∀ (L : ℕ) (a κ c d W H : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        c + d ≤ 1 →\n          0 ≤ H →\n            0 ≤ W →\n              (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                  (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                    (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                      (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                        ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                          MeasurableSet A →\n                            (CurrentMM.gaussianRecordLaw (N * T)\n                                      (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                      variance).real\n                                  A ≤\n                                1 / 4 →\n                              (CurrentMM.gaussianRecordLaw (N * T)\n                                        (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                        variance).real\n                                    Aᶜ ≤\n                                  1 / 4 →\n                                ↑variance ≤\n                                  2 * ↑N * ↑T * (2 * W * 2 ^ T * d ^ (2 * L + 1) * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_zero","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ), CurrentMM.actualCohortImpulse a impact q rate 0 = impact"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_memory_zero","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (i : Fin n),\n  CurrentMM.cohortImpulseMemory a impact q rate i 0 = rate i * impact"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_price_step","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (j : ℕ),\n  CurrentMM.actualCohortImpulse a impact q rate (j + 1) =\n    a * CurrentMM.actualCohortImpulse a impact q rate j +\n      impact * ∑ i, q i * CurrentMM.cohortImpulseMemory a impact q rate i j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_memory_step","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (i : Fin n) (j : ℕ),\n  CurrentMM.cohortImpulseMemory a impact q rate i (j + 1) =\n    (1 - rate i) * CurrentMM.cohortImpulseMemory a impact q rate i j +\n      rate i * CurrentMM.actualCohortImpulse a impact q rate (j + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_memory_closed","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (i : Fin n) (j : ℕ),\n  CurrentMM.cohortImpulseMemory a impact q rate i j =\n    ∑ s ∈ Finset.range (j + 1), rate i * (1 - rate i) ^ (j - s) * CurrentMM.actualCohortImpulse a impact q rate s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_closed_loop_recursion","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (j : ℕ),\n  CurrentMM.actualCohortImpulse a impact q rate (j + 1) =\n    a * CurrentMM.actualCohortImpulse a impact q rate j +\n      impact *\n        ∑ m ∈ Finset.range (j + 1),\n          CurrentMM.cohortKernel q rate m * CurrentMM.actualCohortImpulse a impact q rate (j - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_model_identification","type":"∀ {n n' : ℕ} (a impact : ℝ),\n  impact ≠ 0 →\n    ∀ (q rate : Fin n → ℝ) (q' rate' : Fin n' → ℝ),\n      (∀ (j : ℕ), CurrentMM.actualCohortImpulse a impact q rate j = CurrentMM.actualCohortImpulse a impact q' rate' j) →\n        ∀ (ρ : ℝ),\n          CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate i) (fun i => q i * rate i) ρ =\n            CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate' i) (fun i => q' i * rate' i) ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_model_converse","type":"∀ {n n' : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (q' rate' : Fin n' → ℝ),\n  (∀ (m : ℕ), CurrentMM.cohortKernel q rate m = CurrentMM.cohortKernel q' rate' m) →\n    ∀ (j : ℕ), CurrentMM.actualCohortImpulse a impact q rate j = CurrentMM.actualCohortImpulse a impact q' rate' j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_conv_l1_le","type":"∀ (a b : ℕ → ℝ) (n : ℕ),\n  ∑ t ∈ Finset.range n, ∑ j ∈ Finset.range (t + 1), |a j| * |b (t - j)| ≤\n    (∑ j ∈ Finset.range n, |a j|) * ∑ u ∈ Finset.range n, |b u|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_response_l1","type":"∀ (a κ K1 s : ℝ) (k h : ℕ → ℝ),\n  h 0 = κ →\n    (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n      (∀ (n : ℕ), ∑ m ∈ Finset.range n, |k m| ≤ K1) →\n        |a| + |κ| * K1 ≤ s → s < 1 → ∀ (n : ℕ), ∑ t ∈ Finset.range n, |h t| ≤ |κ| / (1 - s)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_response_diff_l1","type":"∀ (a κ K1 s E H1 : ℝ) (k k' h h' : ℕ → ℝ),\n  h 0 = κ →\n    h' 0 = κ →\n      (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n        (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n          (∀ (n : ℕ), ∑ m ∈ Finset.range n, |k m| ≤ K1) →\n            |a| + |κ| * K1 ≤ s →\n              s < 1 →\n                (∀ (n : ℕ), ∑ m ∈ Finset.range n, |k m - k' m| ≤ E) →\n                  (∀ (n : ℕ), ∑ t ∈ Finset.range n, |h' t| ≤ H1) →\n                    ∀ (n : ℕ), ∑ t ∈ Finset.range n, |h t - h' t| ≤ |κ| * E * H1 / (1 - s)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_single_kernel_l1","type":"∀ (c η : ℝ), 0 ≤ c → 0 ≤ η → η ≤ 1 → ∀ (n : ℕ), ∑ m ∈ Finset.range n, |c * η * (1 - η) ^ m| ≤ c"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_second_diff_pow_nonneg","type":"∀ (x δ : ℝ), 0 ≤ δ → 0 ≤ x - δ → ∀ (p : ℕ), 0 ≤ (x + δ) ^ p + (x - δ) ^ p - 2 * x ^ p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_split_kernel_gap","type":"∀ (q ηbar δ ε : ℝ),\n  0 ≤ q →\n    0 < ε →\n      0 ≤ δ →\n        ε ≤ ηbar - δ →\n          ηbar + δ ≤ 1 - ε →\n            ∀ (n : ℕ),\n              ∑ m ∈ Finset.range n,\n                  |q / 2 * (ηbar - δ) * (1 - (ηbar - δ)) ^ m + q / 2 * (ηbar + δ) * (1 - (ηbar + δ)) ^ m -\n                      q * ηbar * (1 - ηbar) ^ m| ≤\n                2 * q * δ ^ 2 / ε ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_conv_energy","type":"∀ (d v : ℕ → ℝ) (D : ℝ),\n  (∀ (n : ℕ), ∑ t ∈ Finset.range n, |d t| ≤ D) →\n    ∀ (T : ℕ),\n      ∑ t ∈ Finset.range T, (∑ u ∈ Finset.range (t + 1), v u * d (t - u)) ^ 2 ≤ D ^ 2 * ∑ t ∈ Finset.range T, v t ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_separation_power","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (P : ℝ),\n                      ∑ t ∈ Finset.range T, v t ^ 2 ≤ P * ↑T →\n                        ∀ (variance : NNReal),\n                          variance ≠ 0 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                              MeasurableSet A →\n                                (CurrentMM.gaussianRecordLaw T\n                                          (fun t =>\n                                            (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] v\n                                                (↑t + 1)).price)\n                                          variance).real\n                                      A ≤\n                                    1 / 4 →\n                                  (CurrentMM.gaussianRecordLaw T\n                                            (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price)\n                                            variance).real\n                                        Aᶜ ≤\n                                      1 / 4 →\n                                    ↑variance ≤ 2 * (2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * P * δ ^ 4 * ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfTop_map_eval","type":"∀ {K : ℕ} (κ : ℝ) (r : Fin K → ℝ) (z : ℂ),\n  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) = ↑κ * z * ∏ i, (z - ↑(r i))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_zeros","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ),\n  a ≠ 0 →\n    κ ≠ 0 →\n      Function.Injective r →\n        (∀ (i : Fin K), 0 < r i) →\n          (∀ (i : Fin K), r i < 1) →\n            (∀ (i : Fin K), w i ≠ 0) →\n              (∀ (z : ℂ),\n                  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) = 0 ↔\n                    z = 0 ∨ ∃ i, z = ↑(r i)) ∧\n                (∀ (z : ℂ),\n                    Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) = 0 →\n                      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a κ w r)) ≠ 0) ∧\n                  ∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) = 0 → ‖z‖ < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_root_unique","type":"∀ (r1 r2 : ℝ), 0 < r1 → r1 < 1 → 0 < r2 → r2 < 1 → (1 + r1 ^ 2) / (2 * r1) = (1 + r2 ^ 2) / (2 * r2) → r1 = r2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_factorization_one_cohort","type":"∀ (κ r1 r2 : ℝ),\n  κ ≠ 0 →\n    0 < r1 →\n      r1 < 1 →\n        0 < r2 → r2 < 1 → (∀ (x : ℝ), κ ^ 2 * (1 + r1 ^ 2 - 2 * r1 * x) = κ ^ 2 * (1 + r2 ^ 2 - 2 * r2 * x)) → r1 = r2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_power_two_cohort_coeff","type":"∀ (κ r1 r2 x : ℝ),\n  κ ^ 2 * (1 + r1 ^ 2 - 2 * r1 * x) * (1 + r2 ^ 2 - 2 * r2 * x) =\n    κ ^ 2 * (1 + r1 ^ 2) * (1 + r2 ^ 2) - 2 * κ ^ 2 * (r1 + r2) * (1 + r1 * r2) * x + 4 * κ ^ 2 * r1 * r2 * x ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_factorization_two_cohort","type":"∀ (r1 r2 r1' r2' : ℝ),\n  0 < r1 →\n    r1 ≤ r2 →\n      r2 < 1 →\n        0 < r1' →\n          r1' ≤ r2' →\n            r2' < 1 →\n              r1 * r2 = r1' * r2' → (r1 + r2) * (1 + r1 * r2) = (r1' + r2') * (1 + r1' * r2') → r1 = r1' ∧ r2 = r2'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_factorization_two_cohort_poly","type":"∀ (κ r1 r2 r1' r2' : ℝ),\n  κ ≠ 0 →\n    0 < r1 →\n      r1 ≤ r2 →\n        r2 < 1 →\n          0 < r1' →\n            r1' ≤ r2' →\n              r2' < 1 →\n                (∀ (x : ℝ),\n                    κ ^ 2 * (1 + r1 ^ 2 - 2 * r1 * x) * (1 + r2 ^ 2 - 2 * r2 * x) =\n                      κ ^ 2 * (1 + r1' ^ 2 - 2 * r1' * x) * (1 + r2' ^ 2 - 2 * r2' * x)) →\n                  r1 = r1' ∧ r2 = r2'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_factorization_scale_recovery","type":"∀ (κ κ' r1 r2 : ℝ), 0 < κ → 0 < κ' → 0 < r1 → 0 < r2 → 4 * κ ^ 2 * r1 * r2 = 4 * κ' ^ 2 * r1 * r2 → κ = κ'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_spectral_factorization","type":"∀ (a κ : ℝ) (w r r' : Fin 2 → ℝ),\n  a ≠ 0 →\n    0 < κ →\n      (∀ (i : Fin 2), w i ≠ 0) →\n        0 < r 0 →\n          r 0 < r 1 →\n            r 1 < 1 →\n              0 < r' 0 →\n                r' 0 < r' 1 →\n                  r' 1 < 1 →\n                    (∀ (x : ℝ),\n                        κ ^ 2 * (1 + r 0 ^ 2 - 2 * r 0 * x) * (1 + r 1 ^ 2 - 2 * r 1 * x) =\n                          κ ^ 2 * (1 + r' 0 ^ 2 - 2 * r' 0 * x) * (1 + r' 1 ^ 2 - 2 * r' 1 * x)) →\n                      (∀ (z : ℂ),\n                          Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) = 0 → ‖z‖ < 1) ∧\n                        r 0 = r' 0 ∧ r 1 = r' 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cohortTransC_real","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ) (x : Option (Fin n) → ℝ),\n  (CurrentMM.cohortTransC a κ q rate fun i => ↑(x i)) = fun i => ↑((CurrentMM.cohortLinearTransition a κ q rate) x i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_bottom_eval_C","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ) (ζ : ℂ),\n  Polynomial.eval ζ (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a κ w r)) =\n    (ζ - ↑a) * ∏ i, (ζ - ↑(r i)) - ↑κ * ∑ i, ↑(w i) * ζ * ∏ j ∈ Finset.univ.erase i, (ζ - ↑(r j))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_bottom_factor","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ) (ζ : ℂ),\n  (∀ (j : Fin n), ζ ≠ 1 - ↑(rate j)) →\n    Polynomial.eval ζ\n        (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a κ (fun i => q i * rate i) fun i => 1 - rate i)) =\n      (∏ j, (ζ - (1 - ↑(rate j)))) * (ζ - ↑a - ↑κ * ∑ i, ↑(q i) * ↑(rate i) * ζ / (ζ - (1 - ↑(rate i))))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eigen_iff_bottom_root","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ),\n  a ≠ 0 →\n    κ ≠ 0 →\n      (∀ (i : Fin n), 0 < rate i) →\n        (∀ (i : Fin n), rate i < 1) →\n          (∀ (i : Fin n), q i ≠ 0) →\n            Function.Injective rate →\n              ∀ (ζ : ℂ),\n                (∃ z, z ≠ 0 ∧ CurrentMM.cohortTransC a κ q rate z = ζ • z) ↔\n                  Polynomial.eval ζ\n                      (Polynomial.map (algebraMap ℝ ℂ)\n                        (CurrentMM.tfBottom a κ (fun i => q i * rate i) fun i => 1 - rate i)) =\n                    0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_schur_stable_iff_poles_in_disk","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ),\n  a ≠ 0 →\n    κ ≠ 0 →\n      (∀ (i : Fin n), 0 < rate i) →\n        (∀ (i : Fin n), rate i < 1) →\n          (∀ (i : Fin n), q i ≠ 0) →\n            Function.Injective rate →\n              ((∀ (ζ : ℂ), (∃ z, z ≠ 0 ∧ CurrentMM.cohortTransC a κ q rate z = ζ • z) → ‖ζ‖ < 1) ↔\n                ∀ (ζ : ℂ),\n                  Polynomial.eval ζ\n                        (Polynomial.map (algebraMap ℝ ℂ)\n                          (CurrentMM.tfBottom a κ (fun i => q i * rate i) fun i => 1 - rate i)) =\n                      0 →\n                    ‖ζ‖ < 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prod_reflect","type":"∀ {K : ℕ} (r : Fin K → ℝ) (x : ℂ),\n  x ≠ 0 → ∀ (s : Finset (Fin K)), x ^ s.card * ∏ j ∈ s, (x⁻¹ - ↑(r j)) = ∏ j ∈ s, (1 - ↑(r j) * x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfBottomRev_eval","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ) (x : ℂ),\n  x ≠ 0 →\n    Polynomial.eval x (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottomRev a κ w r)) =\n      x ^ (K + 1) * Polynomial.eval x⁻¹ (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a κ w r))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfTopRev_eval","type":"∀ {K : ℕ} (κ : ℝ) (r : Fin K → ℝ) (x : ℂ),\n  x ≠ 0 →\n    Polynomial.eval x (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTopRev κ r)) =\n      x ^ (K + 1) * Polynomial.eval x⁻¹ (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_geom_series_mul","type":"∀ (r : ℝ), (PowerSeries.mk fun m => r ^ m) * (1 - PowerSeries.C r * PowerSeries.X) = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_coe_ps","type":"∀ (p : Polynomial ℝ), ↑p = Polynomial.coeToPowerSeries.ringHom p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_impulse_generating","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ),\n  PowerSeries.mk (CurrentMM.actualCohortImpulse a κ q rate) *\n      ↑(CurrentMM.tfBottomRev a κ (fun i => q i * rate i) fun i => 1 - rate i) =\n    ↑(CurrentMM.tfTopRev κ fun i => 1 - rate i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mg_kernel_expand","type":"∀ {ι : Type u_1} (S : Finset ι) (w s : ι → ℝ) (c d : ℝ) (m : ℕ),\n  CurrentMM.mgKernel S w s c d m =\n    ∑ j ∈ Finset.range (m + 1), ↑(m.choose j) * c ^ (m - j) * d ^ j * CurrentMM.mgMoment S w s j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mg_moment_abs_le","type":"∀ {ι : Type u_1} (S : Finset ι) (w s : ι → ℝ) (W : ℝ) (j : ℕ),\n  (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, |s i| ≤ 1) → ∑ i ∈ S, w i ≤ W → |CurrentMM.mgMoment S w s j| ≤ W"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mg_binomial_tail","type":"∀ (c d : ℝ),\n  0 ≤ c →\n    0 ≤ d →\n      ∀ (n m : ℕ),\n        n ≤ m →\n          ∑ j ∈ Finset.Ico n (m + 1), ↑(m.choose j) * c ^ (m - j) * d ^ j ≤ ↑(m.choose n) * d ^ n * (c + d) ^ (m - n)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_kernel_moment_gap","type":"∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι) (T : Finset κ) (w s : ι → ℝ) (w' s' : κ → ℝ) (c d W : ℝ) (n m : ℕ),\n  0 ≤ c →\n    0 ≤ d →\n      (∀ i ∈ S, 0 ≤ w i) →\n        (∀ i ∈ T, 0 ≤ w' i) →\n          (∀ i ∈ S, |s i| ≤ 1) →\n            (∀ i ∈ T, |s' i| ≤ 1) →\n              ∑ i ∈ S, w i ≤ W →\n                ∑ i ∈ T, w' i ≤ W →\n                  (∀ j < n, CurrentMM.mgMoment S w s j = CurrentMM.mgMoment T w' s' j) →\n                    n ≤ m →\n                      |CurrentMM.mgKernel S w s c d m - CurrentMM.mgKernel T w' s' c d m| ≤\n                        2 * W * (↑(m.choose n) * d ^ n * (c + d) ^ (m - n))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_kcohort_kernel_low_orders_equal","type":"∀ {ι : Type u_1} {κ : Type u_2} (S : Finset ι) (T : Finset κ) (w s : ι → ℝ) (w' s' : κ → ℝ) (c d : ℝ) (n m : ℕ),\n  (∀ j < n, CurrentMM.mgMoment S w s j = CurrentMM.mgMoment T w' s' j) →\n    m < n → CurrentMM.mgKernel S w s c d m = CurrentMM.mgKernel T w' s' c d m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_nearcrit_lower","type":"∀ (D : ℂ) (ω ε c₁ C₂ δ : ℝ),\n  0 < c₁ →\n    0 ≤ C₂ →\n      0 ≤ δ →\n        |ω| ≤ δ →\n          0 ≤ ε →\n            c₁ * |ω| ≤ |D.im| →\n              -C₂ * ω ^ 2 ≤ D.re → min (min (1 / 2) c₁ / 2) (c₁ / (2 * C₂ * δ + 1)) * (ε + |ω|) ≤ ‖D + ↑ε‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_ratio_bound","type":"∀ (Δ D : ℂ) (ω ε M c₃ : ℝ), 0 < c₃ → 0 ≤ M → 0 ≤ ε → ‖Δ‖ ≤ M * |ω| → c₃ * (ε + |ω|) ≤ ‖D + ↑ε‖ → ‖Δ‖ ≤ M / c₃ * ‖D + ↑ε‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_ratio_close","type":"∀ (z : ℂ), ‖z‖ ≤ 1 / 8 → |(‖1 + z‖ ^ 2)⁻¹ - 1| ≤ 4 * ‖z‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kl_integrand_le","type":"∀ (u : ℝ), |u - 1| ≤ 1 / 2 → u - 1 - Real.log u ≤ 2 * (u - 1) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_nearcrit_kl_bound","type":"∀ (z : ℝ → ℂ) (ρ KL : ℝ),\n  0 ≤ ρ →\n    ρ ≤ 1 / 8 →\n      (∀ (ω : ℝ), ‖z ω‖ ≤ ρ) →\n        KL = 1 / (4 * Real.pi) * ∫ (ω : ℝ) in -Real.pi..Real.pi, (‖1 + z ω‖ ^ 2)⁻¹ - 1 - Real.log (‖1 + z ω‖ ^ 2)⁻¹ →\n          KL ≤ 16 * ρ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_exp_neg_le","type":"∀ (u : ℝ), 0 ≤ u → Real.exp (-u) ≤ 1 - u + u ^ 2 / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_laplace_location_kl","type":"∀ (b Δ : ℝ), 0 < b → |Δ| / b - 1 + Real.exp (-(|Δ| / b)) ≤ Δ ^ 2 / (2 * b ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_laplace_vs_gaussian","type":"∀ (b Δ : ℝ), 0 < b → |Δ| / b - 1 + Real.exp (-(|Δ| / b)) ≤ 2 * (Δ ^ 2 / (2 * (2 * b ^ 2)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_newslaw_kl_compare","type":"∀ {Ω : Type u_1} {ι : Type u_2} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) (s : Finset ι) (Δ : ι → Ω → ℝ)\n  (g : ℝ → ℝ) (σ2 Istar : ℝ),\n  0 < σ2 →\n    (∀ (x : ℝ), g x ≤ Istar / 2 * x ^ 2) →\n      (∀ t ∈ s, MeasureTheory.Integrable (fun ω => g (Δ t ω)) μ) →\n        (∀ t ∈ s, MeasureTheory.Integrable (fun ω => Δ t ω ^ 2) μ) →\n          ∑ t ∈ s, ∫ (ω : Ω), g (Δ t ω) ∂μ ≤ σ2 * Istar * ∑ t ∈ s, ∫ (ω : Ω), Δ t ω ^ 2 / (2 * σ2) ∂μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hiding_nash_bound","type":"∀ {G : Type u_1} (k L : G → ℝ),\n  (∀ (g : G), 0 ≤ k g) →\n    (∀ (g : G), 0 < L g) →\n      ∀ (pos pref dev det detdev Δ : G → ℝ),\n        (∀ (g : G), k g * (pos g - pref g) ^ 2 + L g * det g ≤ k g * (dev g - pref g) ^ 2 + L g * detdev g) →\n          (∀ (g : G), |dev g - pref g| ≤ Δ g) → ∀ (g : G), det g ≤ k g * Δ g ^ 2 / L g + detdev g"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tags_value_money","type":"∀ (L : ℕ) (a κ c d W s : ℝ) (N T : ℕ) (q rate q' rate' : Fin (L + 1) → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 ≤ c →\n      0 ≤ d →\n        0 < c + d →\n          c + d < 1 →\n            0 ≤ W →\n              |a| + |κ| * (W / (1 - (c + d))) ≤ s →\n                s < 1 →\n                  (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                    (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                      (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                        (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                          ∀ (α₀ β₀ : ℝ),\n                            α₀ + β₀ ≤ 1 →\n                              ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                MeasurableSet A →\n                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                            (CurrentMM.p1RepeatedMean N T (CurrentMM.actualCohortImpulse a κ q rate))\n                                            variance).real\n                                        A ≤\n                                      α₀ →\n                                    (CurrentMM.gaussianRecordLaw (N * T)\n                                              (CurrentMM.p1RepeatedMean N T\n                                                (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                              variance).real\n                                          Aᶜ ≤\n                                        β₀ →\n                                      0 <\n                                          2 * κ ^ 2 * W / ((1 - (c + d)) ^ (2 * L + 2) * (1 - s) ^ 2) *\n                                            d ^ (2 * L + 1) →\n                                        ∀ (ce : ℝ),\n                                          0 ≤ ce →\n                                            ce *\n                                                (4 * ↑variance * (1 - α₀ - β₀) ^ 2 /\n                                                  (2 * κ ^ 2 * W / ((1 - (c + d)) ^ (2 * L + 2) * (1 - s) ^ 2) *\n                                                      d ^ (2 * L + 1)) ^\n                                                    2) ≤\n                                              ce * ↑N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_identification_margin","type":"∀ {Θ : Type u_1} {M : Type u_2} [inst : TopologicalSpace Θ] [inst_1 : PseudoMetricSpace M] {S : Set Θ},\n  IsCompact S →\n    ∀ (μ : Θ → M),\n      Continuous μ →\n        ∀ (Q : Θ → ℝ),\n          Continuous Q →\n            ∀ (θ₀ : Θ),\n              (∀ θ ∈ S, Q θ = 0 → μ θ = μ θ₀) →\n                (∀ θ ∈ S, 0 ≤ Q θ) → ∀ δ > 0, ∃ q > 0, ∀ θ ∈ S, Q θ < q → dist (μ θ) (μ θ₀) < δ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_extremum_criterion_small","type":"∀ {Θ : Type u_1} [TopologicalSpace Θ] (S : Set Θ) (Q QN : Θ → ℝ) (θ₀ θhat : Θ),\n  θ₀ ∈ S → θhat ∈ S → Q θ₀ = 0 → QN θhat ≤ QN θ₀ → ∀ (η : ℝ), (∀ θ ∈ S, |QN θ - Q θ| ≤ η) → Q θhat ≤ 2 * η"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_extremum_consistency","type":"∀ {Θ : Type u_1} {M : Type u_2} [inst : TopologicalSpace Θ] [inst_1 : PseudoMetricSpace M] {S : Set Θ},\n  IsCompact S →\n    ∀ (μ : Θ → M),\n      Continuous μ →\n        ∀ (Q : Θ → ℝ),\n          Continuous Q →\n            ∀ θ₀ ∈ S,\n              Q θ₀ = 0 →\n                (∀ θ ∈ S, Q θ = 0 → μ θ = μ θ₀) →\n                  (∀ θ ∈ S, 0 ≤ Q θ) →\n                    ∀ δ > 0,\n                      ∃ η > 0,\n                        ∀ (QN : Θ → ℝ),\n                          ∀ θhat ∈ S, QN θhat ≤ QN θ₀ → (∀ θ ∈ S, |QN θ - Q θ| ≤ η) → dist (μ θhat) (μ θ₀) < δ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_extremum_consistency_prob","type":"∀ {Θ : Type u_1} {M : Type u_2} [inst : TopologicalSpace Θ] [inst_1 : PseudoMetricSpace M] {Ω : Type u_3}\n  [inst_2 : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P] {S : Set Θ},\n  IsCompact S →\n    ∀ (μ : Θ → M),\n      Continuous μ →\n        ∀ (Q : Θ → ℝ),\n          Continuous Q →\n            ∀ θ₀ ∈ S,\n              Q θ₀ = 0 →\n                (∀ θ ∈ S, Q θ = 0 → μ θ = μ θ₀) →\n                  (∀ θ ∈ S, 0 ≤ Q θ) →\n                    ∀ δ > 0,\n                      ∃ η > 0,\n                        ∀ (QN : Ω → Θ → ℝ) (θhat : Ω → Θ),\n                          (∀ (ω : Ω), θhat ω ∈ S) →\n                            (∀ (ω : Ω), QN ω (θhat ω) ≤ QN ω θ₀) →\n                              P.real {ω | δ ≤ dist (μ (θhat ω)) (μ θ₀)} ≤ P.real {ω | ¬∀ θ ∈ S, |QN ω θ - Q θ| ≤ η}"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_min_one_lipschitz","type":"∀ (a b : ℝ), |min 1 a - min 1 b| ≤ |a - b|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_criterion_uniform_close","type":"∀ {V : Type u_1} {Θ : Type u_2} [inst : SeminormedAddCommGroup V] (n : ℕ) (w : ℕ → ℝ),\n  (∀ (j : ℕ), 0 ≤ w j) →\n    ∀ (x x0 : ℕ → V) (y : ℕ → Θ → V) (θ : Θ),\n      |∑ j ∈ Finset.range n, w j * min 1 ‖x j - y j θ‖ - ∑ j ∈ Finset.range n, w j * min 1 ‖x0 j - y j θ‖| ≤\n        ∑ j ∈ Finset.range n, w j * ‖x j - x0 j‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_nearcrit_finite_sample","type":"∀ {n : ℕ} (lam : Fin n → ℝ) (ρ : ℝ),\n  0 ≤ ρ →\n    ρ ≤ 1 / 8 → (∀ (k : Fin n), |lam k - 1| ≤ 4 * ρ) → 1 / 2 * ∑ k, (lam k - 1 - Real.log (lam k)) ≤ 16 * ↑n * ρ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_mono","type":"∀ (s κ : ℝ), 0 ≤ κ → ∀ (L : ℝ → ℝ), Monotone L → (∀ (x : ℝ), 0 ≤ L x) → Monotone (CurrentMM.cascadeRound s κ L)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_iterate_le_fixed","type":"∀ (s κ : ℝ),\n  0 ≤ κ → ∀ (L : ℝ → ℝ), Monotone L → ∀ (δ : ℝ), δ = s + κ * L δ → s ≤ δ → ∀ (n : ℕ), CurrentMM.cascadeRound s κ L n ≤ δ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_rounds_converge","type":"∀ (s κ : ℝ),\n  0 ≤ κ →\n    ∀ (L : ℝ → ℝ),\n      Monotone L →\n        (∀ (x : ℝ), 0 ≤ L x) →\n          ∀ (Q : ℝ),\n            (∀ (x : ℝ), L x ≤ Q) →\n              Continuous L →\n                ∃ δ,\n                  Filter.Tendsto (CurrentMM.cascadeRound s κ L) Filter.atTop (nhds δ) ∧\n                    δ = s + κ * L δ ∧ ∀ (δ' : ℝ), δ' = s + κ * L δ' → s ≤ δ' → δ ≤ δ'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_contraction","type":"∀ (κ ℓ : ℝ),\n  0 ≤ κ →\n    κ * ℓ < 1 →\n      ∀ (L : ℝ → ℝ),\n        (∀ (x y : ℝ), |L x - L y| ≤ ℓ * |x - y|) →\n          ∀ (s s' δ δ' : ℝ), δ = s + κ * L δ → δ' = s' + κ * L δ' → |δ - δ'| ≤ |s - s'| / (1 - κ * ℓ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_jump","type":"∀ (κ : ℝ) (L : ℝ → ℝ) (δ₀ δ₁ : ℝ),\n  (∀ (δ : ℝ), 0 ≤ δ → δ ≤ δ₀ → δ - κ * L δ ≤ δ₁ - κ * L δ₁) →\n    δ₁ = δ₁ - κ * L δ₁ + κ * L δ₁ ∧ ∀ (s : ℝ), δ₁ - κ * L δ₁ < s → ∀ (δ : ℝ), 0 ≤ δ → δ = s + κ * L δ → δ₀ < δ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_re_inv_one_sub_ge","type":"∀ (w : ℂ) (s : ℝ), ‖w‖ ≤ s → s < 1 → 1 / (1 + s) ≤ (1 / (1 - w)).re"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_no_manipulation_symbol","type":"∀ (κ θ s : ℝ),\n  0 < κ →\n    1 / 2 ≤ θ →\n      0 ≤ s →\n        s < 1 →\n          ∀ (w : ℂ),\n            ‖w‖ ≤ s → κ * (1 / (1 + s) - (1 - θ)) ≤ κ * (1 / (1 - w)).re - (1 - θ) * κ ∧ 0 < κ * (1 / (1 + s) - (1 - θ))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_netting_prefix","type":"∀ (φ : ℕ → (ℕ → ℝ) → ℝ),\n  (∀ (t : ℕ) (y y' : ℕ → ℝ), (∀ u < t, y u = y' u) → φ t y = φ t y') →\n    ∀ (y y' : ℕ → ℝ) (t : ℕ), (∀ u ≤ t, y u - φ u y = y' u - φ u y') → ∀ u ≤ t, y u = y' u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_deadband_bias","type":"∀ (a κ s E : ℝ),\n  s < 1 →\n    0 ≤ E →\n      ∀ (k d e : ℕ → ℝ),\n        (∀ (t : ℕ), |a| + |κ| * ∑ m ∈ Finset.range t, |k m| ≤ s) →\n          (∀ (t : ℕ), |e t| ≤ E) →\n            d 0 = e 0 →\n              (∀ (t : ℕ), d (t + 1) = a * d t + κ * ∑ m ∈ Finset.range (t + 1), k m * d (t - m) + e (t + 1)) →\n                ∀ (t : ℕ), |d t| ≤ E / (1 - s)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_three_equilibria","type":"∀ (ψ : ℝ → ℝ),\n  Continuous ψ →\n    ∀ (s δ₀ δ₁ δ₂ : ℝ),\n      0 ≤ δ₁ →\n        δ₁ < δ₀ →\n          δ₀ ≤ δ₂ →\n            ψ 0 ≤ s →\n              s < ψ δ₁ →\n                ψ δ₀ < s →\n                  s ≤ ψ δ₂ →\n                    ∃ a b c,\n                      a ∈ Set.Icc 0 δ₁ ∧\n                        b ∈ Set.Icc δ₁ δ₀ ∧ c ∈ Set.Icc δ₀ δ₂ ∧ ψ a = s ∧ ψ b = s ∧ ψ c = s ∧ a < b ∧ b < c"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cascade_rounds_geometric","type":"∀ (δstar q : ℝ),\n  0 ≤ q →\n    ∀ (δ : ℕ → ℝ), (∀ (n : ℕ), δstar - δ (n + 1) ≤ q * (δstar - δ n)) → ∀ (n : ℕ), δstar - δ n ≤ q ^ n * (δstar - δ 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_slow_capital_fall","type":"∀ (pstar s κ γ L T : ℝ),\n  0 ≤ γ →\n    0 ≤ L →\n      0 ≤ T →\n        ∀ (p : ℝ → ℝ),\n          (∀ (t : ℝ), p t = pstar - s - κ * L - γ * L * (T - t)) →\n            pstar - p 0 = s + (κ + γ * T) * L ∧\n              pstar - p 0 - (pstar - p T) = γ * T * L ∧ 0 ≤ γ * T * L ∧ ∀ (t : ℝ), p (t + 1) - p t = γ * L"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_centralbinom_q_step","type":"∀ (m : ℝ), 0 ≤ m → (2 * m + 2) ^ 2 * (4 * m + 1) < (2 * m + 1) ^ 2 * (4 * m + 5)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_centralbinom_r_step","type":"∀ (m : ℝ),\n  1 ≤ m →\n    (2 * m + 1) ^ 2 * ((m + 5 / 4) * (32 * (m + 1)) + 1) * m < (2 * m + 2) ^ 2 * ((m + 1 / 4) * (32 * m) + 1) * (m + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_kernel_gap","type":"∀ {p q : ℕ} (wt rt : Fin p → ℝ) (wu ru wu' ru' : Fin q → ℝ) (m : ℕ),\n  CurrentMM.popKernel wt rt m + CurrentMM.popKernel wu ru m -\n      (CurrentMM.popKernel wt rt m + CurrentMM.popKernel wu' ru' m) =\n    CurrentMM.popKernel wu ru m - CurrentMM.popKernel wu' ru' m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_residual_kernel","type":"∀ {p q : ℕ} (wt rt : Fin p → ℝ) (wu ru : Fin q → ℝ) (k : ℕ → ℝ),\n  (∀ (m : ℕ), k m = CurrentMM.popKernel wt rt m + CurrentMM.popKernel wu ru m) →\n    ∀ (m : ℕ), k m - CurrentMM.popKernel wt rt m = CurrentMM.popKernel wu ru m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_single_untagged","type":"∀ {p : ℕ} (wt rt : Fin p → ℝ) (v s : ℝ) (k : ℕ → ℝ),\n  (∀ (m : ℕ), k m = CurrentMM.popKernel wt rt m + v * s ^ m) →\n    v ≠ 0 → v = k 0 - ∑ i, wt i ∧ s = (k 1 - ∑ i, wt i * rt i) / v"}
{"axioms":["propext","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_exponent_step","type":"∀ (K' : ℕ), 2 ≤ K' → ↑(4 * K' - 2) - ↑(4 * (K' - 1) - 2) = 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_flow_gap","type":"∀ (w r G : ℝ) (h h' : ℕ → ℝ) (T : ℕ),\n  |r| ≤ 1 →\n    0 ≤ G →\n      (∀ s < T, |h s - h' s| ≤ G) →\n        ∀ u < T, |CurrentMM.taggedFlowImpulse w r h u - CurrentMM.taggedFlowImpulse w r h' u| ≤ |w| * (↑T * G)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_joint_mean_gap","type":"∀ (T M : ℕ) (h h' wt rt : ℕ → ℝ) (G Wt : ℝ),\n  0 ≤ G →\n    0 ≤ Wt →\n      0 < T →\n        (∀ s < T, |h s - h' s| ≤ G) →\n          (∀ k < M, |wt k| ≤ Wt) →\n            (∀ k < M, |rt k| ≤ 1) →\n              ∀ t < T + M * T, |CurrentMM.jointMean T h wt rt t - CurrentMM.jointMean T h' wt rt t| ≤ G * (1 + Wt * ↑T)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_lower_bound_joint","type":"∀ (a κ B H ε Wt : ℝ) (k k' h h' : ℕ → ℝ) (N T M : ℕ) (wt rt : ℕ → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 < T →\n      0 ≤ Wt →\n        0 ≤ B →\n          0 ≤ H →\n            0 ≤ ε →\n              h 0 = κ →\n                h' 0 = κ →\n                  (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n                    (∀ (t : ℕ), h' (t + 1) = a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n                      (∀ (j : ℕ), |k j| ≤ B) →\n                        (∀ s < T, |h' s| ≤ H) →\n                          (∀ j < T, |k j - k' j| ≤ ε) →\n                            (∀ i < M, |wt i| ≤ Wt) →\n                              (∀ i < M, |rt i| ≤ 1) →\n                                ∀ (α₀ β₀ : ℝ),\n                                  α₀ + β₀ ≤ 1 →\n                                    ∀ (A : Set (CurrentMM.ObservationRecord (N * (T + M * T)))),\n                                      MeasurableSet A →\n                                        (CurrentMM.gaussianRecordLaw (N * (T + M * T))\n                                                  (CurrentMM.p1RepeatedMean N (T + M * T)\n                                                    (CurrentMM.jointMean T h wt rt))\n                                                  variance).real\n                                              A ≤\n                                            α₀ →\n                                          (CurrentMM.gaussianRecordLaw (N * (T + M * T))\n                                                    (CurrentMM.p1RepeatedMean N (T + M * T)\n                                                      (CurrentMM.jointMean T h' wt rt))\n                                                    variance).real\n                                                Aᶜ ≤\n                                              β₀ →\n                                            4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                              ↑N * (↑T + ↑M * ↑T) *\n                                                (ε * CurrentMM.p1GapConst a |κ| B H T * (1 + Wt * ↑T)) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_lower_bound_matched","type":"∀ {ι : Type u_1} {ι' : Type u_2} (S : Finset ι) (S' : Finset ι') (w s : ι → ℝ) (w' s' : ι' → ℝ) (kt : ℕ → ℝ)\n  (a κ B H c d W Wt : ℝ) (k k' h h' : ℕ → ℝ) (N T M n : ℕ) (wt rt : ℕ → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 < T →\n      0 ≤ Wt →\n        0 ≤ B →\n          0 ≤ H →\n            0 ≤ c →\n              0 ≤ d →\n                c + d ≤ 1 →\n                  (∀ i ∈ S, 0 ≤ w i) →\n                    (∀ i ∈ S', 0 ≤ w' i) →\n                      (∀ i ∈ S, |s i| ≤ 1) →\n                        (∀ i ∈ S', |s' i| ≤ 1) →\n                          ∑ i ∈ S, w i ≤ W →\n                            ∑ i ∈ S', w' i ≤ W →\n                              (∀ j < n, CurrentMM.mgMoment S w s j = CurrentMM.mgMoment S' w' s' j) →\n                                (∀ (m : ℕ), k m = kt m + CurrentMM.mgKernel S w s c d m) →\n                                  (∀ (m : ℕ), k' m = kt m + CurrentMM.mgKernel S' w' s' c d m) →\n                                    h 0 = κ →\n                                      h' 0 = κ →\n                                        (∀ (t : ℕ),\n                                            h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n                                          (∀ (t : ℕ),\n                                              h' (t + 1) =\n                                                a * h' t + κ * ∑ j ∈ Finset.range (t + 1), k' j * h' (t - j)) →\n                                            (∀ (j : ℕ), |k j| ≤ B) →\n                                              (∀ s < T, |h' s| ≤ H) →\n                                                (∀ i < M, |wt i| ≤ Wt) →\n                                                  (∀ i < M, |rt i| ≤ 1) →\n                                                    ∀ (α₀ β₀ : ℝ),\n                                                      α₀ + β₀ ≤ 1 →\n                                                        ∀ (A : Set (CurrentMM.ObservationRecord (N * (T + M * T)))),\n                                                          MeasurableSet A →\n                                                            (CurrentMM.gaussianRecordLaw (N * (T + M * T))\n                                                                      (CurrentMM.p1RepeatedMean N (T + M * T)\n                                                                        (CurrentMM.jointMean T h wt rt))\n                                                                      variance).real\n                                                                  A ≤\n                                                                α₀ →\n                                                              (CurrentMM.gaussianRecordLaw (N * (T + M * T))\n                                                                        (CurrentMM.p1RepeatedMean N (T + M * T)\n                                                                          (CurrentMM.jointMean T h' wt rt))\n                                                                        variance).real\n                                                                    Aᶜ ≤\n                                                                  β₀ →\n                                                                4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤\n                                                                  ↑N * (↑T + ↑M * ↑T) *\n                                                                    (2 * W * 2 ^ T * d ^ n *\n                                                                          CurrentMM.p1GapConst a |κ| B H T *\n                                                                        (1 + Wt * ↑T)) ^\n                                                                      2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kernel_centring_true","type":"∀ {K : ℕ} (rc Δ : ℝ),\n  Δ ≠ 0 →\n    ∀ (k : ℕ → ℝ) (s ω : Fin K → ℝ),\n      (∀ (j : ℕ), k j = ∑ i, ω i * (rc + Δ * s i) ^ j) →\n        CurrentMM.kernelMomentEstimate K rc Δ k = CurrentMM.momentMap K (s, ω)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kernel_centring_perturb","type":"∀ {K : ℕ} (rc Δ : ℝ),\n  |rc| ≤ 1 →\n    0 < Δ →\n      Δ ≤ 1 →\n        ∀ (k k' : ℕ → ℝ) (η : ℝ),\n          0 ≤ η →\n            (∀ j < 2 * K, |k' j - k j| ≤ η) →\n              dist (CurrentMM.kernelMomentEstimate K rc Δ k') (CurrentMM.kernelMomentEstimate K rc Δ k) ≤\n                2 ^ (2 * K) * η * (Δ ^ (2 * K - 1))⁻¹"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tag_term_perturb","type":"∀ (w w' r r' : ℝ), |r| ≤ 1 → |r'| ≤ 1 → ∀ (j : ℕ), |w' * r' ^ j - w * r ^ j| ≤ |w' - w| + |w| * ↑j * |r' - r|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_residual_kernel_close","type":"∀ {K m : ℕ} (wt rt wt' rt' : Fin m → ℝ) (Wt : ℝ),\n  (∀ (i : Fin m), |wt i| ≤ Wt) →\n    (∀ (i : Fin m), |rt i| ≤ 1) →\n      (∀ (i : Fin m), |rt' i| ≤ 1) →\n        ∀ (ku k khat : ℕ → ℝ),\n          (∀ (j : ℕ), k j = ∑ i, wt i * rt i ^ j + ku j) →\n            ∀ (ek ew er : ℝ),\n              0 ≤ er →\n                (∀ j < 2 * K, |khat j - k j| ≤ ek) →\n                  (∀ (i : Fin m), |wt' i - wt i| ≤ ew) →\n                    (∀ (i : Fin m), |rt' i - rt i| ≤ er) →\n                      ∀ j < 2 * K, |khat j - ∑ i, wt' i * rt' i ^ j - ku j| ≤ ek + ↑m * (ew + Wt * (2 * ↑K) * er)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_partial_upper_deterministic","type":"∀ {K m : ℕ} (S : Set (Fin K → ℝ)),\n  IsCompact S →\n    ∀ (γ : ℝ),\n      0 < γ →\n        (∀ s ∈ S, ∀ (i j : Fin K), i < j → γ ≤ s j - s i) →\n          (∀ s ∈ S, ∀ (i : Fin K), |s i| ≤ 1) →\n            ∀ (ωmin ωmax : ℝ),\n              0 < ωmin →\n                ωmin ≤ ωmax →\n                  ∀ (rc : ℝ),\n                    |rc| < 1 →\n                      ∃ c₁ > 0,\n                        ∃ L > 0,\n                          ∀ (Δ : ℝ),\n                            0 < Δ →\n                              Δ ≤ 1 - |rc| →\n                                ∀ s ∈ S,\n                                  ∀ (ω : Fin K → ℝ),\n                                    (∀ (i : Fin K), ω i ∈ Set.Icc ωmin ωmax) →\n                                      ∀ (wt rt wt' rt' : Fin m → ℝ) (Wt : ℝ),\n                                        (∀ (i : Fin m), |wt i| ≤ Wt) →\n                                          (∀ (i : Fin m), |rt i| ≤ 1) →\n                                            (∀ (i : Fin m), |rt' i| ≤ 1) →\n                                              ∀ (k khat : ℕ → ℝ),\n                                                (∀ (j : ℕ),\n                                                    k j = ∑ i, wt i * rt i ^ j + ∑ i, ω i * (rc + Δ * s i) ^ j) →\n                                                  ∀ (ek ew er : ℝ),\n                                                    0 ≤ ek →\n                                                      0 ≤ ew →\n                                                        0 ≤ er →\n                                                          (∀ j < 2 * K, |khat j - k j| ≤ ek) →\n                                                            (∀ (i : Fin m), |wt' i - wt i| ≤ ew) →\n                                                              (∀ (i : Fin m), |rt' i - rt i| ≤ er) →\n                                                                2 ^ (2 * K) * (ek + ↑m * (ew + Wt * (2 * ↑K) * er)) *\n                                                                      (Δ ^ (2 * K - 1))⁻¹ ≤\n                                                                    c₁ →\n                                                                  (∃ x,\n                                                                      StrictMono x.1 ∧\n                                                                        (∀ (i : Fin K), x.2 i ≠ 0) ∧\n                                                                          CurrentMM.momentMap K x =\n                                                                            CurrentMM.kernelMomentEstimate K rc Δ\n                                                                              fun j =>\n                                                                              khat j - ∑ i, wt' i * rt' i ^ j) ∧\n                                                                    ∀ (x : CurrentMM.PronyParam K),\n                                                                      StrictMono x.1 →\n                                                                        (∀ (i : Fin K), x.2 i ≠ 0) →\n                                                                          (CurrentMM.momentMap K x =\n                                                                              CurrentMM.kernelMomentEstimate K rc Δ\n                                                                                fun j =>\n                                                                                khat j - ∑ i, wt' i * rt' i ^ j) →\n                                                                            ∀ (i : Fin K),\n                                                                              |x.2 i - ω i| ≤\n                                                                                L *\n                                                                                  (2 ^ (2 * K) * (ek + ↑m * (ew + ⋯)) *\n                                                                                    (Δ ^ (2 * K - 1))⁻¹)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_measurable_obsMap","type":"∀ (M T : ℕ), Measurable (CurrentMM.obsMap M T)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_obsMap_recMat","type":"∀ (M T : ℕ) (g : ℕ → ℝ) (ξ : Fin (M + T) → ℝ) (t : Fin T),\n  CurrentMM.obsMap M T ((CurrentMM.recMat M T g).mulVec ξ) t = ∑ σ, (if ↑σ ≤ M + ↑t then g (M + ↑t - ↑σ) else 0) * ξ σ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passive_record_kl","type":"∀ (M T : ℕ) (v : NNReal),\n  v ≠ 0 →\n    ∀ (g0 g1 r : ℕ → ℝ) (D E1 : ℝ),\n      CurrentMM.IsReciprocal r g0 →\n        g0 0 = 1 →\n          g1 0 = 1 →\n            (∀ (N : ℕ), ∑ m ∈ Finset.range N, |r m| ≤ D) →\n              (∀ (N : ℕ), ∑ m ∈ Finset.range N, |g1 m - g0 m| ≤ E1) →\n                InformationTheory.klDiv (CurrentMM.obsLaw M T v g1) (CurrentMM.obsLaw M T v g0) ≤\n                  ENNReal.ofReal (1 / 2 * (D ^ 2 * ↑T * E1 ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_closed_loop_reciprocal","type":"∀ (a κ : ℝ) (k g : ℕ → ℝ),\n  g 0 = 1 →\n    (∀ (t : ℕ), g (t + 1) = a * g t + κ * ∑ j ∈ Finset.range (t + 1), k j * g (t - j)) →\n      CurrentMM.IsReciprocal (CurrentMM.clRecip a κ k) g"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_clRecip_l1","type":"∀ (a κ K1 : ℝ) (k : ℕ → ℝ),\n  (∀ (N : ℕ), ∑ m ∈ Finset.range N, |k m| ≤ K1) →\n    ∀ (N : ℕ), ∑ m ∈ Finset.range N, |CurrentMM.clRecip a κ k m| ≤ 1 + |a| + |κ| * K1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_split_response_gap","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    (∀ (n : ℕ), ∑ m ∈ Finset.range n, |CurrentMM.cohortKernel ![q] ![ηbar] m| ≤ q) ∧\n                      ∀ (n : ℕ),\n                        ∑ t ∈ Finset.range n,\n                            |CurrentMM.actualCohortImpulse a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] t -\n                                CurrentMM.actualCohortImpulse a κ ![q] ![ηbar] t| ≤\n                          2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2) * δ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost_sample_bound","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (M T : ℕ) (v : NNReal),\n                      v ≠ 0 →\n                        ∀ (A : Set (Fin T → ℝ)),\n                          MeasurableSet A →\n                            (CurrentMM.obsLaw M T v fun j =>\n                                      CurrentMM.actualCohortImpulse a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] j /\n                                        κ).real\n                                  A ≤\n                                1 / 4 →\n                              (CurrentMM.obsLaw M T v fun j =>\n                                        CurrentMM.actualCohortImpulse a κ ![q] ![ηbar] j / κ).real\n                                    Aᶜ ≤\n                                  1 / 4 →\n                                1 ≤ 2 * (1 + s) ^ 2 * (2 * κ * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * δ ^ 4 * ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binom_tail","type":"∀ (a b : ℝ),\n  0 ≤ a →\n    0 ≤ b →\n      ∀ (m J : ℕ),\n        J ≤ m →\n          ∑ j ∈ Finset.Ico J (m + 1), ↑(m.choose j) * a ^ (m - j) * b ^ j ≤ ↑(m.choose J) * b ^ J * (a + b) ^ (m - J)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_population_kernel_expand","type":"∀ {ι : Type u_1} [inst : Fintype ι] (w s : ι → ℝ) (c d : ℝ) (m : ℕ),\n  ∑ i, w i * (c + d * s i) ^ m = ∑ k ∈ Finset.range (m + 1), ↑(m.choose k) * c ^ (m - k) * d ^ k * ∑ i, w i * s i ^ k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_weighted_power_abs_le","type":"∀ {ι : Type u_1} [inst : Fintype ι] (u t : ι → ℝ),\n  (∀ (i : ι), 0 ≤ u i) → (∀ (i : ι), |t i| ≤ 1) → ∀ (k : ℕ), |∑ i, u i * t i ^ k| ≤ ∑ i, u i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_matched_kernel_gap","type":"∀ {ι : Type u_1} {κι : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κι] (w s : ι → ℝ) (w' s' : κι → ℝ) (c d W : ℝ)\n  (J : ℕ),\n  0 ≤ d →\n    (∀ (i : ι), 0 ≤ w i) →\n      (∀ (i : κι), 0 ≤ w' i) →\n        ∑ i, w i ≤ W →\n          ∑ i, w' i ≤ W →\n            (∀ (i : ι), |s i| ≤ 1) →\n              (∀ (i : κι), |s' i| ≤ 1) →\n                (∀ j < J, ∑ i, w i * s i ^ j = ∑ i, w' i * s' i ^ j) →\n                  ∀ (m : ℕ),\n                    |∑ i, w i * (c + d * s i) ^ m - ∑ i, w' i * (c + d * s' i) ^ m| ≤\n                      if J ≤ m then 2 * W * ↑(m.choose J) * d ^ J * (|c| + d) ^ (m - J) else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_matched_kernel_gap_l1","type":"∀ {ι : Type u_1} {κι : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κι] (w s : ι → ℝ) (w' s' : κι → ℝ) (c d W : ℝ)\n  (J : ℕ),\n  0 ≤ d →\n    |c| + d < 1 →\n      (∀ (i : ι), 0 ≤ w i) →\n        (∀ (i : κι), 0 ≤ w' i) →\n          ∑ i, w i ≤ W →\n            ∑ i, w' i ≤ W →\n              (∀ (i : ι), |s i| ≤ 1) →\n                (∀ (i : κι), |s' i| ≤ 1) →\n                  (∀ j < J, ∑ i, w i * s i ^ j = ∑ i, w' i * s' i ^ j) →\n                    ∀ (N : ℕ),\n                      ∑ m ∈ Finset.range N, |∑ i, w i * (c + d * s i) ^ m - ∑ i, w' i * (c + d * s' i) ^ m| ≤\n                        2 * W * d ^ J * (1 / (1 - (|c| + d)) ^ (J + 1))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_geom_partial_le","type":"∀ (x : ℝ), 0 ≤ x → x < 1 → ∀ (N : ℕ), ∑ m ∈ Finset.range N, x ^ m ≤ 1 / (1 - x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_population_kernel_l1","type":"∀ {ι : Type u_1} [inst : Fintype ι] (w s : ι → ℝ) (c d W : ℝ),\n  0 ≤ c →\n    0 ≤ d →\n      c + d < 1 →\n        (∀ (i : ι), 0 ≤ w i) →\n          ∑ i, w i ≤ W →\n            (∀ (i : ι), |s i| ≤ 1) → ∀ (N : ℕ), ∑ m ∈ Finset.range N, |∑ i, w i * (c + d * s i) ^ m| ≤ W / (1 - (c + d))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost_every_K","type":"∀ (L : ℕ) (a κ c d W s : ℝ),\n  0 < κ →\n    0 ≤ c →\n      0 ≤ d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + κ * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                ∀ (q rate q' rate' : Fin (L + 1) → ℝ),\n                  (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                    (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                      (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                        (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                          ∀ (M T : ℕ) (v : NNReal),\n                            v ≠ 0 →\n                              ∀ (A : Set (Fin T → ℝ)),\n                                MeasurableSet A →\n                                  (CurrentMM.obsLaw M T v fun j => CurrentMM.actualCohortImpulse a κ q rate j / κ).real\n                                        A ≤\n                                      1 / 4 →\n                                    (CurrentMM.obsLaw M T v fun j =>\n                                              CurrentMM.actualCohortImpulse a κ q' rate' j / κ).real\n                                          Aᶜ ≤\n                                        1 / 4 →\n                                      1 ≤\n                                        2 * (1 + s) ^ 2 *\n                                            (κ * (2 * W * d ^ (2 * L + 1) * (1 / (1 - (c + d)) ^ (2 * L + 1 + 1))) /\n                                                (1 - s) ^ 2) ^\n                                              2 *\n                                          ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost_matched","type":"∀ {K K' : ℕ} (J : ℕ) (a κ c d W s : ℝ),\n  0 < κ →\n    0 ≤ c →\n      0 ≤ d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + κ * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                ∀ (q rate : Fin K → ℝ) (q' rate' : Fin K' → ℝ) (w sn : Fin K → ℝ) (w' sn' : Fin K' → ℝ),\n                  (∀ (i : Fin K), 1 - rate i = c + d * sn i) →\n                    (∀ (i : Fin K'), 1 - rate' i = c + d * sn' i) →\n                      (∀ (i : Fin K), q i * rate i = w i) →\n                        (∀ (i : Fin K'), q' i * rate' i = w' i) →\n                          (∀ (i : Fin K), 0 ≤ w i) →\n                            (∀ (i : Fin K'), 0 ≤ w' i) →\n                              ∑ i, w i ≤ W →\n                                ∑ i, w' i ≤ W →\n                                  (∀ (i : Fin K), |sn i| ≤ 1) →\n                                    (∀ (i : Fin K'), |sn' i| ≤ 1) →\n                                      (∀ j < J, ∑ i, w i * sn i ^ j = ∑ i, w' i * sn' i ^ j) →\n                                        ∀ (M T : ℕ) (v : NNReal),\n                                          v ≠ 0 →\n                                            ∀ (A : Set (Fin T → ℝ)),\n                                              MeasurableSet A →\n                                                (CurrentMM.obsLaw M T v fun j =>\n                                                          CurrentMM.actualCohortImpulse a κ q rate j / κ).real\n                                                      A ≤\n                                                    1 / 4 →\n                                                  (CurrentMM.obsLaw M T v fun j =>\n                                                            CurrentMM.actualCohortImpulse a κ q' rate' j / κ).real\n                                                        Aᶜ ≤\n                                                      1 / 4 →\n                                                    1 ≤\n                                                      2 * (1 + s) ^ 2 *\n                                                          (κ * (2 * W * d ^ J * (1 / (1 - (c + d)) ^ (J + 1))) /\n                                                              (1 - s) ^ 2) ^\n                                                            2 *\n                                                        ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive_cost_gauss_radau_two","type":"∀ (a κ c d W s : ℝ),\n  0 < κ →\n    0 ≤ c →\n      0 ≤ d →\n        c + d < 1 →\n          0 ≤ W →\n            |a| + κ * (W / (1 - (c + d))) ≤ s →\n              s < 1 →\n                ∀ (q rate q' rate' : Fin 2 → ℝ),\n                  (∀ (i : Fin 2), 1 - rate i = c + d * CurrentMM.grGNode i) →\n                    (∀ (i : Fin 2), 1 - rate' i = c + d * CurrentMM.grRNode i) →\n                      (∀ (i : Fin 2), q i * rate i = W * CurrentMM.grGWeight i) →\n                        (∀ (i : Fin 2), q' i * rate' i = W * CurrentMM.grRWeight i) →\n                          ∀ (M T : ℕ) (v : NNReal),\n                            v ≠ 0 →\n                              ∀ (A : Set (Fin T → ℝ)),\n                                MeasurableSet A →\n                                  (CurrentMM.obsLaw M T v fun j => CurrentMM.actualCohortImpulse a κ q rate j / κ).real\n                                        A ≤\n                                      1 / 4 →\n                                    (CurrentMM.obsLaw M T v fun j =>\n                                              CurrentMM.actualCohortImpulse a κ q' rate' j / κ).real\n                                          Aᶜ ≤\n                                        1 / 4 →\n                                      1 ≤\n                                        2 * (1 + s) ^ 2 *\n                                            (κ * (2 * W * d ^ 3 * (1 / (1 - (c + d)) ^ (3 + 1))) / (1 - s) ^ 2) ^ 2 *\n                                          ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_inner_conv","type":"∀ (r g : ℕ → ℝ),\n  CurrentMM.IsReciprocal r g →\n    ∀ (u τ : ℕ), u ≤ τ → ∑ ρ ∈ Finset.Ico u (τ + 1), g (τ - ρ) * r (ρ - u) = if τ = u then 1 else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recording_factor_N","type":"∀ (M n : ℕ) (g0 g1 r : ℕ → ℝ),\n  CurrentMM.IsReciprocal r g0 →\n    g0 0 = 1 →\n      g1 0 = 1 →\n        ∀ (τ σ : ℕ),\n          τ < n →\n            σ < n →\n              ∑ ρ ∈ Finset.range n,\n                  CurrentMM.recN M g0 τ ρ *\n                    ((if ρ = σ then 1 else 0) + CurrentMM.corrN M r (fun j => g1 j - g0 j) ρ σ) =\n                CurrentMM.recN M g1 τ σ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recording_factor","type":"∀ (M T : ℕ) (g0 g1 r : ℕ → ℝ),\n  CurrentMM.IsReciprocal r g0 →\n    g0 0 = 1 →\n      g1 0 = 1 → (CurrentMM.recMat M T g0 * CurrentMM.corrMat M T r fun j => g1 j - g0 j) = CurrentMM.recMat M T g1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_corrN_upper_zero","type":"∀ (M : ℕ) (r dg : ℕ → ℝ), dg 0 = 0 → ∀ (τ σ : ℕ), τ ≤ σ → CurrentMM.corrN M r dg τ σ = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_corrMat_lower","type":"∀ (M T : ℕ) (r dg : ℕ → ℝ), dg 0 = 0 → (CurrentMM.corrMat M T r dg).IsLowerTriangular"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_corrMat_diag","type":"∀ (M T : ℕ) (r dg : ℕ → ℝ), dg 0 = 0 → ∀ (τ : Fin (M + T)), CurrentMM.corrMat M T r dg τ τ = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sq_sum_le_sq_abs_sum","type":"∀ (s : Finset ℕ) (a : ℕ → ℝ), ∑ j ∈ s, a j ^ 2 ≤ (∑ j ∈ s, |a j|) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_recording_frobenius_N","type":"∀ (M T : ℕ) (r dg : ℕ → ℝ) (D E1 : ℝ),\n  dg 0 = 0 →\n    (∀ (N : ℕ), ∑ m ∈ Finset.range N, |r m| ≤ D) →\n      (∀ (N : ℕ), ∑ m ∈ Finset.range N, |dg m| ≤ E1) →\n        ∑ σ ∈ Finset.range (M + T), ∑ τ ∈ Finset.range (M + T), CurrentMM.corrN M r dg τ σ ^ 2 ≤ D ^ 2 * ↑T * E1 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mom_zero","type":"∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ], CurrentMM.mom μ 0 = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mono2","type":"∀ (μ ν : MeasureTheory.Measure ℝ) [MeasureTheory.SFinite μ] [MeasureTheory.SFinite ν] (i j : ℕ),\n  ∫ (z : ℝ × ℝ), z.1 ^ i * z.2 ^ j ∂μ.prod ν = (∫ (x : ℝ), x ^ i ∂μ) * ∫ (y : ℝ), y ^ j ∂ν"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mono3","type":"∀ (μ ν ρ : MeasureTheory.Measure ℝ) [MeasureTheory.SFinite μ] [MeasureTheory.SFinite ν] [MeasureTheory.SFinite ρ]\n  (k l m : ℕ),\n  ∫ (c : (ℝ × ℝ) × ℝ), c.1.1 ^ k * c.1.2 ^ l * c.2 ^ m ∂(μ.prod ν).prod ρ =\n    ((∫ (x : ℝ), x ^ k ∂μ) * ∫ (x : ℝ), x ^ l ∂ν) * ∫ (x : ℝ), x ^ m ∂ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mono5","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN]\n  (i j k l m : ℕ),\n  ∫ (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ),\n      ω.1.1 ^ i * ω.1.2 ^ j * (ω.2.1.1 ^ k * ω.2.1.2 ^ l * ω.2.2 ^ m) ∂CurrentMM.passiveBlockLaw μW μN =\n    CurrentMM.mom μW i * CurrentMM.mom μN j * (CurrentMM.mom μW k * CurrentMM.mom μW l * CurrentMM.mom μN m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_blockMono_integrable","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (e : ℕ × ℕ × ℕ × ℕ × ℕ), MeasureTheory.Integrable (CurrentMM.blockMono e) (CurrentMM.passiveBlockLaw μW μN)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_block_poly_integrable","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ {n : ℕ} (c : Fin n → ℝ) (e : Fin n → ℕ × ℕ × ℕ × ℕ × ℕ),\n        MeasureTheory.Integrable (fun ω => ∑ t, c t * CurrentMM.blockMono (e t) ω) (CurrentMM.passiveBlockLaw μW μN)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_block_poly_integral","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ {n : ℕ} (c : Fin n → ℝ) (e : Fin n → ℕ × ℕ × ℕ × ℕ × ℕ),\n        ∫ (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ), ∑ t, c t * CurrentMM.blockMono (e t) ω ∂CurrentMM.passiveBlockLaw μW μN =\n          ∑ t, c t * CurrentMM.blockMom μW μN (e t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passiveZ_poly","type":"∀ (b1 b2 : ℝ) (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ),\n  CurrentMM.passiveZ b1 b2 ω = ∑ t, CurrentMM.passiveZc b1 b2 t * CurrentMM.blockMono (CurrentMM.passiveZe t) ω"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passiveZ2_poly","type":"∀ (b1 b2 : ℝ) (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ),\n  CurrentMM.passiveZ b1 b2 ω ^ 2 = ∑ t, CurrentMM.passiveZ2c b1 b2 t * CurrentMM.blockMono (CurrentMM.passiveZ2e t) ω"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passiveZ_measurable","type":"∀ (b1 b2 : ℝ), Measurable (CurrentMM.passiveZ b1 b2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_momW1","type":"∀ {μW : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW], ∫ (x : ℝ), x ∂μW = 0 → CurrentMM.mom μW 1 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_momN1","type":"∀ {μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μN], ∫ (x : ℝ), x ∂μN = 0 → CurrentMM.mom μN 1 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passive0_mean","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (s : ℝ),\n        ∫ (x : ℝ), x ∂μW = 0 →\n          ∫ (x : ℝ), x ^ 2 ∂μW = s →\n            ∫ (x : ℝ), x ∂μN = 0 →\n              ∀ (b1 b2 : ℝ),\n                ∫ (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ), CurrentMM.passiveZ b1 b2 ω ∂CurrentMM.passiveBlockLaw μW μN = b2 * s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passive0_second_moment","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (s σ2 m4 : ℝ),\n        ∫ (x : ℝ), x ∂μW = 0 →\n          ∫ (x : ℝ), x ^ 2 ∂μW = s →\n            ∫ (x : ℝ), x ^ 4 ∂μW = m4 →\n              ∫ (x : ℝ), x ∂μN = 0 →\n                ∫ (x : ℝ), x ^ 2 ∂μN = σ2 →\n                  ∀ (b1 b2 : ℝ),\n                    ∫ (ω : (ℝ × ℝ) × (ℝ × ℝ) × ℝ), CurrentMM.passiveZ b1 b2 ω ^ 2 ∂CurrentMM.passiveBlockLaw μW μN =\n                      b2 ^ 2 * (m4 + s * σ2) + (s + σ2) * (b1 ^ 2 * s + s + σ2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passiveZ_memLp","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (b1 b2 : ℝ), MeasureTheory.MemLp (CurrentMM.passiveZ b1 b2) 2 (CurrentMM.passiveBlockLaw μW μN)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_passive0_variance_le","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (s σ2 m4 : ℝ),\n        ∫ (x : ℝ), x ∂μW = 0 →\n          ∫ (x : ℝ), x ^ 2 ∂μW = s →\n            ∫ (x : ℝ), x ^ 4 ∂μW = m4 →\n              ∫ (x : ℝ), x ∂μN = 0 →\n                ∫ (x : ℝ), x ^ 2 ∂μN = σ2 →\n                  ∀ (b1 b2 : ℝ),\n                    m4 ≤ 3 * s ^ 2 →\n                      ProbabilityTheory.variance (CurrentMM.passiveZ b1 b2) (CurrentMM.passiveBlockLaw μW μN) ≤\n                        (s + σ2) * (s * (1 + b1 ^ 2 + b2 ^ 2) + σ2) + s ^ 2 * b2 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_iid_chebyshev","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  (Z : Ω → ℝ),\n  Measurable Z →\n    MeasureTheory.MemLp Z 2 P →\n      ∀ (n : ℕ) {c : ℝ},\n        0 < c →\n          (MeasureTheory.Measure.pi fun x => P) {ω | c ≤ |∑ i, Z (ω i) - ↑n * ∫ (x : Ω), Z x ∂P|} ≤\n            ENNReal.ofReal (↑n * ProbabilityTheory.variance Z P / c ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sample_size_arith","type":"∀ (n V R α Δ : ℝ), 0 < n → 0 < α → 0 < Δ → V ≤ R → 4 * R / (α * Δ ^ 2) ≤ n → n * V / (n * Δ / 2) ^ 2 ≤ α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_midpoint_lower","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  (Z : Ω → ℝ),\n  Measurable Z →\n    MeasureTheory.MemLp Z 2 P →\n      ∀ (μ Δ R α : ℝ),\n        ∫ (x : Ω), Z x ∂P = μ →\n          ProbabilityTheory.variance Z P ≤ R →\n            0 < α →\n              0 < Δ →\n                ∀ (n : ℕ),\n                  0 < n →\n                    4 * R / (α * Δ ^ 2) ≤ ↑n →\n                      (MeasureTheory.Measure.pi fun x => P) {ω | ∑ i, Z (ω i) < ↑n * (μ - Δ / 2)} ≤ ENNReal.ofReal α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_midpoint_upper","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  (Z : Ω → ℝ),\n  Measurable Z →\n    MeasureTheory.MemLp Z 2 P →\n      ∀ (μ Δ R α : ℝ),\n        ∫ (x : Ω), Z x ∂P = μ →\n          ProbabilityTheory.variance Z P ≤ R →\n            0 < α →\n              0 < Δ →\n                ∀ (n : ℕ),\n                  0 < n →\n                    4 * R / (α * Δ ^ 2) ≤ ↑n →\n                      (MeasureTheory.Measure.pi fun x => P) {ω | ↑n * (μ + Δ / 2) ≤ ∑ i, Z (ω i)} ≤ ENNReal.ofReal α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_passive0","type":"∀ {μW μN : MeasureTheory.Measure ℝ} [MeasureTheory.IsProbabilityMeasure μW] [MeasureTheory.IsProbabilityMeasure μN],\n  (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μW) →\n    (∀ (k : ℕ), MeasureTheory.Integrable (fun x => x ^ k) μN) →\n      ∀ (s σ2 m4 : ℝ),\n        ∫ (x : ℝ), x ∂μW = 0 →\n          ∫ (x : ℝ), x ^ 2 ∂μW = s →\n            ∫ (x : ℝ), x ^ 4 ∂μW = m4 →\n              ∫ (x : ℝ), x ∂μN = 0 →\n                ∫ (x : ℝ), x ^ 2 ∂μN = σ2 →\n                  m4 ≤ 3 * s ^ 2 →\n                    0 < s →\n                      ∀ (b1 b20 b2δ R α : ℝ),\n                        b2δ < b20 →\n                          (s + σ2) * (s * (1 + b1 ^ 2 + b20 ^ 2) + σ2) + s ^ 2 * b20 ^ 2 ≤ R →\n                            (s + σ2) * (s * (1 + b1 ^ 2 + b2δ ^ 2) + σ2) + s ^ 2 * b2δ ^ 2 ≤ R →\n                              0 < α →\n                                ∀ (n : ℕ),\n                                  0 < n →\n                                    4 * R / (α * ((b20 - b2δ) * s) ^ 2) ≤ ↑n →\n                                      (MeasureTheory.Measure.pi fun x => CurrentMM.passiveBlockLaw μW μN)\n                                            {ω | ∑ i, CurrentMM.passiveZ b1 b20 (ω i) < ↑n * ((b20 + b2δ) * s / 2)} ≤\n                                          ENNReal.ofReal α ∧\n                                        (MeasureTheory.Measure.pi fun x => CurrentMM.passiveBlockLaw μW μN)\n                                            {ω | ↑n * ((b20 + b2δ) * s / 2) ≤ ∑ i, CurrentMM.passiveZ b1 b2δ (ω i)} ≤\n                                          ENNReal.ofReal α"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binPinskerAux_self","type":"∀ (p : ℝ), CurrentMM.p1BinPinskerAux p p = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binPinskerAux_hasDerivAt","type":"∀ (p x : ℝ), 0 < x → x < 1 → HasDerivAt (CurrentMM.p1BinPinskerAux p) (-(p * x⁻¹) + (1 - p) * (1 - x)⁻¹ - 4 * (x - p)) x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binPinskerAux_deriv_nonneg","type":"∀ (p x : ℝ), p ≤ x → 0 < x → x < 1 → 0 ≤ -(p * x⁻¹) + (1 - p) * (1 - x)⁻¹ - 4 * (x - p)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binPinskerAux_continuousOn","type":"∀ (p q : ℝ), 0 ≤ p → q < 1 → ContinuousOn (CurrentMM.p1BinPinskerAux p) (Set.Icc p q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binary_pinsker_le","type":"∀ (p q : ℝ), 0 ≤ p → p ≤ q → q < 1 → 2 * (q - p) ^ 2 ≤ p * Real.log (p / q) + (1 - p) * Real.log ((1 - p) / (1 - q))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_binary_pinsker","type":"∀ (p q : ℝ),\n  0 ≤ p → p ≤ 1 → 0 < q → q < 1 → 2 * (p - q) ^ 2 ≤ p * Real.log (p / q) + (1 - p) * Real.log ((1 - p) / (1 - q))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kl_ge_binary","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A →\n    P.AbsolutelyContinuous Q →\n      Q A ≠ 0 →\n        Q Aᶜ ≠ 0 →\n          ENNReal.ofReal (P.real A * Real.log (P.real A / Q.real A) + P.real Aᶜ * Real.log (P.real Aᶜ / Q.real Aᶜ)) ≤\n            InformationTheory.klDiv P Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_set_pinsker","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A → ENNReal.ofReal (2 * (P.real A - Q.real A) ^ 2) ≤ InformationTheory.klDiv P Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_test_error_kl_lower_bound_general","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A →\n    ∀ (a b : ℝ),\n      a + b ≤ 1 → P.real A ≤ a → Q.real Aᶜ ≤ b → ENNReal.ofReal (2 * (1 - a - b) ^ 2) ≤ InformationTheory.klDiv P Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_worst_error_ge","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A →\n    ∀ (c : ℝ), 0 ≤ c → InformationTheory.klDiv P Q ≤ ENNReal.ofReal c → (1 - √(c / 2)) / 2 ≤ max (P.real A) (Q.real Aᶜ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfDen_monic","type":"∀ {K : ℕ} (r : Fin K → ℝ), (CurrentMM.tfDen r).Monic"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfDen_natDegree","type":"∀ {K : ℕ} (r : Fin K → ℝ), (CurrentMM.tfDen r).natDegree = K"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfNum_degree_le","type":"∀ {K : ℕ} (w r : Fin K → ℝ), (CurrentMM.tfNum w r).natDegree ≤ K"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfBottom_monic_natDegree","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ),\n  (CurrentMM.tfBottom a κ w r).Monic ∧ (CurrentMM.tfBottom a κ w r).natDegree = K + 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfDen_eval_self","type":"∀ {K : ℕ} (r : Fin K → ℝ) (k : Fin K), Polynomial.eval (r k) (CurrentMM.tfDen r) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfNum_eval_self","type":"∀ {K : ℕ} (w r : Fin K → ℝ) (k : Fin K),\n  Polynomial.eval (r k) (CurrentMM.tfNum w r) = w k * r k * ∏ j ∈ Finset.univ.erase k, (r k - r j)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_merged_pole_count","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ),\n  a ≠ 0 →\n    κ ≠ 0 →\n      Function.Injective r →\n        (∀ (i : Fin K), r i ≠ 0) →\n          (∀ (i : Fin K), w i ≠ 0) →\n            (∀ (z : ℝ),\n                Polynomial.eval z (CurrentMM.tfTop κ r) = 0 → Polynomial.eval z (CurrentMM.tfBottom a κ w r) ≠ 0) ∧\n              (CurrentMM.tfBottom a κ w r).Monic ∧ (CurrentMM.tfBottom a κ w r).natDegree = K + 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_lower_bound_joint","type":"∀ (D N T : ℕ) (a κ B H ε : ℕ → ℝ) (C : ℝ) (k k' h h' : ℕ → ℕ → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 < T →\n      (∀ (j : ℕ), 0 ≤ B j) →\n        (∀ (j : ℕ), 0 ≤ H j) →\n          (∀ (j : ℕ), 0 ≤ ε j) →\n            (∀ (j : ℕ), h j 0 = κ j) →\n              (∀ (j : ℕ), h' j 0 = κ j) →\n                (∀ (j t : ℕ), h j (t + 1) = a j * h j t + κ j * ∑ i ∈ Finset.range (t + 1), k j i * h j (t - i)) →\n                  (∀ (j t : ℕ), h' j (t + 1) = a j * h' j t + κ j * ∑ i ∈ Finset.range (t + 1), k' j i * h' j (t - i)) →\n                    (∀ (j i : ℕ), |k j i| ≤ B j) →\n                      (∀ (j s : ℕ), s < T → |h' j s| ≤ H j) →\n                        (∀ (j i : ℕ), i < T → |k j i - k' j i| ≤ ε j) →\n                          (∀ j < D, ε j * CurrentMM.p1GapConst (a j) |κ j| (B j) (H j) T ≤ C) →\n                            ∀ (α₀ β₀ : ℝ),\n                              α₀ + β₀ ≤ 1 →\n                                ∀ (A : Set (CurrentMM.ObservationRecord (N * (D * T)))),\n                                  MeasurableSet A →\n                                    (CurrentMM.gaussianRecordLaw (N * (D * T))\n                                              (CurrentMM.p1RepeatedMean N (D * T) (CurrentMM.multiMean T h))\n                                              variance).real\n                                          A ≤\n                                        α₀ →\n                                      (CurrentMM.gaussianRecordLaw (N * (D * T))\n                                                (CurrentMM.p1RepeatedMean N (D * T) (CurrentMM.multiMean T h'))\n                                                variance).real\n                                            Aᶜ ≤\n                                          β₀ →\n                                        4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤ ↑N * (↑D * ↑T) * C ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_lower_bound_matched","type":"∀ {ι : Type u_1} {ι' : Type u_2} (S : Finset ι) (S' : Finset ι') (w : ℕ → ι → ℝ) (s : ι → ℝ) (w' : ℕ → ι' → ℝ)\n  (s' : ι' → ℝ) (D N T n : ℕ) (a κ B H : ℕ → ℝ) (c d W C : ℝ) (k k' h h' : ℕ → ℕ → ℝ) (variance : NNReal),\n  variance ≠ 0 →\n    0 < T →\n      0 ≤ c →\n        0 ≤ d →\n          c + d ≤ 1 →\n            (∀ (j : ℕ), ∀ i ∈ S, 0 ≤ w j i) →\n              (∀ (j : ℕ), ∀ i ∈ S', 0 ≤ w' j i) →\n                (∀ i ∈ S, |s i| ≤ 1) →\n                  (∀ i ∈ S', |s' i| ≤ 1) →\n                    (∀ (j : ℕ), ∑ i ∈ S, w j i ≤ W) →\n                      (∀ (j : ℕ), ∑ i ∈ S', w' j i ≤ W) →\n                        (∀ (j l : ℕ), l < n → CurrentMM.mgMoment S (w j) s l = CurrentMM.mgMoment S' (w' j) s' l) →\n                          (∀ (j m : ℕ), k j m = CurrentMM.mgKernel S (w j) s c d m) →\n                            (∀ (j m : ℕ), k' j m = CurrentMM.mgKernel S' (w' j) s' c d m) →\n                              (∀ (j : ℕ), 0 ≤ B j) →\n                                (∀ (j : ℕ), 0 ≤ H j) →\n                                  (∀ (j : ℕ), h j 0 = κ j) →\n                                    (∀ (j : ℕ), h' j 0 = κ j) →\n                                      (∀ (j t : ℕ),\n                                          h j (t + 1) =\n                                            a j * h j t + κ j * ∑ i ∈ Finset.range (t + 1), k j i * h j (t - i)) →\n                                        (∀ (j t : ℕ),\n                                            h' j (t + 1) =\n                                              a j * h' j t + κ j * ∑ i ∈ Finset.range (t + 1), k' j i * h' j (t - i)) →\n                                          (∀ (j i : ℕ), |k j i| ≤ B j) →\n                                            (∀ (j s : ℕ), s < T → |h' j s| ≤ H j) →\n                                              (∀ j < D,\n                                                  2 * W * 2 ^ T * d ^ n *\n                                                      CurrentMM.p1GapConst (a j) |κ j| (B j) (H j) T ≤\n                                                    C) →\n                                                ∀ (α₀ β₀ : ℝ),\n                                                  α₀ + β₀ ≤ 1 →\n                                                    ∀ (A : Set (CurrentMM.ObservationRecord (N * (D * T)))),\n                                                      MeasurableSet A →\n                                                        (CurrentMM.gaussianRecordLaw (N * (D * T))\n                                                                  (CurrentMM.p1RepeatedMean N (D * T)\n                                                                    (CurrentMM.multiMean T h))\n                                                                  variance).real\n                                                              A ≤\n                                                            α₀ →\n                                                          (CurrentMM.gaussianRecordLaw (N * (D * T))\n                                                                    (CurrentMM.p1RepeatedMean N (D * T)\n                                                                      (CurrentMM.multiMean T h'))\n                                                                    variance).real\n                                                                Aᶜ ≤\n                                                              β₀ →\n                                                            4 * ↑variance * (1 - α₀ - β₀) ^ 2 ≤ ↑N * (↑D * ↑T) * C ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_explicit_pair_K2D2","type":"1 / 2 + 1 / 2 = 2 / 3 + 1 / 3 ∧\n  1 / 2 * -1 + 1 / 2 * 1 = 2 / 3 * (-1 / 2) + 1 / 3 * 1 ∧\n    7 / 10 + 3 / 10 = 14 / 15 + 1 / 15 ∧\n      7 / 10 * -1 + 3 / 10 * 1 = 14 / 15 * (-1 / 2) + 1 / 15 * 1 ∧\n        1 / 2 * (-1) ^ 2 + 1 / 2 * 1 ^ 2 ≠ 2 / 3 * (-1 / 2) ^ 2 + 1 / 3 * 1 ^ 2 ∧\n          7 / 10 * (-1) ^ 2 + 3 / 10 * 1 ^ 2 ≠ 14 / 15 * (-1 / 2) ^ 2 + 1 / 15 * 1 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_rows_lt","type":"∀ (K D l q : ℕ), D * q < K → l + 1 ≤ K + q → D * (l + 1) < K * (D + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_rows_ge","type":"∀ (K D q : ℕ), K ≤ D * q → K * (D + 1) ≤ D * (K + q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_single_market","type":"∀ (K q : ℕ), q < K → ∀ (l : ℕ), l + 1 ≤ K + q → 1 * (l + 1) < K * (1 + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_many_markets","type":"∀ (K D : ℕ), K ≤ D → K * (D + 1) ≤ D * (K + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_uniform_local_injectivity","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F},\n  ContDiff ℝ 1 f →\n    ∀ {Q : Set E},\n      IsCompact Q →\n        (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ f x)) →\n          ∃ r > 0, ∃ c > 0, ∀ x ∈ Q, ∀ u ∈ Metric.closedBall x r, ∀ w ∈ Metric.closedBall x r, c * ‖u - w‖ ≤ ‖f u - f w‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_min_distance_local","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F} {r c : ℝ},\n  0 < c →\n    ∀ {Q : Set E},\n      (∀ x ∈ Q, ∀ u ∈ Metric.closedBall x r, ∀ w ∈ Metric.closedBall x r, c * ‖u - w‖ ≤ ‖f u - f w‖) →\n        ∀ {x : E},\n          x ∈ Q →\n            0 ≤ r →\n              ∀ (that : F) {θ : E},\n                θ ∈ Metric.closedBall x r → ‖f θ - that‖ ≤ ‖f x - that‖ → ‖θ - x‖ ≤ 2 / c * ‖that - f x‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_min_distance_exists","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F},\n  Continuous f → ∀ {A : Set E}, IsCompact A → A.Nonempty → ∀ (that : F), ∃ θ ∈ A, ∀ z ∈ A, ‖f θ - that‖ ≤ ‖f z - that‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_global_lower_bound","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F},\n  ContDiff ℝ 1 f →\n    ∀ {Q : Set E},\n      IsCompact Q →\n        (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ f x)) →\n          Set.InjOn f Q → ∃ c > 0, ∀ u ∈ Q, ∀ w ∈ Q, c * ‖u - w‖ ≤ ‖f u - f w‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_min_distance_global","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F} {c : ℝ},\n  0 < c →\n    ∀ {Q : Set E},\n      (∀ u ∈ Q, ∀ w ∈ Q, c * ‖u - w‖ ≤ ‖f u - f w‖) →\n        ∀ {x θ : E}, x ∈ Q → θ ∈ Q → ∀ (that : F), ‖f θ - that‖ ≤ ‖f x - that‖ → ‖θ - x‖ ≤ 2 / c * ‖that - f x‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pooledMomentMap_contDiff","type":"∀ (K D l : ℕ), ContDiff ℝ 1 (CurrentMM.pooledMomentMap K D l)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pooledMomentMap_fderiv_apply","type":"∀ (K D l : ℕ) (x v : CurrentMM.PoolParam K D) (j : Fin D) (p : Fin (l + 1)),\n  (fderiv ℝ (CurrentMM.pooledMomentMap K D l) x) v j p =\n    ∑ i, (v.2 j i * x.1 i ^ ↑p + x.2 j i * (↑↑p * x.1 i ^ (↑p - 1)) * v.1 i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_injective_top","type":"∀ {K D' : ℕ} (x y : CurrentMM.PoolParam K (D' + 1)),\n  StrictMono x.1 →\n    StrictMono y.1 →\n      (∀ (i : Fin K), x.2 0 i ≠ 0) →\n        (∀ (i : Fin K), y.2 0 i ≠ 0) →\n          CurrentMM.pooledMomentMap K (D' + 1) (2 * K - 1) x = CurrentMM.pooledMomentMap K (D' + 1) (2 * K - 1) y →\n            x = y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_fderiv_injective_top","type":"∀ {K D' : ℕ} (x : CurrentMM.PoolParam K (D' + 1)),\n  Function.Injective x.1 →\n    (∀ (i : Fin K), x.2 0 i ≠ 0) → Function.Injective ⇑(fderiv ℝ (CurrentMM.pooledMomentMap K (D' + 1) (2 * K - 1)) x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_centring_true","type":"∀ {K D l : ℕ} (rc Δ : ℝ),\n  Δ ≠ 0 →\n    ∀ (k : Fin D → ℕ → ℝ) (x : CurrentMM.PoolParam K D),\n      (∀ (j : Fin D) (t : ℕ), k j t = ∑ i, x.2 j i * (rc + Δ * x.1 i) ^ t) →\n        CurrentMM.pooledMomentEstimate D l rc Δ k = CurrentMM.pooledMomentMap K D l x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_centring_perturb","type":"∀ {D l : ℕ} (rc Δ : ℝ),\n  |rc| ≤ 1 →\n    0 < Δ →\n      Δ ≤ 1 →\n        ∀ (k k' : Fin D → ℕ → ℝ) (e : ℝ),\n          0 ≤ e →\n            (∀ (j : Fin D), ∀ t ≤ l, |k' j t - k j t| ≤ e) →\n              dist (CurrentMM.pooledMomentEstimate D l rc Δ k') (CurrentMM.pooledMomentEstimate D l rc Δ k) ≤\n                2 ^ l * e * (Δ ^ l)⁻¹"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_upper_local","type":"∀ {K D l : ℕ} {Q : Set (CurrentMM.PoolParam K D)},\n  IsCompact Q →\n    (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ (CurrentMM.pooledMomentMap K D l) x)) →\n      ∀ (rc : ℝ),\n        |rc| ≤ 1 →\n          ∃ r > 0,\n            ∃ c > 0,\n              ∀ (Δ : ℝ),\n                0 < Δ →\n                  Δ ≤ 1 →\n                    ∀ x ∈ Q,\n                      ∀ (k khat : Fin D → ℕ → ℝ),\n                        (∀ (j : Fin D) (t : ℕ), k j t = ∑ i, x.2 j i * (rc + Δ * x.1 i) ^ t) →\n                          ∀ (e : ℝ),\n                            0 ≤ e →\n                              (∀ (j : Fin D), ∀ t ≤ l, |khat j t - k j t| ≤ e) →\n                                ∃ θ ∈ Metric.closedBall x r,\n                                  (∀ z ∈ Metric.closedBall x r,\n                                      ‖CurrentMM.pooledMomentMap K D l θ -\n                                            CurrentMM.pooledMomentEstimate D l rc Δ khat‖ ≤\n                                        ‖CurrentMM.pooledMomentMap K D l z -\n                                            CurrentMM.pooledMomentEstimate D l rc Δ khat‖) ∧\n                                    ‖θ - x‖ ≤ 2 / c * (2 ^ l * e * (Δ ^ l)⁻¹)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pool_upper_global","type":"∀ {K D l : ℕ} {Q : Set (CurrentMM.PoolParam K D)},\n  IsCompact Q →\n    Q.Nonempty →\n      (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ (CurrentMM.pooledMomentMap K D l) x)) →\n        Set.InjOn (CurrentMM.pooledMomentMap K D l) Q →\n          ∀ (rc : ℝ),\n            |rc| ≤ 1 →\n              ∃ c > 0,\n                ∀ (Δ : ℝ),\n                  0 < Δ →\n                    Δ ≤ 1 →\n                      ∀ x ∈ Q,\n                        ∀ (k khat : Fin D → ℕ → ℝ),\n                          (∀ (j : Fin D) (t : ℕ), k j t = ∑ i, x.2 j i * (rc + Δ * x.1 i) ^ t) →\n                            ∀ (e : ℝ),\n                              0 ≤ e →\n                                (∀ (j : Fin D), ∀ t ≤ l, |khat j t - k j t| ≤ e) →\n                                  ∃ θ ∈ Q,\n                                    (∀ z ∈ Q,\n                                        ‖CurrentMM.pooledMomentMap K D l θ -\n                                              CurrentMM.pooledMomentEstimate D l rc Δ khat‖ ≤\n                                          ‖CurrentMM.pooledMomentMap K D l z -\n                                              CurrentMM.pooledMomentEstimate D l rc Δ khat‖) ∧\n                                      ‖θ - x‖ ≤ 2 / c * (2 ^ l * e * (Δ ^ l)⁻¹)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sqrt_diff_strict_mono","type":"∀ (s₁ s₂ : ℝ), 0 < s₁ → s₁ < s₂ → √(s₁ ^ 2 + 4 * s₁) - s₁ < √(s₂ ^ 2 + 4 * s₂) - s₂"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_pos","type":"∀ (s : ℝ), 0 < s → 0 < CurrentMM.kalmanGain s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_lt_one","type":"∀ (s : ℝ), 0 < s → CurrentMM.kalmanGain s < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_riccati_eq","type":"∀ (s : ℝ), 0 ≤ s → CurrentMM.kalmanGain s ^ 2 + s * CurrentMM.kalmanGain s = s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_strict_mono","type":"∀ (s₁ s₂ : ℝ), 0 < s₁ → s₁ < s₂ → CurrentMM.kalmanGain s₁ < CurrentMM.kalmanGain s₂"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_kalmanGain_injective","type":"∀ {s₁ s₂ : ℝ}, 0 < s₁ → 0 < s₂ → CurrentMM.kalmanGain s₁ = CurrentMM.kalmanGain s₂ → s₁ = s₂"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_primitives_sample_transfer","type":"∀ (C σ Δs Δη c_plus N : ℝ) (K : ℕ),\n  1 ≤ K →\n    0 < C →\n      0 < σ →\n        0 < Δs →\n          0 < c_plus →\n            Δη ≤ c_plus * Δs →\n              0 < Δη → C * σ ^ 2 / Δη ^ (4 * K - 2) ≤ N → C * (c_plus ^ (4 * K - 2))⁻¹ * σ ^ 2 / Δs ^ (4 * K - 2) ≤ N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_intensity_tied_mass_inversion","type":"∀ (w_η m : ℝ),\n  0 < w_η →\n    have n := m / w_η;\n    n * w_η = m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_intensity_tied_tap_difference","type":"∀ (g : ℝ → ℝ) (n bar_η δ : ℝ),\n  n * g (bar_η + δ) + n * g (bar_η - δ) - 2 * n * g bar_η = n * (g (bar_η + δ) + g (bar_η - δ) - 2 * g bar_η)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_quadratic_second_difference_identity","type":"∀ (A B C bar_η δ : ℝ),\n  have g := fun x => A * x ^ 2 + B * x + C;\n  g (bar_η + δ) + g (bar_η - δ) - 2 * g bar_η = 2 * A * δ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_intensity_tied_quadratic_tap_gap","type":"∀ (A B C n bar_η δ : ℝ),\n  have g := fun x => A * x ^ 2 + B * x + C;\n  n * g (bar_η + δ) + n * g (bar_η - δ) - 2 * n * g bar_η = 2 * A * n * δ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_tied_sample_bound","type":"∀ (L n δ σ N : ℝ),\n  0 < L →\n    0 < n → 0 < δ → 0 < σ → 1 / 4 ≤ N * (L * n * δ ^ 2) ^ 2 / (2 * σ ^ 2) → σ ^ 2 / (2 * L ^ 2 * n ^ 2) / δ ^ 4 ≤ N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_deconv_eq","type":"∀ (a κ : ℝ) (h : ℕ → ℝ) (t : ℕ),\n  CurrentMM.deconv a κ h t =\n    (h (t + 1) - a * h t - κ * ∑ j ∈ Finset.range t, CurrentMM.deconv a κ h j * h (t - j)) / κ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_deconv_true","type":"∀ (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (k h : ℕ → ℝ),\n      h 0 = κ →\n        (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n          ∀ (t : ℕ), CurrentMM.deconv a κ h t = k t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_response_bound","type":"∀ (a κ A : ℝ),\n  0 ≤ A →\n    ∀ (n : ℕ),\n      ∃ B ≥ 0,\n        ∀ (k h : ℕ → ℝ),\n          h 0 = κ →\n            (∀ (t : ℕ), h (t + 1) = a * h t + κ * ∑ j ∈ Finset.range (t + 1), k j * h (t - j)) →\n              (∀ (j : ℕ), |k j| ≤ A) → ∀ t ≤ n, |h t| ≤ B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_deconv_perturb","type":"∀ (a κ A B : ℝ),\n  κ ≠ 0 →\n    0 ≤ A →\n      0 ≤ B →\n        ∀ (T n : ℕ),\n          ∃ C ≥ 0,\n            ∀ (h h' : ℕ → ℝ) (e : ℝ),\n              0 ≤ e →\n                e ≤ 1 →\n                  (∀ t ≤ T, |h' t - h t| ≤ e) →\n                    (∀ t ≤ T, |h t| ≤ B) →\n                      (∀ t < T, |CurrentMM.deconv a κ h t| ≤ A) →\n                        ∀ t < n, t < T → |CurrentMM.deconv a κ h' t - CurrentMM.deconv a κ h t| ≤ C * e"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_momentMap_contDiff","type":"∀ (K : ℕ), ContDiff ℝ 1 (CurrentMM.momentMap K)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_momentMap_fderiv_apply","type":"∀ (K : ℕ) (x v : CurrentMM.PronyParam K) (m : Fin (2 * K)),\n  (fderiv ℝ (CurrentMM.momentMap K) x) v m = ∑ i, (v.2 i * x.1 i ^ ↑m + x.2 i * (↑↑m * x.1 i ^ (↑m - 1)) * v.1 i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_double_root","type":"∀ (a : ℝ) (r : Polynomial ℝ),\n  Polynomial.eval a ((Polynomial.X - Polynomial.C a) ^ 2 * r) = 0 ∧\n    Polynomial.eval a (Polynomial.derivative ((Polynomial.X - Polynomial.C a) ^ 2 * r)) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hermite_functional","type":"∀ {K : ℕ} (s ω u d : Fin K → ℝ),\n  Function.Injective s →\n    (∀ (i : Fin K), ω i ≠ 0) →\n      (∀ m < 2 * K, ∑ i, (d i * s i ^ m + ω i * (↑m * s i ^ (m - 1)) * u i) = 0) → u = 0 ∧ d = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_momentMap_fderiv_injective","type":"∀ {K : ℕ} (x : CurrentMM.PronyParam K),\n  Function.Injective x.1 → (∀ (i : Fin K), x.2 i ≠ 0) → Function.Injective ⇑(fderiv ℝ (CurrentMM.momentMap K) x)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mergedWeight_at_node","type":"∀ {K : ℕ} (s w : Fin K → ℝ), Function.Injective s → ∀ (i : Fin K), CurrentMM.mergedWeight Finset.univ s w (s i) = w i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_ordered_representation_unique","type":"∀ {K : ℕ} (x y : CurrentMM.PronyParam K),\n  StrictMono x.1 →\n    StrictMono y.1 →\n      (∀ (i : Fin K), x.2 i ≠ 0) →\n        (∀ (i : Fin K), y.2 i ≠ 0) → CurrentMM.momentMap K x = CurrentMM.momentMap K y → x = y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prony_hankel_factor","type":"∀ {K : ℕ} (x : CurrentMM.PronyParam K),\n  CurrentMM.pronyHankel (CurrentMM.momentMap K x) =\n    (Matrix.vandermonde x.1).transpose * Matrix.diagonal x.2 * Matrix.vandermonde x.1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prony_hankel_det_ne_zero","type":"∀ {K : ℕ} (x : CurrentMM.PronyParam K),\n  Function.Injective x.1 → (∀ (i : Fin K), x.2 i ≠ 0) → (CurrentMM.pronyHankel (CurrentMM.momentMap K x)).det ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prony_polynomial","type":"∀ {K : ℕ} (x : CurrentMM.PronyParam K),\n  Function.Injective x.1 →\n    (∀ (i : Fin K), x.2 i ≠ 0) →\n      ∀ (c : Fin K → ℝ),\n        (CurrentMM.pronyHankel (CurrentMM.momentMap K x)).mulVec c = CurrentMM.pronyRhs (CurrentMM.momentMap K x) →\n          CurrentMM.pronyPoly c = ∏ i, (Polynomial.X - Polynomial.C (x.1 i)) ∧\n            ∀ (z : ℝ), Polynomial.eval z (CurrentMM.pronyPoly c) = 0 ↔ ∃ i, x.1 i = z"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_gaussian_hasSubgaussianMGF","type":"∀ (v : NNReal), ProbabilityTheory.HasSubgaussianMGF id v (ProbabilityTheory.gaussianReal 0 v)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mean_noise_tail","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  {N : ℕ},\n  0 < N →\n    ∀ (ξ : Fin N → Ω → ℝ) (v : NNReal),\n      ProbabilityTheory.iIndepFun ξ P →\n        (∀ (n : Fin N), ProbabilityTheory.HasSubgaussianMGF (ξ n) v P) →\n          ∀ {ε : ℝ}, 0 ≤ ε → P.real {ω | ε ≤ |(∑ n, ξ n ω) / ↑N|} ≤ 2 * Real.exp (-(↑N * ε ^ 2) / (2 * ↑v))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_noise_union","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  {N : ℕ},\n  0 < N →\n    ∀ (ξ : Fin N → ℕ → Ω → ℝ) (v : NNReal),\n      0 < v →\n        (∀ (t : ℕ), ProbabilityTheory.iIndepFun (fun n => ξ n t) P) →\n          (∀ (n : Fin N) (t : ℕ), ProbabilityTheory.HasSubgaussianMGF (ξ n t) v P) →\n            ∀ {K : ℕ},\n              1 ≤ K →\n                ∀ {β : ℝ},\n                  0 < β →\n                    β < 1 →\n                      P.real\n                          {ω |\n                            ∃ t ∈ Finset.Icc 1 (2 * K),\n                              √2 * √(Real.log (4 * ↑K / β)) * √↑v / √↑N ≤ |(∑ n, ξ n t ω) / ↑N|} ≤\n                        β"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_centring_true","type":"∀ {K : ℕ} (a κ rc Δ : ℝ),\n  Δ ≠ 0 →\n    ∀ (h : ℕ → ℝ) (s ω : Fin K → ℝ),\n      (∀ (j : ℕ), CurrentMM.deconv a κ h j = ∑ i, ω i * (rc + Δ * s i) ^ j) →\n        CurrentMM.pronyMomentEstimate K a κ rc Δ h = CurrentMM.momentMap K (s, ω)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_centring_perturb","type":"∀ {K : ℕ} (a κ rc Δ : ℝ),\n  |rc| ≤ 1 →\n    0 < Δ →\n      Δ ≤ 1 →\n        ∀ (h h' : ℕ → ℝ) (η : ℝ),\n          0 ≤ η →\n            (∀ j < 2 * K, |CurrentMM.deconv a κ h' j - CurrentMM.deconv a κ h j| ≤ η) →\n              dist (CurrentMM.pronyMomentEstimate K a κ rc Δ h') (CurrentMM.pronyMomentEstimate K a κ rc Δ h) ≤\n                2 ^ (2 * K) * η * (Δ ^ (2 * K - 1))⁻¹"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prony_deterministic","type":"∀ {K : ℕ} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (S : Set (Fin K → ℝ)),\n      IsCompact S →\n        ∀ (γ : ℝ),\n          0 < γ →\n            (∀ s ∈ S, ∀ (i j : Fin K), i < j → γ ≤ s j - s i) →\n              (∀ s ∈ S, ∀ (i : Fin K), |s i| ≤ 1) →\n                ∀ (ωmin ωmax : ℝ),\n                  0 < ωmin →\n                    ωmin ≤ ωmax →\n                      ∀ (rc : ℝ),\n                        |rc| < 1 →\n                          ∃ c₁ > 0,\n                            ∃ L > 0,\n                              ∃ C ≥ 0,\n                                ∀ (Δ : ℝ),\n                                  0 < Δ →\n                                    Δ ≤ 1 - |rc| →\n                                      ∀ s ∈ S,\n                                        ∀ (ω : Fin K → ℝ),\n                                          (∀ (i : Fin K), ω i ∈ Set.Icc ωmin ωmax) →\n                                            ∀ (h : ℕ → ℝ),\n                                              h 0 = κ →\n                                                (∀ (t : ℕ),\n                                                    h (t + 1) =\n                                                      a * h t +\n                                                        κ *\n                                                          ∑ j ∈ Finset.range (t + 1),\n                                                            (∑ i, ω i * (rc + Δ * s i) ^ j) * h (t - j)) →\n                                                  ∀ (hhat : ℕ → ℝ) (e : ℝ),\n                                                    0 ≤ e →\n                                                      e ≤ 1 →\n                                                        (∀ t ≤ 2 * K, |hhat t - h t| ≤ e) →\n                                                          2 ^ (2 * K) * (C * e) * (Δ ^ (2 * K - 1))⁻¹ ≤ c₁ →\n                                                            (∃ x,\n                                                                StrictMono x.1 ∧\n                                                                  (∀ (i : Fin K), x.2 i ≠ 0) ∧\n                                                                    CurrentMM.momentMap K x =\n                                                                      CurrentMM.pronyMomentEstimate K a κ rc Δ hhat) ∧\n                                                              ∀ (x : CurrentMM.PronyParam K),\n                                                                StrictMono x.1 →\n                                                                  (∀ (i : Fin K), x.2 i ≠ 0) →\n                                                                    CurrentMM.momentMap K x =\n                                                                        CurrentMM.pronyMomentEstimate K a κ rc Δ hhat →\n                                                                      ∀ (i : Fin K),\n                                                                        |x.2 i - ω i| ≤\n                                                                          L *\n                                                                            (2 ^ (2 * K) * (C * e) *\n                                                                              (Δ ^ (2 * K - 1))⁻¹)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_prony_upper_bound","type":"∀ {K : ℕ},\n  1 ≤ K →\n    ∀ (a κ : ℝ),\n      κ ≠ 0 →\n        ∀ (S : Set (Fin K → ℝ)),\n          IsCompact S →\n            ∀ (γ : ℝ),\n              0 < γ →\n                (∀ s ∈ S, ∀ (i j : Fin K), i < j → γ ≤ s j - s i) →\n                  (∀ s ∈ S, ∀ (i : Fin K), |s i| ≤ 1) →\n                    ∀ (ωmin ωmax : ℝ),\n                      0 < ωmin →\n                        ωmin ≤ ωmax →\n                          ∀ (rc : ℝ),\n                            |rc| < 1 →\n                              ∃ c₀ > 0,\n                                ∃ Cst > 0,\n                                  ∀ (Δ : ℝ),\n                                    0 < Δ →\n                                      Δ ≤ 1 - |rc| →\n                                        ∀ s ∈ S,\n                                          ∀ (ω : Fin K → ℝ),\n                                            (∀ (i : Fin K), ω i ∈ Set.Icc ωmin ωmax) →\n                                              ∀ (h : ℕ → ℝ),\n                                                h 0 = κ →\n                                                  (∀ (t : ℕ),\n                                                      h (t + 1) =\n                                                        a * h t +\n                                                          κ *\n                                                            ∑ j ∈ Finset.range (t + 1),\n                                                              (∑ i, ω i * (rc + Δ * s i) ^ j) * h (t - j)) →\n                                                    ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]\n                                                      (P : MeasureTheory.Measure Ω)\n                                                      [MeasureTheory.IsProbabilityMeasure P] {N : ℕ},\n                                                      0 < N →\n                                                        ∀ (ξ : Fin N → ℕ → Ω → ℝ) (v : NNReal),\n                                                          0 < v →\n                                                            (∀ (t : ℕ),\n                                                                ProbabilityTheory.iIndepFun (fun n => ξ n t) P) →\n                                                              (∀ (n : Fin N) (t : ℕ),\n                                                                  ProbabilityTheory.HasSubgaussianMGF (ξ n t) v P) →\n                                                                ∀ (β : ℝ),\n                                                                  0 < β →\n                                                                    β < 1 →\n                                                                      √↑v / √↑N * (Δ ^ (2 * K - 1))⁻¹ ≤\n                                                                          c₀ / √(Real.log (4 * ↑K / β)) →\n                                                                        P.real\n                                                                            {ω' |\n                                                                              ¬((∃ x, ⋯) ∧\n                                                                                  ∀ (x : CurrentMM.PronyParam K), ⋯)} ≤\n                                                                          β"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_pair_record_kl_energy","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (variance : NNReal),\n                      variance ≠ 0 →\n                        InformationTheory.klDiv\n                            (CurrentMM.gaussianRecordLaw T\n                              (fun t =>\n                                (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] v\n                                    (↑t + 1)).price)\n                              variance)\n                            (CurrentMM.gaussianRecordLaw T\n                              (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price) variance) ≤\n                          ENNReal.ofReal\n                            (((2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * δ ^ 4 * ∑ t ∈ Finset.range T, v t ^ 2) /\n                              (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_kl","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (V : ℝ),\n                      ∑ t ∈ Finset.range T, |v t| ≤ V →\n                        ∀ (variance : NNReal),\n                          variance ≠ 0 →\n                            InformationTheory.klDiv\n                                (CurrentMM.gaussianRecordLaw T\n                                  (fun t =>\n                                    (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] v\n                                        (↑t + 1)).price)\n                                  variance)\n                                (CurrentMM.gaussianRecordLaw T\n                                  (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price)\n                                  variance) ≤\n                              ENNReal.ofReal\n                                ((2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * V ^ 2 * δ ^ 4 / (2 * ↑variance))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_quantity_test","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∀ (T : ℕ) (v : ℕ → ℝ) (V : ℝ),\n                      ∑ t ∈ Finset.range T, |v t| ≤ V →\n                        ∀ (variance : NNReal),\n                          variance ≠ 0 →\n                            ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                              MeasurableSet A →\n                                (CurrentMM.gaussianRecordLaw T\n                                          (fun t =>\n                                            (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ] v\n                                                (↑t + 1)).price)\n                                          variance).real\n                                      A ≤\n                                    1 / 4 →\n                                  (CurrentMM.gaussianRecordLaw T\n                                            (fun t => (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] v (↑t + 1)).price)\n                                            variance).real\n                                        Aᶜ ≤\n                                      1 / 4 →\n                                    ↑variance ≤ 2 * (2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * V ^ 2 * δ ^ 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_kl","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∃ m > 0,\n                      ∀ (T : ℕ) (v : Fin T → ℝ) (B P fee : ℝ) (variance : NNReal),\n                        variance ≠ 0 →\n                          0 ≤ fee →\n                            0 ≤\n                                CurrentMM.equity\n                                  (CurrentMM.traderCashAfter B P κ fee (CurrentMM.actualCohortImpulse a κ ![q] ![ηbar])\n                                    v)\n                                  (∑ i, v i) P →\n                              InformationTheory.klDiv\n                                  (CurrentMM.gaussianRecordLaw T\n                                    (fun t =>\n                                      (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ]\n                                          (CurrentMM.extendFiniteProbe v) (↑t + 1)).price)\n                                    variance)\n                                  (CurrentMM.gaussianRecordLaw T\n                                    (fun t =>\n                                      (CurrentMM.controlledCohortRun a κ ![q] ![ηbar] (CurrentMM.extendFiniteProbe v)\n                                          (↑t + 1)).price)\n                                    variance) ≤\n                                ENNReal.ofReal\n                                  ((2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * B * δ ^ 4 / (↑variance * m))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_capital_test","type":"∀ (a κ q ηbar δ ε s : ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ q →\n        0 < ε →\n          0 < δ →\n            ε ≤ ηbar - δ →\n              ηbar + δ ≤ 1 - ε →\n                a + κ * q ≤ s →\n                  s < 1 →\n                    ∃ m > 0,\n                      ∀ (T : ℕ) (v : Fin T → ℝ) (B P fee : ℝ) (variance : NNReal),\n                        variance ≠ 0 →\n                          0 ≤ fee →\n                            0 ≤\n                                CurrentMM.equity\n                                  (CurrentMM.traderCashAfter B P κ fee (CurrentMM.actualCohortImpulse a κ ![q] ![ηbar])\n                                    v)\n                                  (∑ i, v i) P →\n                              ∀ (A : Set (CurrentMM.ObservationRecord T)),\n                                MeasurableSet A →\n                                  (CurrentMM.gaussianRecordLaw T\n                                            (fun t =>\n                                              (CurrentMM.controlledCohortRun a κ ![q / 2, q / 2] ![ηbar - δ, ηbar + δ]\n                                                  (CurrentMM.extendFiniteProbe v) (↑t + 1)).price)\n                                            variance).real\n                                        A ≤\n                                      1 / 4 →\n                                    (CurrentMM.gaussianRecordLaw T\n                                              (fun t =>\n                                                (CurrentMM.controlledCohortRun a κ ![q] ![ηbar]\n                                                    (CurrentMM.extendFiniteProbe v) (↑t + 1)).price)\n                                              variance).real\n                                          Aᶜ ≤\n                                        1 / 4 →\n                                      ↑variance * m ≤ 4 * (2 * κ ^ 2 * q / (ε ^ 3 * (1 - s) ^ 2)) ^ 2 * B * δ ^ 4"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_question_taps_identity","type":"∀ {n : ℕ} (w r : Fin n → ℝ) (c : ℕ → ℝ) (L : ℕ),\n  ∑ i, w i * ∑ t ∈ Finset.range L, c t * r i ^ t = ∑ t ∈ Finset.range L, c t * ∑ i, w i * r i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_weighted_upper","type":"∀ {n : ℕ} (w r : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ w i) →\n    ∀ (W : ℝ), ∑ i, w i ≤ W → ∀ (h : ℝ → ℝ) (H : ℝ), (∀ (i : Fin n), h (r i) ≤ H) → ∑ i, w i * h (r i) ≤ W * max H 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_question_weak_duality","type":"∀ {n₀ n₁ : ℕ} (w₀ r₀ : Fin n₀ → ℝ) (w₁ r₁ : Fin n₁ → ℝ),\n  (∀ (i : Fin n₀), 0 ≤ w₀ i) →\n    (∀ (i : Fin n₁), 0 ≤ w₁ i) →\n      ∀ (W : ℝ),\n        ∑ i, w₀ i ≤ W →\n          ∑ i, w₁ i ≤ W →\n            ∀ (g : ℝ → ℝ) (c : ℕ → ℝ) (L : ℕ) (Hp Hm : ℝ),\n              (∀ (i : Fin n₁), g (r₁ i) - ∑ t ∈ Finset.range L, c t * r₁ i ^ t ≤ Hp) →\n                (∀ (i : Fin n₀), Hm ≤ g (r₀ i) - ∑ t ∈ Finset.range L, c t * r₀ i ^ t) →\n                  ∑ i, w₁ i * g (r₁ i) - ∑ i, w₀ i * g (r₀ i) ≤\n                    W * max Hp 0 + W * max (-Hm) 0 +\n                      √(∑ t ∈ Finset.range L, c t ^ 2) *\n                        √(∑ t ∈ Finset.range L, (∑ i, w₁ i * r₁ i ^ t - ∑ i, w₀ i * r₀ i ^ t) ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_question_truncation_error","type":"∀ {n : ℕ} (w r : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ w i) →\n    ∀ (W : ℝ),\n      ∑ i, w i ≤ W →\n        ∀ (g : ℝ → ℝ) (c ε : ℕ → ℝ) (L : ℕ) (τ : ℝ),\n          0 ≤ τ →\n            (∀ (i : Fin n), |g (r i) - ∑ t ∈ Finset.range L, c t * r i ^ t| ≤ τ) →\n              |∑ t ∈ Finset.range L, c t * (∑ i, w i * r i ^ t + ε t) - ∑ i, w i * g (r i)| ≤\n                W * τ + |∑ t ∈ Finset.range L, c t * ε t|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_geometric_energy","type":"∀ (c r : ℝ), 0 ≤ r → r < 1 → ∀ (T : ℕ), ∑ t ∈ Finset.range T, (c * r ^ t) ^ 2 ≤ c ^ 2 / (1 - r ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_parametric_tail","type":"∀ (a : ℕ → ℝ) (A : ℝ),\n  0 ≤ A →\n    (∀ (M : ℕ), ∑ t ∈ Finset.range M, a t ^ 2 ≤ A ^ 2) →\n      ∀ (r : ℝ),\n        0 ≤ r →\n          r < 1 →\n            ∀ (gr : ℝ),\n              HasSum (fun t => a t * r ^ t) gr →\n                ∀ (L : ℕ), |gr - ∑ t ∈ Finset.range L, a t * r ^ t| ≤ A * r ^ L / √(1 - r ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_parametric_modulus","type":"∀ (a : ℕ → ℝ) (A : ℝ),\n  0 ≤ A →\n    (∀ (M : ℕ), ∑ t ∈ Finset.range M, a t ^ 2 ≤ A ^ 2) →\n      ∀ (rbar : ℝ),\n        0 ≤ rbar →\n          rbar < 1 →\n            ∀ (g : ℝ → ℝ),\n              (∀ (x : ℝ), 0 ≤ x → x ≤ rbar → HasSum (fun t => a t * x ^ t) (g x)) →\n                ∀ {n₀ n₁ : ℕ} (w₀ r₀ : Fin n₀ → ℝ) (w₁ r₁ : Fin n₁ → ℝ),\n                  (∀ (i : Fin n₀), 0 ≤ w₀ i) →\n                    (∀ (i : Fin n₁), 0 ≤ w₁ i) →\n                      ∀ (W : ℝ),\n                        0 ≤ W →\n                          ∑ i, w₀ i ≤ W →\n                            ∑ i, w₁ i ≤ W →\n                              (∀ (i : Fin n₀), 0 ≤ r₀ i ∧ r₀ i ≤ rbar) →\n                                (∀ (i : Fin n₁), 0 ≤ r₁ i ∧ r₁ i ≤ rbar) →\n                                  ∀ (L : ℕ) (δ : ℝ),\n                                    √(∑ t ∈ Finset.range L, (∑ i, w₁ i * r₁ i ^ t - ∑ i, w₀ i * r₀ i ^ t) ^ 2) ≤ δ →\n                                      ∑ i, w₁ i * g (r₁ i) - ∑ i, w₀ i * g (r₀ i) ≤\n                                        δ * A + 2 * W * (A * rbar ^ L / √(1 - rbar ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_long_memory_impossible","type":"∀ (g : ℝ → ℝ),\n  (∀ (B ρ : ℝ), ρ < 1 → ∃ r, ρ < r ∧ r < 1 ∧ B < |g r| * √(1 - r)) →\n    ∀ (N : ℕ),\n      0 < N →\n        ∀ (σ : ℝ),\n          0 < σ →\n            ∀ (W : ℝ),\n              0 < W →\n                ∀ (ε : ℝ),\n                  ∃ r c,\n                    0 ≤ r ∧\n                      r < 1 ∧\n                        0 < c ∧\n                          c ≤ W ∧\n                            (∀ (T : ℕ), (↑N * ∑ t ∈ Finset.range T, (c * r ^ t) ^ 2) / (2 * σ ^ 2) ≤ 1 / 2) ∧\n                              2 * ε < |c * g r - 0|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hermite_partial","type":"∀ {K : ℕ} (s d e : Fin K → ℝ) (G : Finset (Fin K)),\n  Function.Injective s →\n    (∀ i ∉ G, e i = 0) →\n      ∀ (N : ℕ), K + G.card ≤ N → (∀ m < N, ∑ i, (d i * s i ^ m + e i * (↑m * s i ^ (m - 1))) = 0) → e = 0 ∧ d = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rank_condition_witness","type":"∀ {K D : ℕ} (s : Fin K → ℝ),\n  Function.Injective s →\n    ∀ (g : Fin K → Fin D) (l : ℕ),\n      (∀ (j : Fin D), K + {i | g i = j}.card ≤ l + 1) →\n        Function.Injective ⇑(fderiv ℝ (CurrentMM.pooledMomentMap K D l) (CurrentMM.rankWitness s g))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mod_groups_small","type":"∀ (K D : ℕ), 0 < D → ∀ (j : Fin D), {i | ↑i % D = ↑j}.card ≤ (K + D - 1) / D"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rank_condition_every_K","type":"∀ (K D : ℕ) (hD : 0 < D) (s : Fin K → ℝ),\n  Function.Injective s →\n    Function.Injective\n      ⇑(fderiv ℝ (CurrentMM.pooledMomentMap K D (K + (K + D - 1) / D - 1))\n          (CurrentMM.rankWitness s fun i => ⟨↑i % D, ⋯⟩))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_walsh_quadratic_bound","type":"∀ {α : Type u_1} {β : Type u_2} [DecidableEq α] (M : ℕ) (X : Finset α) (Y : Finset β) (P : α → Finset ℕ) (q : β → ℕ)\n  (c : α → ℝ) (d : β → ℝ),\n  (∀ x ∈ X, P x ⊆ Finset.range M) →\n    (∀ x ∈ X, (P x).card = 2) →\n      (∀ y ∈ Y, q y < M) →\n        Set.InjOn q ↑Y →\n          (∀ x ∈ X, {x' ∈ X | P x' = P x}.card ≤ 2) →\n            (CurrentMM.pE M fun ω =>\n                (∑ x ∈ X, c x * CurrentMM.walsh M (P x) ω + ∑ y ∈ Y, d y * CurrentMM.probe M (q y) ω) ^ 2) ≤\n              2 * ∑ x ∈ X, c x ^ 2 + ∑ y ∈ Y, d y ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_running_tap_mse","type":"∀ (A : ℝ),\n  A ≠ 0 →\n    ∀ (T L j : ℕ),\n      0 < T →\n        j ≤ L →\n          ∀ (h n : ℕ → ℝ),\n            (CurrentMM.pE (T + L) fun ω => (CurrentMM.runTap A T L h n j ω - h j) ^ 2) ≤\n              (2 * ∑ i ∈ Finset.range (T + L + 1), h i ^ 2 + (∑ t ∈ Finset.range T, n t ^ 2) / (A ^ 2 * ↑T)) / ↑T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_running_prony_upper","type":"∀ {K : ℕ} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (S : Set (Fin K → ℝ)),\n      IsCompact S →\n        ∀ (γ : ℝ),\n          0 < γ →\n            (∀ s ∈ S, ∀ (i j : Fin K), i < j → γ ≤ s j - s i) →\n              (∀ s ∈ S, ∀ (i : Fin K), |s i| ≤ 1) →\n                ∀ (ωmin ωmax : ℝ),\n                  0 < ωmin →\n                    ωmin ≤ ωmax →\n                      ∀ (rc : ℝ),\n                        |rc| < 1 →\n                          ∃ c₁ > 0,\n                            ∃ L > 0,\n                              ∃ C ≥ 0,\n                                ∀ (Δ : ℝ),\n                                  0 < Δ →\n                                    Δ ≤ 1 - |rc| →\n                                      ∀ s ∈ S,\n                                        ∀ (wt : Fin K → ℝ),\n                                          (∀ (i : Fin K), wt i ∈ Set.Icc ωmin ωmax) →\n                                            ∀ (h : ℕ → ℝ),\n                                              h 0 = κ →\n                                                (∀ (t : ℕ),\n                                                    h (t + 1) =\n                                                      a * h t +\n                                                        κ *\n                                                          ∑ j ∈ Finset.range (t + 1),\n                                                            (∑ i, wt i * (rc + Δ * s i) ^ j) * h (t - j)) →\n                                                  ∀ (A : ℝ),\n                                                    A ≠ 0 →\n                                                      ∀ (T Lead : ℕ),\n                                                        0 < T →\n                                                          2 * K ≤ Lead →\n                                                            ∀ (n : ℕ → ℝ) (e : ℝ),\n                                                              0 < e →\n                                                                e ≤ 1 →\n                                                                  2 ^ (2 * K) * (C * e) * (Δ ^ (2 * K - 1))⁻¹ ≤ c₁ →\n                                                                    1 -\n                                                                        ∑ t ∈ Finset.range (2 * K + 1),\n                                                                          (2 *\n                                                                                  ∑ i ∈ Finset.range (T + Lead + 1),\n                                                                                    h i ^ 2 +\n                                                                                (∑ u ∈ Finset.range T, n u ^ 2) /\n                                                                                  (A ^ 2 * ↑T)) /\n                                                                              ↑T /\n                                                                            e ^ 2 ≤\n                                                                      CurrentMM.pProb (T + Lead) fun ξ =>\n                                                                        (∃ x,\n                                                                            StrictMono x.1 ∧\n                                                                              (∀ (i : Fin K), x.2 i ≠ 0) ∧\n                                                                                CurrentMM.momentMap K x =\n                                                                                  CurrentMM.pronyMomentEstimate K a κ rc\n                                                                                    Δ fun t =>\n                                                                                    CurrentMM.runTap A T Lead h n t ξ) ∧\n                                                                          ∀ (x : CurrentMM.PronyParam K),\n                                                                            StrictMono x.1 →\n                                                                              (∀ (i : Fin K), x.2 i ≠ 0) →\n                                                                                (CurrentMM.momentMap K x =\n                                                                                    CurrentMM.pronyMomentEstimate K a κ\n                                                                                      rc Δ fun t =>\n                                                                                      CurrentMM.runTap A T Lead h n t\n                                                                                        ξ) →\n                                                                                  ∀ (i : Fin K), |x.2 i - wt i| ≤ L * ⋯"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_coupling_bound","type":"∀ {Ω : Type u_1} {α : Type u_2} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω)\n  [MeasureTheory.IsProbabilityMeasure P] (X Y : Ω → α) (A : Set α) (B : Set Ω),\n  (∀ ω ∉ B, X ω = Y ω) → P.real {ω | X ω ∈ A} ≤ P.real {ω | Y ω ∈ A} + P.real B"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_exit_union_bound","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P]\n  (T n : ℕ) (E : ℕ → ℕ → Set Ω) (p : ℝ),\n  (∀ t < T, ∀ g < n, P.real (E t g) ≤ p) → P.real (⋃ t ∈ Finset.range T, ⋃ g ∈ Finset.range n, E t g) ≤ ↑T * ↑n * p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_stress_test_cost","type":"∀ (T n p α TV : ℝ), 0 < n → 0 < p → TV ≤ T * n * p → 1 - 2 * α ≤ TV → (1 - 2 * α) / (n * p) ≤ T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_stress_test_cost_exp","type":"∀ (T n α TV ϑ : ℝ),\n  0 < n → TV ≤ T * n * Real.exp (-(1 / (2 * ϑ ^ 2))) → 1 - 2 * α ≤ TV → (1 - 2 * α) * Real.exp (1 / (2 * ϑ ^ 2)) / n ≤ T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_smooth_lower_cost","type":"∀ (N σ α CD A e : ℝ),\n  0 ≤ N →\n    0 < σ →\n      α < 1 / 2 →\n        0 < CD →\n          A ≠ 0 →\n            0 ≤ e →\n              e ≤ CD * |A| ^ 3 →\n                1 - 2 * α ≤ √(N * e ^ 2 / (4 * σ ^ 2)) → 4 * σ ^ 2 * (1 - 2 * α) ^ 2 / (CD ^ 2 * A ^ 6) ≤ N"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_smooth_upper_cost","type":"∀ (N σ z κ ΔM₃ A gap : ℝ),\n  0 < σ →\n    0 ≤ z →\n      0 < κ →\n        ΔM₃ ≠ 0 →\n          A ≠ 0 →\n            κ ^ 4 * |ΔM₃| * |A| ^ 3 / 6 ≤ |gap| →\n              (12 * σ * z) ^ 2 / (κ ^ 8 * ΔM₃ ^ 2 * A ^ 6) ≤ N → 2 * σ * z ≤ √N * |gap|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eqMem_congr","type":"∀ (r : ℝ) (s s' : ℕ → ℝ) (t : ℕ), (∀ j < t, s j = s' j) → CurrentMM.eqMem r s t = CurrentMM.eqMem r s' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_satAggFlow_congr","type":"∀ {K : ℕ} (ψ : ℝ → ℝ) (c l r : Fin K → ℝ) (s s' : ℕ → ℝ) (t : ℕ),\n  (∀ j < t, s j = s' j) → CurrentMM.satAggFlow ψ c l r s t = CurrentMM.satAggFlow ψ c l r s' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_flow_market_invariance","type":"∀ (F F' : (ℕ → ℝ) → ℕ → ℝ) (T : ℕ),\n  (∀ (s s' : ℕ → ℝ) (t : ℕ), (∀ j < t, s j = s' j) → F s t = F s' t) →\n    (∀ (s : ℕ → ℝ), ∀ t ≤ T, F s t = F' s t) →\n      ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n        CurrentMM.EqCausal X Pr S →\n          ∀ (ps ys ps' ys' : ℕ → ℝ),\n            CurrentMM.FlowMarketPath F v z X Pr S ps ys →\n              CurrentMM.FlowMarketPath F' v z X Pr S ps' ys' → ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sat_sufficiency","type":"∀ {K K' : ℕ} (ψ : ℝ → ℝ) (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ),\n  (∀ (g : ℝ → ℝ → ℝ), ∑ i, c i * g (r i) (l i) = ∑ j, c' j * g (r' j) (l' j)) →\n    ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.FlowMarketPath (CurrentMM.satAggFlow ψ c l r) v z X Pr S ps ys →\n            CurrentMM.FlowMarketPath (CurrentMM.satAggFlow ψ c' l' r') v z X Pr S ps' ys' →\n              ∀ (t : ℕ), ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_satAggFlow_linear_of_band","type":"∀ {K : ℕ} (ψ : ℝ → ℝ),\n  (∀ (u : ℝ), |u| ≤ 1 → ψ u = u) →\n    ∀ (c l r : Fin K → ℝ) (s : ℕ → ℝ) (t : ℕ),\n      (∀ (i : Fin K), |l i * CurrentMM.eqMem (r i) s t| ≤ 1) →\n        CurrentMM.satAggFlow ψ c l r s t = CurrentMM.eqAggFlow (fun i => c i * l i) r s t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sat_stress_invariance","type":"∀ {K K' : ℕ} (ψ ψ' : ℝ → ℝ),\n  (∀ (u : ℝ), |u| ≤ 1 → ψ u = u) →\n    (∀ (u : ℝ), |u| ≤ 1 → ψ' u = u) →\n      ∀ (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ) (T : ℕ),\n        (∀ m < T, CurrentMM.eqKernel (fun i => c i * l i) r m = CurrentMM.eqKernel (fun j => c' j * l' j) r' m) →\n          ∀ (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ)\n            (S : ℕ → (ℕ → ℝ) → ℝ),\n            CurrentMM.EqCausal X Pr S →\n              ∀ (ps ys ps' ys' : ℕ → ℝ),\n                CurrentMM.FlowMarketPath (CurrentMM.satAggFlow ψ c l r) v z X Pr S ps ys →\n                  CurrentMM.FlowMarketPath (CurrentMM.satAggFlow ψ' c' l' r') v z X Pr S ps' ys' →\n                    (∀ t ≤ T,\n                        (∀ (i : Fin K), |l i * CurrentMM.eqMem (r i) (fun j => S j ps) t| ≤ 1) ∧\n                          ∀ (j : Fin K'), |l' j * CurrentMM.eqMem (r' j) (fun j => S j ps) t| ≤ 1) →\n                      ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sat_follows_linear","type":"∀ {K : ℕ} (ψ : ℝ → ℝ),\n  (∀ (u : ℝ), |u| ≤ 1 → ψ u = u) →\n    ∀ (c l r : Fin K → ℝ) (T : ℕ) (v : ℝ) (z : ℕ → ℝ) (X : ℕ → ℝ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ)\n      (Pr : ℕ → (ℕ → ℝ) → (ℕ → ℝ) → ℝ) (S : ℕ → (ℕ → ℝ) → ℝ),\n      CurrentMM.EqCausal X Pr S →\n        ∀ (ps ys ps' ys' : ℕ → ℝ),\n          CurrentMM.FlowMarketPath (CurrentMM.satAggFlow ψ c l r) v z X Pr S ps ys →\n            CurrentMM.FlowMarketPath (CurrentMM.satAggFlow id c l r) v z X Pr S ps' ys' →\n              (∀ t ≤ T, ∀ (i : Fin K), |l i * CurrentMM.eqMem (r i) (fun j => S j ps) t| ≤ 1) →\n                ∀ t ≤ T, ps t = ps' t ∧ ys t = ys' t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sat_capacity_differs","type":"1 * (1 / 10) = 1 / 4 * (1 / 5) + 1 * (1 / 20) ∧ 1 ≠ 1 / 4 + 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_LR","type":"∀ (n1 d1 n2 d2 : Polynomial ℝ) (s1 s2 : ℝ),\n  (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1) = 0 → ‖z‖ < 1) →\n    (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2) = 0 → ‖z‖ < 1) →\n      (∀ (z : ℂ),\n          ‖z‖ = 1 →\n            s1 *\n                ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) /\n                      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1)‖ ^\n                  2 =\n              s2 *\n                ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n2) /\n                      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2)‖ ^\n                  2) →\n        Polynomial.C ↑s1 * Polynomial.map (algebraMap ℝ ℂ) n1 * Polynomial.map (algebraMap ℝ ℂ) n1.reverse *\n                Polynomial.map (algebraMap ℝ ℂ) d2 *\n              Polynomial.map (algebraMap ℝ ℂ) d2.reverse *\n            Polynomial.X ^ (n2.natDegree + d1.natDegree) =\n          Polynomial.C ↑s2 * Polynomial.map (algebraMap ℝ ℂ) n2 * Polynomial.map (algebraMap ℝ ℂ) n2.reverse *\n                Polynomial.map (algebraMap ℝ ℂ) d1 *\n              Polynomial.map (algebraMap ℝ ℂ) d1.reverse *\n            Polynomial.X ^ (n1.natDegree + d2.natDegree)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rootMult_six","type":"∀ (s : ℂ),\n  s ≠ 0 →\n    ∀ (n nr d dr : Polynomial ℂ) (k : ℕ) (α : ℂ),\n      α ≠ 0 →\n        n ≠ 0 →\n          d ≠ 0 →\n            Polynomial.eval α nr ≠ 0 →\n              Polynomial.eval α dr ≠ 0 →\n                Polynomial.rootMultiplicity α (Polynomial.C s * n * nr * d * dr * Polynomial.X ^ k) =\n                  Polynomial.rootMultiplicity α n + Polynomial.rootMultiplicity α d"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_mult_eq","type":"∀ (n1 d1 n2 d2 : Polynomial ℝ) (s1 s2 : ℝ),\n  s1 ≠ 0 →\n    s2 ≠ 0 →\n      n1 ≠ 0 →\n        n2 ≠ 0 →\n          d1 ≠ 0 →\n            d2 ≠ 0 →\n              (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) = 0 → ‖z‖ < 1) →\n                (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n2) = 0 → ‖z‖ < 1) →\n                  (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1) = 0 → ‖z‖ < 1) →\n                    (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2) = 0 → ‖z‖ < 1) →\n                      (∀ (z : ℂ),\n                          ‖z‖ = 1 →\n                            s1 *\n                                ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) /\n                                      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1)‖ ^\n                                  2 =\n                              s2 *\n                                ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n2) /\n                                      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2)‖ ^\n                                  2) →\n                        ∀ (α : ℂ),\n                          α ≠ 0 →\n                            ‖α‖ < 1 →\n                              Polynomial.rootMultiplicity α (Polynomial.map (algebraMap ℝ ℂ) n1) +\n                                  Polynomial.rootMultiplicity α (Polynomial.map (algebraMap ℝ ℂ) d2) =\n                                Polynomial.rootMultiplicity α (Polynomial.map (algebraMap ℝ ℂ) n2) +\n                                  Polynomial.rootMultiplicity α (Polynomial.map (algebraMap ℝ ℂ) d1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_monic_eq_of_rootMult","type":"∀ (P Q : Polynomial ℂ),\n  P.Monic → Q.Monic → (∀ (x : ℂ), Polynomial.rootMultiplicity x P = Polynomial.rootMultiplicity x Q) → P = Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eval_map_real","type":"∀ (p : Polynomial ℝ) (x : ℝ), Polynomial.eval (↑x) (Polynomial.map (algebraMap ℝ ℂ) p) = ↑(Polynomial.eval x p)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfMonicTop_monic","type":"∀ {K : ℕ} (r : Fin K → ℝ), (CurrentMM.tfMonicTop r).Monic"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_eval_tfTop","type":"∀ {K : ℕ} (κ : ℝ) (r : Fin K → ℝ) (z : ℂ),\n  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r)) =\n    ↑κ * Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfMonicTop r))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfDen_eval_ne","type":"∀ {K : ℕ} (r : Fin K → ℝ) (x : ℝ), (∀ (i : Fin K), r i ≠ x) → Polynomial.eval x (CurrentMM.tfDen r) ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tfBottom_eval_zero","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ),\n  Polynomial.eval 0 (CurrentMM.tfBottom a κ w r) = -a * Polynomial.eval 0 (CurrentMM.tfDen r)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rootMult_zero_monicTop","type":"∀ {K : ℕ} (r : Fin K → ℝ),\n  (∀ (i : Fin K), r i ≠ 0) →\n    Polynomial.rootMultiplicity 0 (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfMonicTop r)) = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rootMult_zero_bottom","type":"∀ {K : ℕ} (a κ : ℝ) (w r : Fin K → ℝ),\n  a ≠ 0 →\n    (∀ (i : Fin K), r i ≠ 0) →\n      Polynomial.rootMultiplicity 0 (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a κ w r)) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_spectrum_H","type":"∀ {K1 K2 : ℕ} (a1 κ1 a2 κ2 s1 s2 : ℝ) (w1 r1 : Fin K1 → ℝ) (w2 r2 : Fin K2 → ℝ),\n  a1 ≠ 0 →\n    κ1 ≠ 0 →\n      a2 ≠ 0 →\n        κ2 ≠ 0 →\n          Function.Injective r1 →\n            Function.Injective r2 →\n              (∀ (i : Fin K1), 0 < r1 i) →\n                (∀ (i : Fin K1), r1 i < 1) →\n                  (∀ (i : Fin K2), 0 < r2 i) →\n                    (∀ (i : Fin K2), r2 i < 1) →\n                      (∀ (i : Fin K1), w1 i ≠ 0) →\n                        (∀ (i : Fin K2), w2 i ≠ 0) →\n                          0 < s1 →\n                            0 < s2 →\n                              (∀ (z : ℂ),\n                                  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a1 κ1 w1 r1)) =\n                                      0 →\n                                    ‖z‖ < 1) →\n                                (∀ (z : ℂ),\n                                    Polynomial.eval z\n                                          (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a2 κ2 w2 r2)) =\n                                        0 →\n                                      ‖z‖ < 1) →\n                                  (∀ (ω : ℝ),\n                                      s1 *\n                                            ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ1 r1)) /\n                                                  Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ)\n                                                      (CurrentMM.tfBottom a1 κ1 w1 r1))‖ ^\n                                              2 /\n                                          (2 * Real.pi) =\n                                        s2 *\n                                            ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ2 r2)) /\n                                                  Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ)\n                                                      (CurrentMM.tfBottom a2 κ2 w2 r2))‖ ^\n                                              2 /\n                                          (2 * Real.pi)) →\n                                    s1 * κ1 ^ 2 = s2 * κ2 ^ 2 ∧\n                                      CurrentMM.tfDen r1 = CurrentMM.tfDen r2 ∧\n                                        CurrentMM.tfBottom a1 κ1 w1 r1 = CurrentMM.tfBottom a2 κ2 w2 r2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_merged_from_polys","type":"∀ {K1 K2 : ℕ} (a1 a2 κ : ℝ),\n  κ ≠ 0 →\n    ∀ (w1 r1 : Fin K1 → ℝ) (w2 r2 : Fin K2 → ℝ),\n      Function.Injective r2 →\n        (∀ (i : Fin K1), r1 i ≠ 0) →\n          CurrentMM.tfDen r1 = CurrentMM.tfDen r2 →\n            CurrentMM.tfBottom a1 κ w1 r1 = CurrentMM.tfBottom a2 κ w2 r2 →\n              a1 = a2 ∧ ∀ (i : Fin K1) (j : Fin K2), r1 i = r2 j → w1 i = w2 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_spectrum_merged","type":"∀ {K1 K2 : ℕ} (a1 a2 κ s1 s2 : ℝ) (w1 r1 : Fin K1 → ℝ) (w2 r2 : Fin K2 → ℝ),\n  a1 ≠ 0 →\n    a2 ≠ 0 →\n      κ ≠ 0 →\n        Function.Injective r1 →\n          Function.Injective r2 →\n            (∀ (i : Fin K1), 0 < r1 i) →\n              (∀ (i : Fin K1), r1 i < 1) →\n                (∀ (i : Fin K2), 0 < r2 i) →\n                  (∀ (i : Fin K2), r2 i < 1) →\n                    (∀ (i : Fin K1), w1 i ≠ 0) →\n                      (∀ (i : Fin K2), w2 i ≠ 0) →\n                        0 < s1 →\n                          0 < s2 →\n                            (∀ (z : ℂ),\n                                Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a1 κ w1 r1)) =\n                                    0 →\n                                  ‖z‖ < 1) →\n                              (∀ (z : ℂ),\n                                  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a2 κ w2 r2)) =\n                                      0 →\n                                    ‖z‖ < 1) →\n                                (∀ (ω : ℝ),\n                                    s1 *\n                                          ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                  (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r1)) /\n                                                Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                  (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a1 κ w1 r1))‖ ^\n                                            2 /\n                                        (2 * Real.pi) =\n                                      s2 *\n                                          ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                  (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ r2)) /\n                                                Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                  (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a2 κ w2 r2))‖ ^\n                                            2 /\n                                        (2 * Real.pi)) →\n                                  s1 = s2 ∧\n                                    a1 = a2 ∧\n                                      Set.range r1 = Set.range r2 ∧\n                                        ∀ (i : Fin K1) (j : Fin K2), r1 i = r2 j → w1 i = w2 j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_unit_circle_infinite","type":"{z | ‖z‖ = 1}.Infinite"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_conj_eval_map","type":"∀ (p : Polynomial ℝ) (z : ℂ),\n  (starRingEnd ℂ) (Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p)) =\n    Polynomial.eval ((starRingEnd ℂ) z) (Polynomial.map (algebraMap ℝ ℂ) p)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rev_eval_map","type":"∀ (p : Polynomial ℝ) (z : ℂ),\n  z ≠ 0 →\n    z ^ p.natDegree * Polynomial.eval z⁻¹ (Polynomial.map (algebraMap ℝ ℂ) p) =\n      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p.reverse)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_rev_ne_zero","type":"∀ (p : Polynomial ℝ),\n  (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p) = 0 → ‖z‖ < 1) →\n    ∀ (α : ℂ), α ≠ 0 → ‖α‖ ≤ 1 → Polynomial.eval α (Polynomial.map (algebraMap ℝ ℂ) p.reverse) ≠ 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_circle_sq","type":"∀ (p : Polynomial ℝ) (z : ℂ),\n  ‖z‖ = 1 →\n    z ^ p.natDegree * ↑(‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p)‖ ^ 2) =\n      Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p) *\n        Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) p.reverse)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_spectral_zero_transfer","type":"∀ (n1 d1 n2 d2 : Polynomial ℝ) (s1 s2 : ℝ),\n  s2 ≠ 0 →\n    (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) = 0 → ‖z‖ < 1) →\n      (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n2) = 0 → ‖z‖ < 1) →\n        (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1) = 0 → ‖z‖ < 1) →\n          (∀ (z : ℂ), Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2) = 0 → ‖z‖ < 1) →\n            (∀ (z : ℂ),\n                Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) = 0 →\n                  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1) ≠ 0) →\n              (∀ (z : ℂ),\n                  ‖z‖ = 1 →\n                    s1 *\n                        ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n1) /\n                              Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d1)‖ ^\n                          2 =\n                      s2 *\n                        ‖Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) n2) /\n                              Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) d2)‖ ^\n                          2) →\n                ∀ (α : ℂ),\n                  α ≠ 0 →\n                    Polynomial.eval α (Polynomial.map (algebraMap ℝ ℂ) n1) = 0 →\n                      Polynomial.eval α (Polynomial.map (algebraMap ℝ ℂ) n2) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_minphase_spectrum_rates","type":"∀ {K1 K2 : ℕ} (a1 κ1 a2 κ2 s1 s2 : ℝ) (w1 r1 : Fin K1 → ℝ) (w2 r2 : Fin K2 → ℝ),\n  a1 ≠ 0 →\n    κ1 ≠ 0 →\n      a2 ≠ 0 →\n        κ2 ≠ 0 →\n          Function.Injective r1 →\n            Function.Injective r2 →\n              (∀ (i : Fin K1), 0 < r1 i) →\n                (∀ (i : Fin K1), r1 i < 1) →\n                  (∀ (i : Fin K2), 0 < r2 i) →\n                    (∀ (i : Fin K2), r2 i < 1) →\n                      (∀ (i : Fin K1), w1 i ≠ 0) →\n                        (∀ (i : Fin K2), w2 i ≠ 0) →\n                          0 < s1 →\n                            0 < s2 →\n                              (∀ (z : ℂ),\n                                  Polynomial.eval z (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a1 κ1 w1 r1)) =\n                                      0 →\n                                    ‖z‖ < 1) →\n                                (∀ (z : ℂ),\n                                    Polynomial.eval z\n                                          (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfBottom a2 κ2 w2 r2)) =\n                                        0 →\n                                      ‖z‖ < 1) →\n                                  (∀ (ω : ℝ),\n                                      s1 *\n                                            ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ1 r1)) /\n                                                  Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ)\n                                                      (CurrentMM.tfBottom a1 κ1 w1 r1))‖ ^\n                                              2 /\n                                          (2 * Real.pi) =\n                                        s2 *\n                                            ‖Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ) (CurrentMM.tfTop κ2 r2)) /\n                                                  Polynomial.eval (Complex.exp (↑ω * Complex.I))\n                                                    (Polynomial.map (algebraMap ℝ ℂ)\n                                                      (CurrentMM.tfBottom a2 κ2 w2 r2))‖ ^\n                                              2 /\n                                          (2 * Real.pi)) →\n                                    Set.range r1 = Set.range r2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_probe_steer_target","type":"∀ (a κ : ℝ) (F : (ℕ → ℝ) → ℕ → ℝ) (x_star : ℕ → ℝ),\n  κ ≠ 0 → CurrentMM.ProbePricePath a κ F (CurrentMM.steeringProbe a κ F x_star) x_star"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_probe_flow_recovery","type":"∀ (a κ : ℝ) (F : (ℕ → ℝ) → ℕ → ℝ) (v x : ℕ → ℝ),\n  CurrentMM.ProbePricePath a κ F v x →\n    κ ≠ 0 → F x 0 = x 0 / κ - v 0 ∧ ∀ (t : ℕ), F x (t + 1) = (x (t + 1) - a * x t) / κ - v (t + 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_probe_flow_recovery_eq","type":"∀ (a κ : ℝ) (F F' : (ℕ → ℝ) → ℕ → ℝ) (v x : ℕ → ℝ),\n  CurrentMM.ProbePricePath a κ F v x → CurrentMM.ProbePricePath a κ F' v x → κ ≠ 0 → ∀ (t : ℕ), F x t = F' x t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.realSgn_zero","type":"CurrentMM.realSgn 0 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.realSgn_pos","type":"∀ {x : ℝ}, x > 0 → CurrentMM.realSgn x = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.realSgn_neg","type":"∀ {x : ℝ}, x < 0 → CurrentMM.realSgn x = -1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_odd_policy_decomp","type":"∀ (ψ : ℝ → ℝ), CurrentMM.IsOddPolicy ψ → ∀ (c l m : ℝ), c * ψ (l * m) = c * CurrentMM.realSgn l * ψ (|l| * m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sat_signed_capacity_sufficiency","type":"∀ {K K' : ℕ} (ψ : ℝ → ℝ),\n  CurrentMM.IsOddPolicy ψ →\n    ∀ (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ),\n      (∀ (g : ℝ → ℝ → ℝ),\n          ∑ i, c i * CurrentMM.realSgn (l i) * g (r i) |l i| = ∑ j, c' j * CurrentMM.realSgn (l' j) * g (r' j) |l' j|) →\n        ∀ (s : ℕ → ℝ) (t : ℕ), CurrentMM.satAggFlow ψ c l r s t = CurrentMM.satAggFlow ψ c' l' r' s t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cubic_pulse_tap1_kernel_cancel","type":"∀ {K K' : ℕ} (γ : ℝ) (c l : Fin K → ℝ) (c' l' : Fin K' → ℝ) (κ A : ℝ),\n  ∑ i, c i * l i = ∑ j, c' j * l' j →\n    CurrentMM.cubicPulseTap1Flow γ c l κ A - CurrentMM.cubicPulseTap1Flow γ c' l' κ A =\n      -γ * κ ^ 3 * (∑ i, c i * l i ^ 3 - ∑ j, c' j * l' j ^ 3) * A ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cubic_pulse_tap1_price_gap","type":"∀ {K K' : ℕ} (γ : ℝ) (c l : Fin K → ℝ) (c' l' : Fin K' → ℝ) (κ A : ℝ),\n  ∑ i, c i * l i = ∑ j, c' j * l' j →\n    κ * (CurrentMM.cubicPulseTap1Flow γ c l κ A - CurrentMM.cubicPulseTap1Flow γ c' l' κ A) =\n      -γ * κ ^ 4 * (∑ i, c i * l i ^ 3 - ∑ j, c' j * l' j ^ 3) * A ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_vandermonde_2x2_invertible","type":"∀ (x y s1_sq s2_sq : ℝ), s1_sq ≠ s2_sq → x + y = 0 → x * s1_sq + y * s2_sq = 0 → x = 0 ∧ y = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_vandermonde_2x2_weights_zero","type":"∀ (d1 d2 s1 s2 : ℝ),\n  s1 > 0 → s2 > 0 → s1 ≠ s2 → d1 * s1 + d2 * s2 = 0 → d1 * s1 * s1 ^ 2 + d2 * s2 * s2 ^ 2 = 0 → d1 = 0 ∧ d2 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ramp_of_nonpos","type":"∀ {u : ℝ}, u ≤ 0 → CurrentMM.ramp u = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.ramp_of_pos","type":"∀ {u : ℝ}, u ≥ 0 → CurrentMM.ramp u = u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hard_limit_kink_recovery","type":"∀ (a0 d1 d2 u1 u2 : ℝ),\n  0 < u1 →\n    u1 < u2 →\n      (∀ u ≥ 0, a0 * u - d1 * CurrentMM.ramp (u - u1) - d2 * CurrentMM.ramp (u - u2) = 0) → a0 = 0 ∧ d1 = 0 ∧ d2 = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_clip_in_band","type":"∀ (y : ℝ), -1 ≤ y → y ≤ 1 → max (-1) (min 1 y) = y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_proportional_trade_recursion","type":"∀ (v vt1 u_star u_star_t1 xt η κ lam : ℝ),\n  κ + lam > 0 →\n    u_star = v / (κ + lam) →\n      vt1 = (1 - η) * v + η * xt → u_star_t1 = vt1 / (κ + lam) → u_star_t1 = (1 - η) * u_star + η / (κ + lam) * xt"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_exists_separating_direction","type":"∀ (A : Finset (ℝ × ℝ)),\n  (∀ a ∈ A, 0 < a.2) → ∃ θ, 0 < θ ∧ ∀ a ∈ A, ∀ b ∈ A, a.2 * (a.1 * θ + 1) = b.2 * (b.1 * θ + 1) → a = b"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_fiberwise_atoms","type":"∀ {ι : Type} [inst : Fintype ι] (d ρ lam : ι → ℝ) (f : ℝ × ℝ → ℝ),\n  ∑ k, d k * f (ρ k, lam k) =\n    ∑ a ∈ Finset.image (fun k => (ρ k, lam k)) Finset.univ, (∑ k with (ρ k, lam k) = a, d k) * f a"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_atoms_zero_of_dilations","type":"∀ (ψ : ℝ → ℝ),\n  CurrentMM.IndepDilations ψ →\n    ∀ (A : Finset (ℝ × ℝ)) (W : ℝ × ℝ → ℝ),\n      (∀ a ∈ A, 0 ≤ a.1) →\n        (∀ a ∈ A, 0 < a.2) → (∀ (θ u : ℝ), ∑ a ∈ A, W a * ψ (a.2 * (a.1 * θ + 1) * u) = 0) → ∀ a ∈ A, W a = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_dilation_identification","type":"∀ {ι : Type} [inst : Fintype ι] (ψ : ℝ → ℝ),\n  CurrentMM.IndepDilations ψ →\n    ∀ (d ρ lam : ι → ℝ),\n      (∀ (k : ι), 0 ≤ ρ k) →\n        (∀ (k : ι), 0 < lam k) →\n          (∀ (θ u : ℝ), ∑ k, d k * ψ (lam k * (ρ k * θ + 1) * u) = 0) →\n            ∀ (g : ℝ → ℝ → ℝ), ∑ k, d k * g (ρ k) (lam k) = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_stress_identification","type":"∀ {K K' : ℕ} (ψ : ℝ → ℝ),\n  CurrentMM.IsOddPolicy ψ →\n    CurrentMM.IndepDilations ψ →\n      ∀ (a κ : ℝ),\n        κ ≠ 0 →\n          ∀ (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ),\n            (∀ (i : Fin K), 0 ≤ r i) →\n              (∀ (j : Fin K'), 0 ≤ r' j) →\n                (∀ (i : Fin K), l i ≠ 0) →\n                  (∀ (j : Fin K'), l' j ≠ 0) →\n                    ((∀ (v x : ℕ → ℝ),\n                        CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow ψ c l r) v x →\n                          CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow ψ c' l' r') v x) ↔\n                      ∀ (g : ℝ → ℝ → ℝ),\n                        ∑ i, c i * CurrentMM.realSgn (l i) * g (r i) |l i| =\n                          ∑ j, c' j * CurrentMM.realSgn (l' j) * g (r' j) |l' j|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.clipPolicy_of_band","type":"∀ {y : ℝ}, -1 ≤ y → y ≤ 1 → CurrentMM.clipPolicy y = y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.clipPolicy_of_ge","type":"∀ {y : ℝ}, 1 ≤ y → CurrentMM.clipPolicy y = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.clipPolicy_of_le","type":"∀ {y : ℝ}, y ≤ -1 → CurrentMM.clipPolicy y = -1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_clipPolicy_odd","type":"CurrentMM.IsOddPolicy CurrentMM.clipPolicy"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_clip_indep_dilations","type":"CurrentMM.IndepDilations CurrentMM.clipPolicy"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_stress_identification_hard_limit","type":"∀ {K K' : ℕ} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ),\n      (∀ (i : Fin K), 0 ≤ r i) →\n        (∀ (j : Fin K'), 0 ≤ r' j) →\n          (∀ (i : Fin K), l i ≠ 0) →\n            (∀ (j : Fin K'), l' j ≠ 0) →\n              ((∀ (v x : ℕ → ℝ),\n                  CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow CurrentMM.clipPolicy c l r) v x →\n                    CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow CurrentMM.clipPolicy c' l' r') v x) ↔\n                ∀ (g : ℝ → ℝ → ℝ),\n                  ∑ i, c i * CurrentMM.realSgn (l i) * g (r i) |l i| =\n                    ∑ j, c' j * CurrentMM.realSgn (l' j) * g (r' j) |l' j|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cubic_not_indep_dilations","type":"∀ (γ : ℝ), ¬CurrentMM.IndepDilations (CurrentMM.cubicPolicy γ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_one_sub_tanh","type":"∀ (y : ℝ), 1 - Real.tanh y = 2 * Real.exp (-(2 * y)) / (1 + Real.exp (-(2 * y)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tendsto_exp_neg_mul","type":"∀ (c : ℝ), 0 < c → Filter.Tendsto (fun u => Real.exp (-(c * u))) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tendsto_one_sub_tanh","type":"∀ (x : ℝ), 0 < x → Filter.Tendsto (fun u => 1 - Real.tanh (x * u)) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tendsto_scaled_self","type":"∀ (a : ℝ), 0 < a → Filter.Tendsto (fun u => Real.exp (2 * a * u) * (1 - Real.tanh (a * u))) Filter.atTop (nhds 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tendsto_scaled_other","type":"∀ (a x : ℝ),\n  0 < a → a < x → Filter.Tendsto (fun u => Real.exp (2 * a * u) * (1 - Real.tanh (x * u))) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tanh_indep_dilations","type":"CurrentMM.IndepDilations Real.tanh"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tanh_odd","type":"CurrentMM.IsOddPolicy Real.tanh"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_stress_identification_tanh","type":"∀ {K K' : ℕ} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (c l r : Fin K → ℝ) (c' l' r' : Fin K' → ℝ),\n      (∀ (i : Fin K), 0 ≤ r i) →\n        (∀ (j : Fin K'), 0 ≤ r' j) →\n          (∀ (i : Fin K), l i ≠ 0) →\n            (∀ (j : Fin K'), l' j ≠ 0) →\n              ((∀ (v x : ℕ → ℝ),\n                  CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow Real.tanh c l r) v x →\n                    CurrentMM.ProbePricePath a κ (CurrentMM.satAggFlow Real.tanh c' l' r') v x) ↔\n                ∀ (g : ℝ → ℝ → ℝ),\n                  ∑ i, c i * CurrentMM.realSgn (l i) * g (r i) |l i| =\n                    ∑ j, c' j * CurrentMM.realSgn (l' j) * g (r' j) |l' j|)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_response_robust_threshold","type":"∀ (rA rB movedA movedB threshold radius : ℝ),\n  rA + radius ≤ threshold →\n    threshold < rB - radius → |movedA - rA| ≤ radius → |movedB - rB| ≤ radius → movedA ≤ threshold ∧ threshold < movedB"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_supervisory_gaussian_unsafe_halt","type":"∀ (N : ℕ),\n  0 < N →\n    ∀ (r threshold allowance drift radius : ℝ) (v : NNReal),\n      0 < radius →\n        drift ≤ allowance →\n          (MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal r v)\n              {x | (∑ i, x i) / ↑N + radius + allowance ≤ threshold ∧ threshold < r + drift} ≤\n            ENNReal.ofReal (↑v / (↑N * radius ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_supervisory_gaussian_unsafe_halt_budget","type":"∀ (N : ℕ),\n  0 < N →\n    ∀ (r threshold allowance drift radius beta : ℝ) (v : NNReal),\n      0 < radius →\n        drift ≤ allowance →\n          ↑v ≤ beta * (↑N * radius ^ 2) →\n            (MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal r v)\n                {x | (∑ i, x i) / ↑N + radius + allowance ≤ threshold ∧ threshold < r + drift} ≤\n              ENNReal.ofReal beta"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_no_data_throttle_optimal","type":"∀ (fallback halt p : ℝ), 0 ≤ p → fallback ≤ halt → fallback ≤ p * halt + (1 - p) * fallback"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_no_data_capped_halt_optimal","type":"∀ (fallback halt p pMax : ℝ),\n  p ≤ pMax → halt ≤ fallback → pMax * halt + (1 - pMax) * fallback ≤ p * halt + (1 - p) * fallback"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_information_purchase_break_even","type":"∀ (fallback expectedActionLoss fixedFee perSample n : ℝ),\n  fixedFee + n * perSample + expectedActionLoss < fallback ↔ fixedFee + n * perSample < fallback - expectedActionLoss"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_optional_information_value_nonnegative","type":"∀ (fallback paid : ℝ), 0 ≤ fallback - min fallback paid"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_robust_uniform_action","type":"∀ (a theta sEnvelope s threshold allowance drift : ℝ),\n  0 ≤ theta →\n    s ≤ sEnvelope →\n      a + theta * (sEnvelope - a) + allowance ≤ threshold → drift ≤ allowance → a + theta * (s - a) + drift ≤ threshold"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_market_wide_measure","type":"∀ (a S sbar θ : ℝ), a < S → (a + θ * (S - a) ≤ sbar ↔ θ ≤ (sbar - a) / (S - a))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_persistence_merged","type":"∀ {n : ℕ} (a κ : ℝ) (q rate : Fin n → ℝ),\n  (∀ (i : Fin n), rate i ≠ 0) → a + κ * ∑ i, q i = a + κ * ∑ i, q i * rate i / rate i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_resolvent_expand","type":"∀ (u d s : ℝ),\n  u ≠ 0 →\n    u - d * s ≠ 0 →\n      ∀ (J : ℕ),\n        1 / (u - d * s) = ∑ m ∈ Finset.range J, d ^ m * s ^ m / u ^ (m + 1) + d ^ J * s ^ J / (u ^ J * (u - d * s))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_resolvent_sum_split","type":"∀ {τ : Type u_1} [inst : Fintype τ] (v t : τ → ℝ) (u d : ℝ) (J : ℕ),\n  0 < u →\n    0 ≤ d →\n      d < u →\n        (∀ (i : τ), |t i| ≤ 1) →\n          ∑ i, v i / (u - d * t i) =\n            ∑ m ∈ Finset.range J, d ^ m / u ^ (m + 1) * ∑ i, v i * t i ^ m +\n              d ^ J / u ^ J * ∑ i, v i * t i ^ J / (u - d * t i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_resolvent_remainder_le","type":"∀ {τ : Type u_1} [inst : Fintype τ] (v t : τ → ℝ) (u d W : ℝ) (J : ℕ),\n  0 ≤ d →\n    d < u →\n      (∀ (i : τ), 0 ≤ v i) → (∀ (i : τ), |t i| ≤ 1) → ∑ i, v i ≤ W → |∑ i, v i * t i ^ J / (u - d * t i)| ≤ W / (u - d)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_persistence_gap","type":"∀ {ι : Type u_1} {κι : Type u_2} [inst : Fintype ι] [inst_1 : Fintype κι] (w s : ι → ℝ) (w' s' : κι → ℝ) (u d W : ℝ)\n  (J : ℕ),\n  0 ≤ d →\n    d < u →\n      (∀ (i : ι), 0 ≤ w i) →\n        (∀ (i : κι), 0 ≤ w' i) →\n          ∑ i, w i ≤ W →\n            ∑ i, w' i ≤ W →\n              (∀ (i : ι), |s i| ≤ 1) →\n                (∀ (i : κι), |s' i| ≤ 1) →\n                  (∀ j < J, ∑ i, w i * s i ^ j = ∑ i, w' i * s' i ^ j) →\n                    |∑ i, w i / (u - d * s i) - ∑ i, w' i / (u - d * s' i)| ≤ 2 * W * d ^ J / (u ^ J * (u - d))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_target_two_cohorts","type":"∀ (a κ c d W H : ℝ),\n  0 < κ →\n    0 < W →\n      0 ≤ c →\n        0 < d →\n          d ≤ (1 - c) / 5 →\n            0 ≤ H →\n              ∀ (q rate q' rate' : Fin 2 → ℝ),\n                (∀ (i : Fin 2), 1 - rate i = c + d * ![-1, 1 / 3] i) →\n                  (∀ (i : Fin 2), 1 - rate' i = c + d * ![-1 / 2, 2 / 3] i) →\n                    (∀ (i : Fin 2), q i * rate i = W * ![1 / 4, 3 / 4] i) →\n                      (∀ (i : Fin 2), q' i * rate' i = W * ![4 / 7, 3 / 7] i) →\n                        have u := 1 - c;\n                        have SA := a + κ * ∑ i, q i;\n                        have SB := a + κ * ∑ i, q' i;\n                        q 0 ≤ q 1 ∧\n                          |SA - SB| ≤ κ * (2 * W * d ^ 3 / (u ^ 3 * (u - d))) ∧\n                            SA - κ * q 1 + 3 * κ * W / (28 * u) - κ * (2 * W * d ^ 3 / (u ^ 3 * (u - d))) >\n                                SA - κ * q 1 ∧\n                              (∀ (sbar : ℝ),\n                                  SA - κ * q 1 ≤ sbar →\n                                    sbar <\n                                        SA - κ * q 1 + 3 * κ * W / (28 * u) - κ * (2 * W * d ^ 3 / (u ^ 3 * (u - d))) →\n                                      SA - κ * q 1 ≤ sbar ∧ ∀ (j : Fin 2), SB - κ * q' j > sbar) ∧\n                                ∀ (N T : ℕ) (variance : NNReal),\n                                  variance ≠ 0 →\n                                    (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                                      ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                        MeasurableSet A →\n                                          (CurrentMM.gaussianRecordLaw (N * T)\n                                                    (CurrentMM.p1RepeatedMean N T\n                                                      (CurrentMM.actualCohortImpulse a κ q rate))\n                                                    variance).real\n                                                A ≤\n                                              1 / 4 →\n                                            (CurrentMM.gaussianRecordLaw (N * T)\n                                                      (CurrentMM.p1RepeatedMean N T\n                                                        (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                      variance).real\n                                                  Aᶜ ≤\n                                                1 / 4 →\n                                              ↑variance ≤\n                                                2 * ↑N * ↑T *\n                                                  (2 * W * 2 ^ T * d ^ 3 * CurrentMM.p1GapConst a |κ| W H T) ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_prop_target_every_K","type":"∀ (L : ℕ) (a κ c d W H : ℝ) (q rate q' rate' : Fin (L + 1) → ℝ),\n  0 ≤ a →\n    0 < κ →\n      0 ≤ c →\n        0 < d →\n          c + d ≤ 1 →\n            0 < W →\n              0 ≤ H →\n                (∀ (i : Fin (L + 1)), 1 - rate i = c + d * CurrentMM.gridNode L (2 * ↑i + 1)) →\n                  (∀ (i : Fin (L + 1)), 1 - rate' i = c + d * CurrentMM.gridNode L (2 * ↑i)) →\n                    (∀ (i : Fin (L + 1)), q i * rate i = W * ↑((2 * L + 1).choose (2 * ↑i + 1)) / 2 ^ (2 * L)) →\n                      (∀ (i : Fin (L + 1)), q' i * rate' i = W * ↑((2 * L + 1).choose (2 * ↑i)) / 2 ^ (2 * L)) →\n                        ∀ (i_star : Fin (L + 1)) (Δq : ℝ),\n                          0 < Δq →\n                            (∀ (j : Fin (L + 1)), q' j ≤ q i_star - Δq) →\n                              have u := 1 - c;\n                              have SA := a + κ * ∑ i, q i;\n                              have SB := a + κ * ∑ i, q' i;\n                              have gap_bound := κ * (2 * W * d ^ (2 * L + 1) / (u ^ (2 * L + 1) * (u - d)));\n                              d < u →\n                                gap_bound < κ * Δq →\n                                  |SA - SB| ≤ gap_bound ∧\n                                    (∀ (sbar : ℝ),\n                                        SA - κ * q i_star ≤ sbar ∧ sbar < SA - κ * q i_star + κ * Δq - gap_bound →\n                                          SA - κ * q i_star ≤ sbar ∧ ∀ (j : Fin (L + 1)), SB - κ * q' j > sbar) ∧\n                                      ∀ (N T : ℕ) (variance : NNReal),\n                                        variance ≠ 0 →\n                                          (∀ t < T, |CurrentMM.actualCohortImpulse a κ q' rate' t| ≤ H) →\n                                            ∀ (A : Set (CurrentMM.ObservationRecord (N * T))),\n                                              MeasurableSet A →\n                                                (CurrentMM.gaussianRecordLaw (N * T)\n                                                          (CurrentMM.p1RepeatedMean N T\n                                                            (CurrentMM.actualCohortImpulse a κ q rate))\n                                                          variance).real\n                                                      A ≤\n                                                    1 / 4 →\n                                                  (CurrentMM.gaussianRecordLaw (N * T)\n                                                            (CurrentMM.p1RepeatedMean N T\n                                                              (CurrentMM.actualCohortImpulse a κ q' rate'))\n                                                            variance).real\n                                                        Aᶜ ≤\n                                                      1 / 4 →\n                                                    ↑variance ≤\n                                                      2 * ↑N * ↑T *\n                                                        (2 * W * 2 ^ T * d ^ (2 * L + 1) *\n                                                            CurrentMM.p1GapConst a |κ| W H T) ^\n                                                          2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_first_flow","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (i : Fin n),\n  q i * CurrentMM.cohortImpulseMemory a impact q rate i 0 = q i * rate i * impact"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_mean_chebyshev","type":"∀ (N : ℕ),\n  0 < N →\n    ∀ (m : ℝ) (v : NNReal) (ε : ℝ),\n      0 < ε →\n        (MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal m v) {x | ε ≤ |(∑ i, x i) / ↑N - m|} ≤\n          ENNReal.ofReal (↑v / (↑N * ε ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_weight_recovery","type":"∀ (N : ℕ),\n  0 < N →\n    ∀ (w κ : ℝ),\n      κ ≠ 0 →\n        ∀ (v : NNReal) (ε : ℝ),\n          0 < ε →\n            (MeasureTheory.Measure.pi fun x => ProbabilityTheory.gaussianReal (w * κ) v)\n                {x | ε ≤ |(∑ i, x i) / ↑N / κ - w|} ≤\n              ENNReal.ofReal (↑v / (↑N * κ ^ 2 * ε ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_tagged_recovery_all_classes","type":"∀ {K : ℕ} (N : ℕ),\n  0 < N →\n    ∀ (a κ : ℝ),\n      κ ≠ 0 →\n        ∀ (q rate : Fin K → ℝ) (v : NNReal) (ε : ℝ),\n          0 < ε →\n            (MeasureTheory.Measure.pi fun i =>\n                  MeasureTheory.Measure.pi fun x =>\n                    ProbabilityTheory.gaussianReal (q i * CurrentMM.cohortImpulseMemory a κ q rate i 0) v)\n                (⋃ i, {x | ε ≤ |(∑ e, x i e) / ↑N / κ - q i * rate i|}) ≤\n              ↑K * ENNReal.ofReal (↑v / (↑N * κ ^ 2 * ε ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_iv_determinant_bound","type":"∀ {L : ℕ} (c lam : Fin L → ℝ) (lbar r w wmin : ℝ),\n  (∀ (l : Fin L), 0 ≤ c l) →\n    (∀ (l : Fin L), 0 ≤ lam l) →\n      (∀ (l : Fin L), lam l ≤ lbar) →\n        lbar < 1 →\n          0 ≤ r →\n            r < 1 →\n              0 ≤ wmin →\n                wmin ≤ w →\n                  !![w * ∑ l, c l / (1 - r * lam l), ∑ l, c l * lam l;\n                          w * ∑ l, c l * lam l / (1 - r * lam l), ∑ l, c l].det =\n                      w *\n                        ((∑ l, c l) * ∑ l, c l / (1 - r * lam l) -\n                          (∑ l, c l * lam l) * ∑ l, c l * lam l / (1 - r * lam l)) ∧\n                    wmin * (1 - lbar ^ 2) * (∑ l, c l) ^ 2 ≤\n                      w *\n                        ((∑ l, c l) * ∑ l, c l / (1 - r * lam l) -\n                          (∑ l, c l * lam l) * ∑ l, c l * lam l / (1 - r * lam l))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_second_flow","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (i : Fin n),\n  q i * CurrentMM.cohortImpulseMemory a impact q rate i 1 =\n    q i * rate i * ((1 - rate i) * impact + CurrentMM.actualCohortImpulse a impact q rate 1)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_tagged_rate_perturb","type":"∀ (w κ r h1 ωmin ωmax B e A' F' H' : ℝ),\n  κ ≠ 0 →\n    0 < ωmin →\n      ωmin ≤ w →\n        w ≤ ωmax →\n          |r| ≤ 1 →\n            |h1| ≤ B →\n              0 ≤ e →\n                e ≤ ωmin * |κ| / 2 →\n                  |A' - w * κ| ≤ e →\n                    |F' - w * (r * κ + h1)| ≤ e →\n                      |H' - h1| ≤ e →\n                        |(F' * κ / A' - H') / κ - r| ≤\n                          (2 * (ωmax * |κ| + ωmax * (|κ| + B)) / (ωmin ^ 2 * |κ|) + 1) / |κ| * e"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_thm_tagged_rate_recovery","type":"∀ {K : ℕ} (N : ℕ),\n  0 < N →\n    ∀ (a κ : ℝ),\n      κ ≠ 0 →\n        ∀ (q rate : Fin K → ℝ) (i : Fin K) (ωmin ωmax B : ℝ),\n          0 < ωmin →\n            ωmin ≤ q i * rate i →\n              q i * rate i ≤ ωmax →\n                |1 - rate i| ≤ 1 →\n                  |CurrentMM.actualCohortImpulse a κ q rate 1| ≤ B →\n                    ∀ (v : NNReal) (e : ℝ),\n                      0 < e →\n                        e ≤ ωmin * |κ| / 2 →\n                          (MeasureTheory.Measure.pi fun j =>\n                                MeasureTheory.Measure.pi fun x =>\n                                  ProbabilityTheory.gaussianReal\n                                    (![q i * CurrentMM.cohortImpulseMemory a κ q rate i 0,\n                                        q i * CurrentMM.cohortImpulseMemory a κ q rate i 1,\n                                        CurrentMM.actualCohortImpulse a κ q rate 1]\n                                      j)\n                                    v)\n                              {x |\n                                (2 * (ωmax * |κ| + ωmax * (|κ| + B)) / (ωmin ^ 2 * |κ|) + 1) / |κ| * e <\n                                  |((∑ n, x 1 n) / ↑N * κ / ((∑ n, x 0 n) / ↑N) - (∑ n, x 2 n) / ↑N) / κ -\n                                      (1 - rate i)|} ≤\n                            3 * ENNReal.ofReal (↑v / (↑N * e ^ 2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_klFun_set_jensen","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (μ ν : MeasureTheory.Measure α) [MeasureTheory.IsFiniteMeasure μ]\n  [MeasureTheory.IsFiniteMeasure ν],\n  μ.AbsolutelyContinuous ν →\n    ∀ {A : Set α},\n      ν A ≠ 0 →\n        MeasureTheory.IntegrableOn (fun x => InformationTheory.klFun (μ.rnDeriv ν x).toReal) A ν →\n          ν.real A * InformationTheory.klFun (μ.real A / ν.real A) ≤\n            ∫ (x : α) in A, InformationTheory.klFun (μ.rnDeriv ν x).toReal ∂ν"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_setLIntegral_klFun_ge","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (μ ν : MeasureTheory.Measure α) [MeasureTheory.IsFiniteMeasure μ]\n  [MeasureTheory.IsFiniteMeasure ν],\n  μ.AbsolutelyContinuous ν →\n    ∀ {A : Set α},\n      ν A ≠ 0 →\n        ENNReal.ofReal (ν.real A * InformationTheory.klFun (μ.real A / ν.real A)) ≤\n          ∫⁻ (x : α) in A, ENNReal.ofReal (InformationTheory.klFun (μ.rnDeriv ν x).toReal) ∂ν"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mul_klFun_div","type":"∀ (p q : ℝ), 0 < q → q * InformationTheory.klFun (p / q) = p * Real.log (p / q) + q - p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mul_log_ge_neg_exp","type":"∀ (x : ℝ), 0 ≤ x → -Real.exp (-1) ≤ x * Real.log x"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_test_error_kl_lower_bound","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] {A : Set α},\n  MeasurableSet A → P.real A ≤ 1 / 4 → Q.real Aᶜ ≤ 1 / 4 → ENNReal.ofReal (1 / 4) ≤ InformationTheory.klDiv P Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_track_sum_sq_le","type":"∀ (m : ℕ), ∑ j ∈ Finset.range m, (↑j + 1) ^ 2 ≤ ↑m ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_track_kl_window","type":"∀ (n C v : ℝ),\n  0 ≤ n →\n    0 ≤ C →\n      ∀ (m : ℕ) (kl : ℕ → ℝ),\n        (∀ j < m, kl j ≤ n * C * (v * (↑j + 1)) ^ 2) → ∑ j ∈ Finset.range m, kl j ≤ n * C * v ^ 2 * ↑m ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_track_two_point","type":"∀ {α : Type u_1} [inst : MeasurableSpace α] (P Q : MeasureTheory.Measure α) [MeasureTheory.IsProbabilityMeasure P]\n  [MeasureTheory.IsProbabilityMeasure Q] (est : α → ℝ),\n  Measurable est →\n    ∀ (u w ε : ℝ),\n      2 * ε ≤ |u - w| →\n        InformationTheory.klDiv P Q ≤ ENNReal.ofReal (1 / 2) →\n          1 / 4 ≤ max (P.real {x | ε ≤ |est x - u|}) (Q.real {x | ε ≤ |est x - w|})"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_track_tradeoff","type":"∀ (v B ε : ℝ), 0 < v → 0 ≤ B → 0 < ε → ε ^ 3 = v * B ^ 2 → v * (ε / v) + B / √(ε / v) = 2 * ε"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_observer_floor","type":"∀ (σ v₀ γ n A : ℝ), 0 ≤ v₀ → 0 < n → A ≠ 0 → σ ^ 2 * γ ≤ σ ^ 2 * (v₀ + γ * n * A ^ 2) / (n * A ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hiding_detection_bound","type":"∀ (k L D₀ : ℝ),\n  0 ≤ k →\n    0 < L →\n      ∀ (det : ℝ → ℝ) (Dstar Ddev : ℝ),\n        0 ≤ Ddev →\n          Ddev ≤ D₀ →\n            k * (D₀ - Dstar) ^ 2 + L * det Dstar ≤ k * (D₀ - Ddev) ^ 2 + L * det Ddev →\n              det Dstar ≤ k * D₀ ^ 2 / L + det Ddev"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_hiding_tag_no_crowding","type":"∀ (k L D₀ p : ℝ), 0 ≤ k → ∀ (D : ℝ), k * (D₀ - D₀) ^ 2 + L * p ≤ k * (D₀ - D) ^ 2 + L * p"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_uniform_lower_bound_fderiv","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] {f : E → F},\n  ContDiff ℝ 1 f →\n    ∀ {Q : Set E},\n      IsCompact Q →\n        (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ f x)) → ∃ m > 0, ∀ x ∈ Q, ∀ (v : E), m * ‖v‖ ≤ ‖(fderiv ℝ f x) v‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_uniform_local_inverse","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [FiniteDimensional ℝ E]\n  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace ℝ F] [FiniteDimensional ℝ F] {f : E → F},\n  ContDiff ℝ 1 f →\n    Module.finrank ℝ E = Module.finrank ℝ F →\n      ∀ {Q : Set E},\n        IsCompact Q →\n          (∀ x ∈ Q, Function.Injective ⇑(fderiv ℝ f x)) →\n            ∃ ρ₀ > 0, ∃ L > 0, ∀ x ∈ Q, ∀ (y : F), dist y (f x) ≤ ρ₀ → ∃ z, dist z x ≤ L * dist y (f x) ∧ f z = y"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cor_unknown_primitives_recursion","type":"∀ {n : ℕ} (a κ : ℝ),\n  κ ≠ 0 →\n    ∀ (q rate : Fin n → ℝ) (t : ℕ),\n      CurrentMM.actualCohortImpulse a κ q rate (t + 1) =\n        0 * CurrentMM.actualCohortImpulse a κ q rate t +\n          κ *\n            ∑ m ∈ Finset.range (t + 1),\n              CurrentMM.absorbedKernel a κ q rate m * CurrentMM.actualCohortImpulse a κ q rate (t - m)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_mergedWeight_mul_rate","type":"∀ {ι : Type u_1} (S : Finset ι) (r w : ι → ℝ) (ρ : ℝ),\n  CurrentMM.mergedWeight S r (fun i => w i * r i) ρ = ρ * CurrentMM.mergedWeight S r w ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_sum_eq_sum_mergedWeight","type":"∀ {ι : Type u_1} (S : Finset ι) (r w : ι → ℝ) (R : Finset ℝ),\n  (∀ i ∈ S, r i ∈ R) → ∑ i ∈ S, w i = ∑ ρ ∈ R, CurrentMM.mergedWeight S r w ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.p1_cor_unknown_primitives_identification","type":"∀ {n n' : ℕ} (a κ a' κ' : ℝ),\n  κ ≠ 0 →\n    ∀ (q rate : Fin n → ℝ) (q' rate' : Fin n' → ℝ),\n      (∀ (i : Fin n), 1 - rate i ≠ 0) →\n        (∀ (i : Fin n'), 1 - rate' i ≠ 0) →\n          (∀ (j : ℕ), CurrentMM.actualCohortImpulse a κ q rate j = CurrentMM.actualCohortImpulse a' κ' q' rate' j) →\n            κ = κ' ∧\n              a = a' ∧\n                ∀ (ρ : ℝ),\n                  CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate i) (fun i => q i * rate i) ρ =\n                    CurrentMM.mergedWeight Finset.univ (fun i => 1 - rate' i) (fun i => q' i * rate' i) ρ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnegative_probe_zero_quantity","type":"∀ {T : ℕ} (v : Fin T → ℝ), (∀ (i : Fin T), 0 ≤ v i) → CurrentMM.cumulativeQuantity v = 0 → ∀ (i : Fin T), v i = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_short_perpetual_entry_basis","type":"∀ {T : ℕ} (P impact : ℝ) (h : ℕ → ℝ) (v : Fin T → ℝ),\n  (∀ (i : Fin T), 0 ≤ v i) →\n    CurrentMM.cumulativeQuantity v * CurrentMM.shortPerpetualEntry P impact h v =\n      CurrentMM.executedNotional P impact h v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_perpetual_principal_equity_bridge","type":"∀ {T : ℕ} (B P impact flatFee commission funding : ℝ) (h : ℕ → ℝ) (v : Fin T → ℝ),\n  (∀ (i : Fin T), 0 ≤ v i) →\n    CurrentMM.shortPerpetualEquity B P impact flatFee commission funding h v =\n      CurrentMM.sequenceDealerEquity B P impact flatFee h v - commission * CurrentMM.executedNotional P impact h v -\n        funding"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_executed_notional_cost_identity","type":"∀ {T : ℕ} (P impact : ℝ) (h : ℕ → ℝ) (v : Fin T → ℝ),\n  h 0 = impact →\n    CurrentMM.executedNotional P impact h v = P * CurrentMM.cumulativeQuantity v + CurrentMM.quadraticExecutionCost h v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnegative_execution_cost_upper_bound","type":"∀ {T : ℕ} (impact : ℝ) (h : ℕ → ℝ) (v : Fin T → ℝ),\n  (∀ (i : Fin T), 0 ≤ v i) →\n    (∀ (j : ℕ), h j ≤ impact) → CurrentMM.quadraticExecutionCost h v ≤ impact / 2 * CurrentMM.cumulativeQuantity v ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_short_perpetual_margin_with_charges","type":"∀ {T : ℕ} (B P impact flatFee commission funding margin V reserve : ℝ) (h : ℕ → ℝ) (v : Fin T → ℝ),\n  (∀ (i : Fin T), 0 ≤ v i) →\n    0 ≤ impact →\n      0 ≤ P →\n        0 ≤ flatFee →\n          0 ≤ commission →\n            0 ≤ margin →\n              Antitone h →\n                h 0 = impact →\n                  CurrentMM.cumulativeQuantity v ≤ V →\n                    funding ≤ reserve →\n                      (margin + 1 / 2 + commission / 2) * impact * V ^ 2 + (flatFee + (margin + commission) * P) * V +\n                            reserve ≤\n                          B →\n                        margin * |(-CurrentMM.cumulativeQuantity v)| * (P + CurrentMM.sequenceFinalDisplacement h v) ≤\n                          CurrentMM.shortPerpetualEquity B P impact flatFee commission funding h v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_perpetual_fee_reserve_cap","type":"∀ {n T : ℕ} (a B P impact flatFee commission funding margin V reserve : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 < P →\n        0 ≤ flatFee →\n          0 ≤ commission →\n            0 < margin →\n              0 < B - reserve →\n                0 ≤ V →\n                  (∀ (i : Fin n), 0 ≤ q i) →\n                    (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n                      a + impact * ∑ i, q i < 1 →\n                        (∀ (i : Fin T), 0 ≤ v i) →\n                          CurrentMM.cumulativeQuantity v ≤ V →\n                            funding ≤ reserve →\n                              V ≤\n                                  CurrentMM.robustQuantityCap ((margin + 1 / 2 + commission / 2) * impact)\n                                    (flatFee + (margin + commission) * P) (B - reserve) →\n                                margin * |(-CurrentMM.cumulativeQuantity v)| *\n                                    (P +\n                                      CurrentMM.sequenceFinalDisplacement\n                                        (CurrentMM.actualCohortImpulse a impact q rate) v) ≤\n                                  CurrentMM.shortPerpetualEquity B P impact flatFee commission funding\n                                    (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_baseline_direct_fill","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ) (i : Fin T),\n  CurrentMM.actualBaselineBeforeFill a impact q rate v i + impact * v i =\n    (CurrentMM.controlledCohortRun a impact q rate (CurrentMM.extendFiniteProbe v) (↑i + 1)).price"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_finite_price_scalar_convolution","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ) (i : Fin T),\n  (CurrentMM.controlledCohortRun a impact q rate (CurrentMM.extendFiniteProbe v) (↑i + 1)).price =\n    ∑ j, v j * if j ≤ i then CurrentMM.actualCohortImpulse a impact q rate (↑i - ↑j) else 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_refreshed_baseline_is_kernel","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ) (i : Fin T),\n  CurrentMM.actualBaselineBeforeFill a impact q rate v i =\n    CurrentMM.baselineDisplacement (CurrentMM.actualCohortImpulse a impact q rate) v i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_final_price_is_sequence_displacement","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  (CurrentMM.controlledCohortRun a impact q rate (CurrentMM.extendFiniteProbe v) T).price =\n    CurrentMM.sequenceFinalDisplacement (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_dealer_cash_matches_sequence","type":"∀ {n T : ℕ} (a B P impact fee : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  CurrentMM.physicalDealerCash a B P impact fee q rate v =\n    CurrentMM.sequenceDealerCash B P impact fee (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_dealer_equity_matches_sequence","type":"∀ {n T : ℕ} (a B P impact fee : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  CurrentMM.physicalDealerEquity a B P impact fee q rate v =\n    CurrentMM.sequenceDealerEquity B P impact fee (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_counterparty_robust_cap","type":"∀ {n : ℕ} (a B P impact fee margin V : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 < P →\n        0 ≤ fee →\n          0 < margin →\n            0 < B →\n              0 ≤ V →\n                (∀ (i : Fin n), 0 ≤ q i) →\n                  (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n                    a + impact * ∑ i, q i < 1 →\n                      (CurrentMM.physicalRobustQuantityMargin a B P impact fee margin V q rate ↔\n                        V ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (fee + margin * P) B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_partial_fill_margin","type":"∀ {n T : ℕ} (a B P impact fee margin V : ℝ) (q rate : Fin n → ℝ) (v : Fin (T + 1) → ℝ) (fraction : ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 < P →\n        0 ≤ fee →\n          0 < margin →\n            0 < B →\n              0 ≤ V →\n                (∀ (i : Fin n), 0 ≤ q i) →\n                  (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n                    a + impact * ∑ i, q i < 1 →\n                      (∀ (i : Fin (T + 1)), 0 ≤ v i) →\n                        0 ≤ fraction ∧ fraction ≤ 1 →\n                          CurrentMM.cumulativeQuantity v ≤ V →\n                            V ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (fee + margin * P) B →\n                              margin * |(-CurrentMM.cumulativeQuantity (CurrentMM.partialLastFill v fraction))| *\n                                  (P +\n                                    (CurrentMM.controlledCohortRun a impact q rate\n                                        (CurrentMM.extendFiniteProbe (CurrentMM.partialLastFill v fraction))\n                                        (T + 1)).price) ≤\n                                CurrentMM.physicalDealerEquity a B P impact fee q rate\n                                  (CurrentMM.partialLastFill v fraction)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_nonnegative_probe_mark_positive","type":"∀ {n T : ℕ} (a P impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      0 < P →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i < 1 →\n              (∀ (i : Fin T), 0 ≤ v i) →\n                0 < P + (CurrentMM.controlledCohortRun a impact q rate (CurrentMM.extendFiniteProbe v) T).price"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_counterparty_equity_positive","type":"∀ {n T : ℕ} (a B P impact fee margin V : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 < P →\n        0 ≤ fee →\n          0 < margin →\n            0 < B →\n              0 ≤ V →\n                (∀ (i : Fin n), 0 ≤ q i) →\n                  (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n                    a + impact * ∑ i, q i < 1 →\n                      (∀ (i : Fin T), 0 ≤ v i) →\n                        CurrentMM.cumulativeQuantity v ≤ V →\n                          V ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (fee + margin * P) B →\n                            0 < CurrentMM.physicalDealerEquity a B P impact fee q rate v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_price_box","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          a + impact * ∑ i, q i ≤ 1 →\n            CurrentMM.stateInBox state M →\n              0 ≤ (CurrentMM.cohortStep a impact q rate 0 state).price ∧\n                (CurrentMM.cohortStep a impact q rate 0 state).price ≤ M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_step_preserves_box","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              CurrentMM.stateInBox state M → CurrentMM.stateInBox (CurrentMM.cohortStep a impact q rate 0 state) M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_trajectory_box","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (initial : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              CurrentMM.stateInBox initial M →\n                ∀ (t : ℕ), CurrentMM.stateInBox (CurrentMM.autonomousState a impact q rate initial t) M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_pulse_initial_box","type":"∀ {n : ℕ} (a impact A : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ impact →\n    0 ≤ A →\n      (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) → CurrentMM.stateInBox (CurrentMM.pulse1 a impact q rate A) (impact * A)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_positive_pulse_peak","type":"∀ {n : ℕ} (a impact A : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ A →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              ∀ (t : ℕ),\n                0 ≤ (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate A) t).price ∧\n                  (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate A) t).price ≤ impact * A"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.funded_trader_positive_trajectory_margin","type":"∀ {n : ℕ} (a impact A cost margin P : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ A →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              margin ≤ 1 →\n                ∀ (t : ℕ),\n                  have mark :=\n                    P + (CurrentMM.autonomousState a impact q rate (CurrentMM.pulse1 a impact q rate A) t).price;\n                  margin * |A| * mark ≤\n                    CurrentMM.equity\n                      (CurrentMM.pulseTraderCapital impact cost margin P A - A * CurrentMM.averageFill P impact A -\n                        cost * A)\n                      A mark"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_signed_price_bound","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          a + impact * ∑ i, q i ≤ 1 →\n            CurrentMM.stateAbsBound state M → |(CurrentMM.cohortStep a impact q rate 0 state).price| ≤ M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_step_preserves_abs_bound","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (state : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              CurrentMM.stateAbsBound state M → CurrentMM.stateAbsBound (CurrentMM.cohortStep a impact q rate 0 state) M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.signed_cohort_trajectory_abs_bound","type":"∀ {n : ℕ} (a impact M : ℝ) (q rate : Fin n → ℝ) (initial : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      0 ≤ M →\n        (∀ (i : Fin n), 0 ≤ q i) →\n          (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n            a + impact * ∑ i, q i ≤ 1 →\n              CurrentMM.stateAbsBound initial M →\n                ∀ (t : ℕ), CurrentMM.stateAbsBound (CurrentMM.autonomousState a impact q rate initial t) M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.euclidean_state_bounds_components","type":"∀ {n : ℕ} (initial : CurrentMM.CohortState n), CurrentMM.stateAbsBound initial ‖CurrentMM.cohortEuclideanState initial‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.price_only_euclidean_gain_bound","type":"∀ {n : ℕ} (a impact exposure : ℝ) (q rate : Fin n → ℝ) (initial : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i ≤ 1 →\n            ∀ (t : ℕ),\n              |exposure * (CurrentMM.autonomousState a impact q rate initial t).price| ≤\n                |exposure| * ‖CurrentMM.cohortEuclideanState initial‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.pure_price_unit_state_norm","type":"∀ (n : ℕ), ‖CurrentMM.cohortEuclideanState { price := 1, memory := fun x => 0 }‖ = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.price_only_exact_peak_gain","type":"∀ {n : ℕ} (a impact exposure : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i ≤ 1 →\n            IsGreatest\n              ((fun pair => |exposure * (CurrentMM.autonomousState a impact q rate pair.1 pair.2).price|) ''\n                {pair | ‖CurrentMM.cohortEuclideanState pair.1‖ ≤ 1})\n              |exposure|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.finite_column_quantity_bound","type":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {n : ℕ} (columns : Fin n → E)\n  (quantity : Fin n → ℝ) (M V : ℝ),\n  0 ≤ M → (∀ (i : Fin n), ‖columns i‖ ≤ M) → ∑ i, |quantity i| ≤ V → ‖∑ i, quantity i • columns i‖ ≤ V * M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.quantity_pulse_attains_column_bound","type":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {n : ℕ} (columns : Fin n → E)\n  (pulseIndex : Fin n) (V : ℝ),\n  0 ≤ V →\n    ∑ i, |if i = pulseIndex then V else 0| = V ∧\n      ‖∑ i, (if i = pulseIndex then V else 0) • columns i‖ = V * ‖columns pulseIndex‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.euclidean_third_tap_norm","type":"∀ (impact q delta : ℝ), 0 ≤ impact → 0 ≤ q → ‖CurrentMM.thirdTapVector impact q delta‖ = impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_pulse_third_tap_signal","type":"∀ (A impact q delta : ℝ),\n  0 ≤ A → 0 ≤ impact → 0 ≤ q → ‖A • CurrentMM.thirdTapVector impact q delta‖ = A * impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_product_rn_derivative","type":"∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α] [inst_1 : MeasurableSpace β]\n  (μ0 ν0 : MeasureTheory.Measure α) (μ1 ν1 : MeasureTheory.Measure β) [MeasureTheory.SigmaFinite μ0]\n  [MeasureTheory.SigmaFinite ν0] [MeasureTheory.SigmaFinite μ1] [MeasureTheory.SigmaFinite ν1],\n  μ0.AbsolutelyContinuous ν0 →\n    μ1.AbsolutelyContinuous ν1 →\n      (μ0.prod μ1).rnDeriv (ν0.prod ν1) =ᵐ[ν0.prod ν1] fun p => μ0.rnDeriv ν0 p.1 * μ1.rnDeriv ν1 p.2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_product_llr","type":"∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α] [inst_1 : MeasurableSpace β]\n  (μ0 ν0 : MeasureTheory.Measure α) (μ1 ν1 : MeasureTheory.Measure β) [MeasureTheory.SigmaFinite μ0]\n  [MeasureTheory.SigmaFinite ν0] [MeasureTheory.SigmaFinite μ1] [MeasureTheory.SigmaFinite ν1],\n  μ0.AbsolutelyContinuous ν0 →\n    μ1.AbsolutelyContinuous ν1 →\n      MeasureTheory.llr (μ0.prod μ1) (ν0.prod ν1) =ᵐ[μ0.prod μ1] fun p =>\n        MeasureTheory.llr μ0 ν0 p.1 + MeasureTheory.llr μ1 ν1 p.2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_product_kl_additive","type":"∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α] [inst_1 : MeasurableSpace β]\n  (μ0 ν0 : MeasureTheory.Measure α) (μ1 ν1 : MeasureTheory.Measure β) [MeasureTheory.IsProbabilityMeasure μ0]\n  [MeasureTheory.IsProbabilityMeasure ν0] [MeasureTheory.IsProbabilityMeasure μ1]\n  [MeasureTheory.IsProbabilityMeasure ν1],\n  μ0.AbsolutelyContinuous ν0 →\n    μ1.AbsolutelyContinuous ν1 →\n      MeasureTheory.Integrable (MeasureTheory.llr μ0 ν0) μ0 →\n        MeasureTheory.Integrable (MeasureTheory.llr μ1 ν1) μ1 →\n          InformationTheory.klDiv (μ0.prod μ1) (ν0.prod ν1) =\n            InformationTheory.klDiv μ0 ν0 + InformationTheory.klDiv μ1 ν1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.passive_three_step_price_expansion","type":"∀ (a kappa q eta delta w1 w2 w3 : ℝ),\n  have b1 := a + kappa * q * eta;\n  have b2_0 := b1 ^ 2 + kappa * q * eta * (1 - eta);\n  have b2_d := b1 ^ 2 + kappa * (q / 2) * ((eta - delta) * (1 - (eta - delta)) + (eta + delta) * (1 - (eta + delta)));\n  b2_0 - b2_d = kappa * q * delta ^ 2 ∧\n    b2_0 * w1 + b1 * w2 + w3 - (b2_d * w1 + b1 * w2 + w3) = kappa * q * delta ^ 2 * w1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.passive_block_price_mark_positive","type":"∀ (P_star b b1 b2 w1 w2 w3 : ℝ),\n  0 ≤ b1 →\n    b1 ≤ 1 →\n      0 ≤ b2 →\n        b2 ≤ 1 →\n          |w1| ≤ b →\n            |w2| ≤ b →\n              |w3| ≤ b → 3 * b < P_star → |b2 * w1 + b1 * w2 + w3| ≤ 3 * b ∧ 0 < P_star + (b2 * w1 + b1 * w2 + w3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.passive_uniform_fourth_cumulant_nonpos","type":"∀ (b sigma_sq b1 b2 : ℝ),\n  have sw_sq := b ^ 2 / 3;\n  have m4_unif := b ^ 4 / 5;\n  have R := (sw_sq + sigma_sq) * (sw_sq * (1 + b1 ^ 2 + b2 ^ 2) + sigma_sq) + sw_sq ^ 2 * b2 ^ 2;\n  m4_unif - 3 * sw_sq ^ 2 = -2 * b ^ 4 / 15 ∧ R + b2 ^ 2 * (m4_unif - 3 * sw_sq ^ 2) ≤ R"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.passive_covariance_gap_and_chebyshev_sample_bound","type":"∀ (kappa q sw_sq delta R alpha n : ℝ),\n  0 < R →\n    0 < alpha →\n      0 < kappa * q * sw_sq * delta ^ 2 →\n        4 * R / (alpha * (kappa * q * sw_sq * delta ^ 2) ^ 2) ≤ n →\n          have Delta := kappa * q * sw_sq * delta ^ 2;\n          0 < n ∧ 4 * (R / n) / Delta ^ 2 ≤ alpha"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_first_pulse_price","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (A : ℝ), (CurrentMM.pulse1 a impact q rate A).price = impact * A"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_first_pulse_memory","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (A : ℝ) (i : Fin n),\n  (CurrentMM.pulse1 a impact q rate A).memory i = rate i * (impact * A)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_single_second_price","type":"∀ (a impact q rate A : ℝ),\n  (CurrentMM.pulse2 a impact (fun x => q) (fun x => rate) A).price = A * CurrentMM.singlePriceTap1 a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_single_third_price","type":"∀ (a impact q rate A : ℝ),\n  (CurrentMM.pulse3 a impact (fun x => q) (fun x => rate) A).price = A * CurrentMM.singlePriceTap2 a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_split_second_price","type":"∀ (a impact q rate delta A : ℝ),\n  (CurrentMM.pulse2 a impact (fun x => q / 2) (CurrentMM.pairRates rate delta) A).price =\n    A * CurrentMM.splitPriceTap1 a impact q rate delta"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_split_third_price","type":"∀ (a impact q rate delta A : ℝ),\n  (CurrentMM.pulse3 a impact (fun x => q / 2) (CurrentMM.pairRates rate delta) A).price =\n    A * CurrentMM.splitPriceTap2 a impact q rate delta"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_third_observation_separation","type":"∀ (a impact q rate delta A : ℝ),\n  (CurrentMM.pulse3 a impact (fun x => q / 2) (CurrentMM.pairRates rate delta) A).price -\n      (CurrentMM.pulse3 a impact (fun x => q) (fun x => rate) A).price =\n    -A * impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_equity_disclosure_from_recursion","type":"∀ (B P a impact cost q rate delta A : ℝ),\n  (CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q / 2) (CurrentMM.pairRates rate delta) -\n      CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q) fun x => rate) =\n    A ^ 2 * impact ^ 2 * q * delta ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_equity_marks_distinct","type":"∀ (B P a impact cost q rate delta A : ℝ),\n  0 < A →\n    0 < impact →\n      0 < q →\n        delta ≠ 0 →\n          CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q / 2) (CurrentMM.pairRates rate delta) ≠\n            CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q) fun x => rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_equity_decision_correct","type":"∀ (B P a impact cost q rate delta A : ℝ),\n  0 < A →\n    0 < impact →\n      0 < q →\n        delta ≠ 0 →\n          have e0 := CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q) fun x => rate;\n          have e1 :=\n            CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q / 2) (CurrentMM.pairRates rate delta);\n          CurrentMM.exactEquityDecision e0 e0 = false ∧ CurrentMM.exactEquityDecision e0 e1 = true"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.arbitrarily_small_equity_distinguishing_pulse","type":"∀ (B P a impact cost q rate delta margin radius : ℝ),\n  0 < B →\n    0 < P →\n      0 < impact →\n        0 ≤ cost →\n          0 < q →\n            delta ≠ 0 →\n              0 < margin →\n                0 < radius →\n                  ∃ A,\n                    0 < A ∧\n                      A ≤ radius ∧\n                        A ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (cost + margin * P) B ∧\n                          have e0 := CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q) fun x => rate;\n                          have e1 :=\n                            CurrentMM.counterpartyThirdEquity B P a impact cost A (fun x => q / 2)\n                              (CurrentMM.pairRates rate delta);\n                          CurrentMM.exactEquityDecision e0 e0 = false ∧ CurrentMM.exactEquityDecision e0 e1 = true"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_cohort_step_monotone","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (x y : CurrentMM.CohortState n),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 ≤ rate i ∧ rate i ≤ 1) →\n          CurrentMM.cohortStateLE x y →\n            CurrentMM.cohortStateLE (CurrentMM.cohortStep a impact q rate 0 x)\n              (CurrentMM.cohortStep a impact q rate 0 y)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_sequence_dealer_equity","type":"∀ {n : ℕ} (B P impact fee : ℝ) (h : ℕ → ℝ) (v : Fin n → ℝ),\n  h 0 = impact →\n    CurrentMM.sequenceDealerEquity B P impact fee h v =\n      B + CurrentMM.quadraticExecutionCost h v -\n          CurrentMM.cumulativeQuantity v * CurrentMM.sequenceFinalDisplacement h v -\n        fee * CurrentMM.cumulativeQuantity v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.adverse_mark_entry_upper_bound","type":"∀ (n : ℕ) (h : ℕ → ℝ) (impact : ℝ),\n  Antitone h → h 0 = impact → ∀ (i j : Fin n), CurrentMM.adverseMarkEntry n h i j ≤ impact / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.sequence_adverse_quadratic_identity","type":"∀ {n : ℕ} (h : ℕ → ℝ) (v : Fin n → ℝ),\n  CurrentMM.cumulativeQuantity v * CurrentMM.sequenceFinalDisplacement h v - CurrentMM.quadraticExecutionCost h v =\n    ∑ i, ∑ j, v i * v j * CurrentMM.adverseMarkEntry n h i j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnegative_sequence_adverse_mark_bound","type":"∀ {n : ℕ} (h : ℕ → ℝ) (impact : ℝ) (v : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ v i) →\n    Antitone h →\n      h 0 = impact →\n        CurrentMM.cumulativeQuantity v * CurrentMM.sequenceFinalDisplacement h v -\n            CurrentMM.quadraticExecutionCost h v ≤\n          impact / 2 * CurrentMM.cumulativeQuantity v ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnegative_sequence_displacement_bound","type":"∀ {n : ℕ} (h : ℕ → ℝ) (impact : ℝ) (v : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ v i) →\n    Antitone h → h 0 = impact → CurrentMM.sequenceFinalDisplacement h v ≤ impact * CurrentMM.cumulativeQuantity v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnegative_sequence_margin","type":"∀ {n : ℕ} (B P impact fee margin V : ℝ) (h : ℕ → ℝ) (v : Fin n → ℝ),\n  (∀ (i : Fin n), 0 ≤ v i) →\n    0 ≤ impact →\n      0 ≤ P →\n        0 ≤ fee →\n          0 ≤ margin →\n            Antitone h →\n              h 0 = impact →\n                CurrentMM.cumulativeQuantity v ≤ V →\n                  (margin + 1 / 2) * impact * V ^ 2 + (fee + margin * P) * V ≤ B →\n                    margin * |(-CurrentMM.cumulativeQuantity v)| * (P + CurrentMM.sequenceFinalDisplacement h v) ≤\n                      CurrentMM.sequenceDealerEquity B P impact fee h v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.single_sequence_pulse_account","type":"∀ (B P impact fee V : ℝ) (h : ℕ → ℝ),\n  h 0 = impact → (CurrentMM.sequenceDealerEquity B P impact fee h fun x => V) = B - impact * V ^ 2 / 2 - fee * V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_nonnegative_sequence_margin_iff","type":"∀ (B P impact fee margin V : ℝ) (h : ℕ → ℝ),\n  0 ≤ impact →\n    0 ≤ P →\n      0 ≤ fee →\n        0 ≤ margin →\n          0 ≤ V →\n            Antitone h →\n              h 0 = impact →\n                (CurrentMM.robustNonnegativeSequenceMargin B P impact fee margin V h ↔\n                  (margin + 1 / 2) * impact * V ^ 2 + (fee + margin * P) * V ≤ B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.robust_nonnegative_quantity_allowance_iff","type":"∀ (B P impact fee margin V : ℝ) (h : ℕ → ℝ),\n  0 < impact →\n    0 < P →\n      0 ≤ fee →\n        0 < margin →\n          0 < B →\n            0 ≤ V →\n              Antitone h →\n                h 0 = impact →\n                  (CurrentMM.robustNonnegativeSequenceMargin B P impact fee margin V h ↔\n                    V ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (fee + margin * P) B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.partial_last_fill_quantity_bound","type":"∀ {n : ℕ} (v : Fin (n + 1) → ℝ) (fraction : ℝ),\n  (∀ (i : Fin (n + 1)), 0 ≤ v i) →\n    0 ≤ fraction ∧ fraction ≤ 1 →\n      (∀ (i : Fin (n + 1)), 0 ≤ CurrentMM.partialLastFill v fraction i) ∧\n        CurrentMM.cumulativeQuantity (CurrentMM.partialLastFill v fraction) ≤ CurrentMM.cumulativeQuantity v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.intermediate_linear_fill_margin","type":"∀ {n : ℕ} (B P impact fee margin V : ℝ) (h : ℕ → ℝ) (v : Fin (n + 1) → ℝ) (fraction : ℝ),\n  (∀ (i : Fin (n + 1)), 0 ≤ v i) →\n    0 ≤ fraction ∧ fraction ≤ 1 →\n      0 ≤ impact →\n        0 ≤ P →\n          0 ≤ fee →\n            0 ≤ margin →\n              Antitone h →\n                h 0 = impact →\n                  CurrentMM.cumulativeQuantity v ≤ V →\n                    (margin + 1 / 2) * impact * V ^ 2 + (fee + margin * P) * V ≤ B →\n                      margin * |(-CurrentMM.cumulativeQuantity (CurrentMM.partialLastFill v fraction))| *\n                          (P + CurrentMM.sequenceFinalDisplacement h (CurrentMM.partialLastFill v fraction)) ≤\n                        CurrentMM.sequenceDealerEquity B P impact fee h (CurrentMM.partialLastFill v fraction)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.arbitrary_signed_sequence_margin_certificate","type":"∀ (K0 M_maint G_max V c_fee adverse_mark E_final : ℝ),\n  0 ≤ V →\n    0 ≤ G_max →\n      0 ≤ c_fee →\n        adverse_mark ≤ 2 * G_max * V ^ 2 →\n          K0 - adverse_mark - c_fee * V ≤ E_final → 2 * G_max * V ^ 2 + c_fee * V + M_maint ≤ K0 → M_maint ≤ E_final"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.perpetual_funding_and_liquidation_penalty_margin_certificate","type":"∀ (K0 M_maint L_pen D_max c_fee f_max V F_fund E_perp : ℝ),\n  0 ≤ V →\n    0 ≤ f_max →\n      0 ≤ L_pen →\n        |F_fund| ≤ f_max * V →\n          K0 - D_max - c_fee * V - |F_fund| ≤ E_perp →\n            D_max + (c_fee + f_max) * V + L_pen + M_maint ≤ K0 → M_maint + L_pen ≤ E_perp"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.capital_lower_bound_of_information_ratio","type":"∀ {info loss rho c : ℝ}, 0 < rho → info ≤ rho * loss → c ≤ info → c / rho ≤ loss"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.expected_loss_lower_bound_of_information_ratio","type":"∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {X Y : Ω → ℝ} {rho c : ℝ},\n  0 < rho →\n    MeasureTheory.Integrable X μ →\n      MeasureTheory.Integrable Y μ →\n        (∀ᵐ (ω : Ω) ∂μ, X ω ≤ rho * Y ω) → c ≤ ∫ (ω : Ω), X ω ∂μ → c / rho ≤ ∫ (ω : Ω), Y ω ∂μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.sq_sum_le_cap_mul_abs_sum","type":"∀ {n : ℕ} (v : Fin n → ℝ) {V : ℝ}, (∀ (i : Fin n), |v i| ≤ V) → ∑ i, v i ^ 2 ≤ V * ∑ i, |v i|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.rayleigh_holder_total_loss_lower_bound","type":"∀ {c lam_max loss_quad c_fee l1_min l1_norm : ℝ},\n  0 < lam_max →\n    c ≤ lam_max * loss_quad → 0 ≤ c_fee → l1_min ≤ l1_norm → c / lam_max + c_fee * l1_min ≤ loss_quad + c_fee * l1_norm"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.lecam_two_point_moment_matched_cubic_gap","type":"∀ (q tau eta_bar d_eta : ℝ),\n  q ≠ 0 →\n    have p_minus := 1 / 2 - tau / q;\n    have p_plus := 1 / 2 + tau / q;\n    have w0_1 := q * p_minus;\n    have w0_2 := q * p_plus;\n    have eta0_1 := eta_bar - p_plus * d_eta;\n    have eta0_2 := eta_bar + p_minus * d_eta;\n    have w1_1 := q * p_plus;\n    have w1_2 := q * p_minus;\n    have eta1_1 := eta_bar - p_minus * d_eta;\n    have eta1_2 := eta_bar + p_plus * d_eta;\n    w1_1 * eta1_1 + w1_2 * eta1_2 - (w0_1 * eta0_1 + w0_2 * eta0_2) = 0 ∧\n      w1_1 * eta1_1 ^ 2 + w1_2 * eta1_2 ^ 2 - (w0_1 * eta0_1 ^ 2 + w0_2 * eta0_2 ^ 2) = 0 ∧\n        w1_1 * eta1_1 ^ 3 + w1_2 * eta1_2 ^ 3 - (w0_1 * eta0_1 ^ 3 + w0_2 * eta0_2 ^ 3) =\n          4 * tau * p_minus * p_plus * d_eta ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.kreiss_resolvent_guard_solvency_invariance","type":"∀ {alpha gain_MC u_norm reserve B_maint drawdown : ℝ},\n  0 < reserve → drawdown ≤ alpha * gain_MC * u_norm → alpha * gain_MC * u_norm + reserve ≤ B_maint → drawdown < B_maint"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.coordinate_weighted_output_cone_contraction","type":"∀ (w1 w2 : ℝ),\n  0 ≤ w1 →\n    w1 ≤ 2 / 3 * w2 →\n      have w1' := 1 / 2 * w1 + 3 / 20 * w2;\n      have w2' := 4 / 25 * w1 + 187 / 250 * w2;\n      0 ≤ w1' ∧ w1' ≤ 2 / 3 * w2' ∧ w1' ^ 2 + w2' ^ 2 ≤ w1 ^ 2 + w2 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.coordinate_weighted_output_initial_peak","type":"1 ≤ 2 / 3 * 160 ∧\n  1 ^ 2 + 160 ^ 2 = 25601 ∧\n    1 / 2 * 1 + 3 / 20 * 160 = 49 / 2 ∧\n      4 / 25 * 1 + 187 / 250 * 160 = 2996 / 25 ∧ (49 / 2) ^ 2 + (2996 / 25) ^ 2 < 1 ^ 2 + 160 ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.adaptive_to_deterministic_ratio_lower_bound","type":"∀ (C_adapt_lb E_C_adapt C_det_star C_det_ub : ℝ),\n  0 < C_det_star →\n    0 ≤ C_adapt_lb → C_adapt_lb ≤ E_C_adapt → C_det_star ≤ C_det_ub → C_adapt_lb / C_det_ub ≤ E_C_adapt / C_det_star"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.zero_padding_preserves_flat_and_cost","type":"∀ {L K : ℕ} (v : Fin L → ℝ) (quad_cost : ℝ),\n  ∑ i, v i + ∑ _j, 0 = ∑ i, v i ∧ ∑ i, |v i| + ∑ _j, |0| = ∑ i, |v i| ∧ quad_cost + 0 = quad_cost"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.min_capital_horizon_monotone","type":"∀ (C_star_L1 C_star_L2 C_padded : ℝ), C_padded = C_star_L1 → C_star_L2 ≤ C_padded → C_star_L2 ≤ C_star_L1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.dominant_mode_radius_sq_lower_bound","type":"∀ (r1_sq d2 gamma_max : ℝ), 0 ≤ r1_sq → 0 ≤ d2 → 0 ≤ gamma_max → 1 ≤ r1_sq + gamma_max * d2 → 1 - gamma_max * d2 ≤ r1_sq"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.analytical_quadratic_linear_envelope_bound","type":"∀ (sqrt_d2 W_perp : ℝ), -(W_perp ^ 2 / 4) ≤ sqrt_d2 ^ 2 - W_perp * sqrt_d2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.rayleigh_holder_closed_form_analytic_lower_bound","type":"∀ (L0_min d2_sqrt F_dom_min r1 W_perp_max loss_total : ℝ),\n  L0_min + d2_sqrt ^ 2 + F_dom_min * r1 - W_perp_max * d2_sqrt ≤ loss_total →\n    L0_min + F_dom_min * r1 - W_perp_max ^ 2 / 4 ≤ loss_total"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.rayleigh_holder_2d_box_lower_bound","type":"∀ (L0_min d1 d1_lo d2 d2_lo d2_hi_sqrt F_dom_min r1_lo W_perp_max loss_total : ℝ),\n  d1_lo ≤ d1 →\n    d2_lo ≤ d2 →\n      0 ≤ d2_hi_sqrt →\n        0 ≤ F_dom_min →\n          0 ≤ r1_lo →\n            0 ≤ W_perp_max →\n              L0_min + d1 + d2 + F_dom_min * r1_lo - W_perp_max * d2_hi_sqrt ≤ loss_total →\n                L0_min + d1_lo + d2_lo + F_dom_min * r1_lo - W_perp_max * d2_hi_sqrt ≤ loss_total"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.lecam_rate_admissibility_iff","type":"∀ (eta_bar p_minus p_plus d_eta : ℝ),\n  0 < p_plus →\n    0 < p_minus →\n      p_minus ≤ p_plus →\n        0 < d_eta →\n          (0 < eta_bar - p_plus * d_eta ∧ eta_bar + p_plus * d_eta < 1 ↔\n            d_eta < eta_bar / p_plus ∧ d_eta < (1 - eta_bar) / p_plus)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.lecam_two_point_tv_minimax_lower_bound","type":"∀ (p_succ_0 p_succ_1 p_fail_0 p_fail_1 tv : ℝ),\n  p_succ_0 + p_fail_0 = 1 →\n    p_succ_1 + p_fail_1 = 1 → p_succ_0 + p_succ_1 ≤ 1 + tv → (1 - tv) / 2 ≤ max p_fail_0 p_fail_1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.moment_estimator_cubic_inversion_stability","type":"∀ (tau_hat tau_true M3_hat M3_true p_minus p_plus d_eta eps : ℝ),\n  0 < 2 * p_minus * p_plus * d_eta ^ 3 →\n    M3_hat - M3_true = 2 * p_minus * p_plus * d_eta ^ 3 * (tau_hat - tau_true) →\n      |M3_hat - M3_true| ≤ eps → |tau_hat - tau_true| ≤ eps / (2 * p_minus * p_plus * d_eta ^ 3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.dealer_step_equity_update","type":"∀ (K_t I_t p_t dp C_hedge : ℝ),\n  have E_t := K_t + I_t * p_t;\n  have K_next := K_t - C_hedge;\n  have p_next := p_t + dp;\n  have E_next := K_next + I_t * p_next;\n  E_next = E_t + I_t * dp - C_hedge"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.resolvent_guard_norm_ball_sufficiency","type":"∀ (E_t MM_t abs_I dp_bound C_hedge R_safe I_dp E_next MM_next : ℝ),\n  0 < R_safe →\n    |I_dp| ≤ abs_I * dp_bound →\n      MM_next ≤ MM_t + 5e-3 * abs_I * dp_bound →\n        abs_I * (1 + 5e-3) * dp_bound + C_hedge + R_safe ≤ E_t - MM_t → E_next = E_t + I_dp - C_hedge → MM_next < E_next"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.signed_shock_counterexample_ce15_theorem","type":"have I0 := -2000;\nhave P0 := 100;\nhave E0 := 10000;\nhave K0 := E0 - I0 * P0;\nhave dp_fav := -10;\nhave E1_fav := K0 + I0 * (P0 + dp_fav);\nhave MM1_fav := 5e-3 * -I0 * (P0 + dp_fav) - 50;\nhave dp_adv := 10;\nhave E1_adv := K0 + I0 * (P0 + dp_adv);\nhave MM1_adv := 5e-3 * -I0 * (P0 + dp_adv) - 50;\n|dp_fav| = 10 ∧\n  |dp_adv| = 10 ∧\n    E1_fav = 30000 ∧ MM1_fav = 850 ∧ MM1_fav < E1_fav ∧ E1_adv = -10000 ∧ MM1_adv = 1050 ∧ E1_adv < MM1_adv"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.resolvent_guard_multistep_recursive_solvency","type":"∀ (T : ℕ) (E MM : ℕ → ℝ), MM 0 < E 0 → (∀ t < T, MM t < E t → MM (t + 1) < E (t + 1)) → ∀ t ≤ T, MM t < E t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.parseval_toep_quadratic_ratio_bound","type":"∀ {N : ℕ} (n_weight d_weight x_sq : Fin N → ℝ) (rho_max sigma_sq kl_req : ℝ),\n  0 < rho_max →\n    0 < sigma_sq →\n      (∀ (k : Fin N), 0 ≤ x_sq k) →\n        (∀ (k : Fin N), n_weight k ≤ rho_max * d_weight k) →\n          2 * sigma_sq * kl_req ≤ ∑ k, n_weight k * x_sq k →\n            sigma_sq * kl_req / rho_max ≤ 1 / 2 * ∑ k, d_weight k * x_sq k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.wald_sequential_kl_chain_rule_capital_bound","type":"∀ {T : ℕ} (E_kl_step E_loss_step : Fin T → ℝ) (rho_max kl_req : ℝ),\n  0 < rho_max →\n    (∀ (t : Fin T), E_kl_step t ≤ rho_max * E_loss_step t) →\n      kl_req ≤ ∑ t, E_kl_step t → kl_req / rho_max ≤ ∑ t, E_loss_step t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.flat_round_trip_double_entry_terminal_loss_identity","type":"∀ {L : ℕ} (v d : Fin L → ℝ) (P_star c_fee : ℝ),\n  ∑ t, v t = 0 → ∑ t, (v t * (P_star + d t) + c_fee * |v t|) = ∑ t, v t * d t + c_fee * ∑ t, |v t|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.numerical_certificate_64_74_rational_enclosure","type":"∀ {L : ℕ} (v : Fin L → ℝ) (Q_0 Q_1 S_req gamma mu c_fee : ℝ),\n  0 < gamma →\n    0 ≤ mu →\n      mu ≤ 1 →\n        1 / gamma ≤ c_fee →\n          S_req - gamma * ∑ t, |v t| ≤ gamma ^ 2 * ((1 - mu) * Q_0 + mu * Q_1) →\n            have C_0grid := 639206 / 10000;\n            have C_d2_analytic := 647383 / 10000;\n            have C_interval_cert := 647423 / 10000;\n            have C_feasible_ub := 653827 / 10000;\n            S_req / gamma ^ 2 ≤ max (Q_0 + c_fee * ∑ t, |v t|) (Q_1 + c_fee * ∑ t, |v t|) ∧\n              C_0grid < C_d2_analytic ∧\n                C_d2_analytic < C_interval_cert ∧\n                  C_interval_cert < C_feasible_ub ∧ C_feasible_ub - C_interval_cert = 6404 / 10000"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.subgaussian_martingale_drawdown_and_cvar_bound","type":"∀ (Q_drift V_proxy z_delta tail_slack : ℝ),\n  0 ≤ Q_drift →\n    0 ≤ V_proxy →\n      0 ≤ z_delta →\n        0 ≤ tail_slack →\n          have D_vaR := Q_drift + √(2 * V_proxy * z_delta);\n          have D_cvaR := Q_drift + √(2 * V_proxy * (z_delta + tail_slack));\n          Q_drift ≤ D_vaR ∧ D_vaR ≤ D_cvaR"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.cramer_rao_two_cohort_inverse_sixth_scaling","type":"∀ (sigma_h c_J C_J d_eta J_norm : ℝ),\n  0 < sigma_h →\n    0 < c_J →\n      0 < d_eta →\n        c_J * d_eta ^ 3 ≤ J_norm →\n          J_norm ≤ C_J * d_eta ^ 3 →\n            have V_crb := sigma_h ^ 2 / J_norm ^ 2;\n            sigma_h ^ 2 / (C_J ^ 2 * d_eta ^ 6) ≤ V_crb ∧ V_crb ≤ sigma_h ^ 2 / (c_J ^ 2 * d_eta ^ 6)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.minimax_sample_complexity_theta_d_eta_minus_six","type":"∀ (eta_bar d_eta K_lecam K_upper : ℝ),\n  0 < d_eta →\n    0 < K_lecam →\n      K_lecam ≤ K_upper →\n        have q := 1 / 5;\n        have p_minus := 9 / 20;\n        have p_plus := 11 / 20;\n        have delta_M3 :=\n          q * p_plus * (eta_bar - p_minus * d_eta) ^ 3 + q * p_minus * (eta_bar + p_plus * d_eta) ^ 3 -\n            (q * p_minus * (eta_bar - p_plus * d_eta) ^ 3 + q * p_plus * (eta_bar + p_minus * d_eta) ^ 3);\n        have c_low := K_lecam / (99 / 10000) ^ 2;\n        have c_up := K_upper / (99 / 10000) ^ 2;\n        have N_lecam := K_lecam / delta_M3 ^ 2;\n        have N_upper := K_upper / delta_M3 ^ 2;\n        delta_M3 = 99 / 10000 * d_eta ^ 3 ∧\n          N_lecam = c_low / d_eta ^ 6 ∧ N_upper = c_up / d_eta ^ 6 ∧ 0 < N_lecam ∧ N_lecam ≤ N_upper"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.resolvent_guard_cumulative_positive_at_zero_alpha","type":"∀ (abs_I_next mu s_zero G_cum_zero u_bar_cum state_transient C_hedge R_safe B_rem : ℝ),\n  0 < abs_I_next →\n    0 ≤ mu →\n      0 < s_zero →\n        1 ≤ G_cum_zero →\n          0 < u_bar_cum →\n            0 ≤ state_transient →\n              0 < R_safe →\n                abs_I_next * (1 + mu) * (state_transient + s_zero * G_cum_zero * u_bar_cum) + C_hedge + R_safe ≤ B_rem →\n                  0 < abs_I_next * (1 + mu) * (s_zero * G_cum_zero * u_bar_cum) ∧\n                    abs_I_next * (1 + mu) * (state_transient + s_zero * G_cum_zero * u_bar_cum) + C_hedge < B_rem"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.resolvent_guard_maintenance_margin_tier2_consistency","type":"∀ (d : ℝ),\n  have abs_I := 2000;\n  have mu := 5 / 1000;\n  have E0 := 10000;\n  have MM0 := 950;\n  have R_safe := 950;\n  have B_rem0 := E0 - MM0;\n  have u_adm_safe := (B_rem0 - R_safe) / (abs_I * (1 + mu));\n  u_adm_safe = 270 / 67 ∧\n    (abs_I * (1 + mu) * d + R_safe ≤ B_rem0 ↔ d ≤ u_adm_safe) ∧\n      ¬abs_I * (1 + mu) * (81 / 20) + R_safe ≤ B_rem0 ∧\n        (d ≤ u_adm_safe → E0 - abs_I * d - (MM0 + mu * abs_I * d) ≥ R_safe)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.non_anticipative_guard_action_invariance","type":"∀ {State : Type u_1} (guardPolicy : State → ℝ → ℝ) (s : State) (u_bar_step u_1 u_2 : ℝ),\n  have alpha_1 := guardPolicy s u_bar_step;\n  have alpha_2 := guardPolicy s u_bar_step;\n  (u_1 ≠ u_2 → alpha_1 = alpha_2) ∧ alpha_1 = alpha_2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.resolvent_guard_post_hedge_and_fill_margin_accounting","type":"∀\n  (abs_I_next mu state_transient mc_val G_cum s_alpha u_bar_step u_bar_cum C_hedge R_safe B_rem fill_qty half_spread\n    p_mid : ℝ),\n  0 ≤ abs_I_next →\n    0 ≤ mu →\n      0 ≤ s_alpha →\n        0 ≤ mc_val →\n          mc_val ≤ G_cum →\n            0 ≤ u_bar_step →\n              u_bar_step ≤ u_bar_cum →\n                0 ≤ fill_qty →\n                  half_spread ≤ mu * p_mid →\n                    (abs_I_next + fill_qty) * (1 + mu) * (state_transient + s_alpha * G_cum * u_bar_cum) + C_hedge +\n                            (mu * p_mid - half_spread) * fill_qty +\n                          R_safe ≤\n                        B_rem →\n                      have abs_I_post_fill := abs_I_next + fill_qty;\n                      have C_fill := (mu * p_mid - half_spread) * fill_qty;\n                      0 ≤ C_fill ∧\n                        5 / 1000 * 100 - 2 / 100 = 48 / 100 ∧\n                          abs_I_post_fill * (1 + mu) * (state_transient + mc_val * s_alpha * u_bar_step) + C_hedge +\n                                  C_fill +\n                                R_safe ≤\n                              B_rem ∧\n                            R_safe ≤\n                              B_rem -\n                                (abs_I_post_fill * (1 + mu) * (state_transient + mc_val * s_alpha * u_bar_step) +\n                                    C_hedge +\n                                  C_fill)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.prony_blind_four_moment_uniform_upper_bound","type":"∀ (w_1 w_2 eta_1 eta_2 w_min eta_min eps_h op_norm eps_M p_minus p_plus d_eta w_err_bound : ℝ),\n  w_min ≤ w_1 →\n    w_min ≤ w_2 →\n      0 < w_min →\n        eta_min ≤ eta_1 →\n          eta_min ≤ eta_2 →\n            0 < eta_min →\n              eta_2 - eta_1 = d_eta →\n                0 ≤ op_norm →\n                  eps_M ≤ op_norm * eps_h →\n                    0 < p_minus →\n                      0 < p_plus →\n                        0 < d_eta →\n                          w_err_bound = eps_M / (2 * p_minus * p_plus * d_eta ^ 3) →\n                            have g_1 := w_1 * eta_1 + w_2 * eta_2;\n                            have g_2 := w_1 * eta_1 * (1 - eta_1) + w_2 * eta_2 * (1 - eta_2);\n                            have g_3 := w_1 * eta_1 * (1 - eta_1) ^ 2 + w_2 * eta_2 * (1 - eta_2) ^ 2;\n                            have det_H0 := g_1 * g_3 - g_2 ^ 2;\n                            det_H0 = w_1 * w_2 * eta_1 * eta_2 * d_eta ^ 2 ∧\n                              w_min ^ 2 * eta_min ^ 2 * d_eta ^ 2 ≤ det_H0 ∧\n                                0 < det_H0 ∧ w_err_bound ≤ op_norm * eps_h / (2 * p_minus * p_plus * d_eta ^ 3)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.cramer_rao_two_cohort_confluent_vandermonde_exact_bound","type":"∀ (w_1 w_2 eta_1 eta_2 d_eta sigma_h : ℝ),\n  eta_2 - eta_1 = d_eta →\n    0 < d_eta →\n      0 < sigma_h →\n        have u_0 := eta_2 ^ 2 * (eta_2 - 3 * eta_1);\n        have u_1 := 6 * eta_1 * eta_2;\n        have u_2 := -3 * (eta_1 + eta_2);\n        have u_3 := 2;\n        have col_w1 := u_0 * 1 + u_1 * eta_1 + u_2 * eta_1 ^ 2 + u_3 * eta_1 ^ 3;\n        have col_w2 := u_0 * 1 + u_1 * eta_2 + u_2 * eta_2 ^ 2 + u_3 * eta_2 ^ 3;\n        have col_eta1 := w_1 * (u_1 * 1 + u_2 * (2 * eta_1) + u_3 * (3 * eta_1 ^ 2));\n        have col_eta2 := w_2 * (u_1 * 1 + u_2 * (2 * eta_2) + u_3 * (3 * eta_2 ^ 2));\n        have row_norm_sq := (u_0 ^ 2 + u_1 ^ 2 + u_2 ^ 2 + u_3 ^ 2) / d_eta ^ 6;\n        have V_crb_w1 := sigma_h ^ 2 * row_norm_sq;\n        col_w1 = d_eta ^ 3 ∧ col_w2 = 0 ∧ col_eta1 = 0 ∧ col_eta2 = 0 ∧ 4 * sigma_h ^ 2 / d_eta ^ 6 ≤ V_crb_w1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.prony_four_moment_confluent_vandermonde_and_toeplitz_deconv_bound","type":"∀ (w_1 w_2 eta_1 eta_2 d_eta dM_0 dM_1 dM_2 dM_3 eps_M kappa H du_1 du_2 h_1 eps_u : ℝ),\n  eta_2 - eta_1 = d_eta →\n    0 < d_eta →\n      0 ≤ eta_1 →\n        eta_1 ≤ 1 →\n          0 ≤ eta_2 →\n            eta_2 ≤ 1 →\n              |dM_0| ≤ eps_M →\n                |dM_1| ≤ eps_M →\n                  |dM_2| ≤ eps_M →\n                    |dM_3| ≤ eps_M →\n                      0 < kappa →\n                        |h_1| ≤ H →\n                          |du_1| ≤ eps_u →\n                            |du_2| ≤ eps_u →\n                              have M_0 := w_1 + w_2;\n                              have M_1 := w_1 * eta_1 + w_2 * eta_2;\n                              have M_2 := w_1 * eta_1 ^ 2 + w_2 * eta_2 ^ 2;\n                              have M_3 := w_1 * eta_1 ^ 3 + w_2 * eta_2 ^ 3;\n                              have u_0 := eta_2 ^ 2 * (eta_2 - 3 * eta_1);\n                              have u_1 := 6 * eta_1 * eta_2;\n                              have u_2 := -3 * (eta_1 + eta_2);\n                              have u_3 := 2;\n                              have w1_rec := (u_0 * M_0 + u_1 * M_1 + u_2 * M_2 + u_3 * M_3) / d_eta ^ 3;\n                              have dw_1 := (u_0 * dM_0 + u_1 * dM_1 + u_2 * dM_2 + u_3 * dM_3) / d_eta ^ 3;\n                              have dg_1 := du_1 / kappa;\n                              have dg_2 := (du_2 - h_1 * dg_1) / kappa;\n                              u_0 * M_0 + u_1 * M_1 + u_2 * M_2 + u_3 * M_3 = d_eta ^ 3 * w_1 ∧\n                                w1_rec = w_1 ∧\n                                  |dw_1| ≤ 16 * eps_M / d_eta ^ 3 ∧\n                                    |dg_1| ≤ eps_u / kappa ∧ |dg_2| ≤ (kappa + H) * eps_u / kappa ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.worst_interval_955_two_slab_rational_certificate","type":"have L0_lo := 6254949437 / 100000000;\nhave F_lo := 224048596 / 100000000;\nhave W_hi := 37247202 / 100000000;\nhave g_hi := 23283937 / 100000000;\nhave u_mid := 9 / 100;\nhave u_top := 295050563 / 100000000;\nhave fm_lo := 9894667537 / 10000000000;\nhave fm_hi := 9894667538 / 10000000000;\nhave ft_lo := 5594695058 / 10000000000;\nhave a1_lo := (1 - fm_lo) / u_mid;\nhave a1_hi := (1 - fm_lo) / u_mid;\nhave slab1_lb := L0_lo + F_lo * fm_lo + F_lo * a1_lo * u_mid - W_hi ^ 2 / (4 * (1 - F_lo * a1_hi));\nhave a2_lo := (fm_lo - ft_lo) / (u_top - u_mid);\nhave a2_hi := (fm_hi - ft_lo) / (u_top - u_mid);\nhave slab2_lb := L0_lo + F_lo * ft_lo + F_lo * a2_lo * u_top - W_hi ^ 2 / (4 * (1 - F_lo * a2_hi));\ng_hi * u_top < 99 / 100 ∧\n  fm_lo ^ 2 ≤ 1 - g_hi * u_mid ∧\n    1 - g_hi * u_mid ≤ fm_hi ^ 2 ∧\n      ft_lo ^ 2 ≤ 1 - g_hi * u_top ∧\n        647429 / 10000 < slab1_lb ∧ 647429 / 10000 < slab2_lb ∧ 647423 / 10000 < min slab1_lb slab2_lb"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.nonnormal_jordan_kreiss_bilateral_bound","type":"∀ (lam beta : ℝ) (t : ℕ),\n  0 < lam →\n    lam < 1 →\n      0 < beta →\n        have z_star := 2 - lam;\n        have K_res_witness := (z_star - 1) * beta / (z_star - lam) ^ 2;\n        have j_pow_scaled := ↑t * lam ^ t * beta;\n        1 < z_star ∧\n          K_res_witness = beta / (4 * (1 - lam)) ∧\n            0 < K_res_witness ∧ ((1 - lam) * ↑t + 1) * lam ^ t ≤ 1 ∧ j_pow_scaled ≤ 4 * K_res_witness"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.diagonal_minus_rank_one_posDef","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (d u : ι → ℝ),\n  (∀ (i : ι), 0 < d i) → ∑ i, u i ^ 2 / d i < 1 → (Matrix.diagonal d - Matrix.vecMulVec u u).PosDef"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_matrix_positive","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  (∀ (i : Fin n), rate i ≤ 1) → (CurrentMM.cohortSpectralMatrix a impact q rate).PosSemidef"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_matrix_gap","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i) →\n          a + impact * ∑ i, q i < 1 → (1 - CurrentMM.cohortSpectralMatrix a impact q rate).PosDef"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_weighted_dot","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (z : Option (Fin n) → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i) →\n          ∑ i,\n              CurrentMM.cohortSpectralVector a impact q rate i *\n                (CurrentMM.cohortSpectralScale a impact q rate i * z i) =\n            a * z none + impact * ∑ j, q j * z (some j)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_cohort_symmetric_intertwining","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (z : Option (Fin n) → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i) →\n          (fun i =>\n              CurrentMM.cohortSpectralScale a impact q rate i *\n                (CurrentMM.cohortLinearTransition a impact q rate) z i) =\n            (CurrentMM.cohortSpectralMatrix a impact q rate).mulVec fun i =>\n              CurrentMM.cohortSpectralScale a impact q rate i * z i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_input_vector","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  (fun i => CurrentMM.cohortSpectralScale a impact q rate i * CurrentMM.cohortInputVector impact rate i) =\n    impact • CurrentMM.cohortSpectralVector a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_first_column","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  (CurrentMM.cohortSpectralMatrix a impact q rate).mulVec (Pi.single none 1) =\n    √a • CurrentMM.cohortSpectralVector a impact q rate"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_spectral_powers_intertwining","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (z : Option (Fin n) → ℝ) (t : ℕ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i) →\n          (fun i =>\n              CurrentMM.cohortSpectralScale a impact q rate i *\n                (CurrentMM.cohortLinearTransition a impact q rate ^ t) z i) =\n            (CurrentMM.cohortSpectralMatrix a impact q rate ^ t).mulVec fun i =>\n              CurrentMM.cohortSpectralScale a impact q rate i * z i"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.hermitian_diagonal_power","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ) (hA : A.IsHermitian) (j : ι) (t : ℕ),\n  (A ^ t) j j = ∑ i, ↑hA.eigenvectorUnitary j i ^ 2 * hA.eigenvalues i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_matrix_eigenvalues_below_one","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ) (hA : A.PosSemidef),\n  (1 - A).PosDef → ∀ (i : ι), 0 ≤ ⋯.eigenvalues i ∧ ⋯.eigenvalues i < 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_impulse_moment","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (t : ℕ),\n  0 < a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i) →\n          CurrentMM.actualCohortImpulse a impact q rate t =\n            impact / a * (CurrentMM.cohortSpectralMatrix a impact q rate ^ (t + 1)) none none"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_impulse_mixture","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 < a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ lambda weights,\n              (∀ (i : Option (Fin n)), 0 ≤ lambda i ∧ lambda i < 1) ∧\n                (∀ (i : Option (Fin n)), 0 ≤ weights i) ∧\n                  ∑ i, weights i = impact ∧\n                    ∀ (t : ℕ), CurrentMM.actualCohortImpulse a impact q rate t = ∑ i, weights i * lambda i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_impulse_antitone","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 < a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 → Antitone (CurrentMM.actualCohortImpulse a impact q rate)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_impulse_continuous_in_anchor","type":"∀ {n : ℕ} (impact : ℝ) (q rate : Fin n → ℝ) (t : ℕ), Continuous fun a => CurrentMM.actualCohortImpulse a impact q rate t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_nonnegative_anchor_impulse_antitone","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 → Antitone (CurrentMM.actualCohortImpulse a impact q rate)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.physical_cohort_robust_quantity_allowance","type":"∀ {n : ℕ} (a B P impact fee margin V : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 < impact →\n      0 < P →\n        0 ≤ fee →\n          0 < margin →\n            0 < B →\n              0 ≤ V →\n                (∀ (i : Fin n), 0 ≤ q i) →\n                  (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n                    a + impact * ∑ i, q i < 1 →\n                      (CurrentMM.robustNonnegativeSequenceMargin B P impact fee margin V\n                          (CurrentMM.actualCohortImpulse a impact q rate) ↔\n                        V ≤ CurrentMM.robustQuantityCap ((margin + 1 / 2) * impact) (fee + margin * P) B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_execution_coercive","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 < a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ radius,\n              (0 ≤ radius ∧ radius < 1) ∧\n                ∀ (T : ℕ) (v : Fin T → ℝ),\n                  impact * ((1 - radius) / (1 + radius)) / 2 * CurrentMM.probeEnergy v ≤\n                    CurrentMM.quadraticExecutionCost (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_execution_cost_positive","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  0 < a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            (v ≠ fun x => 0) → 0 < CurrentMM.quadraticExecutionCost (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_trader_energy_bound","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 < a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ radius,\n              (0 ≤ radius ∧ radius < 1) ∧\n                ∀ (T : ℕ) (v : Fin T → ℝ) (B P fee : ℝ),\n                  0 ≤ fee →\n                    0 ≤\n                        CurrentMM.equity\n                          (CurrentMM.traderCashAfter B P impact fee (CurrentMM.actualCohortImpulse a impact q rate) v)\n                          (∑ i, v i) P →\n                      CurrentMM.probeEnergy v ≤ 2 * B / (impact * ((1 - radius) / (1 + radius)))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_positive_anchor_impulse_dissipates","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 < a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            Filter.Tendsto (CurrentMM.actualCohortImpulse a impact q rate) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.inventory_single_lag_reduction","type":"∀ (φ ψ q y_t I_prev u_t : ℝ),\n  I_prev * φ + u_t = φ * I_prev + u_t → u_t = q * y_t - ψ * I_prev → φ * I_prev + u_t = (φ - ψ) * I_prev + q * y_t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.stock_flow_two_root_bridge","type":"∀ (ρ_inv r q η x_t y_t y_prev I_t I_prev I_prev2 : ℝ),\n  I_t = ρ_inv * I_prev + q * y_t →\n    I_prev = ρ_inv * I_prev2 + q * y_prev →\n      y_t = r * y_prev + η * x_t → I_t - (ρ_inv + r) * I_prev + ρ_inv * r * I_prev2 = q * η * x_t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.stock_flow_unit_turnover_limit","type":"∀ (r q η x_t y_t y_prev I_t I_prev I_prev2 : ℝ),\n  I_t = 1 * I_prev + q * y_t →\n    I_prev = 1 * I_prev2 + q * y_prev → y_t = r * y_prev + η * x_t → I_t - I_prev - r * (I_prev - I_prev2) = q * η * x_t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.baseline_demeaning_eliminates_pstar","type":"∀ (p_star x_t ν_t ν_0 : ℝ), p_star + x_t + ν_t - (p_star + ν_0) = x_t + (ν_t - ν_0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.plugin_deconv_k0_identity","type":"∀ (h1_hat a a_hat κ κ_hat : ℝ),\n  κ ≠ 0 →\n    κ_hat ≠ 0 →\n      (h1_hat - a_hat * κ_hat) / κ_hat ^ 2 - (h1_hat - a * κ) / κ ^ 2 =\n        (h1_hat * (κ + κ_hat) * (κ - κ_hat) - (a_hat - a) * κ_hat * κ ^ 2 - a * κ * κ_hat * (κ - κ_hat)) /\n          (κ ^ 2 * κ_hat ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.plugin_prony_rate_preservation","type":"∀ (k_plug k_known k_true a a_hat κ κ_hat w_hat w_true L_h L_a L_κ C_a C_κ norm_C scale_inv L_inv δ_N : ℝ),\n  0 ≤ norm_C →\n    0 ≤ scale_inv →\n      0 ≤ L_inv →\n        0 ≤ L_a →\n          0 ≤ L_κ →\n            |k_known - k_true| ≤ L_h * δ_N →\n              |k_plug - k_known| ≤ L_a * |a_hat - a| + L_κ * |κ_hat - κ| →\n                |a_hat - a| ≤ C_a * δ_N →\n                  |κ_hat - κ| ≤ C_κ * δ_N →\n                    |w_hat - w_true| ≤ L_inv * (norm_C * scale_inv * |k_plug - k_true|) →\n                      |w_hat - w_true| ≤ L_inv * norm_C * (L_h + L_a * C_a + L_κ * C_κ) * (δ_N * scale_inv)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_throttle_fixed_point_exists","type":"∀ (g : ℝ → ℝ),\n  Continuous g →\n    (∀ (m : ℝ), 0 ≤ g m) → (∀ (m : ℝ), g m ≤ 1) → ∀ (a κ Q : ℝ), ∃ α ∈ Set.Icc 0 1, α = g (1 - a - κ * α * Q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_throttle_fixed_point_unique","type":"∀ (g : ℝ → ℝ),\n  Monotone g →\n    ∀ (a κ Q : ℝ), 0 ≤ κ * Q → ∀ (α₁ α₂ : ℝ), α₁ = g (1 - a - κ * α₁ * Q) → α₂ = g (1 - a - κ * α₂ * Q) → α₁ = α₂"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_throttle_safe","type":"∀ (g : ℝ → ℝ) (Mmin : ℝ), (∀ m ≤ Mmin, g m = 0) → ∀ (α M : ℝ), α = g M → 0 < α → Mmin < M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_throttle_margin_floor","type":"∀ (g : ℝ → ℝ) (Mmin : ℝ),\n  (∀ m ≤ Mmin, g m = 0) →\n    (∀ (m : ℝ), 0 ≤ g m) → ∀ (a κ Q α : ℝ), α = g (1 - a - κ * α * Q) → min Mmin (1 - a) ≤ 1 - a - κ * α * Q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_throttle_cap","type":"∀ (g : ℝ → ℝ) (Mmin : ℝ),\n  (∀ m ≤ Mmin, g m = 0) → ∀ (a κ Q α : ℝ), α = g (1 - a - κ * α * Q) → 0 < α → κ * α * Q < 1 - a - Mmin"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_drift_sum_succ","type":"∀ (W : ℕ), ∑ j ∈ Finset.range W, (↑j + 1) = ↑W * (↑W + 1) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_drift_bias","type":"∀ (W : ℕ),\n  0 < W →\n    ∀ (d MT : ℝ) (m : ℕ → ℝ),\n      (∀ (j : ℕ), |m j - MT| ≤ d * (↑j + 1)) → |(∑ j ∈ Finset.range W, m j) / ↑W - MT| ≤ d * (↑W + 1) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_drift_amgm","type":"∀ (a b c : ℝ), 0 ≤ a → 0 ≤ b → 0 ≤ c → 27 * a * b * c ≤ (a + b + c) ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_drift_window","type":"∀ (d q u : ℝ), 0 < d → 0 < q → 0 < u → 27 * d * q ^ 2 ≤ (d * u ^ 2 + 2 * q / u) ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_drift_squares","type":"∀ (c : ℝ) (k : ℕ), ∑ j ∈ Finset.range k, (c * (↑j + 1)) ^ 2 ≤ c ^ 2 * ↑k ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_hidden_cs","type":"∀ (n : ℕ) (r : ℝ) (x : ℕ → ℝ),\n  0 ≤ r → r ≤ 1 → (∑ m ∈ Finset.range n, r ^ m * x m) ^ 2 ≤ ↑n * ∑ m ∈ Finset.range n, x m ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_hidden_kl","type":"∀ (K : ℝ) (T : ℕ), 0 ≤ K → K * ∑ j ∈ Finset.range T, (↑j + 1) ^ 2 ≤ K * ↑T ^ 3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_hidden_record","type":"∀ (α K T3 : ℝ), 0 < K → 2 * (1 - 2 * α) ^ 2 ≤ K * T3 → 2 * (1 - 2 * α) ^ 2 / K ≤ T3"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_hidden_unsafe_margin","type":"∀ (c μ κq : ℝ), κq = c + μ → c - κq = -μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_absresp_mono","type":"∀ (H : ℕ), 2 ≤ H → ∀ (ρ ρ' : ℝ), 0 ≤ ρ → ρ < ρ' → ∑ j ∈ Finset.range H, ρ ^ j < ∑ j ∈ Finset.range H, ρ' ^ j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_general_measure_bias","type":"∀ (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsFiniteMeasure μ] (g p : ℝ → ℝ) (B u : ℝ),\n  MeasureTheory.Integrable g μ →\n    MeasureTheory.Integrable p μ →\n      μ.real Set.univ ≤ B → 0 ≤ u → (∀ᵐ (r : ℝ) ∂μ, |g r - p r| ≤ u) → |∫ (r : ℝ), g r ∂μ - ∫ (r : ℝ), p r ∂μ| ≤ B * u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_modulus_tap_identity","type":"∀ {n L : ℕ} (g : ℝ → ℝ) (c : Fin L → ℝ) (r m : Fin n → ℝ),\n  ∑ j, m j * g (r j) - ∑ t, c t * ∑ j, m j * r j ^ ↑t = ∑ j, m j * (g (r j) - ∑ t, c t * r j ^ ↑t)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_modulus_cs","type":"∀ {L : ℕ} (c d : Fin L → ℝ) (R D : ℝ),\n  0 ≤ R → 0 ≤ D → ∑ t, c t ^ 2 ≤ R ^ 2 → ∑ t, d t ^ 2 ≤ D ^ 2 → ∑ t, c t * d t ≤ R * D"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_modulus_weak_duality","type":"∀ {n₁ n₀ L : ℕ} (g : ℝ → ℝ) (c : Fin L → ℝ) (r₁ m₁ : Fin n₁ → ℝ) (r₀ m₀ : Fin n₀ → ℝ) (B U V R D : ℝ),\n  (∀ (j : Fin n₁), 0 ≤ m₁ j) →\n    (∀ (j : Fin n₀), 0 ≤ m₀ j) →\n      ∑ j, m₁ j ≤ B →\n        ∑ j, m₀ j ≤ B →\n          0 ≤ U →\n            0 ≤ V →\n              (∀ (j : Fin n₁), g (r₁ j) - ∑ t, c t * r₁ j ^ ↑t ≤ U) →\n                (∀ (j : Fin n₀), -(g (r₀ j) - ∑ t, c t * r₀ j ^ ↑t) ≤ V) →\n                  0 ≤ R →\n                    0 ≤ D →\n                      ∑ t, c t ^ 2 ≤ R ^ 2 →\n                        ∑ t, (∑ j, m₁ j * r₁ j ^ ↑t - ∑ j, m₀ j * r₀ j ^ ↑t) ^ 2 ≤ D ^ 2 →\n                          ∑ j, m₁ j * g (r₁ j) - ∑ j, m₀ j * g (r₀ j) ≤ B * (U + V) + R * D"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_modulus_affine_bias","type":"∀ {n L : ℕ} (g : ℝ → ℝ) (c : Fin L → ℝ) (r m : Fin n → ℝ) (B U V : ℝ),\n  (∀ (j : Fin n), 0 ≤ m j) →\n    ∑ j, m j ≤ B →\n      0 ≤ U →\n        0 ≤ V →\n          (∀ (j : Fin n), g (r j) - ∑ t, c t * r j ^ ↑t ≤ U) →\n            (∀ (j : Fin n), -(g (r j) - ∑ t, c t * r j ^ ↑t) ≤ V) →\n              |∑ j, m j * g (r j) - (∑ t, c t * ∑ j, m j * r j ^ ↑t + B * (U - V) / 2)| ≤ B * (U + V) / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_mono_margin","type":"∀ (a κ N qbar qD s : ℝ), 1 - a - κ * N * ((1 - s) * qbar + s * qD) = 1 - a - κ * N * qbar - s * (κ * N * (qD - qbar))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_mono_threshold","type":"∀ (M0 c : ℝ), 0 < c → M0 - M0 / c * c = 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_mono_below","type":"∀ (M0 c s : ℝ), 0 < c → s < M0 / c → 0 < M0 - s * c"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_mono_above","type":"∀ (M0 c s : ℝ), 0 < c → M0 / c < s → M0 - s * c < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_mono_common_noise","type":"∀ (n σ2 : ℝ), n ^ 2 * σ2 = n * (n * σ2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_ma_matvec_abs","type":"∀ {d : ℕ} (A : Fin d → Fin d → ℝ) (u z : Fin d → ℝ),\n  (∀ (j k : Fin d), 0 ≤ A j k) → (∀ (k : Fin d), |u k| ≤ z k) → ∀ (j : Fin d), |∑ k, A j k * u k| ≤ ∑ k, A j k * z k"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_ma_flow_bound","type":"∀ {d n : ℕ} (Q Qbar : Fin n → Fin d → Fin d → ℝ) (S y v : Fin n → Fin d → ℝ) (z : Fin d → ℝ),\n  (∀ (i : Fin n) (j l : Fin d), 0 ≤ Qbar i j l) →\n    (∀ (i : Fin n) (l : Fin d), 0 ≤ S i l) →\n      (∀ (i : Fin n) (j l : Fin d), |Q i j l| ≤ Qbar i j l) →\n        (∀ (i : Fin n) (l : Fin d), |y i l| ≤ z l) →\n          (∀ (i : Fin n) (l : Fin d), |v i l| ≤ S i l * |y i l|) →\n            ∀ (k : Fin d), |∑ i, ∑ l, Q i k l * v i l| ≤ ∑ i, ∑ l, Qbar i k l * S i l * z l"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_ma_memory_box","type":"∀ (r y x m : ℝ), 0 ≤ r → r ≤ 1 → |y| ≤ m → |x| ≤ m → |r * y + (1 - r) * x| ≤ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_ma_step","type":"∀ {d n : ℕ} (A K : Fin d → Fin d → ℝ) (Q Qbar : Fin n → Fin d → Fin d → ℝ) (S : Fin n → Fin d → ℝ) (x : Fin d → ℝ)\n  (y v : Fin n → Fin d → ℝ) (w z : Fin d → ℝ) (wbar : ℝ),\n  (∀ (j k : Fin d), 0 ≤ A j k) →\n    (∀ (j k : Fin d), 0 ≤ K j k) →\n      (∀ (i : Fin n) (j l : Fin d), 0 ≤ Qbar i j l) →\n        (∀ (i : Fin n) (l : Fin d), 0 ≤ S i l) →\n          (∀ (i : Fin n) (j l : Fin d), |Q i j l| ≤ Qbar i j l) →\n            (∀ (k : Fin d), |x k| ≤ z k) →\n              (∀ (i : Fin n) (l : Fin d), |y i l| ≤ z l) →\n                (∀ (i : Fin n) (l : Fin d), |v i l| ≤ S i l * |y i l|) →\n                  (∀ (k : Fin d), |w k| ≤ wbar) →\n                    (∀ (j : Fin d), ∑ k, A j k * z k + ∑ k, K j k * (∑ i, ∑ l, Qbar i k l * S i l * z l + wbar) ≤ z j) →\n                      ∀ (j : Fin d), |∑ k, A j k * x k + ∑ k, K j k * (∑ i, ∑ l, Q i k l * v i l + w k)| ≤ z j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_multiasset_comparison","type":"∀ {d n : ℕ} (A K : Fin d → Fin d → ℝ) (Qbar : Fin n → Fin d → Fin d → ℝ) (S : Fin n → Fin d → ℝ) (wbar : ℝ)\n  (z : Fin d → ℝ) (x : ℕ → Fin d → ℝ) (y v : ℕ → Fin n → Fin d → ℝ) (Q : ℕ → Fin n → Fin d → Fin d → ℝ)\n  (R : ℕ → Fin n → Fin d → ℝ) (w : ℕ → Fin d → ℝ),\n  (∀ (j k : Fin d), 0 ≤ A j k) →\n    (∀ (j k : Fin d), 0 ≤ K j k) →\n      (∀ (i : Fin n) (j l : Fin d), 0 ≤ Qbar i j l) →\n        (∀ (i : Fin n) (l : Fin d), 0 ≤ S i l) →\n          (∀ (j : Fin d), ∑ k, A j k * z k + ∑ k, K j k * (∑ i, ∑ l, Qbar i k l * S i l * z l + wbar) ≤ z j) →\n            (∀ (j : Fin d), |x 0 j| ≤ z j) →\n              (∀ (i : Fin n) (j : Fin d), |y 0 i j| ≤ z j) →\n                (∀ (t : ℕ) (i : Fin n) (j l : Fin d), |Q t i j l| ≤ Qbar i j l) →\n                  (∀ (t : ℕ) (i : Fin n) (l : Fin d), |v t i l| ≤ S i l * |y t i l|) →\n                    (∀ (t : ℕ) (k : Fin d), |w t k| ≤ wbar) →\n                      (∀ (t : ℕ) (i : Fin n) (j : Fin d), 0 ≤ R t i j ∧ R t i j ≤ 1) →\n                        (∀ (t : ℕ) (j : Fin d),\n                            x (t + 1) j =\n                              ∑ k, A j k * x t k + ∑ k, K j k * (∑ i, ∑ l, Q t i k l * v t i l + w (t + 1) k)) →\n                          (∀ (t : ℕ) (i : Fin n) (j : Fin d),\n                              y (t + 1) i j = R t i j * y t i j + (1 - R t i j) * x (t + 1) j) →\n                            ∀ (t : ℕ), (∀ (j : Fin d), |x t j| ≤ z j) ∧ ∀ (i : Fin n) (j : Fin d), |y t i j| ≤ z j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_multiasset_supnorm","type":"∀ {d n : ℕ} (A K : Fin d → Fin d → ℝ) (Qbar : Fin n → Fin d → Fin d → ℝ) (S : Fin n → Fin d → ℝ) (wbar m : ℝ)\n  (z : Fin d → ℝ) (x : ℕ → Fin d → ℝ) (y v : ℕ → Fin n → Fin d → ℝ) (Q : ℕ → Fin n → Fin d → Fin d → ℝ)\n  (R : ℕ → Fin n → Fin d → ℝ) (w : ℕ → Fin d → ℝ),\n  (∀ (j k : Fin d), 0 ≤ A j k) →\n    (∀ (j k : Fin d), 0 ≤ K j k) →\n      (∀ (i : Fin n) (j l : Fin d), 0 ≤ Qbar i j l) →\n        (∀ (i : Fin n) (l : Fin d), 0 ≤ S i l) →\n          (∀ (j : Fin d), ∑ k, A j k * z k + ∑ k, K j k * (∑ i, ∑ l, Qbar i k l * S i l * z l + wbar) ≤ z j) →\n            (∀ (j : Fin d), z j ≤ m) →\n              (∀ (j : Fin d), x 0 j = 0) →\n                (∀ (i : Fin n) (j : Fin d), y 0 i j = 0) →\n                  (∀ (j : Fin d), 0 ≤ z j) →\n                    (∀ (t : ℕ) (i : Fin n) (j l : Fin d), |Q t i j l| ≤ Qbar i j l) →\n                      (∀ (t : ℕ) (i : Fin n) (l : Fin d), |v t i l| ≤ S i l * |y t i l|) →\n                        (∀ (t : ℕ) (k : Fin d), |w t k| ≤ wbar) →\n                          (∀ (t : ℕ) (i : Fin n) (j : Fin d), 0 ≤ R t i j ∧ R t i j ≤ 1) →\n                            (∀ (t : ℕ) (j : Fin d),\n                                x (t + 1) j =\n                                  ∑ k, A j k * x t k + ∑ k, K j k * (∑ i, ∑ l, Q t i k l * v t i l + w (t + 1) k)) →\n                              (∀ (t : ℕ) (i : Fin n) (j : Fin d),\n                                  y (t + 1) i j = R t i j * y t i j + (1 - R t i j) * x (t + 1) j) →\n                                ∀ (t : ℕ) (j : Fin d), |x t j| ≤ m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_multiasset_linear_monotone","type":"∀ {d : ℕ} (G : Fin d → Fin d → ℝ) (c z : Fin d → ℝ) (x : ℕ → Fin d → ℝ),\n  (∀ (j k : Fin d), 0 ≤ G j k) →\n    (∀ (j : Fin d), 0 ≤ c j) →\n      (∀ (j : Fin d), ∑ k, G j k * z k + c j ≤ z j) →\n        (∀ (j : Fin d), 0 ≤ z j) →\n          (∀ (j : Fin d), x 0 j = 0) →\n            (∀ (t : ℕ) (j : Fin d), x (t + 1) j = ∑ k, G j k * x t k + c j) →\n              ∀ (t : ℕ), (∀ (j : Fin d), x t j ≤ x (t + 1) j) ∧ (∀ (j : Fin d), 0 ≤ x t j) ∧ ∀ (j : Fin d), x t j ≤ z j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_natural_displacement","type":"∀ (a κ d : ℝ) (k g x : ℕ → ℝ),\n  g 0 = κ →\n    (∀ (s : ℕ), g (s + 1) = a * g s + κ * ∑ m ∈ Finset.range (s + 1), k m * g (s - m)) →\n      x 0 = d →\n        (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) →\n          ∀ (t : ℕ), κ * x t = d * g t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_natural_double_sum","type":"∀ (k x : ℕ → ℝ) (H : ℕ),\n  ∑ t ∈ Finset.range H, ∑ m ∈ Finset.range (t + 1), k m * x (t - m) =\n    ∑ s ∈ Finset.range H, x s * ∑ m ∈ Finset.range (H - s), k m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_natural_finite_margin","type":"∀ (a κ : ℝ) (k x : ℕ → ℝ),\n  (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) →\n    ∀ (H : ℕ),\n      x 0 - x H = (1 - a) * ∑ t ∈ Finset.range H, x t - κ * ∑ s ∈ Finset.range H, x s * ∑ m ∈ Finset.range (H - s), k m"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_horizon_worst_case","type":"∀ (g w : ℕ → ℝ) (wbar : ℝ) (H : ℕ),\n  (∀ (s : ℕ), |w s| ≤ wbar) → |∑ s ∈ Finset.range H, g s * w s| ≤ wbar * ∑ s ∈ Finset.range H, |g s|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_overshoot_positive_class","type":"∀ (a κ d : ℝ) (k x : ℕ → ℝ),\n  0 ≤ a →\n    0 ≤ κ →\n      (∀ (m : ℕ), 0 ≤ k m) →\n        x 0 = d →\n          (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) → ∀ (t : ℕ), 0 ≤ d * x t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_overshoot_certifies_contrarian","type":"∀ (a κ d : ℝ) (k x : ℕ → ℝ),\n  0 ≤ a →\n    0 ≤ κ →\n      x 0 = d →\n        (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) →\n          ∀ (s : ℕ), d * x s < 0 → ∃ m, k m < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_overshoot_realizable","type":"∀ (a κ d q : ℝ) (k x : ℕ → ℝ),\n  k 0 = q →\n    (∀ (m : ℕ), k (m + 1) = 0) →\n      x 0 = d →\n        (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) →\n          ∀ (t : ℕ), x t = d * (a + κ * q) ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_overshoot_alternates","type":"∀ (a κ d q : ℝ) (k x : ℕ → ℝ),\n  k 0 = q →\n    (∀ (m : ℕ), k (m + 1) = 0) →\n      x 0 = d →\n        (∀ (t : ℕ), x (t + 1) = a * x t + κ * ∑ m ∈ Finset.range (t + 1), k m * x (t - m)) →\n          a + κ * q < 0 → d ≠ 0 → d * x 1 < 0"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_passive_variance_le_inv","type":"∀ (ρ : ℝ) (v : ℕ → ℝ), ρ ^ 2 < 1 → v 0 = 0 → (∀ (t : ℕ), v (t + 1) = ρ ^ 2 * v t + 1) → ∀ (t : ℕ), v t ≤ 1 / (1 - ρ ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_passive_variance_le_t","type":"∀ (ρ : ℝ) (v : ℕ → ℝ), ρ ^ 2 ≤ 1 → v 0 = 0 → (∀ (t : ℕ), v (t + 1) = ρ ^ 2 * v t + 1) → ∀ (t : ℕ), v t ≤ ↑t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_passive_kl_sum","type":"∀ (ρ : ℝ) (v : ℕ → ℝ),\n  ρ ^ 2 < 1 →\n    v 0 = 0 → (∀ (t : ℕ), v (t + 1) = ρ ^ 2 * v t + 1) → ∀ (T : ℕ), ∑ t ∈ Finset.range T, v t ≤ ↑T / (1 - ρ ^ 2)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_passive_kl_margin","type":"∀ (μ : ℝ) (v : ℕ → ℝ),\n  0 < μ →\n    μ ≤ 1 →\n      v 0 = 0 →\n        (∀ (t : ℕ), v (t + 1) = (1 - μ) ^ 2 * v t + 1) →\n          ∀ (T : ℕ), (2 * μ) ^ 2 / 2 * ∑ t ∈ Finset.range T, v t ≤ 2 * ↑T * μ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_one_sub_le","type":"∀ (ρ : ℝ), 0 ≤ ρ → ρ ≤ 1 → 1 - ρ ≤ 1 - ρ ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_kl","type":"∀ (μ g T : ℝ), 0 < μ → 0 < g → 0 ≤ T → μ ≤ g → (2 * μ / g) ^ 2 / 2 * (T / (1 - (1 - μ / g) ^ 2)) ≤ 2 * T * μ / g"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_factor","type":"∀ (r γ : ℝ), 0 < γ → 1 + γ ≤ r → γ / (1 + γ) ≤ 1 - 1 / r"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_prod_lower","type":"∀ (L : ℕ) (b : ℝ) (a : ℕ → ℝ), 0 ≤ b → (∀ (j : ℕ), b ≤ a j) → b ^ L ≤ ∏ j ∈ Finset.range L, a j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_christoffel_cases","type":"∀ (I δ K p : ℝ), 0 < δ → δ ≤ 1 → 0 < K → p / (8 * δ) ≤ I ∨ 1 / (4 * K * δ ^ 2) ≤ I → min (p / 8) (1 / (4 * K)) / δ ≤ I"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pm_variance","type":"∀ (σ2 τ2 c G2 δ M g p : ℝ),\n  0 < p →\n    0 < σ2 →\n      0 < c → 0 < G2 → 0 < δ → 0 < g → δ = M / g → σ2 * c / (2 * p * G2 * δ) ≤ τ2 → σ2 / τ2 ≤ 2 * p * G2 * M / (c * g)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_peak_le_first","type":"∀ (a κ : ℝ) (k g : ℕ → ℝ),\n  0 ≤ a →\n    0 ≤ κ →\n      (∀ (m : ℕ), 0 ≤ k m) →\n        (∀ (s : ℕ), a + κ * ∑ m ∈ Finset.range (s + 1), k m ≤ 1) →\n          g 0 = κ →\n            (∀ (s : ℕ), g (s + 1) = a * g s + κ * ∑ m ∈ Finset.range (s + 1), k m * g (s - m)) →\n              ∀ (s : ℕ), 0 ≤ g s ∧ g s ≤ κ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_peak_locality","type":"∀ (a κ : ℝ) (k k' g g' : ℕ → ℝ) (n : ℕ),\n  (∀ m ≤ n, k m = k' m) →\n    g 0 = κ →\n      g' 0 = κ →\n        (∀ (s : ℕ), g (s + 1) = a * g s + κ * ∑ m ∈ Finset.range (s + 1), k m * g (s - m)) →\n          (∀ (s : ℕ), g' (s + 1) = a * g' s + κ * ∑ m ∈ Finset.range (s + 1), k' m * g' (s - m)) →\n            ∀ s ≤ n + 1, g s = g' s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_peak_monotone","type":"∀ (a κ : ℝ) (k k' g g' : ℕ → ℝ),\n  0 ≤ a →\n    0 ≤ κ →\n      (∀ (m : ℕ), 0 ≤ k m) →\n        (∀ (m : ℕ), k m ≤ k' m) →\n          g 0 = κ →\n            g' 0 = κ →\n              (∀ (s : ℕ), g (s + 1) = a * g s + κ * ∑ m ∈ Finset.range (s + 1), k m * g (s - m)) →\n                (∀ (s : ℕ), g' (s + 1) = a * g' s + κ * ∑ m ∈ Finset.range (s + 1), k' m * g' (s - m)) →\n                  ∀ (s : ℕ), 0 ≤ g s ∧ g s ≤ g' s"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pooled_sq","type":"∀ (u v : ℝ), (u + v) ^ 2 ≤ 2 * u ^ 2 + 2 * v ^ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pooled_var","type":"∀ (V₁ V₂ κ A δ : ℝ), V₁ ≤ A * δ → κ ^ 2 * V₂ ≤ A * δ → 2 * (V₁ + κ ^ 2 * V₂) ≤ 4 * (A * δ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pooled_kl","type":"∀ (μ κ sw2 se2 T : ℝ),\n  0 < μ →\n    0 < κ →\n      0 < sw2 → (2 * μ / κ) ^ 2 / 2 * T * ((κ ^ 2 * sw2 + se2) / (sw2 * μ)) = 2 * T * μ * (1 + se2 / (κ ^ 2 * sw2))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_pooled_record","type":"∀ (α μ R T : ℝ), 0 < μ → 0 ≤ R → 2 * (1 - 2 * α) ^ 2 ≤ 2 * T * μ * (1 + R) → (1 - 2 * α) ^ 2 / (μ * (1 + R)) ≤ T"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_memory_box","type":"∀ (r y x M : ℝ), 0 ≤ r → r ≤ 1 → |y| ≤ M → |x| ≤ M → |r * y + (1 - r) * x| ≤ M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_sector_flow_bound","type":"∀ {n : ℕ} (q Q s y v : Fin n → ℝ) (M : ℝ),\n  (∀ (i : Fin n), 0 ≤ Q i) →\n    (∀ (i : Fin n), 0 ≤ s i) →\n      (∀ (i : Fin n), |q i| ≤ Q i) →\n        (∀ (i : Fin n), |y i| ≤ M) → (∀ (i : Fin n), |v i| ≤ s i * |y i|) → |∑ i, q i * v i| ≤ (∑ i, Q i * s i) * M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_sector_finite_box","type":"∀ {n : ℕ} (H : ℕ) (a κ w M : ℝ) (Q s : Fin n → ℝ) (x : ℕ → ℝ) (y q v r : ℕ → Fin n → ℝ),\n  0 ≤ κ →\n    (∀ (i : Fin n), 0 ≤ Q i) →\n      (∀ (i : Fin n), 0 ≤ s i) →\n        x 0 = 0 →\n          (∀ (i : Fin n), y 0 i = 0) →\n            0 ≤ M →\n              (∀ t < H, ∀ (i : Fin n), |q t i| ≤ Q i) →\n                (∀ t < H, ∀ (i : Fin n), |v t i| ≤ s i * |y t i|) →\n                  (∀ t < H, ∀ (i : Fin n), 0 ≤ r t i ∧ r t i ≤ 1) →\n                    (∀ t < H, |x (t + 1)| ≤ |a| * |x t| + κ * (|∑ i, q t i * v t i| + w)) →\n                      (∀ t < H, ∀ (i : Fin n), y (t + 1) i = r t i * y t i + (1 - r t i) * x (t + 1)) →\n                        |a| * M + κ * ((∑ i, Q i * s i) * M + w) ≤ M → ∀ t ≤ H, |x t| ≤ M ∧ ∀ (i : Fin n), |y t i| ≤ M"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_sector_radius","type":"∀ (a κ Φ w : ℝ),\n  0 < 1 - |a| - κ * Φ →\n    |a| * (κ * w / (1 - |a| - κ * Φ)) + κ * (Φ * (κ * w / (1 - |a| - κ * Φ)) + w) = κ * w / (1 - |a| - κ * Φ)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_sector_safety","type":"∀ {n : ℕ} (H : ℕ) (a κ w : ℝ) (Q s : Fin n → ℝ) (x noise : ℕ → ℝ) (y q v r : ℕ → Fin n → ℝ),\n  0 ≤ κ →\n    0 ≤ w →\n      (∀ (i : Fin n), 0 ≤ Q i) →\n        (∀ (i : Fin n), 0 ≤ s i) →\n          x 0 = 0 →\n            (∀ (i : Fin n), y 0 i = 0) →\n              (∀ t < H, ∀ (i : Fin n), |q t i| ≤ Q i) →\n                (∀ t < H, ∀ (i : Fin n), |v t i| ≤ s i * |y t i|) →\n                  (∀ t < H, ∀ (i : Fin n), 0 ≤ r t i ∧ r t i ≤ 1) →\n                    (∀ t < H, |noise t| ≤ w) →\n                      (∀ t < H, x (t + 1) = a * x t + κ * (∑ i, q t i * v t i + noise t)) →\n                        (∀ t < H, ∀ (i : Fin n), y (t + 1) i = r t i * y t i + (1 - r t i) * x (t + 1)) →\n                          0 < 1 - |a| - κ * ∑ i, Q i * s i → ∀ t ≤ H, |x t| ≤ κ * w / (1 - |a| - κ * ∑ i, Q i * s i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_weight_drift","type":"∀ (q : ℕ → ℝ) (q0 γ : ℝ), |q 0| ≤ q0 → (∀ (t : ℕ), |q (t + 1) - q t| ≤ γ) → ∀ (t : ℕ), |q t| ≤ q0 + ↑t * γ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_lifetime_sensitivity","type":"∀ {n : ℕ} (q0 γ s : Fin n → ℝ) (Φ : ℝ) (H : ℕ),\n  (∀ (i : Fin n), 0 ≤ s i) →\n    0 ≤ ∑ i, γ i * s i → ↑H * ∑ i, γ i * s i ≤ Φ - ∑ i, q0 i * s i → ∀ t ≤ H, ∑ i, (q0 i + ↑t * γ i) * s i ≤ Φ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_lifetime_floor","type":"∀ (margin D : ℝ), 0 ≤ margin → 0 < D → ↑⌊margin / D⌋₊ * D ≤ margin"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_lifetime_envelope","type":"∀ {n : ℕ} (q : ℕ → Fin n → ℝ) (q0 γ s : Fin n → ℝ) (Φ : ℝ),\n  (∀ (i : Fin n), |q 0 i| ≤ q0 i) →\n    (∀ (t : ℕ) (i : Fin n), |q (t + 1) i - q t i| ≤ γ i) →\n      (∀ (i : Fin n), 0 ≤ γ i) →\n        (∀ (i : Fin n), 0 ≤ s i) →\n          ∑ i, q0 i * s i ≤ Φ →\n            0 < ∑ i, γ i * s i →\n              have H := ⌊(Φ - ∑ i, q0 i * s i) / ∑ i, γ i * s i⌋₊;\n              (∀ t ≤ H, ∀ (i : Fin n), |q t i| ≤ q0 i + ↑H * γ i) ∧ ∑ i, (q0 i + ↑H * γ i) * s i ≤ Φ"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_bias_from_tail","type":"∀ {n : ℕ} (weight tail : Fin n → ℝ) (B u : ℝ),\n  (∀ (i : Fin n), 0 ≤ weight i) →\n    0 ≤ u → ∑ i, weight i ≤ B → (∀ (i : Fin n), |tail i| ≤ u) → |∑ i, weight i * tail i| ≤ B * u"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_interval_half_width","type":"∀ (bias radius ε : ℝ), bias ≤ ε / 2 → radius ≤ ε / 2 → bias + radius ≤ ε"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_variance_radius","type":"∀ (z σ A N ε : ℝ), 0 ≤ z → 0 ≤ σ → 0 ≤ A → 0 < N → 0 ≤ ε → 4 * z ^ 2 * σ ^ 2 * A ≤ N * ε ^ 2 → z * σ * √(A / N) ≤ ε / 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_signed_psi_bounds","type":"∀ (s i : ℝ), i ≤ s → max s (-i) ≤ max s 0 + max (-i) 0 ∧ max s 0 + max (-i) 0 ≤ 2 * max s (-i)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_signed_modulus_sandwich","type":"∀ (B δn ψ m : ℝ), 0 ≤ B → 0 ≤ δn → m ≤ ψ → ψ ≤ 2 * m → B * ψ + δn ≤ 2 * B * m + δn ∧ 2 * B * m + δn ≤ 2 * (B * ψ + δn)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_signed_geom_mul","type":"∀ (x : ℝ) (H : ℕ), (∑ t ∈ Finset.range H, x ^ t) * (x - 1) = x ^ H - 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_signed_alternating_sum","type":"∀ (q : ℝ), 0 ≤ q → q < 1 → ∀ (H : ℕ), 0 ≤ ∑ t ∈ Finset.range H, (-q) ^ t ∧ ∑ t ∈ Finset.range H, (-q) ^ t ≤ 2"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_signed_abs_sum","type":"∀ q < 1, ∀ (H : ℕ), ∑ t ∈ Finset.range H, q ^ t = (1 - q ^ H) / (1 - q)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_strategic_profitable_deviation","type":"∀ (q : ℝ),\n  0 ≤ q → q ≤ 1 → ∃ q', 0 ≤ q' ∧ q' ≤ 1 ∧ CurrentMM.thesisStrategicUtility q < CurrentMM.thesisStrategicUtility q'"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.thesis_strategic_no_equilibrium","type":"¬∃ q, 0 ≤ q ∧ q ≤ 1 ∧ ∀ (z : ℝ), 0 ≤ z → z ≤ 1 → CurrentMM.thesisStrategicUtility z ≤ CurrentMM.thesisStrategicUtility q"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.aligned_sign_abs","type":"∀ (x : ℝ), |CurrentMM.alignedSign x| = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.aligned_sign_product","type":"∀ (x : ℝ), x * CurrentMM.alignedSign x = |x|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.scalar_window_envelope_bound","type":"∀ {T : ℕ} (background reserve fee gain V : ℝ) (coeff v : Fin T → ℝ),\n  0 ≤ gain →\n    0 ≤ fee →\n      (∀ (i : Fin T), |coeff i| ≤ gain) →\n        CurrentMM.scalarProbeQuantity v ≤ V →\n          CurrentMM.scalarWindowLoad background reserve fee coeff v ≤ |background| + reserve + (gain + fee) * V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.scalar_worst_pulse_quantity","type":"∀ {T : ℕ} (background V : ℝ) (coeff : Fin T → ℝ) (chosen : Fin T),\n  0 ≤ V → CurrentMM.scalarProbeQuantity (CurrentMM.scalarWorstPulse background V coeff chosen) = V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.scalar_worst_pulse_output","type":"∀ {T : ℕ} (background V : ℝ) (coeff : Fin T → ℝ) (chosen : Fin T),\n  0 ≤ V →\n    |CurrentMM.scalarWindowOutput background coeff (CurrentMM.scalarWorstPulse background V coeff chosen)| =\n      |background| + |coeff chosen| * V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.exact_scalar_window_budget","type":"∀ {T : ℕ} (background reserve fee gain V B : ℝ) (coeff : Fin T → ℝ) (chosen : Fin T),\n  0 ≤ V →\n    0 ≤ fee →\n      (∀ (i : Fin T), |coeff i| ≤ gain) →\n        |coeff chosen| = gain →\n          ((∀ (v : Fin T → ℝ),\n              CurrentMM.scalarProbeQuantity v ≤ V → CurrentMM.scalarWindowLoad background reserve fee coeff v ≤ B) ↔\n            |background| + reserve + (gain + fee) * V ≤ B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_window_gain_cap","type":"∀ (background reserve fee gain V B : ℝ),\n  0 < gain + fee → (|background| + reserve + (gain + fee) * V ≤ B ↔ V ≤ (B - reserve - |background|) / (gain + fee))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.zero_window_gain_feasibility","type":"∀ (background reserve fee gain V B : ℝ),\n  gain + fee = 0 → (|background| + reserve + (gain + fee) * V ≤ B ↔ |background| + reserve ≤ B)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.finite_window_minimum_cap","type":"∀ {ι : Type u_1} [DecidableEq ι] (times : Finset ι) (hne : times.Nonempty) (background gain : ι → ℝ)\n  (B reserve fee V : ℝ),\n  (∀ t ∈ times, 0 < gain t + fee) →\n    ((∀ t ∈ times, |background t| + reserve + (gain t + fee) * V ≤ B) ↔\n      V ≤ times.inf' hne fun t => (B - reserve - |background t|) / (gain t + fee))"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_carried_state_superposition","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (A : Module.End ℝ E) (H z0 : E) (v : ℕ → ℝ)\n  (t : ℕ), CurrentMM.carriedLinearRun A H z0 v t = (A ^ t) z0 + CurrentMM.controlledLinearRun A H v t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_carried_monetary_output","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (A : Module.End ℝ E) (C : E →ₗ[ℝ] ℝ) (H z0 : E)\n  (v : ℕ → ℝ) (t : ℕ),\n  C (CurrentMM.carriedLinearRun A H z0 v t) = C ((A ^ t) z0) + ∑ j ∈ Finset.range t, v j * C ((A ^ (t - 1 - j)) H)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_coordinate_power_invariance","type":"∀ {E : Type u_1} {F : Type u_2} [inst : AddCommGroup E] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module ℝ E]\n  [inst_3 : _root_.Module ℝ F] (T : E ≃ₗ[ℝ] F) (A : Module.End ℝ E) (z : E) (t : ℕ),\n  (CurrentMM.transformedTransition T A ^ t) (T z) = T ((A ^ t) z)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_monetary_coordinate_invariance","type":"∀ {E : Type u_1} {F : Type u_2} [inst : AddCommGroup E] [inst_1 : AddCommGroup F] [inst_2 : _root_.Module ℝ E]\n  [inst_3 : _root_.Module ℝ F] (T : E ≃ₗ[ℝ] F) (A : Module.End ℝ E) (C : E →ₗ[ℝ] ℝ) (z : E) (t : ℕ),\n  (C ∘ₗ ↑T.symm) ((CurrentMM.transformedTransition T A ^ t) (T z)) = C ((A ^ t) z)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_quantity_unit_state_invariance","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (A : Module.End ℝ E) (H z0 : E) (v : ℕ → ℝ)\n  (scale : ℝ),\n  scale ≠ 0 →\n    ∀ (t : ℕ),\n      CurrentMM.carriedLinearRun A (scale⁻¹ • H) z0 (fun j => scale * v j) t = CurrentMM.carriedLinearRun A H z0 v t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.quantity_unit_budget_invariance","type":"∀ {T : ℕ} (v : Fin T → ℝ) (scale : ℝ),\n  0 < scale → (CurrentMM.scalarProbeQuantity fun j => scale * v j) = scale * CurrentMM.scalarProbeQuantity v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.quantity_unit_envelope_invariance","type":"∀ (background reserve fee gain V scale : ℝ),\n  scale ≠ 0 →\n    |background| + reserve + (gain / scale + fee / scale) * (scale * V) = |background| + reserve + (gain + fee) * V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.uncarried_window_reset_counterexample","type":"9 / 10 * 1 + 1 = 19 / 10 ∧ 9 / 10 * 1 + 1 / 10 = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.finite_scalar_maximum_gain","type":"∀ {T : ℕ} (coeff : Fin (T + 1) → ℝ), ∃ chosen, ∀ (i : Fin (T + 1)), |coeff i| ≤ |coeff chosen|"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.prefix_quantity_budget","type":"∀ (v : ℕ → ℝ) (t N : ℕ) (V : ℝ),\n  t ≤ N → ∑ j ∈ Finset.range N, |v j| ≤ V → (CurrentMM.scalarProbeQuantity fun j => v ↑j) ≤ V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_monetary_prefix_gate","type":"∀ {E : Type u_1} [inst : AddCommGroup E] [inst_1 : _root_.Module ℝ E] (A : Module.End ℝ E) (C : E →ₗ[ℝ] ℝ) (H z0 : E)\n  (v : ℕ → ℝ) (t N : ℕ) (reserve fee gain V : ℝ),\n  t ≤ N →\n    0 ≤ gain →\n      0 ≤ fee →\n        (∀ (j : Fin t), |C ((A ^ (t - 1 - ↑j)) H)| ≤ gain) →\n          ∑ j ∈ Finset.range N, |v j| ≤ V →\n            |C (CurrentMM.carriedLinearRun A H z0 v t)| + reserve + fee * ∑ j ∈ Finset.range t, |v j| ≤\n              |C ((A ^ t) z0)| + reserve + (gain + fee) * V"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.hermitian_entry_power","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ) (hA : A.IsHermitian) (j k : ι) (t : ℕ),\n  (A ^ t) j k = ∑ i, ↑hA.eigenvectorUnitary j i * ↑hA.eigenvectorUnitary k i * hA.eigenvalues i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.positive_matrix_powers_dissipate","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A : Matrix ι ι ℝ),\n  A.PosSemidef → (1 - A).PosDef → ∀ (j k : ι), Filter.Tendsto (fun t => (A ^ t) j k) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_zero_anchor_impulse_successor","type":"∀ {n : ℕ} (impact : ℝ) (q rate : Fin n → ℝ) (t : ℕ),\n  0 ≤ impact →\n    (∀ (i : Fin n), 0 ≤ q i) →\n      (∀ (i : Fin n), 0 < rate i) →\n        CurrentMM.actualCohortImpulse 0 impact q rate (t + 1) =\n          impact *\n            ∑ i,\n              ∑ j,\n                CurrentMM.cohortSpectralVector 0 impact q rate i *\n                    (CurrentMM.cohortSpectralMatrix 0 impact q rate ^ t) i j *\n                  CurrentMM.cohortSpectralVector 0 impact q rate j"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_zero_anchor_impulse_dissipates","type":"∀ {n : ℕ} (impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ impact →\n    (∀ (i : Fin n), 0 ≤ q i) →\n      (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n        impact * ∑ i, q i < 1 → Filter.Tendsto (CurrentMM.actualCohortImpulse 0 impact q rate) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_parameter_set_compact","type":"∀ {ι : Type u_1} [inst : Fintype ι] (impact : ℝ), IsCompact (CurrentMM.compactMixtureParameters impact)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.mixture_moment_map_continuous","type":"∀ {ι : Type u_1} [inst : Fintype ι], Continuous CurrentMM.mixtureMomentMap"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_zero_anchor_weak_mixture","type":"∀ {n : ℕ} (impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ impact →\n    (∀ (i : Fin n), 0 ≤ q i) →\n      (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n        impact * ∑ i, q i < 1 →\n          ∃ lambda weights,\n            (∀ (i : Option (Fin n)), 0 ≤ lambda i ∧ lambda i ≤ 1) ∧\n              (∀ (i : Option (Fin n)), 0 ≤ weights i) ∧\n                ∑ i, weights i = impact ∧\n                  ∀ (t : ℕ), CurrentMM.actualCohortImpulse 0 impact q rate t = ∑ i, weights i * lambda i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_zero_anchor_impulse_mixture","type":"∀ {n : ℕ} (impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ impact →\n    (∀ (i : Fin n), 0 ≤ q i) →\n      (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n        impact * ∑ i, q i < 1 →\n          ∃ lambda weights,\n            (∀ (i : Option (Fin n)), 0 ≤ lambda i ∧ lambda i < 1) ∧\n              (∀ (i : Option (Fin n)), 0 ≤ weights i) ∧\n                ∑ i, weights i = impact ∧\n                  ∀ (t : ℕ), CurrentMM.actualCohortImpulse 0 impact q rate t = ∑ i, weights i * lambda i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_nonnegative_anchor_impulse_mixture","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ lambda weights,\n              (∀ (i : Option (Fin n)), 0 ≤ lambda i ∧ lambda i < 1) ∧\n                (∀ (i : Option (Fin n)), 0 ≤ weights i) ∧\n                  ∑ i, weights i = impact ∧\n                    ∀ (t : ℕ), CurrentMM.actualCohortImpulse a impact q rate t = ∑ i, weights i * lambda i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_mixture_difference_formula","type":"∀ {ι : Type u_1} [inst : Fintype ι] (weights lambda : ι → ℝ) (m t : ℕ),\n  CurrentMM.iteratedPriceDifference (CurrentMM.positiveMixtureKernel weights lambda) m t =\n    ∑ i, weights i * (1 - lambda i) ^ m * lambda i ^ t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_physical_impulse_completely_monotone","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 ≤ impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∀ (m t : ℕ), 0 ≤ CurrentMM.iteratedPriceDifference (CurrentMM.actualCohortImpulse a impact q rate) m t"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_all_anchor_execution_coercive","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ radius,\n              (0 ≤ radius ∧ radius < 1) ∧\n                ∀ (T : ℕ) (v : Fin T → ℝ),\n                  impact * ((1 - radius) / (1 + radius)) / 2 * CurrentMM.probeEnergy v ≤\n                    CurrentMM.quadraticExecutionCost (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_all_anchor_execution_cost_positive","type":"∀ {n T : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ) (v : Fin T → ℝ),\n  0 ≤ a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            (v ≠ fun x => 0) → 0 < CurrentMM.quadraticExecutionCost (CurrentMM.actualCohortImpulse a impact q rate) v"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"named_theorem","name":"CurrentMM.actual_all_anchor_trader_energy_bound","type":"∀ {n : ℕ} (a impact : ℝ) (q rate : Fin n → ℝ),\n  0 ≤ a →\n    0 < impact →\n      (∀ (i : Fin n), 0 ≤ q i) →\n        (∀ (i : Fin n), 0 < rate i ∧ rate i ≤ 1) →\n          a + impact * ∑ i, q i < 1 →\n            ∃ radius,\n              (0 ≤ radius ∧ radius < 1) ∧\n                ∀ (T : ℕ) (v : Fin T → ℝ) (B P fee : ℝ),\n                  0 ≤ fee →\n                    0 ≤\n                        CurrentMM.equity\n                          (CurrentMM.traderCashAfter B P impact fee (CurrentMM.actualCohortImpulse a impact q rate) v)\n                          (∑ i, v i) P →\n                      CurrentMM.probeEnergy v ≤ 2 * B / (impact * ((1 - radius) / (1 + radius)))"}
