    let some info := env.find? name | throwError "Missing declaration {name}"
    unless info.isTheorem do
      throwError "Expected theorem declaration: {name}"
    let axioms ← collectAxioms name
    let typeText ← liftTermElabM do
      return (← Meta.ppExpr info.type).pretty
    IO.println (Json.mkObj [("kind", toJson ("named_theorem" : String)),
      ("name", toJson name.toString), ("axioms", toJson (axioms.map Name.toString)),
      ("type", toJson typeText)]).compress
  IO.println (Json.mkObj [("kind", toJson ("audit_summary" : String)),
