  `CurrentMM.actual_all_anchor_execution_cost_positive,
  `CurrentMM.actual_all_anchor_trader_energy_bound]
  let mut allConstantCount := 0
  for (name, _) in env.constants.toList do
    if name.toString.startsWith "CurrentMM." then
      allConstantCount := allConstantCount + 1
      let axioms ← collectAxioms name
      for ax in axioms do
        unless allowed.contains ax do
          throwError "Forbidden axiom dependency in {name}: {ax}"
  for name in names do
    let some info := env.find? name | throwError "Missing declaration {name}"
    unless info.isTheorem do
      throwError "Expected theorem declaration: {name}"
    let axioms ← collectAxioms name
    let typeText ← liftTermElabM do
      return (← Meta.ppExpr info.type).pretty
    IO.println (Json.mkObj [("kind", toJson ("named_theorem" : String)),
      ("name", toJson name.toString), ("axioms", toJson (axioms.map Name.toString)),
      ("type", toJson typeText)]).compress
  IO.println (Json.mkObj [("kind", toJson ("audit_summary" : String)),
    ("named_theorems", toJson names.size),
    ("project_constants_scanned", toJson allConstantCount),
    ("status", toJson ("NAMED_DECLARATIONS_KERNEL_CHECKED_STANDARD_FOUNDATIONS_ONLY" : String))]).compress
