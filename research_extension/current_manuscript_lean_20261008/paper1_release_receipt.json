      "name": "CurrentMM.p1_gr_dominant_intensity_gap",
      "type": "\u2200 (W u d : \u211d),\n  0 < W \u2192\n    0 < u \u2192\n      0 \u2264 d \u2192\n        d \u2264 u / 3 \u2192\n          \u2200 (i : Fin 2),\n            CurrentMM.grIntensity CurrentMM.grGWeight CurrentMM.grGNode W u d i \u2264\n              CurrentMM.grIntensity CurrentMM.grRWeight CurrentMM.grRNode W u d 1 - W / (8 * u)"
    },
    {
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ],
      "kind": "named_theorem",
      "name": "CurrentMM.p1_gr_aggregate_gap",
      "type": "\u2200 (W u d : \u211d),\n  0 < W \u2192\n    0 \u2264 d \u2192\n      d < u \u2192\n        |\u2211 i, CurrentMM.grIntensity CurrentMM.grGWeight CurrentMM.grGNode W u d i -\n              \u2211 i, CurrentMM.grIntensity CurrentMM.grRWeight CurrentMM.grRNode W u d i| \u2264\n          2 * W * d ^ 3 / (u ^ 3 * (u - d))"
    },
    {
